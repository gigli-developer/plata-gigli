+  "NumpadAdd", "NumpadSubtract", "NumpadMultiply", "NumpadDivide", "NumpadDecimal", "NumpadEnter",
+  "Backquote", "Minus", "Equal", "BracketLeft", "BracketRight", "Backslash", "Semicolon", "Quote",
+  "Comma", "Period", "Slash", "MediaPlayPause", "MediaStop", "MediaTrackNext", "MediaTrackPrevious",
+  "AudioVolumeUp", "AudioVolumeDown", "AudioVolumeMute",
+]);
+
+const KEY_LABELS: Record<string, string> = {
+  Space: "Espacio", Escape: "Esc", Backspace: "Retroceso", Delete: "Supr", Home: "Inicio", End: "Fin",
+  PageUp: "RePág", PageDown: "AvPág", ArrowUp: "↑", ArrowDown: "↓", ArrowLeft: "←", ArrowRight: "→",
+  Pause: "Pausa", PrintScreen: "ImpPnt", ScrollLock: "Bloq Despl",
+  NumpadAdd: "Num +", NumpadSubtract: "Num −", NumpadMultiply: "Num *", NumpadDivide: "Num /",
+  NumpadDecimal: "Num .", NumpadEnter: "Num Enter",
+  Backquote: "`", Minus: "-", Equal: "=", BracketLeft: "[", BracketRight: "]", Backslash: "\\",
+  Semicolon: ";", Quote: "'", Comma: ",", Period: ".", Slash: "/",
+  MediaPlayPause: "Play/Pausa", MediaStop: "Stop", MediaTrackNext: "Siguiente", MediaTrackPrevious: "Anterior",
+  AudioVolumeUp: "Vol +", AudioVolumeDown: "Vol −", AudioVolumeMute: "Silencio",
+};
+
+/** KeyboardEvent.code → the key name atajos.rs stores, or null if it can't be a hotkey. */
+function keyFromCode(code: string): string | null {
+  if (/^Key[A-Z]$/.test(code)) return code.slice(3);
+  if (/^Digit[0-9]$/.test(code)) return code.slice(5);
+  if (/^F([1-9]|1[0-9]|2[0-4])$/.test(code)) return code;
+  if (/^Numpad[0-9]$/.test(code)) return code;
+  return NAMED_KEYS.has(code) ? code : null;
+}
+
+function keyLabel(key: string): string {
+  if (KEY_LABELS[key]) return KEY_LABELS[key];
+  if (/^Numpad[0-9]$/.test(key)) return `Num ${key.slice(6)}`;
+  return key;
+}
+
+/** "Ctrl+Alt+Space" → "Ctrl + Alt + Espacio". */
+export function displayHotkey(hotkey: string): string {
+  return hotkey
+    .split("+")
+    .map((t) => t.trim())
+    .filter(Boolean)
+    .map((t) => ((MODIFIERS as readonly string[]).includes(t) ? t : keyLabel(t)))
+    .join(" + ");
+}
+
+/** Keys nobody types with: they may go alone (or with Shift only). */
+function worksAlone(key: string): boolean {
+  return /^F\d+$/.test(key) || key.startsWith("Media") || key.startsWith("AudioVolume")
+    || key === "Pause" || key === "ScrollLock" || key === "PrintScreen";
+}
+
+/** The same refusal as atajos::normalize_hotkey, in the same words. */
+function whyNot(mods: Set<string>, key: string): string | null {
+  const strong = mods.has("Ctrl") || mods.has("Alt") || mods.has("Win");
+  if (!strong && !worksAlone(key)) {
+    return `${keyLabel(key)} sola taparía lo que escribís en cualquier programa: sumale Ctrl, Alt o Win, o usá una tecla F.`;
+  }
+  return null;
+}
+
+function modsOf(e: KeyboardEvent): Set<string> {
+  const mods = new Set<string>();
+  if (e.ctrlKey) mods.add("Ctrl");
+  if (e.altKey) mods.add("Alt");
+  if (e.shiftKey) mods.add("Shift");
+  if (e.metaKey) mods.add("Win");
+  return mods;
+}
+
+function combo(mods: Set<string>, key: string | null): string {
+  const parts: string[] = MODIFIERS.filter((m) => mods.has(m));
+  if (key) parts.push(key);
+  return parts.join("+");
+}
+
+function dot(color: string): HTMLElement {
+  return h("i", { class: "dot", style: `background:${color}` });
+}
+
+const GREEN = "#22c55e";
+const RED = "#f4505e";
+const GREY = "#6b7079";
+
+// ── Atajos ────────────────────────────────────────────────────────────────────
+
+export interface AtajosHooks {
+  /** The hotkey as stored right now. */
+  current: () => string;
+  /** Store a new hotkey through the normal settings save. */
+  save: (hotkey: string) => Promise<void>;
+}
+
+/** The section, plus `refresh` for when settings change in another window. */
+export function atajosSection(hooks: AtajosHooks): { el: HTMLElement; refresh: () => void } {
+  const stateDot = dot(GREY);
+  const field = h("button", { class: "keycap-field", type: "button", title: "Hacé clic y apretá la combinación" });
+  const reset = h("button", { class: "link", type: "button", text: `Restablecer (${DEFAULT_HOTKEY})` });
+  const feedback = h("div", {});
+  let listening = false;
+
+  const showKey = () => {
+    clear(field);
+    for (const part of displayHotkey(hooks.current() || DEFAULT_HOTKEY).split(" + ")) {
+      field.append(h("kbd", { text: part }));
+    }
+  };
+
+  const showStatus = (st: LauncherHotkeyStatus | null) => {
+    clear(feedback);
+    if (!st) return;
+    stateDot.style.background = st.registered ? GREEN : st.error ? RED : GREY;
+    if (st.error) feedback.append(h("div", { class: "notice err", text: st.error }));
+  };
+
+  const refresh = () => {
+    if (listening) return;
+    showKey();
+    void Bridge.launcherHotkeyStatus().then(showStatus);
+  };
+
+  const store = async (hotkey: string) => {
+    await hooks.save(hotkey);
+    // Rust registered it while saving: ask how it went.
+    showStatus(await Bridge.launcherHotkeyStatus());
+  };
+
+  field.addEventListener("focus", () => {
+    listening = true;
+    field.classList.add("listening");
+    clear(field);
+    field.append(h("span", { class: "hint", text: "Apretá la combinación… (Esc cancela)" }));
+    clear(feedback);
+    // Otherwise pressing the current key would open the launcher, not reach us.
+    void Bridge.launcherHotkeySuspend(true);
+  });
+
+  field.addEventListener("blur", () => {
+    listening = false;
+    field.classList.remove("listening");
+    showKey();
+    void Bridge.launcherHotkeySuspend(false).then(showStatus);
+  });
+
+  field.addEventListener("keydown", (e) => {
+    if (!listening) return;
+    e.preventDefault();
+    e.stopPropagation();
+    const mods = modsOf(e);
+    if (e.code === "Escape" && mods.size === 0) {
+      field.blur();
+      return;
+    }
+    if (["ControlLeft", "ControlRight", "AltLeft", "AltRight", "ShiftLeft", "ShiftRight", "MetaLeft", "MetaRight"].includes(e.code)) {
+      clear(field);
+      for (const part of displayHotkey(combo(mods, null)).split(" + ")) field.append(h("kbd", { text: part }));
+      field.append(h("span", { class: "hint", text: " + …" }));
+      return;
+    }
+    const key = keyFromCode(e.code);
+    clear(feedback);
+    if (!key) {
+      feedback.append(h("div", { class: "notice warn", text: "Esa tecla no se puede usar como atajo. Probá con otra." }));
+      return;
+    }
+    const why = whyNot(mods, key);
+    if (why) {
+      feedback.append(h("div", { class: "notice warn", text: why }));
+      return;
+    }
+    const hotkey = combo(mods, key);
+    void store(hotkey).then(() => field.blur());
+  });
+
+  reset.addEventListener("click", () => {
+    void store(DEFAULT_HOTKEY).then(showKey);
+  });
+
+  void onEvent<string>("launcher-hotkey-error", (reason) => {
+    stateDot.style.background = RED;
+    clear(feedback);
+    feedback.append(h("div", { class: "notice err", text: reason }));
+  });
+
+  refresh();
+
+  const el = h(
+    "section",
+    {},
+    h("h2", {}, stateDot, h("span", { text: "Atajos" })),
+    h("div", {
+      class: "hint",
+      text: "Una tecla abre la isla escuchando: decís lo que necesitás (o lo escribís) y Mochi elige la skill. Anda desde cualquier programa.",
+    }),
+    h("div", { class: "row" }, h("label", { text: "Abrir el lanzador" }), field, reset),
+    feedback,
+  );
+  return { el, refresh };
+}
+
+// ── Centro de Control ─────────────────────────────────────────────────────────
+
+/** Windows keeps a credential up to 2560 bytes of UTF-16. */
+const MAX_ICAL_CHARS = 1280;
+
+function icalLines(text: string): { urls: string[]; bad: number } {
+  const urls: string[] = [];
+  let bad = 0;
+  for (const raw of text.split(/\r?\n/)) {
+    const line = raw.trim();
+    if (!line || line.startsWith("#")) continue;
+    if (/^(https?|webcal):\/\/\S+$/i.test(line)) {
+      if (!urls.includes(line)) urls.push(line);
+    } else {
+      bad++;
+    }
+  }
+  return { urls, bad };
+}
+
+export function centroSection(present: Record<string, boolean>): HTMLElement {
+  // Secret
+  const secretDot = dot(present["cdc-secret"] ? GREEN : RED);
+  const secret = h("input", {
+    type: "password",
+    placeholder: present["cdc-secret"] ? "••••••••  (guardado)" : "el secreto cdc_coucou_secret",
+    autocomplete: "off",
+    spellcheck: "false",
+    style: "flex:1 1 auto;min-width:0",
+  }) as HTMLInputElement;
+  const secretSave = h("button", { text: "Guardar" });
+  const secretClear = h("button", { class: "danger", text: "Borrar" });
+  secretClear.style.display = present["cdc-secret"] ? "" : "none";
+
+  // Calendars
+  const icalDot = dot(present["cdc-ical-urls"] ? GREEN : RED);
+  const ical = h("textarea", {
+    rows: "3",
+    placeholder: present["cdc-ical-urls"]
+      ? "Hay calendarios guardados. Por seguridad no se muestran: pegá la lista completa para reemplazarla."
+      : "https://calendar.google.com/calendar/ical/…/basic.ics\n(una dirección por línea)",
+    autocomplete: "off",
+    spellcheck: "false",
+  }) as HTMLTextAreaElement;
+  const icalSave = h("button", { text: "Guardar" });
+  const icalClear = h("button", { class: "danger", text: "Borrar" });
+  icalClear.style.display = present["cdc-ical-urls"] ? "" : "none";
+
+  const feedback = h("div", {});
+  const say = (cls: "ok" | "err" | "warn", text: string) => {
+    clear(feedback);
+    feedback.append(h("div", { class: `notice ${cls}`, text }));
+  };
+
+  const setSecret = (stored: boolean) => {
+    present["cdc-secret"] = stored;
+    secretDot.style.background = stored ? GREEN : RED;
+    secret.placeholder = stored ? "••••••••  (guardado)" : "el secreto cdc_coucou_secret";
+    secretClear.style.display = stored ? "" : "none";
+  };
+  const setIcal = (stored: boolean) => {
+    present["cdc-ical-urls"] = stored;
+    icalDot.style.background = stored ? GREEN : RED;
+    ical.placeholder = stored
+      ? "Hay calendarios guardados. Por seguridad no se muestran: pegá la lista completa para reemplazarla."
+      : "https://calendar.google.com/calendar/ical/…/basic.ics\n(una dirección por línea)";
+    icalClear.style.display = stored ? "" : "none";
+  };
+
+  secretSave.addEventListener("click", async () => {
+    const value = secret.value.trim();
+    if (!value) return;
+    try {
+      await Bridge.secretSet("cdc-secret", value);
+      secret.value = "";
+      setSecret(true);
+      say("ok", "Secreto guardado. Nunca toca el disco.");
+    } catch (err) {
+      say("err", `No pude guardarlo: ${String(err)}`);
+    }
+  });
+
+  secretClear.addEventListener("click", async () => {
+    try {
+      await Bridge.secretClear("cdc-secret");
+      setSecret(false);
+      say("ok", "Secreto borrado.");
+    } catch (err) {
+      say("err", `No pude borrarlo: ${String(err)}`);
+    }
+  });
+
+  icalSave.addEventListener("click", async () => {
+    const { urls, bad } = icalLines(ical.value);
+    if (urls.length === 0) {
+      if (ical.value.trim()) say("warn", "Ninguna línea parece una dirección iCal: tienen que empezar con https://.");
+      return;
+    }
+    const value = urls.join("\n");
+    if (value.length > MAX_ICAL_CHARS) {
+      say("warn", `Son demasiadas direcciones para guardarlas juntas (hasta ${MAX_ICAL_CHARS} caracteres; hay ${value.length}).`);
+      return;
+    }
+    try {
+      await Bridge.secretSet("cdc-ical-urls", value);
+      ical.value = "";
+      setIcal(true);
+      const n = urls.length === 1 ? "1 calendario guardado" : `${urls.length} calendarios guardados`;
+      say(bad ? "warn" : "ok", bad ? `${n}. Salteé ${bad} línea${bad === 1 ? "" : "s"} que no parecía${bad === 1 ? "" : "n"} una dirección.` : `${n}.`);
+    } catch (err) {
+      say("err", `No pude guardarlos: ${String(err)}`);
+    }
+  });
+
+  icalClear.addEventListener("click", async () => {
+    try {
+      await Bridge.secretClear("cdc-ical-urls");
+      setIcal(false);
+      say("ok", "Calendarios borrados.");
+    } catch (err) {
+      say("err", `No pude borrarlos: ${String(err)}`);
+    }
+  });
+
+  return h(
+    "section",
+    {},
+    h("h2", {}, h("i", { class: "dot", style: "background:#7cc4ff" }), h("span", { text: "Centro de Control" })),
+    h("div", {
+      class: "hint",
+      text: "Las skills del Centro (Mi día, Lo que vence, Huecos de la semana…) leen tus tareas con este secreto y tu agenda de los calendarios iCal. Todo queda en el Administrador de credenciales de Windows.",
+    }),
+    h("div", { class: "row" },
+      h("label", { text: "Secreto" }), secret, secretSave, secretClear, secretDot,
+    ),
+    h("div", { class: "row", style: "align-items:flex-start" },
+      h("label", { text: "Calendarios (iCal)", style: "padding-top:6px" }),
+      h("div", { style: "display:flex;flex-direction:column;gap:6px;flex:1 1 auto;min-width:0" },
+        ical,
+        h("div", { class: "hint", text: "En Google Calendar: Configuración → tu calendario → Dirección secreta en formato iCal" }),
+      ),
+      h("div", { style: "display:flex;align-items:center;gap:8px;padding-top:4px" }, icalSave, icalClear, icalDot),
+    ),
+    feedback,
+  );
+}
