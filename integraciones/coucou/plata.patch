+#[cfg(windows)]
+/// The window's trip from where the island was let go to where it docks.
+struct Glide {
+    from: (i32, i32),
+    to: (i32, i32),
+    size: (i32, i32),
+    ticket: u64,
+}
+
+#[cfg(windows)]
+impl Glide {
+    /// Ease-out over SLIDE_MS, one step per composed frame. Gives up as soon as
+    /// anything else places the window (a new drag, a display change).
+    fn run(&self, hwnd: HWND) {
+        let (w, h) = self.size;
+        set_bounds(hwnd, self.from.0, self.from.1, w, h);
+        if SLIDE_MS > 0 && self.from != self.to && animations_enabled() {
+            let start = Instant::now();
+            let total = SLIDE_MS as f64 / 1000.0;
+            loop {
+                wait_frame();
+                if PLACEMENT.load(Ordering::SeqCst) != self.ticket {
+                    return;
+                }
+                let t = start.elapsed().as_secs_f64() / total;
+                if t >= 1.0 {
+                    break;
+                }
+                let e = 1.0 - (1.0 - t).powi(3);
+                let x = self.from.0 as f64 + (self.to.0 - self.from.0) as f64 * e;
+                let y = self.from.1 as f64 + (self.to.1 - self.from.1) as f64 * e;
+                move_to(hwnd, x.round() as i32, y.round() as i32);
+            }
+        }
+        if PLACEMENT.load(Ordering::SeqCst) == self.ticket {
+            set_bounds(hwnd, self.to.0, self.to.1, w, h);
+        }
+    }
+}
