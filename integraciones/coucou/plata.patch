--- /dev/null
+++ b/windows/src/views/chats.ts
@@ -0,0 +1,358 @@
+// The island's chats (Plata and Claude) and the large panel they share.
+//
+// Every chat has a size button in its header. Enlarged, the island becomes a
+// messaging app: the list of chats on the left (search, "+", one row per chat
+// with its last line, time and state) and the active chat on the right. The
+// chat views themselves are the same ones as in normal size: the panel only
+// lays them out (style.css #island.chat-big). Picking another chat in the list
+// switches the view; both have the same size, so the island stays put and only
+// the right side crossfades. Only the chats are listed: the Claude Code
+// sessions the hooks follow stay in the overview.
+
+import { h, svg, clear } from "./dom";
+import { ICONS } from "./icons";
+import { State } from "../core/state";
+import { chatBigSize, setChatBig, type IslandViewName } from "../core/layout";
+import { plainLine } from "./markdown";
+import type { ViewActions } from "./views";
+
+export type ChatId = "plata" | "prompt";
+
+interface ChatInfo {
+  name: string;
+  /** Avatar body: Plata's orange, the island's white Mochi for Claude. */
+  color: string;
+  /** The size button's tint, as "r,g,b". */
+  accent: string;
+}
+
+const CHAT_INFO: Record<ChatId, ChatInfo> = {
+  plata: { name: "Plata", color: "#ff9e1b", accent: "255,158,27" },
+  prompt: { name: "Claude", color: "#f5f6f8", accent: "245,246,248" },
+};
+
+/** Order of the list: Plata first, it is the one the panel is mostly for. */
+const ORDER: ChatId[] = ["plata", "prompt"];
+
+// ── What each chat reports for the list ────────────────────────────────────
+
+export interface ChatMeta {
+  /** Last real message, as one line of plain text ("" = none yet). */
+  last: string;
+  /** The last message was Lucas's. */
+  mine: boolean;
+  /** When it was sent or arrived (ms since epoch). */
+  at: number | null;
+  /** Waiting for an answer. */
+  busy: boolean;
+  /** Plata: proposals waiting for Approve / Reject. */
+  waiting: number;
+}
+
+const meta: Record<ChatId, ChatMeta> = {
+  plata: { last: "", mine: false, at: null, busy: false, waiting: 0 },
+  prompt: { last: "", mine: false, at: null, busy: false, waiting: 0 },
+};
+
+export function reportChat(id: ChatId, patch: Partial<ChatMeta>): void {
+  Object.assign(meta[id], patch);
