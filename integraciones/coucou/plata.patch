+  return words[w] ?? 0;
+}
+
+// ── Free time ───────────────────────────────────────────────────────────────
+
+/** A span of minutes since local midnight. */
+export interface Span {
+  s: number;
+  e: number;
+}
+
+export const DAY_FROM = 7 * 60;
+export const DAY_TO = 23 * 60;
+
+/**
+ * The timed events of one local day as minute spans, clipped to the day.
+ * `dayStartMs` is that day's local midnight in epoch ms. All-day events don't
+ * take time (a deadline, "Finalización del período").
+ */
+export function dayBusy(events: readonly CalEvent[], dayStartMs: number): Span[] {
+  const out: Span[] = [];
+  for (const ev of events) {
+    if (ev.allDay || ev.free) continue;
+    const s = Math.max(0, (ev.start - dayStartMs) / 60_000);
+    const e = Math.min(1440, (ev.end - dayStartMs) / 60_000);
+    if (e > s) out.push({ s, e });
+  }
+  return merge(out);
+}
+
+export function merge(spans: readonly Span[]): Span[] {
+  const sorted = [...spans].filter((x) => x.e > x.s).sort((a, b) => a.s - b.s);
+  const out: Span[] = [];
+  for (const x of sorted) {
+    const last = out[out.length - 1];
+    if (last && x.s <= last.e) last.e = Math.max(last.e, x.e);
+    else out.push({ ...x });
+  }
+  return out;
+}
+
+/**
+ * Free spans between `from` and `to` that aren't busy, at least `minLen`
+ * minutes long. `notBefore` cuts what already went by (today).
+ */
+export function freeSlots(
+  busy: readonly Span[],
+  opts: { from?: number; to?: number; minLen?: number; notBefore?: number } = {},
+): Span[] {
+  const from = Math.max(opts.from ?? DAY_FROM, opts.notBefore ?? 0);
+  const to = opts.to ?? DAY_TO;
+  const minLen = opts.minLen ?? 30;
+  const out: Span[] = [];
+  let cur = from;
+  for (const b of merge(busy)) {
+    if (b.e <= cur) continue;
+    if (b.s >= to) break;
+    if (b.s - cur >= minLen) out.push({ s: cur, e: Math.min(b.s, to) });
+    cur = Math.max(cur, b.e);
+  }
+  if (to - cur >= minLen) out.push({ s: cur, e: to });
+  return out;
+}
+
+/** The longest span (earliest on a tie), or null. */
+export function longest(spans: readonly Span[]): Span | null {
+  let best: Span | null = null;
+  for (const x of spans) if (!best || x.e - x.s > best.e - best.s) best = x;
+  return best;
+}
+
+export const total = (spans: readonly Span[]) => spans.reduce((a, x) => a + (x.e - x.s), 0);
+
+/** Rounds up to the next :00 or :30. */
+export function nextHalfHour(min: number): number {
+  return Math.ceil(min / 30) * 30;
+}
+
+// ── Tasks ───────────────────────────────────────────────────────────────────
+
+export type Why = "quieta" | "atrasada" | "hoy" | "proxima" | "en_curso";
+
+export interface Candidate {
+  id: string;
+  titulo: string;
+  area: string | null;
+  color: string | null;
+  why: Why;
+  /** quieta / atrasada: days; proxima: days to go; else 0. */
+  dias: number;
+  vence: string | null;
+}
+
+/**
+ * "¿Qué hago ahora?", deterministic: in-progress tasks that went quiet first
+ * (the quietest first), then the oldest overdue, then today's, then the nearest
+ * upcoming, then whatever is in progress and moving. "Otra" walks this list.
+ */
+export function pickTasks(f: Foco): Candidate[] {
+  const out: Candidate[] = [];
+  const seen = new Set<string>();
+  const add = (c: Candidate) => {
+    const key = c.id || c.titulo;
+    if (seen.has(key)) return;
+    seen.add(key);
+    out.push(c);
+  };
+  const enCurso = f.enCurso ?? [];
+  [...enCurso].filter((t) => t.quieta_dias > 0).sort((a, b) => b.quieta_dias - a.quieta_dias)
+    .forEach((t) => add({ id: t.id, titulo: t.titulo, area: t.area, color: t.color, why: "quieta", dias: t.quieta_dias, vence: null }));
+  [...(f.atrasadas ?? [])].sort((a, b) => b.dias_atraso - a.dias_atraso)
+    .forEach((t) => add({ id: t.id, titulo: t.titulo, area: t.area, color: t.color, why: "atrasada", dias: t.dias_atraso, vence: t.vence }));
+  (f.paraHoy ?? []).forEach((t) => add({ id: t.id, titulo: t.titulo, area: t.area, color: t.color, why: "hoy", dias: 0, vence: t.vence }));
+  [...(f.proximas ?? [])].sort((a, b) => a.en_dias - b.en_dias)
+    .forEach((t) => add({ id: t.id, titulo: t.titulo, area: t.area, color: t.color, why: "proxima", dias: t.en_dias, vence: t.vence }));
+  enCurso.filter((t) => t.quieta_dias <= 0)
+    .forEach((t) => add({ id: t.id, titulo: t.titulo, area: t.area, color: t.color, why: "en_curso", dias: 0, vence: null }));
+  return out;
+}
+
+/**
+ * Two tasks for tomorrow: what falls due tomorrow first, then the oldest
+ * overdue, then the nearest upcoming.
+ */
+export function suggestTomorrow(f: Foco): Candidate[] {
+  const due = [...(f.proximas ?? [])].filter((t) => t.en_dias <= 1).sort((a, b) => a.en_dias - b.en_dias)
+    .map<Candidate>((t) => ({ id: t.id, titulo: t.titulo, area: t.area, color: t.color, why: "proxima", dias: t.en_dias, vence: t.vence }));
+  const late = [...(f.atrasadas ?? [])].sort((a, b) => b.dias_atraso - a.dias_atraso)
+    .map<Candidate>((t) => ({ id: t.id, titulo: t.titulo, area: t.area, color: t.color, why: "atrasada", dias: t.dias_atraso, vence: t.vence }));
+  const next = [...(f.proximas ?? [])].filter((t) => t.en_dias > 1).sort((a, b) => a.en_dias - b.en_dias)
+    .map<Candidate>((t) => ({ id: t.id, titulo: t.titulo, area: t.area, color: t.color, why: "proxima", dias: t.en_dias, vence: t.vence }));
+  const out: Candidate[] = [];
+  for (const c of [...due, ...late, ...next]) {
+    if (!out.some((x) => (x.id || x.titulo) === (c.id || c.titulo))) out.push(c);
+    if (out.length === 2) break;
+  }
+  return out;
+}
+
+// ── Notices ─────────────────────────────────────────────────────────────────
+
+export interface AvisoGroup {
+  tipo: string;
+  /** The latest notice of this kind (by hour). */
+  ultimo: Aviso;
+  /** Highest rung reached today. */
+  nivel: number;
+  cantidad: number;
+}
+
+/** Today's notices, one row per kind, in the order they last went out (latest last). */
+export function groupAvisos(avisos: readonly Aviso[]): AvisoGroup[] {
+  const by = new Map<string, Aviso[]>();
+  for (const a of avisos) {
+    const k = a.tipo || "aviso";
+    if (!by.has(k)) by.set(k, []);
+    by.get(k)!.push(a);
+  }
+  const out: AvisoGroup[] = [];
+  for (const [tipo, xs] of by) {
+    const sorted = [...xs].sort((a, b) => a.hora.localeCompare(b.hora));
+    out.push({ tipo, ultimo: sorted[sorted.length - 1], nivel: Math.max(...xs.map((x) => x.nivel)), cantidad: xs.length });
+  }
+  return out.sort((a, b) => a.ultimo.hora.localeCompare(b.ultimo.hora));
+}
+
+/** "16:00" from "2026-10-06T16:00:00-03:00", "16:00:00" or "16:00". */
+export function horaDe(v: string): string {
+  // A full timestamp with its zone: read it in Buenos Aires (UTC−3).
+  if (/T\d{1,2}:\d{2}.*(Z|[+-]\d{2}:?\d{2})$/.test(v)) {
+    const ms = Date.parse(v);
+    if (Number.isFinite(ms)) {
+      const d = new Date(ms - 3 * 3_600_000);
+      return `${d.getUTCHours()}:${String(d.getUTCMinutes()).padStart(2, "0")}`;
+    }
+  }
+  const m = /(\d{1,2}):(\d{2})/.exec(v.includes("T") ? v.split("T")[1] : v);
+  return m ? `${Number(m[1])}:${m[2]}` : v;
+}
+
+// ── Tarea rápida ────────────────────────────────────────────────────────────
+
+export interface TareaRapida {
+  titulo: string;
+  /** "YYYY-MM-DD", or null when the text says no day. */
+  vence: string | null;
+}
+
+const WEEKDAYS: Record<string, number> = { domingo: 0, lunes: 1, martes: 2, miercoles: 3, jueves: 4, viernes: 5, sabado: 6 };
+const MONTHS = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
+const NUM_WORDS:Record<string, number> = { un: 1, una: 1, dos: 2, tres: 3, cuatro: 4, cinco: 5, seis: 6, siete: 7, ocho: 8, nueve: 9, diez: 10 };
+// Word edges that work with accents and ñ (\b doesn't): the text is padded with spaces.
+const B = "(?<=[\\s,.;:¡¿(])";
+const E = "(?=[\\s,.;:!?)])";
+const word = (body: string) => new RegExp(`${B}(?:${body})${E}`, "i");
+const plain = (s: string) => s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
+
+function ymd(y: number, m: number, d: number): string | null {
+  const t = new Date(Date.UTC(y, m - 1, d));
+  if (t.getUTCFullYear() !== y || t.getUTCMonth() !== m - 1 || t.getUTCDate() !== d) return null;
+  return `${y}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
+}
+
+function plusDays(date: string, n: number): string {
+  const [y, m, d] = date.split("-").map(Number);
+  const t = new Date(Date.UTC(y, m - 1, d + n));
+  return ymd(t.getUTCFullYear(), t.getUTCMonth() + 1, t.getUTCDate())!;
+}
+
+/**
+ * "mañana a la noche llamar al contador" → { titulo: "Llamar al contador a la noche",
+ * vence: tomorrow }. Understands hoy, mañana, pasado mañana, a weekday (the next
+ * one; said on that same day, next week's), "el 15", "15/10", "en 3 días" and
+ * "la semana que viene". `hoy` is today in Buenos Aires ("YYYY-MM-DD").
+ * Everything else stays in the title as it was written.
+ */
+export function parseTareaRapida(text: string, hoy: string): TareaRapida {
+  let t = ` ${text.trim()} `;
+  let vence: string | null = null;
+  const [hy, hm, hd] = hoy.split("-").map(Number);
+  const take = (re: RegExp, f: (m: RegExpExecArray) => string | null) => {
+    if (vence !== null) return;
+    const m = re.exec(t);
+    if (!m) return;
+    const v = f(m);
+    if (v === null) return;
+    vence = v;
+    t = `${t.slice(0, m.index)} ${t.slice(m.index + m[0].length)}`;
+  };
+
+  // "recordame…", "anotá…": how it was asked, not the task.
+  t = t.replace(/^\s*(?:record[aá](?:me)?|anot[aá](?:me)?|agend[aá](?:me)?|nueva tarea|tarea)\s*:?\s*(?:que\s+)?/i, " ");
+
+  take(word("(?:para\\s+)?pasado\\s+ma[ñn]ana"), () => plusDays(hoy, 2));
+  // Not "a la mañana" / "esta mañana": that's a time of day.
+  take(new RegExp(`${B}(?<!(?:la|esta|de|por)\\s)(?:para\\s+)?ma[ñn]ana${E}`, "i"), () => plusDays(hoy, 1));
+  take(word("(?:para\\s+)?hoy"), () => hoy);
+  take(word("(?:para\\s+)?(?:el\\s+|este\\s+)?(?:pr[óo]ximo\\s+)?(lunes|martes|mi[ée]rcoles|jueves|viernes|s[áa]bado|domingo)"), (m) => {
+    const wd = WEEKDAYS[plain(m[1])];
+    const today = new Date(Date.UTC(hy, hm - 1, hd)).getUTCDay();
+    return plusDays(hoy, (wd - today + 7) % 7 || 7);
+  });
+  take(word("(?:para\\s+)?(?:el\\s+)?(\\d{1,2})[/-](\\d{1,2})(?:[/-](\\d{2}|\\d{4}))?"), (m) => {
+    const d = Number(m[1]);
+    const mo = Number(m[2]);
+    if (m[3]) return ymd(m[3].length === 2 ? 2000 + Number(m[3]) : Number(m[3]), mo, d);
+    const thisYear = ymd(hy, mo, d);
+    if (!thisYear) return null;
+    return thisYear >= hoy ? thisYear : ymd(hy + 1, mo, d);
+  });
+  take(word("(?:para\\s+)?(?:el\\s+)?(\\d{1,2})\\s+de\\s+(enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|setiembre|octubre|noviembre|diciembre)"), (m) => {
+    const mo = MONTHS.indexOf(plain(m[2]).replace("setiembre", "septiembre")) + 1;
+    const thisYear = ymd(hy, mo, Number(m[1]));
+    if (!thisYear) return null;
+    return thisYear >= hoy ? thisYear : ymd(hy + 1, mo, Number(m[1]));
+  });
+  take(word("(?:para\\s+)?el\\s+(\\d{1,2})(?!\\s*(?:hs|h|:|\\d|de\\s))"), (m) => {
+    const d = Number(m[1]);
+    if (d < 1 || d > 31) return null;
+    for (let k = 0; k < 3; k++) {
+      const mo0 = hm - 1 + k;
+      const v = ymd(hy + Math.floor(mo0 / 12), (mo0 % 12) + 1, d);
+      if (v && v >= hoy) return v;
+    }
+    return null;
+  });
+  take(word("(?:dentro\\s+de|en)\\s+(\\d{1,2}|un|una|dos|tres|cuatro|cinco|seis|siete|ocho|nueve|diez)\\s+d[ií]as?"), (m) => {
+    const n = /^\d+$/.test(m[1]) ? Number(m[1]) : NUM_WORDS[plain(m[1])];
+    return n ? plusDays(hoy, n) : null;
+  });
+  take(word("(?:para\\s+)?(?:la\\s+)?(?:semana\\s+que\\s+viene|pr[óo]xima\\s+semana|semana\\s+pr[óo]xima)"), () => plusDays(hoy, 7));
+
+  let titulo = t.replace(/\s+/g, " ").trim();
+  // What was left in front of the day ("que llame…", ", comprar…").
+  for (let prev = ""; prev !== titulo; ) {
+    prev = titulo;
+    titulo = titulo.replace(/^(?:[,.;:\-–]+\s*|(?:que|de)\s+)/i, "").replace(/\s*[,;:\-–]+$/, "").trim();
+  }
+  // "a la noche llamar al contador" reads better with the time at the end.
+  const tod = /^(a la (?:mañana|manana|tarde|noche)|al mediod[ií]a|a las? \d{1,2}(?::\d{2})?(?:\s*(?:hs|h))?)\s+(.+)$/i.exec(titulo);
+  if (tod) titulo = `${tod[2]} ${tod[1]}`;
+  if (titulo) titulo = titulo.charAt(0).toUpperCase() + titulo.slice(1);
+  return { titulo, vence };
+}
