+}
+
+/** "3" → 3; a word for a rung ("primero", "ultimo"…) → its number; else 0. */
+export function nivelNum(v: unknown): number {
+  const n = Number(v);
+  if (v !== null && v !== "" && typeof v !== "boolean" && Number.isFinite(n)) return n;
+  const w = String(v ?? "").trim().toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
