+
+  function rowsFor(s: Seg): Row[] {
+    const f = foco;
+    if (!f) return [];
+    const running = f.enCurso?.find((t) => t.cronometro_desde)?.id ?? null;
+    const meta = (area: string | null, proyecto?: string | null) => [area, proyecto].filter(Boolean).join(" · ");
+    let rows: Row[] = [];
+    if (s === "hoy") {
+      rows = [
+        ...[...(f.atrasadas ?? [])].sort((a, b) => b.dias_atraso - a.dias_atraso).map<Row>((t) => ({
+          id: t.id, titulo: t.titulo, color: t.color, meta: meta(t.area, t.proyecto), tag: `${t.dias_atraso} d tarde`, tone: "late", running: t.id === running,
+        })),
+        ...(f.paraHoy ?? []).map<Row>((t) => ({
+          id: t.id, titulo: t.titulo, color: t.color, meta: meta(t.area, t.proyecto), tag: "hoy", tone: "soon", running: t.id === running,
+        })),
+      ];
+    } else if (s === "curso") {
+      rows = (f.enCurso ?? []).map<Row>((t) => ({
+        id: t.id, titulo: t.titulo, color: t.color, meta: meta(t.area, t.proyecto),
