+// Atajos — the eight Plata skills. Reads come from the agent's quick endpoints
+// (contract §1, through Bridge.quickPlata): no model, no tokens. Registering a
+// spending goes through quick_gasto (a deterministic parser) and proposal_decide;
+// "Contar una situación" talks to the agent (Bridge.plataSend, a new session)
+// and shows the proposals it makes as cards to approve.
+
+import { h, clear } from "../dom";
+import { Bridge, onEvent } from "../../core/bridge";
+import { Sound } from "../../core/sound";
+import { renderMarkdown } from "../plata-markdown";
+import { Card, PLATA_URL, decideButtons, errLine, errorBlock, note, type OpenOpts } from "./card";
+import * as data from "./data";
+import {
+  arClock, ars, classifyError, dec, fechaCorta, mesAnterior, mesNombre, money, num, palabra, plural, usd,
+} from "./format";
+import { horaDe } from "./plan";
+import { ICON, acts, box, btn, li, pill, row, stat, typing } from "./ui";
+
+type Obj = Record<string, unknown>;
+const obj = (v: unknown): Obj => (v && typeof v === "object" && !Array.isArray(v) ? (v as Obj) : {});
+const arr = (v: unknown): Obj[] | null => (Array.isArray(v) ? v.map(obj) : null);
+const str = (v: unknown): string => (v == null ? "" : String(v));
+
+export type Runner = (c: Card, pre: string | null, opts: OpenOpts) => void;
