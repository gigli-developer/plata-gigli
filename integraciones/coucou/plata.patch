+++ b/windows/src/views/atajos/launcher.ts
@@ -0,0 +1,381 @@
+// Atajos de la isla — the launcher. A global key (atajos.rs) opens the island
+// here, already listening: Windows voice typing (Win+H) writes what Lucas says
+// into the field, and once the text stops changing for a second the porter
+// (router.ts) picks one of the 16 skills and opens its card. Typing works too:
+// Enter routes the text, or opens the highlighted skill. The cards themselves
+// live in skills-plata.ts / skills-centro.ts; this file is the list, the voice
+// bar, the routing and the height of the island.
+//
+// The approved prototype is atajos-de-la-isla.html (CONTRATO-ATAJOS.md §4).
+
+import { h, clear } from "../dom";
+import { Bridge } from "../../core/bridge";
+import { Sound } from "../../core/sound";
+import { State } from "../../core/state";
+import { setLauncherHeight } from "../../core/layout";
+import type { ViewActions, ViewHost } from "../views";
+import { AGENTS, SKILLS, decide, filterSkills, hasAmount, routeByRules, skillById, skillHints, type AgentId, type Decision, type SkillId } from "./router";
+import { Card, type CardHost, type OpenOpts } from "./card";
+import { CENTRO_RUN } from "./skills-centro";
+import { PLATA_RUN, type Runner } from "./skills-plata";
+import { SEARCH_SVG, icon, kbd, mochi } from "./ui";
+import { knownPersonas } from "./data";
+
+const RUN: Record<SkillId, Runner> = { ...CENTRO_RUN, ...PLATA_RUN };
+
+/** The island's frame around a view: #content padding (8 + 10) and the header (34). */
+const CHROME_H = 52;
+/** Voice typing writes in bursts: this long without changes and the phrase is done. */
+const SETTLE_MS = 1000;
+/** "Entendí: X" stays this long before the card opens. */
+const UNDERSTOOD_MS = 1000;
+
+/** The island re-animates its geometry when the launcher asks for another height. */
+const resizeListeners = new Set<() => void>();
+export function onLauncherResize(fn: () => void): void {
+  resizeListeners.add(fn);
+}
+
+export interface LauncherHost extends ViewHost {
+  /** `listen`: opened by the global key, so voice typing starts right away. */
+  open(listen: boolean): void;
+  /** Leaving the launcher: stop timers, let the island lose focus. */
+  leave(): void;
+  /** Straight to one skill's card (the Plata and Centro tabs' buttons). */
+  openSkill(id: SkillId, pre?: string | null): void;
+  /** As if `text` had been typed in the launcher and Enter pressed. */
+  ask(text: string): void;
+}
+
+export function buildLauncher(actions: ViewActions): LauncherHost {
+  // ── List ────────────────────────────────────────────────────────────────
+  const input = h("input", {
+    type: "text",
+    class: "lz-input",
+    placeholder: "¿Qué necesitás? Hablá, o escribí y Enter…",
+    autocomplete: "off",
+    spellcheck: "false",
+    "aria-label": "Qué necesitás",
+  }) as HTMLInputElement;
+  const search = h("label", { class: "lz-search", html: SEARCH_SVG }, input, h("kbd", { text: "Esc" }));
+
+  const wave = h("span", { class: "lz-wave", "aria-hidden": "true" }, h("i"), h("i"), h("i"), h("i"), h("i"));
+  const vstate = h("span", { class: "lz-vstate" });
+  const voice = h("div", { class: "lz-voice quiet" }, wave, vstate);
+  voice.hidden = true;
+
+  const rows = new Map<SkillId, HTMLButtonElement>();
+  const groups = h("div", { class: "lz-groups" });
+  for (const agent of ["cdc", "plata"] as AgentId[]) {
+    const a = AGENTS[agent];
+    const g = h("div", { class: "lz-group" });
+    g.style.setProperty("--rgb", a.rgb);
+    g.append(h("h4", {}, mochi(a.color, 16).el, h("span", { text: a.name })));
+    for (const s of SKILLS.filter((x) => x.agent === agent)) {
