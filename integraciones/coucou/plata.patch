+  const running = enCurso?.find((t) => t.cronometro_desde);
+  if (running) {
+    const since = Date.parse(running.cronometro_desde ?? "");
+    const mins = Number.isFinite(since) ? Math.max(0, Math.round((Date.now() - since) / 60_000)) : null;
+    parts.push(`Corre el cronómetro de **${running.titulo}**${mins !== null ? ` hace ${duracion(mins)}` : ""}.`);
+  }
+  c.says(parts.join(" "));
+
+  const oldest = atr?.length ? Math.max(...atr.map((t) => t.dias_atraso)) : 0;
+  const quiet = enCurso?.find((t) => t.quieta_dias > 0);
+  const habitos = f.habitos;
+  const hechos = habitos?.filter((x) => x.hecho_hoy).length ?? 0;
+
+  const st = statusEl();
+  const pause: HTMLButtonElement | null = running
+    ? btn("Pausar cronómetro", "sec", async () => {
+        if (!(await hacer(c, st, [pause], "pausar", {}, "Pausando…")) || !c.alive()) return;
+        tell(st, `Pausé ${running.titulo}.`, "ok");
+        pause?.remove();
+      })
+    : null;
+  const libre: HTMLButtonElement | null = f.noTrabaja
+    ? null
+    : confirmBtn("Hoy no trabajo", "¿Seguro? Sí, hoy no", async () => {
+        if (!(await hacer(c, st, [libre], "no_trabajo", { motivo: "dia_libre" }, "Anotando…")) || !c.alive()) return;
+        c.happy();
+        tell(st, "Anotado: hoy no trabajás.", "ok");
+        libre?.remove();
+      });
+  c.set(
+    dayBox(c, "Hoy", cal, now.date, now.min, "dia"),
+    row(
+      "lz-row3",
+      stat("Atrasadas", atr ? String(atr.length) : null, atr?.length ? `la más vieja, ${oldest} ${plural(oldest, "día", "días")}` : "nada atrasado", { late: !!atr?.length }),
+      stat("En curso", enCurso ? String(enCurso.length) : null, enCurso?.length ? `${(quiet ?? enCurso[0]).titulo}${quiet ? ", quieta" : ""}` : "nada empezado"),
+      stat("Hábitos", habitos ? String(hechos) : null, habitos?.length ? habitos.map((x) => x.nombre.toLowerCase()).join(", ") : "sin hábitos", { small: habitos ? `/${habitos.length}` : undefined }),
+    ),
+    acts(
+      btn("Cerrar el día", "prim", () => c.host.open("cierre"), { enter: true }),
+      btn("¿Qué hago ahora?", "sec", () => c.host.open("ahora")),
+      btn("Ver los avisos", "sec", () => c.host.open("avisos")),
