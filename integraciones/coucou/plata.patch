+// Atajos — money, dates and hours the way the cards write them (es-AR), and
+// how an error turns into the line a card shows. Pure, no relative imports:
+// tested with `node --test` (windows/tests).
+
+const int = new Intl.NumberFormat("es-AR", { maximumFractionDigits: 0 });
+const dec2 = new Intl.NumberFormat("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+
+/** A number that really came in, or null (never 0 for a missing value). */
+export function num(v: unknown): number | null {
+  if (v === null || v === undefined || v === "" || typeof v === "boolean") return null;
+  const n = Number(v);
+  return Number.isFinite(n) ? n : null;
+}
+
+/** "$ 12.500" — pesos, no decimals. */
+export function ars(n: number): string {
+  const r = Math.round(n);
+  return `${r < 0 ? "−" : ""}$ ${int.format(Math.abs(r))}`;
+}
+
+/** "US$ 2.285,77" */
+export function usd(n: number): string {
+  return `${n < 0 ? "−" : ""}US$ ${dec2.format(Math.abs(n))}`;
+}
+
+/** "7.206,18" — USDT, two decimals, no symbol (the box says USDT). */
+export function dec(n: number): string {
+  return `${n < 0 ? "−" : ""}${dec2.format(Math.abs(n))}`;
+}
+
+/** Amount in its currency: ARS → "$ 1.234", USD → "US$ 1.234,00", other → "1.234,00 USDT". */
+export function money(n: number, moneda = "ARS"): string {
+  const m = (moneda || "ARS").toUpperCase();
+  if (m === "ARS") return ars(n);
+  if (m === "USD") return usd(n);
+  return `${dec(n)} ${m}`;
+}
+
+// ── Time, in Buenos Aires ───────────────────────────────────────────────────
+// Argentina is UTC−3 all year (no daylight saving since 2009), so local time is
+// a fixed shift: no need for the Intl time-zone machinery.
+
+export const AR_OFFSET_MIN = -180;
+
+export interface ArClock {
+  /** "YYYY-MM-DD" */
+  date: string;
+  /** Minutes since local midnight. */
+  min: number;
+  /** 0 = domingo … 6 = sábado */
+  weekday: number;
+}
+
+export function arClock(ms: number = Date.now()): ArClock {
+  const d = new Date(ms + AR_OFFSET_MIN * 60_000);
+  return {
+    date: `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`,
+    min: d.getUTCHours() * 60 + d.getUTCMinutes(),
+    weekday: d.getUTCDay(),
+  };
+}
+
+/** Epoch ms of a local Buenos Aires date + minutes. */
+export function arMs(date: string, min = 0): number {
+  const [y, m, d] = date.slice(0, 10).split("-").map(Number);
+  return Date.UTC(y, m - 1, d) + (min - AR_OFFSET_MIN) * 60_000;
+}
+
+export function addDays(date: string, n: number): string {
+  const [y, m, d] = date.slice(0, 10).split("-").map(Number);
+  const t = new Date(Date.UTC(y, m - 1, d + n));
+  return `${t.getUTCFullYear()}-${pad(t.getUTCMonth() + 1)}-${pad(t.getUTCDate())}`;
+}
+
+/** Whole days from `a` to `b` (both "YYYY-MM-DD"). */
+export function daysBetween(a: string, b: string): number {
+  return Math.round((arMs(b) - arMs(a)) / 86_400_000);
+}
+
+function pad(n: number): string {
+  return String(n).padStart(2, "0");
+}
+
+export const DIAS = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
+export const DIAS_CORTOS = ["dom", "lun", "mar", "mié", "jue", "vie", "sáb"];
+export const MESES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
+
+export function weekdayOf(date: string): number {
+  const [y, m, d] = date.slice(0, 10).split("-").map(Number);
+  return new Date(Date.UTC(y, m - 1, d)).getUTCDay();
+}
+
+/** "sáb 10" */
+export function fechaCorta(date: string): string {
+  return `${DIAS_CORTOS[weekdayOf(date)]} ${Number(date.slice(8, 10))}`;
+}
+
+/** "Miércoles 7" */
+export function fechaLarga(date: string): string {
+  const d = DIAS[weekdayOf(date)];
+  return `${d.charAt(0).toUpperCase()}${d.slice(1)} ${Number(date.slice(8, 10))}`;
+}
+
+/** "2026-10" → "octubre"; anything else as it came. */
+export function mesNombre(ym: string): string {
+  const m = /^(\d{4})-(\d{2})/.exec(ym);
+  return m ? MESES[Number(m[2]) - 1] ?? ym : ym;
+}
+
+/** The month before "2026-10" → "septiembre". */
+export function mesAnterior(ym: string): string {
+  const m = /^(\d{4})-(\d{2})/.exec(ym);
+  if (!m) return "el mes pasado";
+  const i = Number(m[2]) - 2;
+  return MESES[(i + 12) % 12];
+}
+
+/** Minutes → "17:30", or "16" on the hour (as the prototype writes ranges). */
+export function hm(min: number): string {
+  const m = Math.round(min);
+  const h = Math.floor(m / 60) % 24;
+  const r = m % 60;
+  return r === 0 ? String(h) : `${h}:${pad(r)}`;
+}
+
+/** Minutes → "17:30" / "16:00" — a clock time. */
+export function hhmm(min: number): string {
+  const m = Math.round(min);
+  return `${Math.floor(m / 60) % 24}:${pad(m % 60)}`;
+}
+
+/** "45 min", "1 h", "2 h 15 min" */
+export function duracion(min: number): string {
+  const m = Math.max(0, Math.round(min));
+  if (m < 60) return `${m} min`;
+  const h = Math.floor(m / 60);
+  const r = m % 60;
+  return r ? `${h} h ${r} min` : `${h} h`;
+}
+
+/** "en 4 d", "hoy", "mañana", "3 d tarde" */
+export function enDias(n: number): string {
+  if (n === 0) return "hoy";
+  if (n === 1) return "mañana";
+  if (n < 0) return `${-n} d tarde`;
+  return `en ${n} d`;
+}
+
+/** "uno", "dos"… up to ten, for the sentences Mochi says; digits after that. */
+export function palabra(n: number, fem = false): string {
+  const w = ["cero", fem ? "una" : "uno", "dos", "tres", "cuatro", "cinco", "seis", "siete", "ocho", "nueve", "diez"];
+  return n >= 0 && n <= 10 && Number.isInteger(n) ? w[n] : int.format(n);
+}
+
+export function plural(n: number, one: string, many: string): string {
+  return n === 1 ? one : many;
+}
+
+// ── Errors → what the card says ─────────────────────────────────────────────
+
+export type ErrorKind = "sesion" | "config" | "apagado" | "fuera" | "red";
+
+export interface CardError {
+  kind: ErrorKind;
+  text: string;
+}
+
+/**
+ * Sorts an error from Rust or the agent into the four things a card can say.
+ * `what` names the thing that couldn't be read ("tus saldos").
+ */
+export function classifyError(err: unknown, what: string): CardError {
+  const raw = String((err as { message?: unknown })?.message ?? err ?? "").replace(/^Error:\s*/, "").trim();
+  const n = raw.toLowerCase();
+  // Coucou's errors are already sentences in Spanish (atajos.rs): shown as they come.
+  const sentence = /^[A-ZÁÉÍÓÚÑ¿¡]/.test(raw) && raw.length > 12;
+  const said = (fallback: string) => (sentence ? withDot(raw) : fallback);
+  if (n.includes("sin_sesion") || n.includes("sin sesión") || n.includes("sin sesion")) {
+    return { kind: "sesion", text: "El agente de Plata no tiene sesión: corré npm run login en agentes." };
+  }
+  if (n.includes("not running inside coucou")) {
+    return { kind: "fuera", text: `No pude leer ${what}: esto anda solo dentro de Coucou.` };
+  }
+  if (
+    n.includes("ajustes") || n.includes("sin_config") || n.includes("no configurad") || n.includes("not configured") ||
+    n.includes("cdc-secret") || n.includes("cdc-ical") || n.includes("falta el secreto") ||
+    /\b401\b/.test(n) || n.includes("unauthorized")
+  ) {
+    return { kind: "config", text: said(`No pude leer ${what}: falta configurarlo en Ajustes (o el secreto no coincide).`) };
+  }
+  if (
+    n.includes("agent_down") || n.includes("connection refused") || n.includes("no pude hablar con el agente") ||
+    n.includes("agente de plata está apagado") || n.includes("agente de plata sigue sin contestar") ||
+    n.includes("todavía no contesta")
+  ) {
+    return { kind: "apagado", text: said(`No pude leer ${what}: el agente de Plata no responde.`) };
+  }
+  return { kind: "red", text: sentence ? withDot(raw) : `No pude leer ${what}${raw ? `: ${raw}` : "."}` };
+}
+
+function withDot(s: string): string {
+  return /[.!?…]$/.test(s) ? s : `${s}.`;
+}
+
+/** Escapes text for innerHTML, then turns **x** into <b>x</b> (Mochi's lines). */
+export function rich(s: string): string {
+  const esc = s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+  return esc.replace(/\*\*(.+?)\*\*/g, "<b>$1</b>");
+}
diff --git a/windows/src/views/atajos/launcher.ts b/windows/src/views/atajos/launcher.ts
