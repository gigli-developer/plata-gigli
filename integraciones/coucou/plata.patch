+        stat("USDT", cri === null ? null : dec(cri), cri !== null && usdtArs !== null ? `${ars(cri * usdtArs)} al cripto` : null, { missing: "No pude leer los USDT" }),
+      ),
+      row(
+        "lz-row2",
+        stat("Te deben", teDeben === null ? null : ars(teDeben), null, { size: 16, missing: "No pude leer lo que te deben" }),
+        stat("Debés", debes === null ? null : ars(debes), null, { size: 16, late: (debes ?? 0) > 0, missing: "No pude leer lo que debés" }),
+      ),
+      acts(
+        btn("¿Cómo voy este mes?", "sec", () => c.host.open("mes")),
+        btn("Dólar hoy", "sec", () => c.host.open("dolar")),
