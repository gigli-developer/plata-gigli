         let _ = win.set_ignore_cursor_events(ignore);
     }
 }
+
+/// Windows voice typing (Win+H) into the island's focused text field. The page
+/// focuses the field first; this lets the window take focus and presses the keys.
+pub fn start_dictation(app: &AppHandle) {
+    use windows::Win32::UI::Input::KeyboardAndMouse::{
+        SendInput, INPUT, INPUT_0, INPUT_KEYBOARD, KEYBDINPUT, KEYBD_EVENT_FLAGS, KEYEVENTF_KEYUP, VIRTUAL_KEY, VK_LWIN,
+    };
+    let Some(win) = window(app) else { return };
+    set_activating(&win, true);
+    let _ = win.set_focus();
+    std::thread::spawn(|| {
+        // Let the focus land before the shortcut, or voice typing opens with no field.
+        std::thread::sleep(Duration::from_millis(180));
+        let key = |vk: VIRTUAL_KEY, up: bool| INPUT {
+            r#type: INPUT_KEYBOARD,
+            Anonymous: INPUT_0 {
+                ki: KEYBDINPUT {
+                    wVk: vk,
+                    wScan: 0,
+                    dwFlags: if up { KEYEVENTF_KEYUP } else { KEYBD_EVENT_FLAGS(0) },
+                    time: 0,
+                    dwExtraInfo: 0,
+                },
+            },
+        };
+        let h = VIRTUAL_KEY(0x48);
+        let inputs = [key(VK_LWIN, false), key(h, false), key(h, true), key(VK_LWIN, true)];
+        unsafe {
+            SendInput(&inputs, std::mem::size_of::<INPUT>() as i32);
+        }
+    });
+}
