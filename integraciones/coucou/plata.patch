+// The Centro de Control agent's tab (the design in the "Centro de Control en
+// Coucou" artifact): on top, the day in one strip — a ring with what's done,
+// one line of summary and today's agenda; below, the checklist with Hoy ·
+// En curso · Semana, one tap per task (✓ tildar, ▶ empezar, ↷ otro día), each
+// with Deshacer; at the foot, today's habits and a field that asks the
+// launcher. Reads coucou-foco through atajos/data (the same cache the
+// launcher's cards use) and writes through data.accion (coucou_accion.sql).
+
+import { h, clear } from "./dom";
+import { State } from "../core/state";
+import { Bridge } from "../core/bridge";
+import { Sound } from "../core/sound";
+import type { ViewActions, ViewHost } from "./views";
+import * as data from "./atajos/data";
+import { errorBlock } from "./atajos/card";
+import { DIAS, addDays, arClock, arMs, classifyError, fechaCorta, hhmm, palabra, plural, rich } from "./atajos/format";
+import type { CalEvent, Foco } from "./atajos/plan";
+import { DEFAULT_EVENT_COLOR, mochi, pill, timeline, type TlEvent } from "./atajos/ui";
+
+const CDC = "#7CC4FF";
+const RING = 138.2; // 2π · 22
+const DAY_MS = 86_400_000;
+
+type Seg = "hoy" | "curso" | "semana";
+
+interface Row {
+  id: string;
+  titulo: string;
+  color: string | null;
+  meta: string;
+  tag: string;
+  tone: "" | "late" | "soon" | "ok";
+  running: boolean;
+}
+
+/** The pill and the header's dot read this (island/integrations: integration_centro). */
+export function publishCentro(f: Foco) {
+  const prev = State.integrations.integration_centro;
+  State.integrations.integration_centro = {
+    data: {
+      atrasadas: f.atrasadas?.length ?? 0,
+      paraHoy: f.paraHoy?.length ?? 0,
+      enCurso: f.enCurso?.length ?? 0,
+      foco: f,
+    },
+    error: null,
+    loaded: true,
+    configured: prev?.configured ?? true,
+  };
+  State.notify();
+}
+
+/** Every 3 minutes, while the pill is on and the secret is saved. */
+export function startCentroPoll() {
+  const tick = async () => {
+    if (State.paused || !State.settings.activeIntegrations.includes("integration_centro")) return;
+    if (!(await Bridge.secretPresent("cdc-secret").catch(() => false))) return;
+    try {
+      publishCentro(await data.foco(true));
+    } catch (e) {
+      const prev = State.integrations.integration_centro;
+      State.integrations.integration_centro = {
+        data: prev?.data ?? {},
+        error: String((e as { message?: unknown })?.message ?? e),
+        loaded: prev?.loaded ?? false,
+        configured: prev?.configured ?? true,
+      };
+      State.notify();
+    }
+  };
+  window.setTimeout(() => void tick(), 6_000);
+  window.setInterval(() => void tick(), 180_000);
+}
+
+const CHECK_SVG = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
+const PLAY_SVG = '<svg width="9" height="9" viewBox="0 0 24 24"><path fill="currentColor" d="M7 4.5v15l12-7.5z"/></svg>';
+const PAUSE_SVG = '<svg width="9" height="9" viewBox="0 0 24 24"><path fill="currentColor" d="M6.5 4.5h4v15h-4zM13.5 4.5h4v15h-4z"/></svg>';
+const LATER_SVG = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17a8 8 0 0 1 14.5-6.5M19 4v6.5h-6.5"/></svg>';
+const REFRESH_SVG = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7"/></svg>';
+const SEND_SVG = '<svg width="11" height="11" viewBox="0 0 24 24"><path fill="currentColor" d="M12 4.5 5.5 11l1.5 1.5 4-4V19.5h2V8.5l4 4L18.5 11 12 4.5z"/></svg>';
+
+export function buildCentro(actions: ViewActions): ViewHost {
+  // ── Day strip ───────────────────────────────────────────────────────────
+  const bot = mochi(CDC, 30);
+  const ring = h("div", { class: "cz-ring", title: "Hechas hoy" });
