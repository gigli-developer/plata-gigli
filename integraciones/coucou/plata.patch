diff --git a/windows/src/views/chats.ts b/windows/src/views/chats.ts
new file mode 100644
index 0000000..e7b127e
--- /dev/null
+++ b/windows/src/views/chats.ts
@@ -0,0 +1,379 @@
+// The island's chats (Plata and Claude) and the large panel they share.
+//
+// Every chat has a size button in its header. Enlarged, the island becomes a
+// messaging app: the list of chats on the left (search, "+", one row per chat
+// with its last line, time and state) and the active chat on the right. The
+// chat views themselves are the same ones as in normal size: the panel only
+// lays them out (style.css #island.chat-big). Picking another chat in the list
+// switches the view; both have the same size, so the island stays put and only
+// the right side crossfades. Only the chats are listed: the Claude Code
+// sessions the hooks follow stay in the overview.
+
+import { h, svg, clear } from "./dom";
+import { ICONS } from "./icons";
+import { State } from "../core/state";
+import { chatBigSize, setChatBig, type IslandViewName } from "../core/layout";
+import { plainLine } from "./plata-markdown";
+import type { ViewActions } from "./views";
+import { createChatBot } from "../mochi/minibots";
+import type { BotEngine } from "../mochi/engine";
+
+export type ChatId = "plata" | "prompt";
+
+interface ChatInfo {
+  name: string;
+  /** Avatar body: Plata's orange, the island's white Mochi for Claude. */
+  color: string;
+  /** The size button's tint, as "r,g,b". */
+  accent: string;
+}
+
+const CHAT_INFO: Record<ChatId, ChatInfo> = {
+  plata: { name: "Plata", color: "#ff9e1b", accent: "255,158,27" },
+  prompt: { name: "Claude", color: "#f5f6f8", accent: "245,246,248" },
+};
+
+/** Order of the list: Plata first, it is the one the panel is mostly for. */
+const ORDER: ChatId[] = ["plata", "prompt"];
+
+// ── What each chat reports for the list ────────────────────────────────────
+
+export interface ChatMeta {
+  /** Last real message, as one line of plain text ("" = none yet). */
+  last: string;
+  /** The last message was Lucas's. */
+  mine: boolean;
+  /** When it was sent or arrived (ms since epoch). */
+  at: number | null;
+  /** Waiting for an answer. */
+  busy: boolean;
+  /** Plata: proposals waiting for Approve / Reject. */
+  waiting: number;
+}
+
+const meta: Record<ChatId, ChatMeta> = {
+  plata: { last: "", mine: false, at: null, busy: false, waiting: 0 },
+  prompt: { last: "", mine: false, at: null, busy: false, waiting: 0 },
+};
+
+export function reportChat(id: ChatId, patch: Partial<ChatMeta>): void {
+  Object.assign(meta[id], patch);
+  syncBots(id);
+  State.notify();
+}
+
+/** A message for the list: Markdown and `acciones` blocks dropped. */
+export function reportMessage(id: ChatId, text: string, mine: boolean): void {
+  const last = plainLine(text);
+  if (!last) return;
+  reportChat(id, { last, mine, at: Date.now() });
+}
+
+/** Claude's chat lives in State.chatHistory, which a file drop also resets. */
+function metaFor(id: ChatId): ChatMeta {
+  if (id !== "prompt") return meta[id];
+  const m = State.chatHistory.at(-1);
+  return {
+    ...meta.prompt,
+    last: m ? plainLine(m.content) : "",
+    mine: m?.role === "user",
+    at: m?.at ?? null,
+  };
+}
+
+/** "+" in the list and "Nueva" in each header: each chat says how it starts over. */
+const resets: Partial<Record<ChatId, () => void>> = {};
+export function registerReset(id: ChatId, fn: () => void): void {
+  resets[id] = fn;
+}
+
+// ── Large panel on / off ───────────────────────────────────────────────────
+
+const BIG_KEY = "chat-big";
+const OLD_BIG_KEY = "plata-big";
+
+const bigListeners = new Set<(on: boolean) => void>();
+export function onBigChange(fn: (on: boolean) => void): void {
+  bigListeners.add(fn);
+}
+
+export function isBig(): boolean {
+  return chatBigSize() !== null;
+}
+
+const sizeButtons: HTMLButtonElement[] = [];
+
+function syncSizeButtons() {
+  const on = isBig();
+  for (const b of sizeButtons) {
+    clear(b);
+    b.append(svg(on ? ICONS.collapse : ICONS.expand, 13, { stroke: 2 }), h("span", { text: on ? "Achicar" : "Agrandar" }));
+    b.title = on ? "Volver al tamaño normal" : "Agrandar el chat";
+    b.setAttribute("aria-label", b.title);
+    b.setAttribute("aria-pressed", on ? "true" : "false");
+  }
+}
+
+/**
+ * The panel takes most of the screen, and back. The size comes from the
+ * display the island is on, so it fits a laptop as well as 1080p; the window
+ * already has room for it (island.rs WINDOW_W/H), so this only animates the
+ * island inside the page.
+ */
+export function setBig(on: boolean): void {
+  if (on !== isBig()) {
+    if (on) {
+      const w = Math.min(1100, Math.max(640, window.screen.availWidth - 120));
+      const hh = Math.min(900, Math.max(440, window.screen.availHeight - 120));
+      setChatBig({ w, h: hh });
+    } else {
+      setChatBig(null);
+    }
+    try {
+      localStorage.setItem(BIG_KEY, on ? "1" : "0");
+    } catch {
+      // A preference, not data: nothing to do if storage is unavailable.
+    }
+  }
+  syncSizeButtons();
+  for (const fn of bigListeners) fn(on);
+  State.notify();
+}
+
+/** The last choice, kept across launches (and the old Plata-only one). */
+export function restoreBig(): void {
+  let v: string | null = null;
+  try {
+    v = localStorage.getItem(BIG_KEY) ?? localStorage.getItem(OLD_BIG_KEY);
+  } catch {
+    // Starts normal.
+  }
+  if (v === "1") setBig(true);
+}
+
+/** The chat's size button: same place and look in every chat, in its tint. */
+function sizeButton(id: ChatId): HTMLButtonElement {
+  const b = h("button", { type: "button", class: "chat-size-btn" }) as HTMLButtonElement;
+  b.style.setProperty("--accent-rgb", CHAT_INFO[id].accent);
+  b.addEventListener("click", () => setBig(!isBig()));
+  sizeButtons.push(b);
+  syncSizeButtons();
+  return b;
+}
+
+// ── Pieces ──────────────────────────────────────────────────────────────────
+
+/** Every avatar's Mochi, per chat: the row in the list and the chat's header. */
+const bots: Record<ChatId, BotEngine[]> = { plata: [], prompt: [] };
+const botWasBusy: Record<ChatId, boolean> = { plata: false, prompt: false };
+
+/** A live Mochi in the chat's colour: it breathes, blinks and looks around like the others. */
+export function avatar(id: ChatId, size: number): HTMLElement {
+  const bot = createChatBot(CHAT_INFO[id].color, Math.round(size * 0.86));
+  bots[id].push(bot.engine);
+  const el = h("span", { class: "chat-av", "aria-hidden": "true" }, bot.el);
+  el.style.setProperty("--s", `${size}px`);
+  syncBots(id);
+  return el;
+}
+
+/** The avatars show what the chat is doing; a fresh answer gets a little joy. */
+function syncBots(id: ChatId): void {
+  const m = metaFor(id);
+  const state = m.busy ? "thinking" : m.waiting > 0 ? "approval" : "idle";
+  const answered = botWasBusy[id] && !m.busy;
+  botWasBusy[id] = m.busy;
+  for (const engine of bots[id]) {
+    engine.setState(state);
+    if (answered) engine.triggerEmote("happy");
+  }
+}
+
+/**
+ * A chat's header: avatar (shown in the panel) + name + a dim detail, the
+ * chat's own links, and the size button, always last.
+ */
+export function chatHead(id: ChatId, ...extras: Node[]): { el: HTMLElement; sub: HTMLElement } {
+  const sub = h("span", { class: "chat-head-sub" });
+  const el = h(
+    "div",
+    { class: "chat-head" },
+    avatar(id, 30),
+    h("div", { class: "chat-head-title" }, h("span", { class: "chat-head-name", text: CHAT_INFO[id].name }), sub),
+    ...extras,
+    sizeButton(id),
+  );
+  return { el, sub };
+}
+
+const hhmm = new Intl.DateTimeFormat("es-AR", { hour: "2-digit", minute: "2-digit", hour12: false });
+const weekday = new Intl.DateTimeFormat("es-AR", { weekday: "short" });
+
+/** "14:32" today, "Ayer", the weekday this week, then the date. */
+export function relTime(at: number, now = Date.now()): string {
+  const d = new Date(at);
+  const today = new Date(now);
+  today.setHours(0, 0, 0, 0);
+  const day = new Date(at);
+  day.setHours(0, 0, 0, 0);
+  const days = Math.round((today.getTime() - day.getTime()) / 86_400_000);
+  if (days <= 0) return hhmm.format(d);
+  if (days === 1) return "Ayer";
+  if (days < 7) return weekday.format(d).replace(".", "");
+  return `${d.getDate()}/${d.getMonth() + 1}`;
+}
+
+// ── The list on the left ───────────────────────────────────────────────────
+
+interface Row {
+  el: HTMLButtonElement;
+  name: HTMLElement;
+  time: HTMLElement;
+  last: HTMLElement;
+  busy: HTMLElement;
+  badge: HTMLElement;
+}
+
+function makeRow(av: HTMLElement): Row {
+  const name = h("span", { class: "side-name" });
+  const time = h("span", { class: "side-time" });
+  const last = h("span", { class: "side-last" });
+  const busy = h("i", { class: "side-busy", title: "Trabajando" });
+  const badge = h("span", { class: "side-badge" });
+  const el = h(
+    "button",
+    { type: "button", class: "side-row" },
+    av,
+    h(
+      "span",
+      { class: "side-text" },
+      h("span", { class: "side-line" }, name, time),
+      h("span", { class: "side-line" }, last, busy, badge),
+    ),
+  ) as HTMLButtonElement;
+  return { el, name, time, last, busy, badge };
+}
+
+export function buildChatSide(actions: ViewActions): { el: HTMLElement; sync(): void } {
+  const search = h("input", {
+    type: "search",
+    class: "side-search",
+    placeholder: "Buscar",
+    spellcheck: "false",
+    "aria-label": "Buscar en los chats",
+  }) as HTMLInputElement;
+  const newBtn = h(
+    "button",
+    { type: "button", class: "side-icon-btn", title: "Conversación nueva", "aria-label": "Conversación nueva" },
+    svg(ICONS.plus, 13),
+  );
+  const list = h("nav", { class: "side-list", "aria-label": "Chats" });
+  const empty = h("div", { class: "side-empty", text: "Nada con eso." });
+
+  const rows = new Map<ChatId, Row>();
+  for (const id of ORDER) {
+    const row = makeRow(avatar(id, 36));
+    row.name.textContent = CHAT_INFO[id].name;
+    row.el.addEventListener("click", () => {
+      if (State.view !== id) {
+        actions.blip();
+        actions.setView(id);
+      }
+    });
+    rows.set(id, row);
+    list.append(row.el);
+  }
+  list.append(empty);
+
+  const gear = h(
+    "button",
+    { type: "button", class: "side-icon-btn", title: "Ajustes", "aria-label": "Ajustes", onclick: () => go("settings") },
+    svg(ICONS.gear, 14),
+  );
+  const sound = h("button", {
+    type: "button",
+    class: "side-icon-btn",
+    onclick: () => actions.toggleSound(),
+  });
+
+  function go(v: IslandViewName) {
+    actions.blip();
+    actions.setView(v);
+  }
+
+  const el = h(
+    "aside",
+    { id: "chat-side" },
+    h("div", { class: "side-top" }, h("div", { class: "side-search-wrap" }, svg(ICONS.search, 12, { stroke: 2 }), search), newBtn),
+    list,
+    // Mochi sits at the left of the foot (layout.ts botPosition).
+    h("div", { class: "chat-side-foot" }, h("span", { class: "side-mochi-slot" }), h("span", { class: "side-brand", text: "Coucou" }), gear, sound),
+  );
+
+  newBtn.addEventListener("click", () => {
+    const id = State.view as ChatId;
+    resets[id]?.();
+  });
+  search.addEventListener("input", () => sync());
+  search.addEventListener("keydown", (e) => {
+    const k = e as KeyboardEvent;
+    if (k.key === "Escape" && search.value) {
+      // Escape clears the search first; a second one closes the island.
+      search.value = "";
+      sync();
+      e.stopPropagation();
+    } else if (k.key === "Enter") {
+      // Enter opens the first chat that matches.
+      const first = ORDER.find((id) => !rows.get(id)!.el.hidden);
+      if (first) {
+        actions.setView(first);
+        search.blur();
+      }
+    } else if (k.key !== "Escape") {
+      e.stopPropagation();
+    }
+  });
+
+  function sync() {
+    const q = search.value.trim().toLocaleLowerCase("es");
+    const match = (...texts: string[]) => !q || texts.some((t) => t.toLocaleLowerCase("es").includes(q));
+    const now = Date.now();
+    let shown = 0;
+
+    for (const id of ORDER) {
+      const row = rows.get(id)!;
+      const m = metaFor(id);
+      const active = State.view === id;
+      const lastText = m.last ? `${m.mine ? "Vos: " : ""}${m.last}` : id === "plata" ? "Saldos, gastos, resúmenes…" : "Preguntale lo que quieras";
+      row.el.hidden = !match(CHAT_INFO[id].name, m.last);
+      if (!row.el.hidden) shown++;
+      row.el.classList.toggle("on", active);
+      if (active) row.el.setAttribute("aria-current", "page");
+      else row.el.removeAttribute("aria-current");
+      row.el.classList.toggle("placeholder", !m.last);
+      if (row.last.textContent !== lastText) row.last.textContent = lastText;
+      row.last.title = m.last;
+      row.time.textContent = m.at ? relTime(m.at, now) : "";
+      row.busy.hidden = !m.busy;
+      row.badge.hidden = m.waiting === 0;
+      row.badge.textContent = m.waiting > 1 ? String(m.waiting) : "!";
+      row.badge.title = m.waiting === 1 ? "Una propuesta espera tu aprobación" : `${m.waiting} propuestas esperan tu aprobación`;
+      const parts = [
+        CHAT_INFO[id].name,
+        m.waiting ? (m.waiting === 1 ? "propuesta esperando aprobación" : `${m.waiting} propuestas esperando aprobación`) : "",
+        m.busy ? "trabajando" : "",
+      ].filter(Boolean);
+      row.el.setAttribute("aria-label", `${parts.join(", ")}${m.last ? `. ${lastText}` : ""}`);
+    }
+
+    empty.hidden = shown > 0;
+
+    clear(sound);
+    sound.append(svg(State.settings.soundEnabled ? ICONS.speakerOn : ICONS.speakerOff, 14));
+    const soundLabel = State.settings.soundEnabled ? "Silenciar" : "Activar el sonido";
+    sound.title = soundLabel;
+    sound.setAttribute("aria-label", soundLabel);
+  }
+
+  return { el, sync };
+}
