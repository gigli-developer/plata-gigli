+// Atajos — the Centro de Control's data (coucou-foco, contract §2) and the
+// little bits of planning the cards do with it: free slots between 7 and 23,
+// the one task for "¿Qué hago ahora?", tomorrow's two suggestions, the notices
+// grouped by kind. Pure, no relative runtime imports: `node --test` runs it.
+
+/** One calendar occurrence, already expanded (calendar.ts). Times are epoch ms. */
+export interface CalEvent {
+  title: string;
+  start: number;
+  end: number;
+  allDay: boolean;
+  /** Marked "Disponible" (TRANSP:TRANSPARENT): drawn, but doesn't take the time. */
+  free: boolean;
+  color: string | null;
+}
+
+export interface Atrasada { id: string; titulo: string; area: string | null; color: string | null; proyecto: string | null; vence: string | null; vence_fin: string | null; dias_atraso: number }
+export interface ParaHoy { id: string; titulo: string; area: string | null; color: string | null; proyecto: string | null; vence: string | null; vence_fin: string | null }
+export interface EnCurso { id: string; titulo: string; area: string | null; color: string | null; proyecto: string | null; desde: string | null; quieta_dias: number; cronometro_desde: string | null }
+export interface Proxima { id: string; titulo: string; area: string | null; color: string | null; vence: string | null; vence_fin: string | null; en_dias: number }
+export interface Habito { id: string; nombre: string; color: string | null; hecho_hoy: boolean }
+export interface Aviso {
+  tipo: string;
+  /** Rung of the ladder, 1 = first notice; 0 when it came as a word we don't know. */
+  nivel: number;
+  /** The level as coucou-foco sent it (a number or a word). */
+  nivelTexto: string;
+  titulo: string; cuerpo: string; hora: string; entregado: boolean }
+export interface Pendiente { tipo: string; datos: unknown }
+
+/**
+ * coucou-foco's answer, checked. A list that didn't come (or came as
+ * something else) is null, so a card can say "No pude leer…" instead of
+ * drawing an empty list as if there were nothing.
+ */
+export interface Foco {
+  hoy: string | null;
+  diaSemana: string | null;
+  noTrabaja: boolean;
+  atrasadas: Atrasada[] | null;
+  paraHoy: ParaHoy[] | null;
+  enCurso: EnCurso[] | null;
+  proximas: Proxima[] | null;
+  habitos: Habito[] | null;
+  sinFecha: number | null;
+  hechasHoy: number | null;
+  avisos: Aviso[] | null;
+  pendientes: Pendiente[] | null;
+  /** Optional: where "Abrir en la app" goes. Not in the contract yet. */
+  appUrl: string | null;
+}
+
+type Obj = Record<string, unknown>;
+const obj = (v: unknown): Obj => (v && typeof v === "object" && !Array.isArray(v) ? (v as Obj) : {});
+const list = (v: unknown): Obj[] | null => (Array.isArray(v) ? v.map(obj) : null);
+const s = (v: unknown): string | null => (typeof v === "string" && v.trim() ? v : v == null ? null : String(v));
+const n0 = (v: unknown): number => (Number.isFinite(Number(v)) ? Number(v) : 0);
+const nOrNull = (v: unknown): number | null => (v == null || v === "" || !Number.isFinite(Number(v)) ? null : Number(v));
+
+export function parseFoco(raw: unknown): Foco {
+  const r = obj(raw);
+  const base = (o: Obj) => ({
+    id: String(o.id ?? ""),
+    titulo: s(o.titulo) ?? "(sin título)",
+    area: s(o.area),
+    color: s(o.color),
+  });
+  return {
+    hoy: s(r.hoy)?.slice(0, 10) ?? null,
+    diaSemana: s(r.dia_semana),
+    noTrabaja: r.no_trabaja === true,
+    atrasadas: list(r.atrasadas)?.map((o) => ({ ...base(o), proyecto: s(o.proyecto), vence: s(o.vence), vence_fin: s(o.vence_fin), dias_atraso: n0(o.dias_atraso) })) ?? null,
+    paraHoy: list(r.para_hoy)?.map((o) => ({ ...base(o), proyecto: s(o.proyecto), vence: s(o.vence), vence_fin: s(o.vence_fin) })) ?? null,
+    enCurso: list(r.en_curso)?.map((o) => ({ ...base(o), proyecto: s(o.proyecto), desde: s(o.desde), quieta_dias: n0(o.quieta_dias), cronometro_desde: s(o.cronometro_desde) })) ?? null,
+    proximas: list(r.proximas)?.map((o) => ({ ...base(o), vence: s(o.vence), vence_fin: s(o.vence_fin), en_dias: n0(o.en_dias) })) ?? null,
