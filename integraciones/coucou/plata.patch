+// Atajos de la isla — the router, the formatting and the planning helpers.
+// Run from windows/:  npm test   (= node --test tests/)
+// Node 22.18+ / 24 strips the TypeScript types itself; nothing to install.
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { alternatives, decide, filterSkills, norm, routeByRules, SKILLS } from "../src/views/atajos/router.ts";
+import { addDays, arClock, arMs, ars, classifyError, dec, enDias, fechaCorta, hm, mesAnterior, mesNombre, money, num, rich, usd } from "../src/views/atajos/format.ts";
+import { dayBusy, freeSlots, groupAvisos, horaDe, longest, parseFoco, parseTareaRapida, pickTasks, suggestTomorrow, total } from "../src/views/atajos/plan.ts";
+import { occurrences, parseCalendars } from "../src/views/atajos/calendar.ts";
+
+// ── Router ─────────────────────────────────────────────────────────────────
+
+test("the prototype's phrases go to the prototype's skills", () => {
+  const cases: Array<[string, string | null]> = [
+    ["gasté 12.500 en el súper con débito", "gasto"],
+    ["¿qué tengo mañana?", "manana"],
+    ["recordame el jueves llamar al contador", "tarea"],
+    ["anoche cené con Branko, pagué 48.000 con la de crédito y me debe la mitad", "situacion"],
+    ["¿cuánto me queda en dólares?", "saldo"],
+    // Nothing matches: these go to the AI router.
+    ["¿me conviene ir al gimnasio hoy o estudiar?", null],
+    ["Thiago me pidió que le devuelva la plata", null],
+  ];
+  for (const [text, want] of cases) assert.equal(routeByRules(text)?.id ?? null, want, text);
+});
+
+test("every skill can be reached by a rule", () => {
+  const cases: Array<[string, string]> = [
+    ["¿Cómo viene mi día?", "dia"],
+    ["¿Qué tengo hoy?", "dia"],
+    ["¿Qué hago ahora?", "ahora"],
+    ["¿Por dónde arranco?", "ahora"],
+    ["mostrame los avisos", "avisos"],
+    ["quiero cerrar el día", "cierre"],
+    ["planificá mañana", "manana"],
+    ["¿Qué vence esta semana?", "vence"],
+    ["¿cuándo tengo un hueco?", "huecos"],
+    ["¿tengo tiempo libre el jueves?", "huecos"],
+    ["anotá comprar yerba", "tarea"],
+    ["tengo que llamar al contador", "tarea"],
+    ["pagué 8500 de nafta en efectivo", "gasto"],
+    ["compré una birra", "gasto"],
+    ["me cobraron 4300 de uber", "gasto"],
+    ["almorcé con Toto, la mitad la pagó él", "situacion"],
+    ["dividimos la cena, pagué yo", "situacion"],
+    ["¿cuánto tengo?", "saldo"],
+    ["mi saldo", "saldo"],
+    ["¿cómo voy este mes?", "mes"],
+    ["¿en qué gasté?", "mes"],
+    ["¿cuándo vence la tarjeta?", "resumenes"],
+    ["resúmenes", "resumenes"],
+    ["Branko me pagó", "deuda"],
+    ["le pagué a Thiago", "deuda"],
+    ["Toto me devolvió la plata", "deuda"],
+    ["¿a cuánto está el dólar?", "dolar"],
+    ["cotización del blue", "dolar"],
+    ["conciliar el resumen de Galicia", "conciliar"],
+  ];
+  for (const [text, want] of cases) assert.equal(routeByRules(text)?.id ?? null, want, text);
+  const reached = new Set(cases.map((c) => c[1]));
+  assert.deepEqual([...SKILLS.map((s) => s.id)].filter((id) => !reached.has(id)), []);
+});
+
+test("accents and ñ don't break word boundaries", () => {
+  assert.equal(norm("Mañana PAGUÉ dólar"), "manana pague dolar");
+  assert.equal(routeByRules("PAGUÉ 3000")?.id, "gasto");
+  // "pague" inside another word is not "pagué".
+  assert.equal(routeByRules("el paguero"), null);
+});
+
+test("ambiguous phrases don't match a rule", () => {
+  for (const t of ["hola", "che", "¿me conviene?", "Thiago", "la plata", "qué onda", ""]) {
+    assert.equal(routeByRules(t), null, t);
+  }
+});
+
+test("decide: rules, then the AI with enough confidence, else three options", () => {
+  assert.deepEqual(decide("gasté 500 en el kiosco", null), { kind: "open", id: "gasto", how: "regla", why: "dice gasté o pagué" });
+  assert.deepEqual(decide("¿me conviene ir al gimnasio hoy o estudiar?", { skill: "ahora", confianza: 74 }), { kind: "open", id: "ahora", how: "IA", confianza: 74 });
+  assert.deepEqual(decide("¿me conviene ir al gimnasio?", { skill: "ahora", confianza: 60 }), { kind: "open", id: "ahora", how: "IA", confianza: 60 });
+  // Below 60, an unknown id, or no AI at all: ask.
+  assert.deepEqual(decide("Thiago me pidió que le devuelva la plata", { skill: null, confianza: 45 }), { kind: "ask", alts: ["deuda", "situacion", "saldo"] });
+  assert.deepEqual(decide("hola", { skill: "inventada", confianza: 99 }), { kind: "ask", alts: ["dia", "gasto", "saldo"] });
+  assert.deepEqual(decide("hola", null), { kind: "ask", alts: ["dia", "gasto", "saldo"] });
+  assert.deepEqual(decide("qué onda", { skill: "huecos", confianza: 40 }), { kind: "ask", alts: ["huecos", "dia", "gasto"] });
+});
+
+test("alternatives: a known person points to debts", () => {
+  assert.deepEqual(alternatives("y lo de Branko?", null, ["Branko", "Toto"]), ["deuda", "situacion", "saldo"]);
+  assert.deepEqual(alternatives("y lo de Branko?", null, []), ["dia", "gasto", "saldo"]);
+  assert.deepEqual(alternatives("x", "deuda", []), ["deuda", "dia", "gasto"]);
+});
+
+test("filter: names and descriptions, and an amount narrows to the two that take one", () => {
+  assert.equal(filterSkills("").length, 16);
+  assert.deepEqual(filterSkills("dolar"), ["saldo", "dolar"]);
+  assert.deepEqual(filterSkills("12500 super"), ["gasto", "situacion"]);
+  assert.deepEqual(filterSkills("12.500"), ["gasto", "situacion"]);
+  assert.deepEqual(filterSkills("huecos"), ["huecos"]);
+  assert.deepEqual(filterSkills("zzz"), []);
+});
+
+// ── Formatting ─────────────────────────────────────────────────────────────
+
+test("money in es-AR", () => {
+  assert.equal(ars(12500), "$ 12.500");
+  assert.equal(ars(9674949.4), "$ 9.674.949");
+  assert.equal(ars(-534052), "−$ 534.052");
+  assert.equal(ars(0), "$ 0");
+  assert.equal(usd(2285.77), "US$ 2.285,77");
+  assert.equal(usd(20), "US$ 20,00");
+  assert.equal(dec(7206.18), "7.206,18");
+  assert.equal(money(20, "USD"), "US$ 20,00");
+  assert.equal(money(1000, "usdt"), "1.000,00 USDT");
+  assert.equal(money(1000, "ARS"), "$ 1.000");
+});
+
+test("num never turns a missing value into 0", () => {
+  assert.equal(num(null), null);
+  assert.equal(num(undefined), null);
+  assert.equal(num(""), null);
+  assert.equal(num("abc"), null);
+  assert.equal(num(true), null);
+  assert.equal(num("12.5"), 12.5);
+  assert.equal(num(0), 0);
+});
+
+test("dates and hours in Buenos Aires", () => {
+  // 2026-10-07 01:10 UTC = 2026-10-06 22:10 in Buenos Aires.
+  const c = arClock(Date.UTC(2026, 9, 7, 1, 10));
+  assert.deepEqual(c, { date: "2026-10-06", min: 22 * 60 + 10, weekday: 2 });
+  assert.equal(arMs("2026-10-06", 22 * 60 + 10), Date.UTC(2026, 9, 7, 1, 10));
+  assert.equal(addDays("2026-10-31", 1), "2026-11-01");
+  assert.equal(fechaCorta("2026-10-10"), "sáb 10");
+  assert.equal(hm(17 * 60 + 30), "17:30");
+  assert.equal(hm(16 * 60), "16");
+  assert.equal(enDias(4), "en 4 d");
+  assert.equal(enDias(-3), "3 d tarde");
+  assert.equal(mesNombre("2026-10"), "octubre");
+  assert.equal(mesAnterior("2026-01"), "diciembre");
+  assert.equal(horaDe("2026-10-06T19:00:00Z"), "16:00");
+  assert.equal(horaDe("16:05:00"), "16:05");
+});
+
+test("errors become what the card says", () => {
+  assert.equal(classifyError(new Error("El agente respondió 503 Service Unavailable: sin_sesion"), "tus saldos").kind, "sesion");
+  assert.equal(classifyError("agent_down", "tus saldos").kind, "apagado");
+  // The sentences Coucou's Rust side (atajos.rs) actually sends.
+  assert.equal(classifyError("El agente de Plata no tiene sesión de Supabase (sin_sesion): volvé a iniciarla en el agente.", "x").kind, "sesion");
+  const cfg = classifyError("Falta el secreto del Centro de Control: cargalo en Ajustes → Centro de Control.", "el Centro");
+  assert.deepEqual(cfg, { kind: "config", text: "Falta el secreto del Centro de Control: cargalo en Ajustes → Centro de Control." });
+  assert.equal(classifyError("El Centro de Control rechazó el secreto (401): revisalo en Ajustes → Centro de Control.", "x").kind, "config");
+  assert.equal(classifyError("No hay calendarios configurados: cargá las direcciones iCal en Ajustes → Centro de Control.", "x").kind, "config");
+  assert.equal(classifyError("El agente de Plata está apagado y no encuentro la carpeta agentes para prenderlo.", "x").kind, "apagado");
+  assert.equal(classifyError("El agente de Plata sigue sin contestar.", "x").kind, "apagado");
+  assert.equal(classifyError(new Error("not running inside Coucou"), "x").kind, "fuera");
+  const r = classifyError("timeout", "el dólar");
+  assert.equal(r.kind, "red");
+  assert.equal(r.text, "No pude leer el dólar: timeout");
+  assert.deepEqual(classifyError("El Centro de Control no contestó a tiempo.", "x"), { kind: "red", text: "El Centro de Control no contestó a tiempo." });
+});
+
+test("rich escapes and bolds", () => {
+  assert.equal(rich("Tenés **$ 1** <b>x</b>"), "Tenés <b>$ 1</b> &lt;b&gt;x&lt;/b&gt;");
+});
+
+// ── Planning ───────────────────────────────────────────────────────────────
+
+test("free slots between 7 and 23", () => {
+  // The prototype's Wednesday: work 6–17, dinner 21:30–22, reading 22:30–23.
+  const busy = [{ s: 360, e: 1020 }, { s: 1290, e: 1320 }, { s: 1350, e: 1380 }];
+  assert.deepEqual(freeSlots(busy), [{ s: 1020, e: 1290 }, { s: 1320, e: 1350 }]);
+  // With a 45-minute minimum the half hour between dinner and reading is gone.
+  assert.deepEqual(freeSlots(busy, { minLen: 45 }), [{ s: 1020, e: 1290 }]);
+  // Free all day.
+  assert.deepEqual(freeSlots([]), [{ s: 420, e: 1380 }]);
+  // Overlapping events merge; short gaps (< 30 min) don't count.
+  assert.deepEqual(freeSlots([{ s: 480, e: 600 }, { s: 590, e: 700 }, { s: 715, e: 1380 }]), [{ s: 420, e: 480 }]);
+  // Today: what already went by is gone.
+  assert.deepEqual(freeSlots([{ s: 1290, e: 1320 }], { notBefore: 22 * 60 + 10 }), [{ s: 1330, e: 1380 }]);
+  assert.deepEqual(longest([{ s: 0, e: 10 }, { s: 20, e: 40 }, { s: 50, e: 70 }]), { s: 20, e: 40 });
+  assert.equal(total([{ s: 0, e: 10 }, { s: 20, e: 40 }]), 30);
+});
+
+test("day busy: clipped to the day, all-day and 'disponible' events don't count", () => {
+  const day = arMs("2026-10-07");
+  const ev = (s: number, e: number, extra: Partial<{ allDay: boolean; free: boolean }> = {}) =>
+    ({ title: "x", start: day + s * 60_000, end: day + e * 60_000, allDay: false, free: false, color: null, ...extra });
+  assert.deepEqual(dayBusy([ev(-60, 120), ev(600, 660), ev(0, 1440, { allDay: true }), ev(700, 800, { free: true })], day), [{ s: 0, e: 120 }, { s: 600, e: 660 }]);
+});
+
+const FOCO = parseFoco({
+  hoy: "2026-10-06",
+  atrasadas: [
+    { id: "a1", titulo: "Segundo parcial", dias_atraso: 3 },
+    { id: "a2", titulo: "Entrega M2", dias_atraso: 35 },
+  ],
+  para_hoy: [{ id: "h1", titulo: "Llamar al banco" }],
+  en_curso: [
+    { id: "c1", titulo: "Recuperatorios", quieta_dias: 0 },
+    { id: "c2", titulo: "Primer parcial", quieta_dias: 6 },
+  ],
+  proximas: [
+    { id: "p2", titulo: "Finalización del período", en_dias: 4 },
+    { id: "p1", titulo: "Turno médico", en_dias: 1 },
+  ],
+  habitos: [{ id: "x", nombre: "Lectura", hecho_hoy: false }],
+  avisos_hoy: [
+    { tipo: "atrasadas", nivel: 2, titulo: "6 atrasadas", hora: "12:00" },
+    { tipo: "atrasadas", nivel: 4, titulo: "6 atrasadas de Estudios", hora: "16:00" },
+    { tipo: "cierre", nivel: 1, titulo: "Cierre del día", hora: "22:00" },
+  ],
+});
+
+test("parseFoco keeps a missing list as null, never as empty", () => {
+  assert.equal(FOCO.atrasadas?.length, 2);
+  assert.equal(FOCO.pendientes, null);
+  assert.equal(FOCO.sinFecha, null);
+  assert.equal(parseFoco(null).atrasadas, null);
+});
+
+test("¿Qué hago ahora?: quiet in-progress, then oldest overdue, today, nearest upcoming", () => {
+  assert.deepEqual(pickTasks(FOCO).map((c) => c.id), ["c2", "a2", "a1", "h1", "p1", "p2", "c1"]);
+  assert.deepEqual(pickTasks(parseFoco({})), []);
+});
+
+test("tomorrow's two: due tomorrow first, then the oldest overdue", () => {
+  assert.deepEqual(suggestTomorrow(FOCO).map((c) => c.id), ["p1", "a2"]);
+});
+
+test("notices grouped by kind with their highest rung", () => {
+  const g = groupAvisos(FOCO.avisos ?? []);
+  assert.deepEqual(g.map((x) => [x.tipo, x.nivel, x.cantidad, x.ultimo.titulo]), [
+    ["atrasadas", 4, 2, "6 atrasadas de Estudios"],
+    ["cierre", 1, 1, "Cierre del día"],
+  ]);
+});
+
+// ── Calendar ───────────────────────────────────────────────────────────────
+
+const ICS = [
+  "BEGIN:VCALENDAR",
+  "VERSION:2.0",
+  "PRODID:-//test//EN",
+  "BEGIN:VTIMEZONE",
+  "TZID:America/Argentina/Buenos_Aires",
+  "BEGIN:STANDARD",
+  "TZOFFSETFROM:-0300",
+  "TZOFFSETTO:-0300",
+  "TZNAME:-03",
+  "DTSTART:19700101T000000",
+  "END:STANDARD",
+  "END:VTIMEZONE",
+  // Every weekday 21:30–22:00, except Thursday the 8th; Friday the 9th moved to 20:00.
+  "BEGIN:VEVENT",
+  "UID:cena@test",
+  "SUMMARY:Cena",
+  "DTSTART;TZID=America/Argentina/Buenos_Aires:20260901T213000",
+  "DTEND;TZID=America/Argentina/Buenos_Aires:20260901T220000",
+  "RRULE:FREQ=DAILY",
