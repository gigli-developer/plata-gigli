+    /// Island on screen (physical) for a placement, as the page lays it out.
+    fn on_screen(dock: &str, p: &Placement, scale: f64, w: f64, h: f64) -> (f64, f64) {
+        let (ix, iy) = island_offset(
+            dock,
+            (p.anchor_x, p.anchor_y),
+            (PW as f64 / scale, PH as f64 / scale),
+            w,
+            h,
+        );
+        (p.x as f64 + ix * scale, p.y as f64 + iy * scale)
+    }
+
+    #[test]
+    fn top_is_centred_on_the_display_whatever_the_size() {
+        let p = place("top", MON, WA, 1.0, PW, PH, (0.0, 0.0), None);
+        assert_eq!((p.x, p.y), (390, 0));
+        for (w, h) in [(288.0, 32.0), (640.0, 160.0), (1100.0, 900.0)] {
+            let (x, y) = on_screen("top", &p, 1.0, w, h);
+            assert_eq!((x + w / 2.0, y), (960.0, 0.0));
+        }
+    }
+
+    #[test]
+    fn float_grows_from_its_centre_and_stays_put() {
+        // Island centre at 700, top at 300.
+        let p = place("float", MON, WA, 1.0, PW, PH, (700.0, 300.0), None);
+        for (w, h) in [(288.0, 32.0), (640.0, 440.0)] {
+            let (x, y) = on_screen("float", &p, 1.0, w, h);
+            assert_eq!(x + w / 2.0, 700.0);
+            assert_eq!(y, 300.0);
+        }
+        // Too tall to fit under its top: pushed up just enough, still inside.
+        let (_, y) = on_screen("float", &p, 1.0, 1100.0, 900.0);
+        assert!(y + 900.0 <= 1032.0 && y >= 0.0);
+    }
+
+    #[test]
+    fn edges_grow_away_from_the_edge() {
+        let l = place("left", MON, WA, 1.0, PW, PH, (500.0, 200.0), None);
+        let r = place("right", MON, WA, 1.0, PW, PH, (500.0, 200.0), None);
+        for (w, h) in [(288.0, 32.0), (640.0, 160.0)] {
+            assert_eq!(on_screen("left", &l, 1.0, w, h), (0.0, 200.0));
+            let (x, y) = on_screen("right", &r, 1.0, w, h);
+            assert_eq!((x + w, y), (1920.0, 200.0));
+        }
+    }
+
+    #[test]
+    fn keeps_the_island_where_it_is_inside_the_window_when_it_can() {
+        // Dropped at centre 900, top 100, while drawn at (570, 0) in the window.
+        let p = place("float", MON, WA, 1.0, PW, PH, (900.0, 100.0), Some((570.0, 0.0)));
+        assert_eq!((p.anchor_x, p.anchor_y), (570.0, 0.0));
+        assert_eq!((p.x, p.y), (330, 100));
+        // Lower down the window cannot follow without leaving the work area.
+        let p = place("float", MON, WA, 1.0, PW, PH, (900.0, 600.0), Some((570.0, 0.0)));
+        assert_eq!(p.y, 1032 - PH);
