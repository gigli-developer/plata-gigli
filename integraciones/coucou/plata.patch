diff --git a/windows/src-tauri/src/claude_code.rs b/windows/src-tauri/src/claude_code.rs
new file mode 100644
index 0000000..dd5ebe7
--- /dev/null
+++ b/windows/src-tauri/src/claude_code.rs
@@ -0,0 +1,632 @@
+// Reconciling a card statement with Claude Code, headless, on Lucas's own plan.
+//
+// The Plata agent (plata_agent.rs) runs on the API and is billed per token.
+// Reconciling a statement is a long read of a PDF against many rows, so the
+// island hands it to Claude Code instead: `claude -p` in the background, with
+// the `conciliar-resumen` skill, which leaves `datos.json` and `informe.html`
+// in a folder of its own. Nothing here writes to Plata.
+//
+// One run per conversation. Its stream-json output is read line by line and
+// turned into short progress lines for the page (`plata-delegado`), then a
+// final event with the parsed `datos.json`.
+
+use std::io::{BufRead, BufReader, Write};
+use std::os::windows::process::CommandExt;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::atomic::{AtomicU8, Ordering};
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use serde::Serialize;
+use serde_json::{json, Value};
+use tauri::{AppHandle, Emitter};
+
+use crate::plata_agent::{self, CREATE_NO_WINDOW};
+
+/// The event every run reports on: `{sesionId, ev}`.
+pub const EVENT: &str = "plata-delegado";
+/// The skill writes and checks a few files; past this the run is stuck.
+const TIMEOUT: Duration = Duration::from_secs(10 * 60);
+const SKILL: &str = "conciliar-resumen";
+
+/// The whole invocation in one place, so it can follow the skill's side of the
+/// contract. The prompt goes in through stdin.
+fn claude_args(carpeta: &Path, skill_dir: &Path) -> Vec<String> {
+    let mut args: Vec<String> = ["-p", "--output-format", "stream-json", "--verbose", "--model", "sonnet", "--allowedTools"]
+        .iter()
+        .map(|s| s.to_string())
+        .collect();
+    args.extend(
+        ["Read", "Write", "Glob", "Skill", "Bash(npm run -s conciliar:leer*)", "Bash(node *llenar.mjs*)"]
+            .iter()
+            .map(|s| s.to_string()),
+    );
+    args.push("--add-dir".into());
+    args.push(carpeta.to_string_lossy().to_string());
+    args.push("--add-dir".into());
+    args.push(skill_dir.to_string_lossy().to_string());
+    args
+}
+
+fn prompt(resumen: &[PathBuf], carpeta: &Path, pedido: &str) -> String {
+    let rutas: Vec<String> = resumen.iter().map(|p| p.to_string_lossy().to_string()).collect();
+    let mut p = format!(
+        "MODO ISLA. Usá la skill {SKILL}. Resumen: {}. Carpeta de salida: {}",
+        rutas.join(", "),
+        carpeta.display()
+    );
+    let pedido = pedido.trim();
+    if !pedido.is_empty() {
+        p.push_str(&format!("\nPedido de Lucas: {pedido}"));
+    }
+    p
+}
+
+/// Variables that would make the child something other than a plain run on
+/// Lucas's login: an API key (billed per token, the thing this avoids) or the
+/// markers of a Claude Code session it was started from.
+const ENV_DROP: &[&str] = &[
+    "ANTHROPIC_API_KEY",
+    "ANTHROPIC_AUTH_TOKEN",
+    "CLAUDECODE",
+    "CLAUDE_CODE_ENTRYPOINT",
+    "CLAUDE_CODE_SESSION_ID",
+    "CLAUDE_CODE_CHILD_SESSION",
+    "CLAUDE_CODE_HOST_SESSION_ID",
+    "CLAUDE_CODE_SDK_HAS_HOST_AUTH_REFRESH",
+    "CLAUDE_CODE_OAUTH_SCOPES",
+    "CLAUDE_CODE_MESSAGING_SOCKET",
+    "CLAUDE_CODE_MESSAGING_TOKEN",
+];
+
+// ── Running jobs ────────────────────────────────────────────────────────────
+
+const STOP_NONE: u8 = 0;
+const STOP_CANCEL: u8 = 1;
+const STOP_TIMEOUT: u8 = 2;
+
+struct Run {
+    sesion_id: String,
+    pid: u32,
+    stop: Arc<AtomicU8>,
+}
+
+static RUNNING: Mutex<Vec<Run>> = Mutex::new(Vec::new());
+
+/// Claude Code starts shells and node: the whole tree goes, not just claude.exe.
+fn kill_tree(pid: u32) {
+    let _ = Command::new("taskkill")
+        .args(["/PID", &pid.to_string(), "/T", "/F"])
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .creation_flags(CREATE_NO_WINDOW)
+        .status();
+}
+
+fn stop(sesion_id: &str, why: u8) -> bool {
+    let running = RUNNING.lock().unwrap();
+    let Some(run) = running.iter().find(|r| r.sesion_id == sesion_id) else { return false };
+    run.stop.store(why, Ordering::SeqCst);
+    kill_tree(run.pid);
+    true
+}
+
+pub fn cancel(sesion_id: &str) -> bool {
+    stop(sesion_id, STOP_CANCEL)
+}
+
+// ── The folder of a run ─────────────────────────────────────────────────────
+
+pub fn runs_dir() -> PathBuf {
+    crate::settings::local_dir().join("conciliaciones")
+}
+
+/// `%LOCALAPPDATA%\Coucou\conciliaciones\2026-10-01_2105-33`, local time.
+fn new_run_dir() -> Result<PathBuf, String> {
+    use windows::Win32::System::SystemInformation::GetLocalTime;
+    let t = unsafe { GetLocalTime() };
+    let stamp = format!("{:04}-{:02}-{:02}_{:02}{:02}-{:02}", t.wYear, t.wMonth, t.wDay, t.wHour, t.wMinute, t.wSecond);
+    let base = runs_dir();
+    let mut dir = base.join(&stamp);
+    let mut n = 2;
+    while dir.exists() {
+        dir = base.join(format!("{stamp}-{n}"));
+        n += 1;
+    }
+    std::fs::create_dir_all(&dir).map_err(|e| format!("No pude crear la carpeta de la conciliación: {e}"))?;
+    Ok(dir)
+}
+
+/// Copies the statement into the run folder, so the run reads (and keeps) its
+/// own copy. Same checks as for the agent: PDF or image, within the limits.
+fn stage_inputs(dir: &Path, adjuntos: &[String], pegado: Option<&str>) -> Result<Vec<PathBuf>, String> {
+    if adjuntos.len() > plata_agent::MAX_ATTACHMENTS {
+        return Err(format!("Hasta {} adjuntos por mensaje.", plata_agent::MAX_ATTACHMENTS));
+    }
+    let mut out = Vec::new();
+    for path in adjuntos {
+        let info = plata_agent::attachment_info(path)?;
+        let name: String = info
+            .name
+            .chars()
+            .map(|c| if c.is_alphanumeric() || " ._-()".contains(c) { c } else { '_' })
+            .collect();
+        let mut target = dir.join(&name);
+        let mut n = 2;
+        while target.exists() {
+            target = dir.join(format!("{n}-{name}"));
+            n += 1;
+        }
+        std::fs::copy(path, &target).map_err(|e| format!("No pude copiar «{}»: {e}", info.name))?;
+        out.push(target);
+    }
+    if let Some(text) = pegado.map(str::trim).filter(|t| !t.is_empty()) {
+        let target = dir.join("resumen.txt");
+        std::fs::write(&target, text).map_err(|e| format!("No pude guardar el resumen pegado: {e}"))?;
+        out.push(target);
+    }
+    if out.is_empty() {
+        return Err("No hay resumen: soltá el PDF o la captura, o pegá el texto.".into());
+    }
+    Ok(out)
+}
+
+// ── stream-json → progress ──────────────────────────────────────────────────
+
+/// What the stream said so far that matters at the end.
+#[derive(Default, Debug)]
+pub(crate) struct Stream {
+    last_progress: Option<String>,
+    /// The `result` line: the final text and whether it is an error.
+    pub result: Option<(String, bool)>,
+    /// The last thing the assistant said, in case no `result` arrives.
+    pub last_text: Option<String>,
+    /// Claude Code has no login (`/login`), so nothing can run.
+    pub auth_failed: bool,
+}
+
+fn file_name_of(input: &Value, key: &str) -> String {
+    let p = input.get(key).and_then(Value::as_str).unwrap_or("");
+    p.rsplit(['\\', '/']).next().unwrap_or(p).to_string()
+}
+
+/// A tool call, said the way Lucas would: what it is doing, not which tool.
+fn tool_phrase(name: &str, input: &Value) -> Option<String> {
+    let path = input.get("file_path").and_then(Value::as_str).unwrap_or("").replace('\\', "/").to_lowercase();
+    let file = file_name_of(input, "file_path");
+    let lower = file.to_lowercase();
+    let ext = lower.rsplit('.').next().unwrap_or("");
+    let phrase = match name {
+        "Skill" => "Usando la receta de conciliación".to_string(),
+        "Read" if path.contains(&format!("/{SKILL}/")) => "Usando la receta de conciliación".to_string(),
+        "Read" if ["pdf", "txt", "png", "jpg", "jpeg", "webp"].contains(&ext) => "Leyendo el resumen".to_string(),
+        "Read" => format!("Leyendo {file}"),
+        "Bash" => {
+            let cmd = input.get("command").and_then(Value::as_str).unwrap_or("");
+            if cmd.contains("conciliar:leer") {
+                "Consultando Plata".to_string()
+            } else if cmd.contains("llenar.mjs") {
+                "Armando el informe".to_string()
+            } else {
+                "Corriendo un comando".to_string()
+            }
+        }
+        "Write" | "Edit" if lower == "datos.json" => "Comparando línea por línea".to_string(),
+        "Write" | "Edit" if lower.ends_with(".html") => "Armando el informe".to_string(),
+        "Write" | "Edit" => format!("Escribiendo {file}"),
+        "Glob" | "Grep" => "Buscando archivos".to_string(),
+        "ToolSearch" | "TodoWrite" => return None,
+        other => format!("Usando {other}"),
+    };
+    Some(phrase)
+}
+
+/// One line of `--output-format stream-json`. Returns the progress events it
+/// produces (none for most lines) and keeps what the final event needs.
+pub(crate) fn parse_line(line: &str, st: &mut Stream) -> Vec<Value> {
+    let Ok(v) = serde_json::from_str::<Value>(line.trim()) else { return vec![] };
+    let mut phrases: Vec<String> = Vec::new();
+    match v.get("type").and_then(Value::as_str) {
+        Some("system") if v.get("subtype").and_then(Value::as_str) == Some("init") => {
+            phrases.push("Claude Code arrancó".into());
+        }
+        Some("assistant") => {
+            if v.get("error").and_then(Value::as_str) == Some("authentication_failed") {
+                st.auth_failed = true;
+            }
+            let content = v.pointer("/message/content").and_then(Value::as_array).cloned().unwrap_or_default();
+            for block in content {
+                match block.get("type").and_then(Value::as_str) {
+                    Some("tool_use") => {
+                        let name = block.get("name").and_then(Value::as_str).unwrap_or("");
+                        let input = block.get("input").cloned().unwrap_or(Value::Null);
+                        if let Some(p) = tool_phrase(name, &input) {
+                            phrases.push(p);
+                        }
+                    }
+                    Some("text") => {
+                        if let Some(t) = block.get("text").and_then(Value::as_str).filter(|t| !t.trim().is_empty()) {
+                            st.last_text = Some(t.trim().to_string());
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+        Some("result") => {
+            let text = v.get("result").and_then(Value::as_str).unwrap_or("").trim().to_string();
+            let is_error = v.get("is_error").and_then(Value::as_bool).unwrap_or(false)
+                || v.get("subtype").and_then(Value::as_str).is_some_and(|s| s != "success");
+            if is_error && (text.contains("Not logged in") || text.contains("/login")) {
+                st.auth_failed = true;
+            }
+            st.result = Some((text, is_error));
+        }
+        _ => {}
+    }
+    let mut out = Vec::new();
+    for p in phrases {
+        // The same step twice in a row (three reads of the PDF) is one line.
+        if st.last_progress.as_deref() == Some(p.as_str()) {
+            continue;
+        }
+        st.last_progress = Some(p.clone());
+        out.push(json!({ "tipo": "progreso", "texto": p }));
+    }
+    out
+}
+
+/// The final event, from what the stream said and what the run left behind.
+pub(crate) fn final_event(st: &Stream, carpeta: &Path, secs: u64, stop: u8, exit_ok: bool, stderr_tail: &str) -> Value {
+    if stop == STOP_CANCEL {
+        return json!({ "tipo": "error", "texto": "Cancelado.", "cancelado": true });
+    }
+    if stop == STOP_TIMEOUT {
+        return json!({ "tipo": "error", "texto": format!("Claude Code tardó más de {} minutos: lo corté.", TIMEOUT.as_secs() / 60) });
+    }
+    if st.auth_failed {
+        return json!({
+            "tipo": "error",
+            "texto": "Claude Code no tiene la sesión iniciada en esta PC. Iniciala una vez (se abre una terminal: seguí los pasos para entrar con tu cuenta) y volvé a probar.",
+            "login": true,
+        });
+    }
+    let datos: Option<Value> = std::fs::read_to_string(carpeta.join("datos.json"))
+        .ok()
+        .and_then(|s| serde_json::from_str(s.trim_start_matches('\u{feff}')).ok());
+    let informe = carpeta.join("informe.html");
+    let informe = informe.is_file().then(|| informe.to_string_lossy().to_string());
+    let (mensaje, is_error) = match &st.result {
+        Some((t, e)) => (t.clone(), *e),
+        None => (st.last_text.clone().unwrap_or_default(), true),
+    };
+    if datos.is_none() && st.result.is_none() && !exit_ok {
+        let detail = stderr_tail.trim();
+        return json!({
+            "tipo": "error",
+            "texto": if detail.is_empty() {
+                "Claude Code terminó sin responder.".to_string()
+            } else {
+                format!("Claude Code terminó con un error: {detail}")
+            },
+        });
+    }
+    let ok = !is_error && datos.as_ref().is_some_and(|d| d.get("error").is_none());
+    json!({
+        "tipo": "fin",
+        "ok": ok,
+        "mensaje": mensaje,
+        "datos": datos,
+        "informe": informe,
+        "carpeta": carpeta.to_string_lossy(),
+        "segundos": secs,
+    })
+}
