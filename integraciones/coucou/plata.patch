+#[cfg(windows)]
+/// Places and sizes the window. `collapsed` picks the wake strip instead of the panel.
+///
+/// `top` glues the window to the top edge, centred, as it always was. `left` and
+/// `right` put it against that edge of the work area at the stored height, and
+/// `float` wherever it was dropped. The page is told where the island is
+/// anchored inside the window (`island-anchor`) and lays it out from there.
+pub fn apply_geometry(app: &AppHandle, pref: &str, collapsed: bool) {
+    PLACEMENT.fetch_add(1, Ordering::SeqCst);
+    let Some(win) = window(app) else { return };
+    let Some(hwnd) = platform::hwnd_of(&win) else { return };
+    let Some(m) = target_monitor(app, pref) else { return };
+    let scale = m.scale_factor();
+    let (mon, wa) = area_of(&m);
+
+    if collapsed {
+        // The wake strip, top centre. Only `top` hides, and the page keeps its
+        // anchor: the window comes back exactly where it was.
+        let sw = ((STRIP_W * scale).round() as i32).max(1);
+        let sh = ((STRIP_H * scale).round() as i32).max(1);
+        set_bounds(hwnd, mon.x + (mon.w - sw) / 2, mon.y, sw, sh);
+        remember_screen(app);
+        return;
+    }
+
+    let (pw, ph) = window_size(app, wa, scale);
+    let (dock, dx, dy) = dock_of(app);
+    // dock_x is the left of a PANEL_W-wide window centred on the island, dock_y
+    // the island's top (settings.rs).
+    let want = (mon.x as f64 + (dx + PANEL_W / 2.0) * scale, mon.y as f64 + dy * scale);
+    let keep = LAST_ANCHOR
+        .lock()
+        .unwrap()
+        .as_ref()
+        .filter(|(d, _, _)| *d == dock)
+        .map(|(_, x, y)| (*x, *y));
+    let p = place(&dock, mon, wa, scale, pw, ph, want, keep);
+    // The anchor first: the page relays out on its next frame, about when the
+    // window lands — and when nothing moved, nothing changes.
+    send_anchor(app, &dock, &p, pw, ph, scale);
+    set_bounds(hwnd, p.x, p.y, pw, ph);
+    remember_screen(app);
+}
