+  display: grid;
+  gap: 6px;
+  justify-items: center;
+  background: rgba(var(--rgb), 0.04);
+}
+
+/* Entrega 2: writing to the Centro — row actions, confirm, the live hint */
+.lz-li.lz-li-act {
+  grid-template-columns: auto 1fr auto auto;
+}
+
+.lz-li.lz-li-act > span:nth-child(2) {
