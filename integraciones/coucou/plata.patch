+
+.lz-past {
+  position: absolute;
+  left: 0;
+  top: 10px;
+  height: 10px;
+  border-radius: 5px 0 0 5px;
+  background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.07) 0 3px, transparent 3px 6px);
