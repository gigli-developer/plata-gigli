+    const teDeben = num(d.te_deben);
+    const debes = num(d.debes);
+    c.says(total !== null ? `Tenés **${ars(total)}** en total, valuado al blue y al cripto de hoy.` : "No pude leer el total. Esto es lo que llegó:");
