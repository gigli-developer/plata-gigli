+  "SUMMARY:Cena temprano",
+  "DTSTART;TZID=America/Argentina/Buenos_Aires:20261009T200000",
+  "DTEND;TZID=America/Argentina/Buenos_Aires:20261009T203000",
+  "END:VEVENT",
+  // A one-off in UTC: 2026-10-07 09:00Z = 06:00 in Buenos Aires.
+  "BEGIN:VEVENT",
