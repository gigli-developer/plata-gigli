+        menu.append(b);
+      }
+      el.append(menu);
+      el.classList.add("menu-open");
+      const outside = (e: MouseEvent) => {
+        if (!menu.contains(e.target as Node)) menuClose?.();
+      };
+      const esc = (e: KeyboardEvent) => {
+        if (e.key === "Escape") {
+          e.stopPropagation();
+          menuClose?.();
+        }
+      };
+      window.setTimeout(() => document.addEventListener("mousedown", outside), 0);
+      document.addEventListener("keydown", esc, true);
+      menuClose = () => {
+        menu.remove();
+        el.classList.remove("menu-open");
+        document.removeEventListener("mousedown", outside);
+        document.removeEventListener("keydown", esc, true);
+        menuClose = null;
+      };
+    });
+    return el;
+  }
+
+  function renderHabits() {
+    clear(habits);
+    const hs = foco?.habitos ?? [];
+    for (const x of hs) {
+      const b = h("button", { type: "button", class: "cz-habit", "aria-pressed": String(x.hecho_hoy), title: x.hecho_hoy ? `${x.nombre}: hecho` : `${x.nombre}: tocá para marcarlo` }, h("i"), x.nombre) as HTMLButtonElement;
+      b.style.setProperty("--hc", x.color ?? CDC);
+      b.addEventListener("click", async () => {
+        if (b.disabled || !x.id) return;
+        const want = !x.hecho_hoy;
+        b.disabled = true;
+        b.setAttribute("aria-pressed", String(want));
+        try {
+          await data.accion("habito", { id: x.id, hecho: want });
+          x.hecho_hoy = want;
+          b.title = want ? `${x.nombre}: hecho` : `${x.nombre}: tocá para marcarlo`;
+          if (want) {
+            bot.engine.triggerEmote("happy");
+            Sound.play("approve");
+          }
+        } catch (e) {
+          b.setAttribute("aria-pressed", String(x.hecho_hoy));
+          Sound.play("error");
+          showToast(classifyError(e, "el Centro de Control").text, null, true);
+        } finally {
+          b.disabled = false;
+        }
+      });
+      habits.append(b);
+    }
+  }
+
+  return {
+    el,
+    sync() {
+      // Called on every state change while the tab is open: read only when stale.
+      if (!loading && Date.now() - loadedAt > 60_000) void load(false);
+    },
+    focus() {
+      // preventScroll: the island is still growing, and a plain focus() scrolls
+      // the clipped island so the field shows — the header ends up off the top.
+      ask.focus({ preventScroll: true });
+    },
+  };
+}
