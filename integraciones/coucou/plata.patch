+      ars: num(x.total_ars),
+      usd: num(x.total_usd),
+      estado: str(x.estado),
+    }));
+    const vencidos = rs.filter((r) => r.estado === "vencido");
+    const hoy = rs.filter((r) => r.estado === "vence_hoy");
+    const prox = rs.filter((r) => r.estado !== "vencido" && r.estado !== "vence_hoy");
+    const parts: string[] = [];
+    if (!rs.length) parts.push("No tenés resúmenes sin pagar por vencer. **Todo al día.**");
+    if (hoy.length) parts.push(hoy.length === 1 ? "**Hoy vence un resumen**" : `**Hoy vencen ${palabra(hoy.length)} resúmenes**`);
+    if (vencidos.length) parts.push(`${hoy.length ? "y hay" : "Hay"} **${palabra(vencidos.length)} ${plural(vencidos.length, "vencido", "vencidos")}** sin marcar como pagado`);
+    if (hoy.length || vencidos.length) parts.push(". Si ya los pagaste, marcalos y el saldo se acomoda.");
+    else if (prox.length) parts.push(`El próximo vence el **${fechaCorta(prox[0].vence)}**: ${prox[0].tarjeta}.`);
+    c.says(parts.join(" ").replace(" .", "."));
+    if (!rs.length) {
+      c.set(acts(btn("Abrir Tarjetas", "sec", () => c.actions.openUrl(`${PLATA_URL}/tarjetas`))));
+      return;
+    }
+    const sumArs = rs.reduce((a, r) => a + (r.ars ?? 0), 0);
+    const sumUsd = rs.reduce((a, r) => a + (r.usd ?? 0), 0);
+    const rows = rs.map((r) => {
+      const amount = [r.ars !== null ? ars(r.ars) : "monto sin leer", r.usd ? usd(r.usd) : ""].filter(Boolean).join(" + ");
+      const tone = r.estado === "vencido" || r.estado === "vence_hoy" ? "late" : "soon";
+      const label = r.estado === "vencido" ? `venció ${r.vence ? fechaCorta(r.vence) : ""}` : r.estado === "vence_hoy" ? "vence hoy" : `vence ${r.vence ? fechaCorta(r.vence) : ""}`;
+      return li("var(--plata)", h("span", {}, `${r.tarjeta} · ${r.periodo}`, h("small", { text: amount })), pill(label.trim(), tone));
+    });
+    const urgent = [...vencidos, ...hoy];
+    c.set(
+      box("Sin pagar", rs.some((r) => r.ars === null) ? null : `${ars(sumArs)}${sumUsd ? ` + ${usd(sumUsd)}` : ""}`, ...rows),
+      acts(
+        btn("Abrir Tarjetas", "prim", () => c.actions.openUrl(`${PLATA_URL}/tarjetas`), { enter: true }),
+        urgent.length
+          ? btn("Ya los pagué…", "sec", () =>
+              c.host.open(
+                "situacion",
+                urgent.length === 1
+                  ? `Ya pagué el resumen de ${urgent[0].tarjeta} de ${urgent[0].periodo}.`
+                  : `Ya pagué los resúmenes de ${urgent.map((r) => r.tarjeta).join(", ").replace(/, ([^,]*)$/, " y $1")}.`,
+                { send: false },
+              ),
+            )
+          : null,
+      ),
+    );
+  }, (e) => c.fail(e, "tus resúmenes", () => c.host.open("resumenes")));
+}
