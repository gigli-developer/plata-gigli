+
+test("calendar: recurrences, exceptions, UTC and all-day, in Buenos Aires time", () => {
+  const { cals, failed } = parseCalendars([ICS, "esto no es un ics"]);
+  assert.equal(failed, 1);
+  const from = arMs("2026-10-07");
+  const to = arMs("2026-10-11");
+  const evs = occurrences(cals, from, to);
+  const fmt = (ms: number) => { const c = arClock(ms); return `${c.date} ${hm(c.min)}`; };
+  assert.deepEqual(evs.map((e) => [e.title, fmt(e.start), fmt(e.end), e.allDay]), [
+    ["JP Morgan presencial", "2026-10-07 6", "2026-10-07 17", false],
