From 27d8a7472d2e8735e30bee24dd325d622251047c Mon Sep 17 00:00:00 2001
From: Lucas <lucasgigli3@gmail.com>
Date: Thu, 1 Oct 2026 22:26:24 -0300
Subject: [PATCH 14/22] =?UTF-8?q?Buscar=20claude.exe=20tambi=C3=A9n=20en?=
 =?UTF-8?q?=20la=20carpeta=20del=20paquete=20de=20la=20app=20(MSIX)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

La app de Claude de la Microsoft Store guarda %APPDATA%\Claude dentro de
%LOCALAPPDATA%\Packages\Claude_<id>\LocalCache\Roaming. Desde fuera del
paquete esa ruta no existe: el login y la conciliación fallaban con "el
sistema no puede encontrar el archivo especificado".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 windows/src-tauri/src/plata_agent.rs | 28 +++++++++++++++++++++++-----
 1 file changed, 23 insertions(+), 5 deletions(-)

diff --git a/windows/src-tauri/src/plata_agent.rs b/windows/src-tauri/src/plata_agent.rs
index 3b73768..83bbfae 100644
--- a/windows/src-tauri/src/plata_agent.rs
+++ b/windows/src-tauri/src/plata_agent.rs
@@ -350,12 +350,30 @@ fn plata_repo_dir() -> Option<PathBuf> {
     })
 }
 
-/// The newest Claude Code the desktop app ships (%APPDATA%\Claude\claude-code\<version>\claude.exe).
+/// The newest Claude Code the desktop app ships (claude-code\<version>\claude.exe).
+///
+/// The Store (MSIX) build of the app writes %APPDATA%\Claude into its package:
+/// %LOCALAPPDATA%\Packages\Claude_<id>\LocalCache\Roaming\Claude. Only the app
+/// itself sees it at %APPDATA%; from Coucou (outside the package) that path does
+/// not exist, so the package folder is searched too.
 pub(crate) fn claude_exe() -> Option<PathBuf> {
-    let base = PathBuf::from(std::env::var_os("APPDATA")?).join("Claude").join("claude-code");
-    std::fs::read_dir(base)
-        .ok()?
-        .flatten()
+    let mut bases = Vec::new();
+    if let Some(local) = std::env::var_os("LOCALAPPDATA") {
+        if let Ok(pkgs) = std::fs::read_dir(PathBuf::from(local).join("Packages")) {
+            for p in pkgs.flatten() {
+                if p.file_name().to_string_lossy().starts_with("Claude_") {
+                    bases.push(p.path().join("LocalCache").join("Roaming").join("Claude").join("claude-code"));
+                }
+            }
+        }
+    }
+    if let Some(roaming) = std::env::var_os("APPDATA") {
+        bases.push(PathBuf::from(roaming).join("Claude").join("claude-code"));
+    }
+    bases
+        .into_iter()
+        .filter_map(|b| std::fs::read_dir(b).ok())
+        .flat_map(|dir| dir.flatten())
         .filter_map(|e| {
             let exe = e.path().join("claude.exe");
             let version: Vec<u64> = e.file_name().to_string_lossy().split('.').map(|n| n.parse().unwrap_or(0)).collect();
-- 
