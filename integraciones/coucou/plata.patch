+// ── Plata ─────────────────────────────────────────────────────────────────────
+//
+// The Plata finance app (Supabase). One call to its `coucou-health` Edge
+// Function, which answers with the card-charge importer's health (the Gmail
+// token that expires every 7 days, the cron), the newest imported charge and the
+// day's dollar rates. The function is read-only and guarded by a shared secret.
+
+const PLATA_DEFAULT_URL: &str =
+    "https://dsocdpxlvcufitvovydr.supabase.co/functions/v1/coucou-health";
+
+async fn poll_plata(app: AppHandle) {
+    let Some(secret) = secrets::get("plata-secret") else { return };
+    let url = secrets::get("plata-url").unwrap_or_else(|| PLATA_DEFAULT_URL.to_string());
+    let response = client()
+        .post(&url)
+        .header("x-coucou-secret", secret)
+        .header("Content-Type", "application/json")
+        .body("{}")
+        .send()
+        .await;
+    let Ok(response) = response else { return };
+    if !response.status().is_success() {
+        let code = response.status().as_u16();
+        log::line(format!("plata HTTP {code}"));
+        emit(&app, IntegrationUpdate {
+            id: "integration_plata",
+            data: json!({}),
+            error: Some(match code {
+                401 => "Wrong secret (401)".into(),
+                _ => format!("API error {code}"),
+            }),
+            event: None,
+        });
+        return;
+    }
+    let json: Value = response.json().await.unwrap_or(json!({}));
+    let problems: Vec<String> = json
+        .get("problems")
+        .and_then(Value::as_array)
+        .map(|list| list.iter().filter_map(|p| p.as_str().map(str::to_string)).collect())
+        .unwrap_or_default();
+
+    // Health first: a dead importer matters more than a new charge. Unlike the
+    // other pollers, a problem already present on the first poll is announced —
+    // an expired token found at launch is exactly what this pill is for.
+    let signature = if problems.is_empty() { "ok".to_string() } else { problems.join("\n") };
+    let previous = SEEN.0.lock().unwrap().insert("plata_health", signature.clone());
+    let health_event = match previous {
+        Some(prev) if prev == signature => None,
+        None if problems.is_empty() => None,
+        _ if problems.is_empty() => Some(IntegrationEvent {
+            success: true,
+            label: "Plata en orden".into(),
+            detail: None,
+        }),
+        _ => {
+            log::line(format!("plata problems: {}", problems.join(" | ")));
+            Some(IntegrationEvent {
+                success: false,
+                label: problems[0].clone(),
+                detail: (problems.len() > 1).then(|| problems[1..].join("\n")),
+            })
+        }
+    };
+
+    let event = health_event.or_else(|| {
+        let tx = json.get("lastTx")?;
+        let id = tx.get("id")?.to_string();
+        if !is_new("plata_tx", &id) {
+            return None;
+        }
+        let amount = tx.get("amount").and_then(Value::as_f64).unwrap_or(0.0);
+        let currency = tx.get("currency").and_then(Value::as_str).unwrap_or("ARS");
+        Some(IntegrationEvent {
+            success: true,
+            label: tx.get("description").and_then(Value::as_str).unwrap_or("Consumo").to_string(),
+            detail: Some(fmt_money(amount, currency)),
+        })
+    });
+
+    emit(&app, IntegrationUpdate { id: "integration_plata", data: json, error: None, event });
+}
+
+/// `$ 6.791,50` / `US$ 4,11` — the Argentine format Plata itself uses.
+fn fmt_money(amount: f64, currency: &str) -> String {
+    let cents = (amount.abs() * 100.0).round() as u64;
+    let int = (cents / 100).to_string();
+    let mut grouped = String::new();
+    for (i, c) in int.chars().enumerate() {
+        if i > 0 && (int.len() - i) % 3 == 0 {
+            grouped.push('.');
+        }
+        grouped.push(c);
+    }
+    let frac = cents % 100;
+    let number = if frac == 0 { grouped } else { format!("{grouped},{frac:02}") };
+    let sign = if amount < 0.0 { "-" } else { "" };
+    let symbol = match currency {
+        "ARS" => "$",
+        "USD" => "US$",
+        other => other,
+    };
+    format!("{sign}{symbol} {number}")
+}
+
+// ── Railway ───────────────────────────────────────────────────────────────────
+//
+// Deployments of one Railway project, through the public GraphQL API with an
+// account token. The project ID is optional: without it the project named
+// "plata" is used (or the only one, if there is just one).
+
+const RAILWAY_API: &str = "https://backboard.railway.com/graphql/v2";
+
+/// None = network trouble (stay quiet, like the other pollers); Some(Err) = an
+/// answer worth showing on the card.
+async fn railway_query(
+    http: &reqwest::Client,
+    token: &str,
+    query: &str,
+    variables: Value,
+) -> Option<Result<Value, String>> {
+    let response = http
+        .post(RAILWAY_API)
+        .header("Authorization", format!("Bearer {token}"))
+        .header("Content-Type", "application/json")
+        .header("User-Agent", "Coucou")
+        .json(&json!({ "query": query, "variables": variables }))
+        .send()
+        .await
+        .ok()?;
+    if !response.status().is_success() {
+        return Some(Err(status_error(response.status().as_u16(), "Token lacks access")));
+    }
+    let json: Value = response.json().await.ok()?;
+    // GraphQL reports a bad token as 200 + errors.
+    if let Some(message) = json
+        .get("errors")
+        .and_then(|e| e.get(0))
+        .and_then(|e| e.get("message"))
+        .and_then(Value::as_str)
+    {
+        return Some(Err(format!("Railway: {message}")));
+    }
+    Some(Ok(json.get("data").cloned().unwrap_or(json!({}))))
+}
+
+async fn railway_project_id(http: &reqwest::Client, token: &str) -> Option<Result<String, String>> {
+    if let Some(id) = secrets::get("railway-project-id") {
+        return Some(Ok(id.trim().to_string()));
+    }
+    let data = match railway_query(http, token, "{ projects(first: 50) { edges { node { id name } } } }", json!({})).await? {
+        Ok(data) => data,
+        Err(_) => return Some(Err("Can't list projects: set the Project ID in Settings".into())),
+    };
+    let projects: Vec<(String, String)> = data
+        .pointer("/projects/edges")
+        .and_then(Value::as_array)
+        .map(|edges| {
+            edges
+                .iter()
+                .filter_map(|e| {
+                    let node = e.get("node")?;
+                    Some((node.get("id")?.as_str()?.to_string(), node.get("name")?.as_str()?.to_string()))
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let found = projects
+        .iter()
+        .find(|(_, name)| name.eq_ignore_ascii_case("plata"))
+        .or(if projects.len() == 1 { projects.first() } else { None });
+    Some(match found {
+        Some((id, _)) => Ok(id.clone()),
+        None => Err("No \"plata\" project: set the Project ID in Settings".into()),
+    })
+}
+
+const RAILWAY_DEPLOYMENTS: &str = "query($input: DeploymentListInput!) {
+  deployments(input: $input, first: 5) {
+    edges { node { id status createdAt staticUrl meta service { name } } }
+  }
+}";
+
+async fn poll_railway(app: AppHandle) {
+    let Some(token) = secrets::get("railway-token") else { return };
+    let http = client();
+    let fail = |app: &AppHandle, message: String| {
+        emit(app, IntegrationUpdate {
+            id: "integration_railway",
+            data: json!({}),
+            error: Some(message),
+            event: None,
+        });
+    };
+
+    let project = match railway_project_id(&http, &token).await {
+        None => return,
+        Some(Err(message)) => return fail(&app, message),
+        Some(Ok(id)) => id,
+    };
+    let data = match railway_query(&http, &token, RAILWAY_DEPLOYMENTS, json!({ "input": { "projectId": project } })).await {
+        None => return,
+        Some(Err(message)) => return fail(&app, message),
+        Some(Ok(data)) => data,
+    };
+
+    let deployments: Vec<Value> = data
+        .pointer("/deployments/edges")
+        .and_then(Value::as_array)
+        .map(|edges| {
+            edges
+                .iter()
+                .filter_map(|e| {
+                    let d = e.get("node")?;
+                    let meta = d.get("meta");
+                    let pick = |key: &str| meta.and_then(|m| m.get(key)).and_then(Value::as_str).map(str::to_string);
+                    Some(json!({
+                        "id": d.get("id")?.as_str()?,
+                        "service": d.pointer("/service/name").and_then(Value::as_str).unwrap_or("service"),
+                        "status": d.get("status")?.as_str()?,
+                        "createdAt": d.get("createdAt").and_then(Value::as_str).unwrap_or(""),
+                        "url": d.get("staticUrl").and_then(Value::as_str).unwrap_or(""),
+                        "commitMessage": pick("commitMessage"),
+                        "branch": pick("branch"),
+                    }))
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+
+    let status_of = |d: &Value| d.get("status").and_then(Value::as_str).unwrap_or("").to_string();
+    let busy = ["QUEUED", "INITIALIZING", "BUILDING", "DEPLOYING", "WAITING"];
+    let deploying = deployments.first().map(|d| busy.contains(&status_of(d).as_str())).unwrap_or(false);
+
+    // Newest finished deployment; keyed on id + status so a SUCCESS that later
+    // CRASHES is announced too.
+    let terminal = ["SUCCESS", "FAILED", "CRASHED"];
+    let event = deployments
+        .iter()
+        .find(|d| terminal.contains(&status_of(d).as_str()))
+        .and_then(|latest| {
+            let status = status_of(latest);
+            let id = latest.get("id")?.as_str()?;
+            if !is_new("railway", &format!("{id}:{status}")) {
+                return None;
+            }
+            let service = latest.get("service")?.as_str()?.to_string();
+            log::line(format!("railway {service} {status}"));
+            Some(IntegrationEvent {
+                success: status == "SUCCESS",
+                label: service,
+                detail: (status != "SUCCESS").then(|| status.to_lowercase()),
+            })
+        });
+
+    emit(&app, IntegrationUpdate {
+        id: "integration_railway",
+        data: json!({ "deployments": deployments, "busy": deploying }),
+        error: None,
+        event,
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::fmt_money;
+
+    #[test]
+    fn money_is_formatted_like_plata() {
+        assert_eq!(fmt_money(6791.5, "ARS"), "$ 6.791,50");
+        assert_eq!(fmt_money(700.0, "ARS"), "$ 700");
+        assert_eq!(fmt_money(1234567.0, "ARS"), "$ 1.234.567");
+        assert_eq!(fmt_money(4.11, "USD"), "US$ 4,11");
+        assert_eq!(fmt_money(10.0, "USDT"), "USDT 10");
+        assert_eq!(fmt_money(-15.0, "ARS"), "-$ 15");
+    }
+}
