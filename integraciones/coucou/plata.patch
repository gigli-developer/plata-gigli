+        let out = stage_inputs(&run, &[s.clone(), s.clone()], Some("  12/09 MERPAGO*VERDULERIA 6.500,00 \n")).unwrap();
+        let names: Vec<_> = out.iter().map(|p| p.file_name().unwrap().to_string_lossy().to_string()).collect();
+        assert_eq!(names, ["visa sept.pdf", "2-visa sept.pdf", "resumen.txt"]);
+        assert_eq!(std::fs::read_to_string(run.join("resumen.txt")).unwrap(), "12/09 MERPAGO*VERDULERIA 6.500,00");
+        assert!(stage_inputs(&run, &[], Some("   ")).is_err());
+        let txt = src.join("notas.txt");
+        std::fs::write(&txt, b"no soy pdf").unwrap();
+        assert!(stage_inputs(&run, &[txt.to_string_lossy().to_string()], None).is_err());
+
+        let p = prompt(&out[..1], &run, " fijate las cuotas ");
+        assert!(p.starts_with("MODO ISLA. Usá la skill conciliar-resumen. Resumen: "));
+        assert!(p.contains("visa sept.pdf. Carpeta de salida: "));
+        assert!(p.ends_with("\nPedido de Lucas: fijate las cuotas"));
+        assert!(!prompt(&out[..1], &run, "").contains("Pedido"));
+        let _ = std::fs::remove_dir_all(&src);
+        let _ = std::fs::remove_dir_all(&run);
+    }
+
+    #[test]
+    fn the_invocation_matches_the_contract() {
+        let a = claude_args(Path::new("D:\\run"), Path::new("C:\\s\\conciliar-resumen"));
+        let joined = a.join(" ");
+        assert!(joined.starts_with("-p --output-format stream-json --verbose --model sonnet --allowedTools Read Write Glob Skill"));
+        assert!(a.contains(&"Bash(npm run -s conciliar:leer*)".to_string()));
+        assert!(a.contains(&"Bash(node *llenar.mjs*)".to_string()));
+        assert!(joined.ends_with("--add-dir D:\\run --add-dir C:\\s\\conciliar-resumen"));
+    }
+}
