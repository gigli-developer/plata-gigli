+  gap: 6px;
+  flex: 1 0 100%;
+  color: #ffb84d;
+}
+
+.plata-cc-run.done .plata-cc-run-head {
+  color: var(--dim-3, #6b6b70);
+}
+
+.plata-cc-run.done .plata-cc-run-head svg {
+  color: #35e08a;
+}
+
+.plata-cc-step {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  min-width: 0;
+  color: var(--dim-2, #9a9fa8);
+}
+
+.plata-cc-step-text {
+  min-width: 0;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+
+.plata-cc-time {
+  flex: none;
+  font-variant-numeric: tabular-nums;
+  color: var(--dim-3, #6b6b70);
+}
+
+.plata-cc-pulse {
+  width: 6px;
+  height: 6px;
+  flex: none;
+  border-radius: 50%;
+  background: #ff9e1b;
+  animation: plata-cc-pulse 1.2s ease-in-out infinite;
+}
+
+@keyframes plata-cc-pulse {
+  50% {
+    opacity: 0.25;
+    transform: scale(0.7);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .plata-cc-pulse,
+  .plata-ready-item.wait i {
+    animation: none;
+  }
+}
+
+.plata-cc-cancel {
+  margin-left: auto;
+}
+
+.plata-cc-btn:disabled {
+  opacity: 0.5;
+}
+
+.plata-cc-run button:focus-visible,
+.plata-cc-btn:focus-visible,
+.plata-cc-error button:focus-visible {
+  outline: 2px solid #ffb84d;
+  outline-offset: 2px;
+}
+
+/* The result card: totals per currency, counts, the first differences. */
+.plata-cc-result {
+  gap: 8px;
+}
+
+.plata-cc-totals {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
+  gap: 8px;
+}
+
+.plata-cc-tot {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 1px 10px;
+  padding: 8px 10px;
+  border-radius: 10px;
+  background: rgba(255, 255, 255, 0.04);
+  border: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+.plata-cc-tot-head {
+  grid-column: 1 / -1;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 3px;
+  font: 500 11px var(--font);
+  letter-spacing: 0.06em;
+  color: var(--dim-2, #9a9fa8);
+}
+
+.plata-cc-state {
+  padding: 1px 7px;
+  border-radius: 99px;
+  font: 500 10.5px var(--font);
+  letter-spacing: 0;
+}
+
+.plata-cc-state.ok {
+  color: #35e08a;
+  background: rgba(53, 224, 138, 0.12);
+}
+
+.plata-cc-state.bad {
+  color: #ff8a84;
+  background: rgba(255, 107, 99, 0.14);
+}
+
+.plata-cc-k {
+  font: 400 10.5px var(--font);
+  color: var(--dim-3, #6b6b70);
+}
+
+.plata-cc-v {
+  font: 500 13.5px var(--font);
+  font-variant-numeric: tabular-nums;
+  color: var(--ink-2);
+  white-space: nowrap;
+}
+
+.plata-cc-v.bad {
+  color: #ff8a84;
+}
+
+.plata-cc-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.plata-cc-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  padding: 2px 9px 2px 7px;
+  border-radius: 99px;
+  background: rgba(255, 255, 255, 0.06);
+  font: 400 11.5px var(--font);
+  color: var(--ink-2);
+}
+
+.plata-cc-chip i,
+.plata-cc-kind i {
+  width: 7px;
+  height: 7px;
+  flex: none;
+  border-radius: 50%;
+  background: var(--c);
+}
+
+.plata-cc-chip b {
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+}
+
+.plata-cc-clean {
+  font: 400 12.5px var(--font);
+  color: #35e08a;
+}
+
+.plata-cc-difs {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 6px;
+}
+
+#island.chat-big .plata-cc-difs {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.plata-cc-dif {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+  padding: 7px 10px;
+  border-radius: 10px;
+  background: rgba(255, 255, 255, 0.035);
+  border-left: 2px solid rgba(255, 255, 255, 0.12);
+  user-select: text;
+}
+
+.plata-cc-dif-top {
+  display: flex;
+  justify-content: space-between;
+  gap: 8px;
+  font: 400 10.5px var(--font);
+  color: var(--dim-3, #6b6b70);
+}
+
+.plata-cc-kind {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  color: var(--c);
+  font-weight: 500;
+}
+
+.plata-cc-date {
+  font-variant-numeric: tabular-nums;
+}
+
+.plata-cc-dif-name {
+  display: flex;
+  gap: 6px;
+  min-width: 0;
+  font: 500 12.5px var(--font);
+  color: var(--ink-2);
+}
+
+.plata-cc-dif-name span:last-child {
+  min-width: 0;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+
+.plata-cc-id {
+  flex: none;
+  font-variant-numeric: tabular-nums;
+  color: #ffb84d;
+}
+
+.plata-cc-dif-amt {
+  font: 400 12px var(--font);
+  font-variant-numeric: tabular-nums;
+  color: #b0b5be;
+}
+
+.plata-cc-dif-do {
+  font: 400 11.5px var(--font);
+  color: var(--dim-2, #9a9fa8);
+}
+
+.plata-cc-actions {
+  flex-wrap: wrap;
+}
+
+.plata-cc-error {
+  row-gap: 6px;
+}
+
+/* ── Plata: the agent's Markdown, drawn ─────────────────────────────────── */
+.reply.md {
+  white-space: normal;
+  line-height: 1.5;
+}
+
+.reply.md > * + * {
+  margin-top: 8px;
+}
+
+.reply.md p,
+.reply.md ul,
+.reply.md ol,
+.reply.md h3,
+.reply.md h4,
+.reply.md h5 {
+  margin: 0;
+}
+
+.reply.md > * + p,
+.reply.md > * + ul,
+.reply.md > * + ol {
+  margin-top: 8px;
+}
+
+.reply.md strong {
+  color: #eef0f3;
+  font-weight: 600;
+}
+
+.reply.md em {
+  color: #c9cdd4;
+}
+
+.reply.md code {
+  font: 11.5px "Cascadia Mono", Consolas, monospace;
+  background: rgba(255, 255, 255, 0.06);
+  padding: 1px 5px;
+  border-radius: 5px;
+}
+
+.reply.md h3,
+.reply.md h4,
+.reply.md h5 {
+  color: #eef0f3;
+  font: 600 13px var(--font);
+  margin-top: 12px;
+}
+
+.reply.md h3 {
+  font-size: 14px;
+}
+
+.reply.md ul,
+.reply.md ol {
+  padding-left: 18px;
+}
+
+.reply.md li + li {
+  margin-top: 3px;
+}
+
+.reply.md li::marker {
+  color: #ff9e1b;
+}
+
+.reply.md hr {
+  border: 0;
+  border-top: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+.reply.md .md-table {
+  overflow-x: auto;
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  border-radius: 12px;
+  background: rgba(255, 255, 255, 0.025);
+}
+
+.reply.md table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 12.5px;
+}
+
+.reply.md th {
+  text-align: left;
+  font: 500 10.5px var(--font);
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: #7d828c;
+  padding: 8px 12px 6px;
+  white-space: nowrap;
+}
+
+.reply.md td {
+  padding: 7px 12px;
+  border-top: 1px solid rgba(255, 255, 255, 0.06);
+  color: #c9cdd4;
+  vertical-align: top;
+}
+
+.reply.md .num {
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+.reply.md .mid {
+  text-align: center;
+}
+
+.reply.md tr.total td {
+  color: #eef0f3;
+  font-weight: 600;
+  border-top-color: rgba(255, 158, 27, 0.35);
+}
+
+.reply.md .md-source {
+  font-size: 11px;
+  color: #6f747d;
+  padding-top: 6px;
+  border-top: 1px solid rgba(255, 255, 255, 0.06);
+}
+
+/* Plata: a multi-line field (Shift+Enter) that grows up to six lines. */
+.chat-bar:has(.plata-input) {
+  align-items: flex-end;
+}
+
+.plata-input {
+  resize: none;
+  height: 18px;
+  max-height: 132px;
+  line-height: 18px;
+  padding: 0;
+  margin-block: 5px;
+  overflow-y: auto;
+  white-space: pre-wrap;
+  word-break: break-word;
+  scrollbar-width: thin;
+}
+
+/* ══ Atajos de la isla (views/atajos) ══════════════════════════════════════
+   The launcher and its skill cards, as in the approved prototype
+   (atajos-de-la-isla.html). Each card sets --rgb to its agent's colour:
+   Centro de Control 124,196,255 · Plata 255,158,27. The view is as tall as its
+   content: .lz-inner keeps its natural height and launcher.ts asks the island
+   for exactly that (setLauncherHeight). */
+
+.lz-view {
+  --rgb: 124, 196, 255;
+  overflow: visible;
+}
+
+.lz-inner {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+}
+
+.lz-list,
+.lz-result {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.lz-list[hidden],
+.lz-result[hidden] {
+  display: none;
+}
+
+.lz-search {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 12px;
+  border-radius: 14px;
+  background: var(--card);
+  border: 1px solid rgba(255, 255, 255, 0.06);
+  color: var(--dim-2);
+  cursor: text;
+}
+
+.lz-input {
+  flex: 1;
+  min-width: 0;
+  background: transparent;
+  border: 0;
+  outline: none;
+  color: var(--ink);
+  font: 400 14px var(--font);
+  user-select: text;
+}
+
+.lz-input::placeholder {
+  color: var(--dim-3);
+}
+
+.lz-view kbd {
+  font: 600 10px var(--mono);
+  color: var(--ink-2);
+  background: #1d2026;
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  border-bottom-width: 2px;
+  border-radius: 5px;
+  padding: 0 5px;
+  white-space: nowrap;
+}
+
+.lz-keys {
+  display: inline-flex;
+  gap: 3px;
+}
+
+/* Voice bar */
+.lz-voice {
+  display: grid;
+  grid-template-columns: auto 1fr;
+  gap: 10px;
+  align-items: center;
+  padding: 8px 12px;
+  min-height: 40px;
+  border-radius: 14px;
+  background: linear-gradient(90deg, rgba(124, 196, 255, 0.1), rgba(255, 158, 27, 0.07));
+  border: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+.lz-voice[hidden] {
+  display: none;
+}
+
+.lz-wave {
+  display: flex;
+  gap: 2px;
+  align-items: center;
+  width: 34px;
+  height: 18px;
+}
+
+.lz-wave i {
+  flex: 1;
+  height: 18px;
+  border-radius: 2px;
+  background: #7cc4ff;
+  animation: lz-wv 0.9s ease-in-out infinite;
+}
+
+.lz-wave i:nth-child(2) { animation-delay: 0.12s; background: #a7d6ff; }
+.lz-wave i:nth-child(3) { animation-delay: 0.24s; }
+.lz-wave i:nth-child(4) { animation-delay: 0.36s; background: #ff9e1b; }
+.lz-wave i:nth-child(5) { animation-delay: 0.48s; }
+
+.lz-voice.quiet .lz-wave i {
+  animation: none;
+  transform: scaleY(0.2);
+  opacity: 0.5;
+}
+
+@keyframes lz-wv {
+  0%, 100% { transform: scaleY(0.25); }
+  50% { transform: scaleY(1); }
+}
+
+.lz-vstate {
+  font: 500 11.5px var(--font);
+  color: var(--dim);
+  min-width: 0;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  align-items: center;
+}
+
+.lz-vstate b {
+  color: var(--ink-2);
+  font-weight: 600;
+}
+
+.lz-got {
+  display: inline-flex;
+  gap: 6px;
+  align-items: center;
+  padding: 3px 10px;
+  border-radius: 99px;
+  background: rgba(var(--rgb), 0.16);
+  color: rgb(var(--rgb));
+  font: 600 12px var(--font);
+  animation: lz-pop 0.3s var(--ease-spring);
+}
+
+.lz-got small {
+  font: 500 10px var(--mono);
+  color: var(--dim-2);
+}
+
+.lz-alt {
+  font: 500 11.5px var(--font);
+  color: var(--ink-2);
+  background: rgba(255, 255, 255, 0.07);
+  border: 1px solid rgba(255, 255, 255, 0.06);
+  border-radius: 999px;
+  padding: 3px 10px;
+  cursor: default;
+  animation: lz-pop 0.3s var(--ease-spring) both;
+}
+
+.lz-alt:hover {
+  border-color: rgba(var(--rgb), 0.6);
+  background: rgba(var(--rgb), 0.14);
+}
+
+/* The two lists */
+.lz-groups {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+  transition: opacity 0.3s;
+}
+
+.lz-groups.dim {
+  opacity: 0.35;
+  pointer-events: none;
+}
+
+.lz-group {
+  border-radius: 16px;
+  background: var(--card);
+  border: 1px solid rgba(255, 255, 255, 0.035);
+  padding: 8px 6px;
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+  min-width: 0;
+}
+
+.lz-group h4 {
+  margin: 0;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font: 600 11.5px var(--font);
+  padding: 0 6px 6px;
+  color: var(--ink);
+}
+
+.lz-sk {
+  display: grid;
+  grid-template-columns: 22px 1fr;
+  gap: 8px;
+  align-items: center;
+  padding: 5px 7px;
+  border-radius: 9px;
+  border: 0;
+  background: transparent;
+  color: var(--ink-2);
+  text-align: left;
+  cursor: default;
+  min-width: 0;
+}
+
+.lz-sk[hidden] {
+  display: none;
+}
+
+.lz-sk:hover,
+.lz-sk.sel {
+  background: rgba(var(--rgb), 0.12);
+}
+
+.lz-ic {
+  width: 22px;
+  height: 22px;
+  border-radius: 7px;
+  display: grid;
+  place-items: center;
+  background: rgba(var(--rgb), 0.14);
+  color: rgb(var(--rgb));
+}
+
+.lz-sk-t {
+  min-width: 0;
+}
+
+.lz-sk-t b {
+  display: block;
+  font: 500 12.5px var(--font);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.lz-sk-t small {
+  display: block;
+  font-size: 10.5px;
+  color: var(--dim-3);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.lz-lfoot {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 14px;
+  font-size: 11px;
+  color: var(--dim-3);
+  padding: 0 4px;
+  align-items: center;
+}
+
+.lz-hk {
+  margin-left: auto;
+  display: inline-flex;
+  gap: 6px;
+  align-items: center;
+}
+
+.lz-err-inline {
+  color: var(--red-text);
+}
+
+/* Card */
+.lz-card {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.lz-rhead {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-height: 24px;
+}
+
+.lz-back {
+  border: 0;
+  background: rgba(255, 255, 255, 0.06);
+  color: var(--dim-2);
+  width: 24px;
+  height: 24px;
+  border-radius: 8px;
+  display: grid;
+  place-items: center;
+  cursor: default;
+  flex: none;
+}
+
+.lz-back:hover {
+  color: var(--ink);
+  background: rgba(255, 255, 255, 0.1);
+}
+
+.lz-name {
+  font: 600 12px var(--font);
+}
+
+.lz-agent {
+  font: 500 11px var(--font);
+  color: var(--dim-3);
+}
+
+.lz-rkeys {
+  margin-left: auto;
+  display: inline-flex;
+  gap: 5px;
+  align-items: center;
+  font-size: 10.5px;
+  color: var(--dim-3);
+}
+
+.lz-says {
+  display: grid;
+  grid-template-columns: auto 1fr;
+  gap: 12px;
+  align-items: center;
+  padding: 10px 14px 10px 10px;
+  border-radius: 16px;
+  background: linear-gradient(180deg, rgba(var(--rgb), 0.11), rgba(var(--rgb), 0.03));
+  border: 1px solid rgba(var(--rgb), 0.16);
+  animation: lz-rise 0.3s var(--ease-out);
+}
+
+.lz-says p {
+  margin: 0;
+  font-size: 13.5px;
+  line-height: 1.45;
+  color: var(--ink-2);
+  user-select: text;
+}
+
+.lz-says p b {
+  color: #fff;
+  font-weight: 600;
+}
+
+.lz-rbody {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.lz-rbody > * {
+  animation: lz-rise 0.32s var(--ease-out) both;
+}
+
+.lz-rbody > *:nth-child(2) { animation-delay: 0.05s; }
+.lz-rbody > *:nth-child(3) { animation-delay: 0.1s; }
+.lz-rbody > *:nth-child(4) { animation-delay: 0.15s; }
+
+@keyframes lz-rise {
+  from { opacity: 0; transform: translateY(6px); }
+  to { opacity: 1; transform: none; }
+}
+
+@keyframes lz-pop {
+  from { opacity: 0; transform: scale(0.94); }
+  to { opacity: 1; transform: none; }
+}
+
+.lz-box {
+  border-radius: 14px;
+  background: var(--card);
+  border: 1px solid rgba(255, 255, 255, 0.035);
+  padding: 10px 12px;
+  min-width: 0;
+  color: inherit;
+  text-align: left;
+  font: inherit;
+}
+
+.lz-box h5 {
+  margin: 0 0 6px;
+  font: 600 11px var(--font);
+  color: var(--dim-2);
+  display: flex;
+  justify-content: space-between;
+  gap: 8px;
+}
+
+.lz-row2,
+.lz-row3 {
+  display: grid;
+  gap: 8px;
+}
+
+.lz-row2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.lz-row3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+
+.lz-pick {
+  cursor: default;
+  transition: border-color 0.15s, background 0.15s;
+}
+
+.lz-pick:hover,
+.lz-pick.sel {
+  border-color: rgba(var(--rgb), 0.5);
+  background: rgba(var(--rgb), 0.08);
+}
+
+.lz-big {
+  font: 650 20px var(--font);
+  letter-spacing: -0.01em;
+  font-variant-numeric: tabular-nums;
+}
+
+.lz-big.late {
