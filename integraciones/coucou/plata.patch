+  );
+}
+
+// ── Railway ───────────────────────────────────────────────────────────────────
+
+const RAILWAY = "#B57BFF";
+
+function railwayAccent(status: unknown): string {
+  switch (status) {
+    case "SUCCESS":
+      return "#22C55E";
+    case "FAILED":
+    case "CRASHED":
+      return "#F4505E";
+    case "REMOVED":
+    case "SKIPPED":
