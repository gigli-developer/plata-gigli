+    if (running) parts.push(`Corre **${running.titulo}**.`);
+    else if (events) {
+      const nowMs = Date.now();
+      const timed = events.filter((e) => !e.allDay);
+      const cur = timed.find((e) => e.start <= nowMs && e.end > nowMs);
+      const next = timed.find((e) => e.start > nowMs);
+      const base = arMs(now.date);
+      if (cur) parts.push(`Ahora: ${cur.title}.`);
+      else if (next) parts.push(`Después: ${next.title} a las ${hhmm((next.start - base) / 60_000)}.`);
+    }
+    sumText.innerHTML = rich(parts.join(" "));
+
+    clear(tlSlot);
+    if (events) {
+      const base = arMs(now.date);
+      const tl: TlEvent[] = events.filter((e) => !e.allDay).map((e) => ({ s: (e.start - base) / 60_000, e: (e.end - base) / 60_000, label: e.title, color: e.color ?? DEFAULT_EVENT_COLOR }));
+      const from = Math.min(8, ...tl.map((e) => Math.max(0, Math.floor(e.s / 60))));
+      tlSlot.append(timeline(tl, now.min, from, 24));
+    } else {
+      const fix = h("button", { type: "button", class: "cz-link", text: "Configurar" });
