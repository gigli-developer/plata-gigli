diff --git a/windows/src/views/atajos/calendar.ts b/windows/src/views/atajos/calendar.ts
new file mode 100644
index 0000000..31a9161
--- /dev/null
+++ b/windows/src/views/atajos/calendar.ts
@@ -0,0 +1,146 @@
+// Atajos — Lucas's calendars, from the iCal texts Coucou downloads
+// (Bridge.calendarIcs, contract §3), expanded into the occurrences that fall in
+// a window of time. Recurring events are expanded with ical.js (RRULE, EXDATE
+// and moved occurrences); times end up as epoch ms, read in Buenos Aires
+// (UTC−3 all year). Only imports ical.js, so `node --test` runs it.
+
+import ICAL from "ical.js";
+import type { CalEvent } from "./plan";
+
+const AR_SHIFT_MS = 3 * 3_600_000;
+/** Backstop for a daily event that started years ago, or a broken rule. */
+const MAX_STEPS = 20_000;
+
+type ITime = InstanceType<typeof ICAL.Time>;
+type IEvent = InstanceType<typeof ICAL.Event>;
+type IComponent = InstanceType<typeof ICAL.Component>;
+
+/** A parsed calendar file: its events, ready to expand over any window. */
+export interface Calendar {
+  masters: IEvent[];
+  colors: Map<IEvent, string | null>;
+}
+
+/**
+ * Parses each .ics text. A file that doesn't parse is skipped and counted, so
+ * one broken address doesn't hide the others.
+ */
+export function parseCalendars(texts: readonly string[]): { cals: Calendar[]; failed: number } {
+  const cals: Calendar[] = [];
+  let failed = 0;
+  for (const text of texts) {
+    try {
+      cals.push(parseOne(text));
+    } catch {
+      failed++;
+    }
+  }
+  return { cals, failed };
+}
+
+function parseOne(text: string): Calendar {
+  const root = new ICAL.Component(ICAL.parse(text));
+  // Time zones first: an event's times are resolved against them.
+  for (const tz of root.getAllSubcomponents("vtimezone")) {
+    try {
+      const id = String(tz.getFirstPropertyValue("tzid") ?? "");
+      if (id && !ICAL.TimezoneService.has(id)) ICAL.TimezoneService.register(tz);
+    } catch {
+      /* an odd VTIMEZONE: its events fall back to Buenos Aires time */
+    }
+  }
+  const calColor = str(root.getFirstPropertyValue("x-apple-calendar-color"));
+  const masters = new Map<string, IEvent>();
+  const exceptions: IComponent[] = [];
+  const loose: IEvent[] = [];
+  for (const v of root.getAllSubcomponents("vevent")) {
+    if (String(v.getFirstPropertyValue("status") ?? "").toUpperCase() === "CANCELLED" && !v.hasProperty("recurrence-id")) continue;
+    if (v.hasProperty("recurrence-id")) {
+      exceptions.push(v);
+      continue;
+    }
+    const ev = new ICAL.Event(v);
+    const uid = ev.uid;
+    if (uid && !masters.has(uid)) masters.set(uid, ev);
+    else loose.push(ev);
+  }
+  for (const ex of exceptions) {
+    const uid = String(ex.getFirstPropertyValue("uid") ?? "");
+    const m = masters.get(uid);
+    if (m) {
+      try {
+        m.relateException(ex);
+      } catch {
+        /* exception for another series */
+      }
+    } else {
+      loose.push(new ICAL.Event(ex));
+    }
+  }
+  const all = [...masters.values(), ...loose];
+  const colors = new Map<IEvent, string | null>();
+  for (const ev of all) colors.set(ev, str(ev.component.getFirstPropertyValue("color")) ?? calColor);
+  return { masters: all, colors };
+}
+
+function str(v: unknown): string | null {
+  return typeof v === "string" && v.trim() ? v.trim() : null;
+}
+
+/**
+ * Epoch ms of an iCal time. UTC and registered zones convert exactly; floating
+ * times, dates and unknown zones are read as Buenos Aires local time.
+ */
+export function timeToMs(t: ITime): number {
+  const local = Date.UTC(t.year, t.month - 1, t.day, t.isDate ? 0 : t.hour, t.isDate ? 0 : t.minute, t.isDate ? 0 : t.second);
+  if (t.isDate) return local + AR_SHIFT_MS;
+  const tzid = t.zone?.tzid ?? "";
+  if (tzid === "UTC" || tzid === "Z") return local;
+  if (!tzid || tzid === "floating" || /Buenos_Aires|Argentina/i.test(tzid) || !ICAL.TimezoneService.has(tzid)) {
+    return local + AR_SHIFT_MS;
+  }
+  return t.toUnixTime() * 1000;
+}
+
+/** Every occurrence that overlaps [fromMs, toMs), sorted by start. */
+export function occurrences(cals: readonly Calendar[], fromMs: number, toMs: number): CalEvent[] {
+  const out: CalEvent[] = [];
+  for (const cal of cals) {
+    for (const ev of cal.masters) {
+      const color = cal.colors.get(ev) ?? null;
+      const title = (ev.summary || "(sin título)").trim();
+      try {
+        if (!ev.isRecurring()) {
+          push(out, title, color, ev.startDate, ev.endDate, fromMs, toMs, ev);
+          continue;
+        }
+        const it = ev.iterator();
+        for (let i = 0; i < MAX_STEPS; i++) {
+          const next = it.next();
+          if (!next) break;
+          if (timeToMs(next) >= toMs) break;
+          const d = ev.getOccurrenceDetails(next);
+          const item = d.item as IEvent;
+          if (String(item.component.getFirstPropertyValue("status") ?? "").toUpperCase() === "CANCELLED") continue;
+          push(out, (item.summary || title).trim(), color, d.startDate, d.endDate, fromMs, toMs, item);
+        }
+      } catch {
+        /* one bad event doesn't take the day down */
+      }
+    }
+  }
+  return out.sort((a, b) => a.start - b.start || a.end - b.end);
+}
+
+function push(out: CalEvent[], title: string, color: string | null, startT: ITime, endT: ITime | null, fromMs: number, toMs: number, ev: IEvent) {
+  // "Disponible" in Google: drawn, but it doesn't take the time.
+  const free = String(ev.component.getFirstPropertyValue("transp") ?? "").toUpperCase() === "TRANSPARENT";
+  const start = timeToMs(startT);
+  let end = endT ? timeToMs(endT) : start;
+  if (startT.isDate && end <= start) end = start + 86_400_000;
+  if (end < start) end = start;
+  if (end <= fromMs || start >= toMs) {
+    if (!(end === start && start >= fromMs && start < toMs)) return;
+  }
+  out.push({ title, start, end, allDay: startT.isDate, free, color });
+}
diff --git a/windows/src/views/atajos/card.ts b/windows/src/views/atajos/card.ts
new file mode 100644
index 0000000..a386578
--- /dev/null
+++ b/windows/src/views/atajos/card.ts
@@ -0,0 +1,249 @@
+// Atajos — the card a skill answers with: back button + name, a line Mochi
+// "says" (a live mini Mochi in the agent's colour), a body and its buttons.
+// Plus what several cards share: the error states and the proposal buttons.
+
+import { h, clear } from "../dom";
+import { pruneMiniBots } from "../../mochi/minibots";
+import { Bridge } from "../../core/bridge";
+import { Sound } from "../../core/sound";
+import type { ViewActions } from "../views";
+import { AGENTS, type Skill, type SkillId } from "./router";
+import { classifyError, rich, type CardError } from "./format";
+import { BACK_SVG, acts, btn, mochi, typing } from "./ui";
+import { NoCalendarError } from "./data";
+
+export const PLATA_URL = "https://plata-production.up.railway.app";
+
+export interface OpenOpts {
+  /** Send `pre` right away (it was said or typed in the launcher). Default true. */
+  send?: boolean;
+}
+
+/** What a card can ask of the launcher. */
+export interface CardHost {
+  actions: ViewActions;
+  open(id: SkillId, pre?: string | null, opts?: OpenOpts): void;
+  back(): void;
+  collapse(): void;
+  /** Bumped every time a card opens: a card checks it before painting late data. */
+  generation(): number;
+}
+
+export class Card {
+  readonly el: HTMLElement;
+  private saysP: HTMLElement;
+  private body: HTMLElement;
+  private bot: ReturnType<typeof mochi>;
+  private readonly gen: number;
+
+  constructor(
+    readonly host: CardHost,
+    readonly skill: Skill,
+    mount: HTMLElement,
+    title?: string,
+  ) {
+    this.gen = host.generation();
+    const agent = AGENTS[skill.agent];
+    this.bot = mochi(agent.color, 38);
+    this.saysP = h("p");
+    this.body = h("div", { class: "lz-rbody" });
+    const back = h("button", { type: "button", class: "lz-back", "aria-label": "Volver a los atajos", title: "Volver (Esc)", html: BACK_SVG });
+    back.addEventListener("click", () => host.back());
+    this.el = h(
+      "div",
+      { class: "lz-card" },
+      h(
+        "div",
+        { class: "lz-rhead" },
+        back,
+        h("span", { class: "lz-name", text: title ?? skill.name }),
+        h("span", { class: "lz-agent", text: `· ${agent.name}` }),
+        h("span", { class: "lz-rkeys" }, h("kbd", { text: "Esc" }), h("span", { text: "volver" })),
+      ),
+      h("div", { class: "lz-says" }, this.bot.el, this.saysP),
+      this.body,
+    );
+    this.el.style.setProperty("--rgb", agent.rgb);
+    clear(mount);
+    mount.append(this.el);
+    pruneMiniBots();
+  }
+
+  get actions(): ViewActions {
+    return this.host.actions;
+  }
+
+  /** Still the card on screen? Late answers for a card that's gone are dropped. */
+  alive(): boolean {
+    return this.gen === this.host.generation() && this.el.isConnected;
+  }
+
+  /** Mochi's line. `**x**` is bold; everything else is escaped. */
+  says(text: string): this {
+    // Sentences built from parts ("Cierre del martes. " + "cero tareas…") start in capitals.
+    const capped = text.replace(/(^|[.!?]\s+)(\*\*)?([a-záéíóúñ])/g, (_m, pre: string, bold: string | undefined, ch: string) => `${pre}${bold ?? ""}${ch.toUpperCase()}`);
+    this.saysP.innerHTML = rich(capped);
+    return this;
+  }
+
+  /** Replaces the body. */
+  set(...nodes: Array<Node | null | false | undefined>): this {
+    clear(this.body);
+    this.add(...nodes);
+    return this;
+  }
+
+  add(...nodes: Array<Node | null | false | undefined>): this {
+    for (const n of nodes) if (n) this.body.append(n);
+    return this;
+  }
+
+  /** "Un segundo…" + dots, Mochi thinking. */
+  loading(says: string): this {
+    this.says(says);
+    this.set(typing());
+    this.think(true);
+    return this;
+  }
+
+  think(on: boolean) {
+    this.bot.engine.setState(on ? "thinking" : "idle");
+  }
+
+  waiting(on: boolean) {
+    this.bot.engine.setState(on ? "approval" : "idle");
+  }
+
+  happy() {
+    this.bot.engine.setState("idle");
+    this.bot.engine.triggerEmote("happy");
+    Sound.play("approve");
+  }
+
+  /**
+   * The read failed: say why and offer the one button that can fix it —
+   * Configurar (Ajustes), Encender el agente, or Reintentar.
+   */
+  fail(err: unknown, what: string, retry: () => void) {
+    if (!this.alive()) return;
+    const e = err instanceof NoCalendarError ? { kind: "config" as const, text: "Falta la dirección iCal de tu calendario." } : classifyError(err, what);
+    this.think(false);
+    this.bot.engine.triggerEmote("annoyed");
+    Sound.play("error");
+    this.says(failLine(e, what));
+    this.set(errorBlock(e, this.host.actions, retry));
+  }
+}
+
+function failLine(e: CardError, what: string): string {
+  switch (e.kind) {
+    case "sesion":
+      return "El agente de Plata **no tiene sesión**.";
+    case "config":
+      return `Para leer ${what} me falta **configurar** algo.`;
+    case "apagado":
+      return "El agente de Plata **no responde**.";
+    default:
+      return `**No pude leer ${what}.**`;
+  }
+}
+
+/** The error's text and its fix, as a box. Also used for half-failed cards. */
+export function errorBlock(e: CardError, actions: ViewActions, retry: () => void): HTMLElement {
+  const fix =
+    e.kind === "config"
+      ? btn("Configurar", "prim", () => actions.openSettingsWindow(), { enter: true })
+      : e.kind === "apagado"
+        ? btn("Encender el agente", "prim", () => {
+            void Bridge.plataStart().then(
+              () => window.setTimeout(retry, 1500),
+              () => retry(),
+            );
+          }, { enter: true })
+        : btn("Reintentar", "prim", retry, { enter: true });
+  return h("div", { class: "lz-errbox" }, h("div", { class: "lz-err", text: e.text }), acts(fix));
+}
+
+/** A one-line error (inside a card that otherwise worked). */
+export function errLine(text: string): HTMLElement {
+  return h("div", { class: "lz-err", text });
+}
+
+/** A one-line, dim note. */
+export function note(text: string): HTMLElement {
+  return h("div", { class: "lz-note", text });
+}
+
+// ── Proposals: Aprobar / Rechazar through proposal_decide ───────────────────
+
+type Obj = Record<string, unknown>;
+
+/**
+ * Wires the Approve / Reject buttons of a proposal: disables them while it
+ * goes, then shows how it ended. `onApplied` runs when it was applied.
+ */
+export function decideButtons(
+  c: Card,
+  id: number,
+  prop: HTMLElement,
+  opts: { approveLabel?: string; onApplied?: () => void; extra?: HTMLElement[] } = {},
+): { foot: HTMLElement; approve: () => void; pending: () => boolean } {
+  const status = h("span", { class: "lz-pstatus" });
+  let done = false;
+  let busy = false;
+  const go = async (approve: boolean) => {
+    if (done || busy) return;
+    busy = true;
+    ok.disabled = true;
+    no.disabled = true;
+    status.className = "lz-pstatus";
+    status.textContent = approve ? "Aplicando…" : "Rechazando…";
+    try {
+      const raw = (await Bridge.proposalDecide(id, approve)) as Obj;
+      const estado = String(raw?.estado ?? "");
+      const mensaje = typeof raw?.mensaje === "string" ? raw.mensaje : "";
+      if (estado === "aplicada") {
+        done = true;
+        prop.classList.add("ok");
+        status.className = "lz-pstatus ok";
+        status.textContent = mensaje || "Listo, quedó registrado.";
+        c.happy();
+        opts.onApplied?.();
+      } else if (estado === "rechazada") {
+        done = true;
+        prop.classList.add("off");
+        status.textContent = "Rechazada. No se registró nada.";
+        c.waiting(false);
+      } else if (estado === "obsoleta") {
+        done = true;
+        prop.classList.add("off");
+        status.className = "lz-pstatus warn";
+        status.textContent = mensaje || "Esta propuesta ya no vale: los datos cambiaron.";
+        c.waiting(false);
+      } else {
+        status.className = "lz-pstatus bad";
+        status.textContent = mensaje || `No se pudo aplicar (${estado || "sin estado"}).`;
+        ok.disabled = false;
+        no.disabled = false;
+      }
+    } catch (err) {
+      const e = classifyError(err, "la respuesta del agente");
+      status.className = "lz-pstatus bad";
+      status.textContent = e.text;
+      ok.disabled = false;
+      no.disabled = false;
+      Sound.play("error");
+    } finally {
+      busy = false;
+      if (done) {
+        ok.remove();
+        no.remove();
+        for (const x of opts.extra ?? []) x.remove();
+      }
+    }
+  };
+  const ok = btn(opts.approveLabel ?? "Aprobar", "prim", () => void go(true), { enter: true });
+  const no = btn("Rechazar", "sec", () => void go(false));
+  const foot = h("div", { class: "lz-pfoot" }, ok, no, ...(opts.extra ?? []), status);
+  return { foot, approve: () => void go(true), pending: () => !done };
+}
diff --git a/windows/src/views/atajos/data.ts b/windows/src/views/atajos/data.ts
new file mode 100644
index 0000000..76dac55
--- /dev/null
+++ b/windows/src/views/atajos/data.ts
@@ -0,0 +1,95 @@
+// Atajos — where the cards' data comes from, with a short cache so the
+// launcher's group lines and the card opened right after share one request.
+// Nothing here makes up a value: a failed read rejects, and the card says so.
+
+import { Bridge, type CentroAccion, type QuickPlataKind } from "../../core/bridge";
+import { parseCalendars, occurrences, type Calendar } from "./calendar";
+import { parseFoco, type CalEvent, type Foco } from "./plan";
+
+interface Entry<T> {
+  at: number;
+  p: Promise<T>;
+}
+
+const cache = new Map<string, Entry<unknown>>();
+
+function cached<T>(key: string, ttlMs: number, load: () => Promise<T>, fresh = false): Promise<T> {
+  const hit = cache.get(key) as Entry<T> | undefined;
+  if (!fresh && hit && Date.now() - hit.at < ttlMs) return hit.p;
+  const p = load();
+  cache.set(key, { at: Date.now(), p });
+  // A failure isn't kept: the next card asks again.
+  p.catch(() => {
+    if (cache.get(key)?.p === p) cache.delete(key);
+  });
+  return p;
+}
+
+/** Plata's quick reads (contract §1). Money changes: 30 s. */
+export function plata(kind: QuickPlataKind, fresh = false): Promise<Record<string, unknown>> {
+  return cached(`plata:${kind}`, 30_000, async () => {
+    const raw = await Bridge.quickPlata(kind);
+    if (!raw || typeof raw !== "object" || Array.isArray(raw)) throw new Error("respuesta inesperada del agente");
+    const o = raw as unknown as Record<string, unknown>;
+    if (typeof o.error === "string") throw new Error(o.error);
+    return o;
+  }, fresh);
+}
+
+/** The Centro de Control's day (contract §2). */
+export function foco(fresh = false): Promise<Foco> {
+  return cached("foco", 60_000, async () => {
+    const raw = await Bridge.centroFoco();
+    const o = raw && typeof raw === "object" ? (raw as unknown as Record<string, unknown>) : null;
+    if (!o) throw new Error("respuesta inesperada del Centro de Control");
+    if (typeof o.error === "string") throw new Error(o.error);
+    return parseFoco(o);
+  }, fresh);
+}
+
+/**
+ * One write on the Centro de Control. Whatever happens, the cached day is
+ * dropped: the next card reads it again.
+ */
+export async function accion(nombre: CentroAccion, args: Record<string, unknown> = {}): Promise<Record<string, unknown>> {
+  try {
+    return await Bridge.centroAccion(nombre, args);
+  } finally {
+    cache.delete("foco");
+  }
+}
+
+/** Thrown when there is no iCal address saved: the card offers "Configurar". */
+export class NoCalendarError extends Error {
+  constructor() {
+    super("sin_config: no hay direcciones iCal guardadas");
+  }
+}
+
+export interface CalendarData {
+  cals: Calendar[];
+  /** Addresses that came back but didn't parse. */
+  failed: number;
+  /** Occurrences overlapping [fromMs, toMs). */
+  between(fromMs: number, toMs: number): CalEvent[];
+}
+
+/** Lucas's calendars (contract §3, calendar_ics), parsed once per 5 minutes. */
+export function calendar(fresh = false): Promise<CalendarData> {
+  return cached("ics", 5 * 60_000, async () => {
+    const texts = await Bridge.calendarIcs();
+    if (!Array.isArray(texts) || texts.length === 0) throw new NoCalendarError();
+    const { cals, failed } = parseCalendars(texts.map(String));
+    if (!cals.length) throw new Error("No pude leer ningún calendario: ¿la dirección iCal es la secreta?");
+    return { cals, failed, between: (a: number, b: number) => occurrences(cals, a, b) };
+  }, fresh);
+}
+
+/** Last known names of the people with debts, for the router's alternatives. */
+export function knownPersonas(): string[] {
+  return personas;
+}
+let personas: string[] = [];
+export function rememberPersonas(names: string[]) {
+  personas = names.filter(Boolean);
+}
