+#[cfg(windows)]
+/// Is Windows online speech recognition on? Voice typing (Win+H) needs it:
+/// HKCU\Software\Microsoft\Speech_OneCore\Settings\OnlineSpeechPrivacy, HasAccepted = 1.
+pub fn online_speech_on() -> bool {
+    use std::os::windows::process::CommandExt;
+    std::process::Command::new("reg")
+        .args(["query", r"HKCU\Software\Microsoft\Speech_OneCore\Settings\OnlineSpeechPrivacy", "/v", "HasAccepted"])
+        .creation_flags(0x0800_0000) // CREATE_NO_WINDOW
+        .output()
+        .map(|o| online_speech_accepted(&String::from_utf8_lossy(&o.stdout)))
+        .unwrap_or(false)
+}
+
+/// `reg query` output → HasAccepted is 1.
+fn online_speech_accepted(out: &str) -> bool {
+    out.lines()
+        .find(|l| l.trim_start().starts_with("HasAccepted"))
+        .and_then(|l| l.split_whitespace().last())
+        .is_some_and(|v| v.eq_ignore_ascii_case("0x1"))
+}
