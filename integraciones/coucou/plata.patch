+      // (delegar), so it would only spend API to land on this same error.
+      // Connecting is the same button as above; once it lands, this runs again.
+      const btn = ccButton("Conectar Claude Code", true, () => void connectClaude(), "Se abre el navegador para autorizar con tu cuenta de Claude");
+      box.append(btn);
+      afterLogin = { text, atts, box, btn };
+      row(box);
+      // The dots above learn about it now, not in a minute.
+      void refreshReady(true);
+      retryButtonSync();
+      return;
+    }
+    const toAgent = ccButton(
+      "Mandárselo a Plata",
+      false,
+      () => {
+        toAgent.disabled = true;
+        void submit(text, { atts, toAgent: true, retry: true });
+      },
+      "Lo hace el agente de Plata, con la API (cuesta plata)",
+    );
+    box.append(toAgent);
+    row(box);
+  }
+
+  /**
+   * Reconciles with Claude Code instead of the agent. `bubble`: false when the
+   * message is already on screen (the agent's suggestion reusing it).
+   */
+  async function delegate(text: string, atts: Attachment[], opts: { bubble?: boolean } = {}) {
+    if (ccRun) {
+      note("Ya estoy conciliando con Claude Code: esperá que termine o cancelalo.", "plata-error");
+      pending = [...atts, ...pending];
+      renderAttachments();
+      return;
+    }
+    lastAtts = { text, atts };
+    retireActionChips();
+    if (opts.bubble !== false) {
+      reportMessage("plata", text.trim() || DEFAULT_ASK, true);
+      const bubble = h("div", { class: "bubble", text: text.trim() || DEFAULT_ASK });
+      bubble.append(h("div", { class: "plata-bubble-atts", text: atts.map(attachmentLabel).join(" · ") }));
+      row(bubble, "chat-row user");
+    }
+    const step = h("span", { class: "plata-cc-step-text", text: "Arrancando Claude Code…" });
+    const time = h("span", { class: "plata-cc-time", text: "0 s" });
+    const cancel = h("button", { type: "button", class: "plata-link plata-cc-cancel", text: "Cancelar", title: "Cortar la conciliación" });
+    const box = h(
+      "div",
+      { class: "plata-cc-run" },
+      h(
+        "div",
+        { class: "plata-cc-run-head" },
+        svg(ICONS.terminal, 12, { stroke: 2 }),
+        h("span", { text: "Lo hago con Claude Code · incluido en tu plan" }),
+      ),
+      h("div", { class: "plata-cc-step", role: "status", "aria-live": "polite" }, h("i", { class: "plata-cc-pulse" }), step, time),
+      cancel,
+    );
+    row(box, "chat-row plata-cc-run-row");
+    const sesion = sesionId;
+    const started = Date.now();
+    const timer = window.setInterval(() => {
+      time.textContent = fmtSecs((Date.now() - started) / 1000);
+    }, 1000);
+    ccRun = { sesion, step, box, timer, started, text, atts };
+    cancel.addEventListener("click", () => {
+      (cancel as HTMLButtonElement).disabled = true;
+      step.textContent = "Cancelando…";
+      void Bridge.plataDelegateCancel(sesion);
+    });
+    Sound.play("send");
+    busy();
+    const files = atts.filter((a): a is FileAttachment => a.kind === "file").map((a) => a.path);
+    const pasted = atts.filter((a): a is TextAttachment => a.kind === "text").map((a) => a.text);
+    try {
+      await Bridge.plataDelegate(sesion, text.trim(), files, pasted.length ? pasted.join("\n\n") : null);
+    } catch (e) {
+      // It never started, so no event will come.
+      endRun();
+      box.remove();
+      ccFailed(`No pude arrancar Claude Code: ${errText(e)}`, text, atts);
+      Sound.play("error");
+    }
+  }
+
+  function endRun() {
+    if (!ccRun) return;
+    window.clearInterval(ccRun.timer);
+    ccRun = null;
+    busy();
+    sync();
+  }
+
+  function onDelegado(ev: Delegado) {
+    const run = ccRun;
+    if (!run) return;
+    if (ev.tipo === "progreso") {
+      run.step.textContent = `${ev.texto}…`;
+      return;
+    }
+    const { box, text, atts, started } = run;
+    endRun();
+    if (ev.tipo === "error") {
+      box.remove();
+      if (ev.cancelado) {
+        note("Cancelaste la conciliación.");
+      } else {
+        ccFailed(ev.texto, text, atts, ev.login === true);
+        Sound.play("error");
+      }
+      return;
+    }
+    // fin: the line stays, as the record of what ran and how long it took.
+    ccNeedsLogin = false;
+    clear(box);
+    box.classList.add("done");
+    box.append(
+      h(
+        "div",
+        { class: "plata-cc-run-head" },
+        svg(ICONS.check, 12, { stroke: 2.2 }),
+        h("span", { text: `Claude Code · ${fmtSecs(ev.segundos ?? (Date.now() - started) / 1000)} · incluido en tu plan` }),
+      ),
+    );
+    const datos = ev.datos ? obj(ev.datos) : null;
+    if (datos && typeof datos.error === "string") {
+      row(h("div", { class: "plata-error", text: `No pude conciliar: ${datos.error}` }));
+      Sound.play("error");
+    } else if (datos) {
+      // The next message to the agent carries it, so "fix it" just works.
+      const contexto = conciliacionContexto(datos);
+      pendingConc = contexto;
+      row(
+        conciliacionCard(datos, ev.informe, {
+          openReport: (p) => {
+            Bridge.plataOpenReport(p).catch((e) => note(errText(e), "plata-error"));
+          },
+          copy: (msg, btn) => void copyText(msg, btn),
+          load: (msg) => void submit(msg),
+          fix: () => void submit(pedidoCorregir(datos), { contexto }),
+        }),
+        "chat-row plata-prop-row",
+      );
+      Sound.play("finish");
+    } else {
+      // No datos.json: Claude Code answered something else (a question, a problem).
+      if (ev.mensaje) {
+        row(h("div", { class: "reply", text: plain(ev.mensaje) }));
+        reportMessage("plata", ev.mensaje, false);
+      }
+      else note("Claude Code terminó sin dejar el resultado.", "plata-error");
+      const informe = ev.informe;
+      if (informe) {
+        row(
+          h(
+            "div",
+            { class: "plata-actions" },
+            ccButton("Abrir informe", true, () => {
+              Bridge.plataOpenReport(informe).catch((e) => note(errText(e), "plata-error"));
+            }),
+          ),
+        );
+      }
+      Sound.play(ev.ok ? "finish" : "error");
+    }
+  }
+
+  async function copyText(msg: string, btn: HTMLButtonElement) {
+    const label = btn.querySelector("span");
+    try {
+      await navigator.clipboard.writeText(msg);
+      if (label) {
+        label.textContent = "Copiado";
+        window.setTimeout(() => (label.textContent = "Copiar faltantes"), 1500);
+      }
+    } catch {
+      // No clipboard: the text on screen, to select by hand.
+      note(msg);
+    }
+  }
+
+  /** The agent says this is a job for Claude Code: offer it, one click away. */
+  function delegateSuggestion(tarea: string, detalle: string) {
+    const actions = h("div", { class: "plata-actions" });
+    const decide = (ok: boolean) => {
+      clear(actions);
+      actions.append(h("span", { class: "plata-decided", text: ok ? "Se lo paso a Claude Code" : "Sigue con Plata" }));
+      if (!ok) return;
+      if (tarea !== "conciliar_resumen" && tarea !== "conciliar_extracto") {
+        // Anything else is a change to the app: the same as the terminal button.
+        Bridge.openClaudeCode(detalle)
+          .then((repo) => note(`Se lo pasé a Claude Code en ${repo || "el repo de Plata"}: se abrió una terminal.`))
+          .catch((e) => note(errText(e), "plata-error"));
+        return;
+      }
+      if (ccNeedsLogin) {
+        // Connect first; the reconciliation follows by itself.
+        if (lastAtts?.atts.length) afterLogin = { text: lastAtts.text, atts: lastAtts.atts, box: null, btn: null };
+        note("Primero hay que conectar Claude Code: autorizá en el navegador que se abre y sigo solo.");
+        void connectClaude();
+      } else if (lastAtts?.atts.length) {
+        void delegate(lastAtts.text, lastAtts.atts, { bubble: false });
+      } else {
+        note(`Soltá ${tarea === "conciliar_extracto" ? "el extracto de la cuenta" : "el resumen"} o pegalo acá: lo hago con Claude Code.`);
+        input.focus();
+      }
+    };
+    actions.append(ccButton("Hacerlo", true, () => decide(true)), ccButton("No", false, () => decide(false)));
+    row(
+      h(
+        "div",
+        { class: "plata-prop plata-cc-suggest" },
+        h("div", { class: "plata-prop-head" }, h("span", { class: "plata-prop-kind", text: "Sugerencia" })),
+        h("div", {
+          class: "plata-prop-body",
+          text: `Plata sugiere hacerlo con Claude Code (incluido en tu plan)${detalle ? `: ${plain(detalle)}` : "."}`,
+        }),
+        actions,
+      ),
+      "chat-row plata-prop-row",
+    );
+  }
+
+  /**
+   * The agent isn't listening. Coucou starts it at launch, so this is a crash or
+   * a launch that is still warming up: start it (a no-op if it's already
+   * starting), wait for it, and resend the message. The button only shows up
+   * if that fails.
+   */
+  async function agentDown(retryText: string, atts: Attachment[]) {
+    if (!status?.dir) {
+      note("El agente de Plata está apagado y no encuentro la carpeta agentes. Prendelo con `npm run servir`.", "plata-error");
+      return;
+    }
+    const line = h("div", { class: "plata-note", text: "El agente estaba apagado: lo estoy prendiendo…" });
+    row(line);
+    State.stateOverride = "thinking";
+    State.notify();
+    const up = await startAndWait();
+    State.stateOverride = null;
+    State.notify();
+    if (up) {
+      line.textContent = "Agente prendido. La primera respuesta tarda un poco más.";
+      void submit(retryText, { retry: true, atts, toAgent: true });
+      return;
+    }
+    line.remove();
+    const box = h(
+      "div",
+      { class: "plata-error" },
+      h("span", { text: "No pude prender el agente (mirá %LOCALAPPDATA%\\Coucou\\plata-agent.log)." }),
+    );
+    const btn = h("button", { class: "btn primary plata-btn" }, h("span", { text: "Reintentar" }));
+    btn.addEventListener("click", () => {
+      box.remove();
+      void agentDown(retryText, atts);
+    });
+    box.append(btn);
+    row(box);
+  }
+
+  /** Starts `npm run servir` if needed and waits up to a minute for it to listen. */
+  async function startAndWait(): Promise<boolean> {
+    try {
+      await Bridge.plataStart();
+    } catch (e) {
+      note(String(e).replace(/^Error:\s*/, ""), "plata-error");
+      return false;
+    }
+    // `npm run servir` checks the session before listening: give it time.
+    for (let i = 0; i < 40; i++) {
+      await new Promise((r) => setTimeout(r, 1500));
+      if ((await refreshStatus()).up) return true;
+    }
+    return false;
+  }
+
+  /**
+   * Sends one message. `atts` are the attachments taken for it: only the field
+   * (Enter / send) takes them, so an Approve click never carries pending chips.
+   */
+  async function submit(
+    text: string,
+    opts: { retry?: boolean; atts?: Attachment[]; toAgent?: boolean; contexto?: string } = {},
+  ) {
+    const atts = opts.atts ?? [];
+    // A statement to reconcile goes to Claude Code (Lucas's plan), not the API.
+    if (atts.length && !opts.toAgent) {
+      void delegate(text, atts);
+      return;
+    }
+    const query = text.trim() || (atts.length ? DEFAULT_ASK : "");
+    if (!query || sending) return;
+    if (atts.length) lastAtts = { text, atts };
+    // Sent to the agent after Claude Code could not: it must not hand it back.
+    let forAgent = opts.toAgent ? `${NO_DELEGAR} ${query}` : query;
+    // A reconciliation the agent has not seen rides on this message, once.
+    // The bubble shows only what Lucas wrote.
+    const contexto = opts.contexto ?? pendingConc;
+    if (contexto && !forAgent.includes(CONC_HEAD)) forAgent = `${contexto}\n\n${forAgent}`;
+    pendingConc = null;
+    const texto = composeText(forAgent, atts);
+    if (texto.length > MAX_TEXT) {
+      note(
+        `Lo pegado es demasiado largo para el agente (${ars0.format(texto.length)} caracteres; hasta ${ars0.format(MAX_TEXT)}). ` +
+          "Pegá solo la parte de los consumos.",
+        "plata-error",
+      );
+      pending = [...atts, ...pending];
+      renderAttachments();
+      return;
+    }
+    const files = atts.filter((a): a is FileAttachment => a.kind === "file").map((a) => a.path);
+    sending = true;
+    lastText = query;
+    replyEl = null;
+    turnReply = null;
+    toolsEl = null;
+    toolsSeen = [];
+    retireActionChips();
+    if (!opts.retry) {
+      reportMessage("plata", query, true);
+      const bubble = h("div", { class: "bubble", text: query });
+      if (atts.length) bubble.append(h("div", { class: "plata-bubble-atts", text: atts.map(attachmentLabel).join(" · ") }));
+      row(bubble, "chat-row user");
+    }
+    Sound.play("send");
+    busy();
+    typing(true);
+    try {
+      await Bridge.plataSend(texto, sesionId, files);
+      Sound.play("finish");
+    } catch (err) {
+      const msg = String(err).replace(/^Error:\s*/, "");
+      typing(false);
+      if (msg === "agent_down") {
+        await refreshStatus();
+        // After `finally` has released the chat, so the resend can go through.
+        window.setTimeout(() => void agentDown(query, atts), 0);
+      } else {
+        note(msg, "plata-error");
+      }
+      Sound.play("error");
+    } finally {
+      sending = false;
+      typing(false);
+      busy();
+      input.disabled = false;
+      input.focus();
+    }
+  }
+
+  void onEvent<{ sesionId: string; ev: Evento }>("plata-event", (p) => {
+    if (p.sesionId === sesionId) onEvento(p.ev);
+  });
+  void onEvent<{ sesionId: string; ev: Delegado }>("plata-delegado", (p) => {
+    if (ccRun && p.sesionId === ccRun.sesion) onDelegado(p.ev);
+  });
+  void onEvent<PlataReadiness>("plata-readiness", applyReady);
+  void onEvent<PlataLoginEvent>("plata-login", onLogin);
+  renderReady();
+  // The check Coucou runs at launch arrives as `plata-readiness`; this covers
+  // a page that loaded after it was sent.
+  window.setTimeout(() => {
+    if (!readiness) void refreshReady();
+  }, 2500);
+
+  const sendFromField = () => {
+    if (sending) return;
+    // While Claude Code reconciles, questions still go to the agent; another statement waits.
+    if (ccRun && pending.length) {
+      note("Ya estoy conciliando con Claude Code: esperá que termine o cancelalo.");
+      return;
+    }
+    const text = input.value;
+    if (!text.trim() && !pending.length) return;
+    input.value = "";
+    autosize();
+    void submit(text, { atts: takeAttachments() });
+  };
+  send.addEventListener("click", sendFromField);
+  input.addEventListener("paste", (e) => {
+    const text = (e as ClipboardEvent).clipboardData?.getData("text/plain") ?? "";
+    if (text.length <= PASTE_AS_ATTACHMENT) return;
+    // A whole statement doesn't fit a one-line field: it becomes a chip.
+    e.preventDefault();
+    const clean = text.replace(/\r\n?/g, "\n").trim();
+    pending.push({ kind: "text", text: clean, lines: clean.split("\n").filter((l) => l.trim()).length });
+    renderAttachments();
+  });
+  input.addEventListener("keydown", (e) => {
+    const k = e as KeyboardEvent;
+    // Enter sends; Shift+Enter (the textarea's default) adds a line. Not while an
+    // IME composes, so an accented letter never sends half a word.
+    if (k.key === "Enter" && !k.shiftKey && !k.isComposing) {
+      e.preventDefault();
+      sendFromField();
+    }
+    e.stopPropagation(); // Escape closes the island, not the chat
+  });
+  mic.addEventListener("click", async () => {
+    input.focus();
+    try {
+      await Bridge.startDictation();
+    } catch (e) {
+      if (!String(e).includes("sin_voz_en_linea")) {
+        note(errText(e), "plata-error");
+        return;
+      }
+      // Windows voice typing (Win+H) needs online speech recognition, which is off.
+      const box = h(
+        "div",
+        { class: "plata-error plata-cc-error" },
+        h("span", {
+          text:
+            "El dictado de Windows necesita el «Reconocimiento de voz en línea», que está apagado. " +
+            "Activalo en la página que se abre y volvé a tocar el micrófono.",
+        }),
+      );
+      box.append(
+        ccButton("Activar voz en línea", true, () => {
+          void Bridge.openSpeechSettings();
+        }),
+        ccButton("Probar igual", false, () => {
+          input.focus();
+          void Bridge.startDictation(true).catch(() => {});
+        }),
+      );
+      row(box);
+    }
+  });
+  toCode.addEventListener("click", async () => {
+    const pedido = input.value.trim();
+    if (!pedido) {
+      note("Escribí qué querés cambiar en la app y tocá este botón: se lo paso a Claude Code.");
+      return;
+    }
+    input.value = "";
+    autosize();
+    retireActionChips();
+    reportMessage("plata", `→ Claude Code: ${pedido}`, true);
+    row(h("div", { class: "bubble", text: `→ Claude Code: ${pedido}` }), "chat-row user");
+    try {
+      const repo = await Bridge.openClaudeCode(pedido);
+      note(
+        `Se lo pasé a Claude Code en ${repo || "el repo de Plata"}: se abrió una terminal. ` +
+          "Los permisos te los pide acá, en la isla, y el deploy lo ves en la pill de Railway.",
+      );
+      Sound.play("send");
+    } catch (e) {
+      note(String(e).replace(/^Error:\s*/, ""), "plata-error");
+    }
+  });
+  function reset() {
+    if (sending || ccRun) return;
+    sesionId = newSession();
+    lastText = "";
+    lastAtts = null;
+    pendingConc = null;
+    pending = [];
+    turnReply = null;
+    waiting.clear();
+    renderAttachments();
+    clear(log);
+    note("Conversación nueva.");
+    reportChat("plata", { last: "", mine: false, at: null, waiting: 0 });
+    input.focus();
+  }
+  resetBtn.addEventListener("click", reset);
+  registerReset("plata", reset);
+
+  note("Preguntale por tus saldos, gastos o deudas, o pedile que registre algo. Lo que cambie datos te lo muestra antes, para que lo apruebes. Para cambios en la app, escribilos y tocá el botón de la terminal. Para revisar un resumen de tarjeta o el extracto de tu cuenta, soltá acá el PDF o la captura, o pegá el texto: lo hace Claude Code, incluido en tu plan.");
+
+  function sync() {
+    input.disabled = sending;
+    input.placeholder = placeholder();
+  }
+
+  return {
+    el,
+    sync,
+    dropFiles(paths: string[]) {
+      void addFiles(paths);
+    },
+    dragHover(on: boolean) {
+      card.classList.toggle("plata-drop-over", on);
+    },
+    focus() {
+      void refreshStatus();
+      void refreshReady();
+      input.focus();
+    },
+  };
+}
