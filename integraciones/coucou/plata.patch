+// ── Registrar gasto ─────────────────────────────────────────────────────────
+
+function qin(input: HTMLInputElement | HTMLTextAreaElement, mic = true): HTMLElement {
+  return h(
+    "label",
+    { class: "lz-qin" },
+    input,
+    mic ? h("span", { class: "lz-mic" }, h("kbd", { text: "Win" }), " ", h("kbd", { text: "H" }), " dictar") : null,
+  );
+}
+
+function cuando(fecha: string): string {
+  if (!fecha) return "Hoy";
+  const date = fecha.slice(0, 10);
+  const hora = fecha.includes("T") ? horaDe(fecha) : "";
+  const today = arClock().date;
+  const dia = date === today ? "Hoy" : /^\d{4}-\d{2}-\d{2}$/.test(date) ? fechaCorta(date) : fecha;
+  return hora ? `${dia} ${hora}` : dia;
+}
+
+function gasto(c: Card, pre: string | null, opts: OpenOpts) {
+  c.says("Decime cuánto y en qué. Si falta algo, lo completo con lo que usás siempre.");
+  const input = h("input", {
+    type: "text",
+    placeholder: "Ej: 12500 en el súper con débito",
+    "aria-label": "Gasto",
+    autocomplete: "off",
+    spellcheck: "false",
+  }) as HTMLInputElement;
+  input.value = pre ?? "";
+  const out = h("div");
+  c.set(qin(input), out);
+  let pending: { id: number; text: string; approve: () => void; isPending: () => boolean } | null = null;
+  let seq = 0;
+
+  /** A proposal on screen that the text no longer matches is dropped (rejected). */
+  const dropPending = () => {
+    if (pending?.isPending()) void Bridge.proposalDecide(pending.id, false).catch(() => {});
+    pending = null;
+  };
+
+  const propose = async () => {
+    const texto = input.value.trim();
+    if (!texto) {
+      input.focus();
+      return;
+    }
+    dropPending();
+    const my = ++seq;
+    clear(out);
+    out.append(typing());
+    c.think(true);
+    const t0 = performance.now();
+    try {
+      const r = obj(await Bridge.quickGasto(texto));
+      if (!c.alive() || my !== seq) return;
+      c.think(false);
+      clear(out);
+      if (r.estado === "falta") {
+        out.append(h("div", { class: "lz-sub lz-falta", text: str(r.mensaje) || `Me falta ${str(r.falta) || "un dato"}. Probá "12500 super".` }));
+        input.focus();
+        return;
+      }
+      const p = obj(r.propuesta);
+      const id = num(p.id);
+      const campos = obj(p.campos);
+      const monto = num(campos.monto);
+      if (r.estado !== "propuesta" || id === null || monto === null) {
+        out.append(errLine(typeof r.error === "string" ? `No pude armar el gasto: ${r.error}` : "No pude armar el gasto: la respuesta vino incompleta."));
+        return;
+      }
+      const moneda = str(campos.moneda) || "ARS";
+      const metodo = str(campos.metodo);
+      const desc = str(campos.descripcion);
+      const tarjeta = str(campos.tarjeta);
+      const prop = h("div", { class: "lz-prop" });
+      const edit = btn("Cambiar algo", "sec", () => {
+        input.focus();
+        input.setSelectionRange(input.value.length, input.value.length);
+      });
+      const d = decideButtons(c, id, prop, {
+        approveLabel: "Registrar",
+        extra: [edit],
+        onApplied: () => window.setTimeout(() => c.alive() && c.host.collapse(), 1600),
+      });
+      prop.append(
+        h(
+          "div",
+          { class: "lz-fields" },
+          field("Gasto", money(monto, moneda), true),
+          campos.categoria ? field("Categoría", str(campos.categoria)) : null,
+          metodo ? field("Medio", metodo) : null,
+          field("Cuándo", cuando(str(campos.fecha))),
+          desc ? field("Descripción", desc) : null,
+          tarjeta ? field("Tarjeta", tarjeta) : null,
+        ),
+        /cr[eé]dito/i.test(metodo)
+          ? h("span", { class: "lz-sub", text: `Entra al resumen${tarjeta ? ` de ${tarjeta}` : " de la tarjeta"}: no baja tu saldo hasta que lo pagues.` })
+          : "",
+        p.texto ? h("span", { class: "lz-sub", text: str(p.texto) }) : "",
+        d.foot,
+      );
+      d.foot.append(h("span", { class: "lz-cost", text: `armado en ${((performance.now() - t0) / 1000).toFixed(1).replace(".", ",")} s · sin IA` }));
+      out.append(prop);
+      pending = { id, text: texto, approve: d.approve, isPending: d.pending };
+      c.waiting(true);
+      Sound.play("finish");
+    } catch (err) {
+      if (!c.alive() || my !== seq) return;
+      c.think(false);
+      clear(out);
+      const e = classifyError(err, "el gasto");
+      out.append(errorBlock(e, c.actions, () => void propose()));
+    }
+  };
+
+  input.addEventListener("keydown", (e) => {
+    if (e.key !== "Enter" || e.isComposing) return;
+    e.preventDefault();
+    if (pending?.isPending() && pending.text === input.value.trim()) pending.approve();
+    else void propose();
+  });
+  input.addEventListener("input", () => {
+    if (pending && pending.text !== input.value.trim()) {
+      dropPending();
+      clear(out);
+      c.waiting(false);
+    }
+  });
+  window.setTimeout(() => {
+    if (!c.alive()) return;
+    input.focus();
+    if (pre) input.setSelectionRange(input.value.length, input.value.length);
+  }, 150);
+  if (pre && opts.send !== false) void propose();
+}
+
+// ── Contar una situación ────────────────────────────────────────────────────
+
+type Evento =
+  | { tipo: "texto"; texto: string }
+  | { tipo: "tool"; nombre: string }
+  | { tipo: "aviso"; texto: string }
+  | { tipo: "propuesta"; propuesta: Obj }
+  | { tipo: "error"; texto: string }
+  | { tipo: "resultado"; nombre: string }
+  | { tipo: "fin"; usos?: Array<{ usd?: number; precio_conocido?: boolean }>; duracionMs?: number }
+  | { tipo: "delegar"; tarea: string; detalle: string };
+
+/** One listener for the agent's stream; each "Contar una situación" card subscribes by session. */
+const sessions = new Map<string, (ev: Evento) => void>();
+let listening = false;
+function subscribe(sesion: string, fn: (ev: Evento) => void): () => void {
+  if (!listening) {
+    listening = true;
+    void onEvent<{ sesionId: string; ev: Evento }>("plata-event", (p) => sessions.get(p.sesionId)?.(p.ev));
+  }
+  sessions.set(sesion, fn);
+  return () => sessions.delete(sesion);
+}
+
+const usdCost = new Intl.NumberFormat("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 3 });
+
+function situacion(c: Card, pre: string | null, opts: OpenOpts) {
+  c.says("Contame qué pasó. Yo armo todos los movimientos y te los muestro antes de registrar nada.");
+  const ta = h("textarea", {
+    rows: "2",
+    placeholder: "Ej: cena con Branko, pagué 48.000 con la de crédito y me debe la mitad",
+    "aria-label": "Situación",
+    spellcheck: "false",
+  }) as HTMLTextAreaElement;
+  ta.value = pre ?? "";
+  const out = h("div", { class: "lz-sit" });
+  const wrap = qin(ta);
+  wrap.classList.add("tall");
+  c.set(wrap, out);
+
+  const sesion = `isla-atajo-${crypto.randomUUID()}`;
+  let sending = false;
+  let reply: HTMLElement | null = null;
+  let tools: HTMLElement | null = null;
+  const proposals: Array<{ approve: () => void; pending: () => boolean }> = [];
+  const t0 = { at: 0 };
+
+  const unsub = subscribe(sesion, (ev) => {
+    if (!c.alive()) {
+      unsub();
+      return;
+    }
+    out.querySelector(".lz-typing")?.remove();
+    switch (ev.tipo) {
+      case "texto": {
+        tools?.remove();
+        tools = null;
+        if (!reply) {
+          reply = h("div", { class: "lz-reply md" });
+          out.append(reply);
+        }
+        const md = `${reply.dataset.raw ? `${reply.dataset.raw}\n\n` : ""}${ev.texto}`;
+        reply.dataset.raw = md;
+        clear(reply);
+        reply.append(renderMarkdown(md));
+        break;
+      }
+      case "tool":
+        if (!tools) {
+          tools = h("div", { class: "lz-note" });
+          out.append(tools);
+        }
+        tools.textContent = `Consultando: ${ev.nombre.replace(/^mcp__[^_]+__/, "").replace(/_/g, " ")}`;
+        break;
+      case "aviso":
+        out.append(note(ev.texto));
+        break;
+      case "propuesta":
+        tools?.remove();
+        tools = null;
+        reply = null;
+        out.append(proposalCard(ev.propuesta));
+        c.waiting(true);
+        Sound.play("finish");
+        break;
+      case "error":
+        out.append(errLine(classifyError(ev.texto, "la respuesta del agente").kind === "sesion" ? "El agente de Plata no tiene sesión: corré npm run login en agentes." : ev.texto));
+        break;
+      case "delegar":
+        out.append(
+          h(
+            "div",
+            { class: "lz-errbox" },
+            note(`Esto lo hace Claude Code: ${ev.tarea}. Abrí la pestaña Plata y soltá el archivo (o usá el clip).`),
+            acts(btn("Abrir Plata", "sec", () => c.actions.setView("plata"))),
+          ),
+        );
+        break;
+      case "fin": {
+        const usos = ev.usos ?? [];
+        const total = usos.reduce((a, u) => a + (u.usd ?? 0), 0);
+        const known = usos.every((u) => u.precio_conocido !== false);
+        const secs = Math.round((ev.duracionMs ?? performance.now() - t0.at) / 1000);
+        out.append(h("div", { class: "lz-cost lz-cost-line", text: `${known ? `US$ ${usdCost.format(total)}` : "costo sin precio"} · ${secs} s` }));
+        break;
+      }
+      default:
+        break;
+    }
+    if (sending) out.append(typing());
+  });
+
+  function proposalCard(p: Obj): HTMLElement {
+    const id = num(p.id);
+    const resumen = str(p.resumen) || str(p.tipo) || "Propuesta";
+    const monto = num(p.monto_ars);
+    const prop = h("div", { class: "lz-prop" });
+    const lines = resumen.split(/\n+/).map((l) => l.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, "").replace(/\*\*(.+?)\*\*/g, "$1").trim()).filter(Boolean);
+    if (lines.length > 1) {
+      lines.forEach((l, i) => prop.append(h("div", { class: "lz-step" }, h("i", { text: String(i + 1) }), h("div", { text: l }))));
+    } else {
+      prop.append(h("div", { class: "lz-ptext", text: lines[0] ?? resumen }));
+    }
+    if (monto !== null) prop.append(h("div", { class: "lz-fields" }, field("Monto", ars(monto), true)));
+    if (p.motivo_confirmacion) prop.append(h("span", { class: "lz-sub", text: str(p.motivo_confirmacion) }));
+    if (id === null) {
+      prop.append(errLine("La propuesta vino sin número: aprobala desde la pestaña Plata."));
+      return prop;
+    }
+    const d = decideButtons(c, id, prop, {
+      approveLabel: "Aprobar",
+      onApplied: () => {
+        if (!proposals.some((x) => x.pending())) window.setTimeout(() => c.alive() && c.host.collapse(), 1800);
+      },
+    });
+    proposals.push({ approve: d.approve, pending: d.pending });
+    d.foot.prepend(h("span", { class: "lz-pid", text: `#${id}` }));
+    prop.append(d.foot);
+    return prop;
+  }
+
+  async function send() {
+    const texto = ta.value.trim();
+    if (!texto || sending) return;
+    sending = true;
+    t0.at = performance.now();
+    reply = null;
+    tools = null;
+    clear(out);
+    out.append(h("div", { class: "lz-said", text: `“${texto}”` }), typing());
+    ta.value = "";
+    ta.placeholder = "Respondele o corregí algo…";
+    c.think(true);
+    try {
+      await Bridge.plataSend(texto, sesion, []);
+    } catch (err) {
+      if (!c.alive()) return;
+      out.querySelector(".lz-typing")?.remove();
+      const e = classifyError(err, "la respuesta del agente");
+      out.append(errorBlock(e, c.actions, () => {
+        ta.value = texto;
+        void send();
+      }));
+      Sound.play("error");
+    } finally {
+      sending = false;
+      if (c.alive()) {
+        out.querySelector(".lz-typing")?.remove();
+        c.think(false);
+        if (proposals.some((x) => x.pending())) c.waiting(true);
+        ta.focus();
+      }
+    }
+  }
+
+  ta.addEventListener("keydown", (e) => {
+    if (e.key !== "Enter" || e.shiftKey || e.isComposing) return;
+    e.preventDefault();
+    if (!ta.value.trim()) {
+      proposals.find((x) => x.pending())?.approve();
+      return;
+    }
+    void send();
+  });
+  window.setTimeout(() => {
+    if (!c.alive()) return;
+    ta.focus();
+    ta.setSelectionRange(ta.value.length, ta.value.length);
+  }, 150);
+  if (pre && opts.send !== false) void send();
+}
+
+// ── Conciliar un resumen ────────────────────────────────────────────────────
+
+function conciliar(c: Card) {
+  c.says("Soltá el PDF del resumen o del extracto en la pestaña Plata. Lo concilia Claude Code con tu plan, **sin costo de API**, en un minuto más o menos.");
+  c.set(
+    h(
+      "div",
+      { class: "lz-drop" },
+      h("span", { html: ICON.doc }),
+      h("b", { text: "Abrí la pestaña Plata y soltá ahí el PDF o la captura" }),
+      h("span", { text: "o tocá el clip para elegirlo · también podés pegar el texto del resumen" }),
+    ),
+    acts(btn("Abrir la pestaña Plata", "prim", () => c.actions.setView("plata"), { enter: true })),
+  );
+}
+
+export const PLATA_RUN: Record<"gasto" | "situacion" | "saldo" | "mes" | "resumenes" | "deuda" | "dolar" | "conciliar", Runner> = {
+  saldo: (c) => saldo(c),
+  mes: (c) => mes(c),
+  resumenes: (c) => resumenes(c),
+  deuda: (c) => deuda(c),
+  dolar: (c) => dolar(c),
+  gasto,
+  situacion,
+  conciliar: (c) => conciliar(c),
+};
