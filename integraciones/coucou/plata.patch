+
+/// The newest Claude Code the desktop app ships (%APPDATA%\Claude\claude-code\<version>\claude.exe).
+fn claude_exe() -> Option<PathBuf> {
+    let base = PathBuf::from(std::env::var_os("APPDATA")?).join("Claude").join("claude-code");
+    std::fs::read_dir(base)
+        .ok()?
+        .flatten()
+        .filter_map(|e| {
+            let exe = e.path().join("claude.exe");
+            let version: Vec<u64> = e.file_name().to_string_lossy().split('.').map(|n| n.parse().unwrap_or(0)).collect();
+            exe.is_file().then_some((version, exe))
+        })
+        .max_by(|a, b| a.0.cmp(&b.0))
+        .map(|(_, exe)| exe)
+}
+
+/// Opens a terminal in the Plata repo with Claude Code working on `pedido`.
+/// The session shows up in the island through the hooks, and its permission
+/// requests are answered there. Returns the folder it opened in.
+pub fn open_claude_code(pedido: &str) -> Result<String, String> {
+    let repo = plata_repo_dir().ok_or_else(|| "No encuentro el repo de Plata (finanzas-app).".to_string())?;
+    let exe = claude_exe().ok_or_else(|| "No encuentro Claude Code (viene con la app de escritorio de Claude).".to_string())?;
+
+    // The request travels in a file: a prompt on the command line would have to
+    // survive the quoting of wt, PowerShell and the shell, and `;` splits wt tabs.
+    let dir = crate::settings::local_dir().join("pedidos");
+    std::fs::create_dir_all(&dir).map_err(|e| e.to_string())?;
+    let stamp = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0);
+    let file = dir.join(format!("pedido-{stamp}.txt"));
+    let prompt = format!(
+        "Pedido que Lucas mandó desde la isla de Coucou, para la app Plata:\n\n{pedido}\n\n\
+         Antes de cambiar nada, creá una rama nueva desde la rama actual. \
+         No hagas push, merge ni deploy sin preguntarme."
+    );
+    std::fs::write(&file, prompt).map_err(|e| e.to_string())?;
+
+    let q = |p: &PathBuf| p.to_string_lossy().replace('\'', "''");
+    let ps = format!("& '{}' (Get-Content -Raw -Encoding UTF8 '{}')", q(&exe), q(&file));
+    let opened = Command::new("wt")
+        .args(["-d", &repo.to_string_lossy(), "--title", "Plata · Claude Code", "powershell", "-NoExit", "-Command", &ps])
+        .spawn();
+    if opened.is_err() {
+        // No Windows Terminal: a plain console window.
+        Command::new("cmd")
+            .args(["/C", "start", "Plata · Claude Code", "powershell", "-NoExit", "-Command", &ps])
+            .current_dir(&repo)
+            .creation_flags(CREATE_NO_WINDOW)
+            .spawn()
+            .map_err(|e| format!("No pude abrir la terminal: {e}"))?;
+    }
+    crate::log::line(format!("claude code opened in {} ({})", repo.display(), file.display()));
+    Ok(repo.file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_default())
+}
