+#[cfg(windows)]
+/// Decides the dock from where the island was dropped, stores it, tells the
+/// page the new anchor and returns the glide that takes the window there.
+fn dock_after_drag(app: &AppHandle, hwnd: HWND) -> Option<(crate::settings::Settings, Glide)> {
+    let shared = app.try_state::<crate::Shared>()?;
+    let origin = window_rect(hwnd)?;
+    let r = *shared.gate.rect.lock().unwrap();
+    let ws = dpi_scale(hwnd);
+    // The island on screen, physical px.
+    let left = origin.left as f64 + r.x * ws;
+    let top = origin.top as f64 + r.y * ws;
+    let right = left + r.w * ws;
+    let cx = left + r.w * ws / 2.0;
+    let cy = top + r.h * ws / 2.0;
+    // The display the island was dropped on: the one under its centre (the
+    // cursor can sit off the island's edge), else the one under the cursor.
+    let monitors = app.available_monitors().ok()?;
+    let m = monitors
+        .iter()
+        .find(|m| monitor_contains(m, cx, cy))
+        .or_else(|| cursor_physical().and_then(|(x, y)| monitors.iter().find(|m| monitor_contains(m, x, y))))
+        .cloned()
+        .or_else(|| app.primary_monitor().ok().flatten())?;
+    let scale = m.scale_factor();
+    let (mon, wa) = area_of(&m);
+
+    let from_left = (left - wa.x as f64) / scale;
+    let from_right = ((wa.x + wa.w) as f64 - right) / scale;
+    let from_top = (top - mon.y as f64) / scale;
+    let dock = if from_left < SNAP {
+        "left"
+    } else if from_right < SNAP {
+        "right"
+    } else if from_top < SNAP {
+        "top"
+    } else {
+        "float"
+    };
+
+    let settings = {
+        let mut st = shared.settings.lock().unwrap();
+        st.dock = dock.to_string();
+        st.dock_monitor = Some(monitor_key(&m));
+        st.dock_y = (top - mon.y as f64) / scale;
+        st.dock_x = (cx - mon.x as f64) / scale - PANEL_W / 2.0;
+        st.clone()
+    };
+
+    // Where the window ends up — keeping the island where it is inside the
+    // window when it can (see `place`) — and where the island then is on screen.
+    let ticket = PLACEMENT.fetch_add(1, Ordering::SeqCst) + 1;
+    let (pw, ph) = window_size(app, wa, scale);
+    let keep = Some((r.x + r.w / 2.0, r.y));
+    let p = place(dock, mon, wa, scale, pw, ph, (cx, top), keep);
+    let (ix, iy) = island_offset(
+        dock,
+        (p.anchor_x, p.anchor_y),
+        (pw as f64 / scale, ph as f64 / scale),
+        r.w,
+        r.h,
+    );
+    let end = (p.x as f64 + ix * scale, p.y as f64 + iy * scale);
+    // The glide starts with the island where it was let go, already in the new
+    // layout, and takes the window to its place.
+    let from = (p.x + (left - end.0).round() as i32, p.y + (top - end.1).round() as i32);
+    send_anchor(app, dock, &p, pw, ph, scale);
+    remember_screen(app);
+    Some((settings, Glide { from, to: (p.x, p.y), size: (pw, ph), ticket }))
+}
