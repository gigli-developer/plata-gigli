+
+  function render() {
+    renderStrip();
+    renderList();
+    renderHabits();
+  }
+
+  function renderStrip() {
+    const f = foco;
+    if (!f) return;
+    const now = arClock();
+    const late = (f.atrasadas ?? []).filter((t) => !gone.has(t.id)).length;
+    const hoy = (f.paraHoy ?? []).filter((t) => !gone.has(t.id)).length;
+    const done = (f.hechasHoy ?? 0) + doneHere;
