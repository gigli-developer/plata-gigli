+/// `npm run servir` takes a few seconds to listen (it checks the session first).
+/// Within this window a second start would only fight the first one for the port.
+const START_GRACE: std::time::Duration = std::time::Duration::from_secs(60);
+
+static LAST_START: std::sync::Mutex<Option<std::time::Instant>> = std::sync::Mutex::new(None);
