diff --git a/windows/src-tauri/src/plata_ready.rs b/windows/src-tauri/src/plata_ready.rs
new file mode 100644
index 0000000..b7811f1
--- /dev/null
+++ b/windows/src-tauri/src/plata_ready.rs
@@ -0,0 +1,221 @@
+// Is the Plata tab ready? Checked in the background when Coucou starts and
+// whenever the tab opens, so a missing piece shows up before Lucas needs it,
+// with the one button that fixes it (plata.ts).
+//
+// The pieces:
+//   agente  the local agent answers /salud (plata_agent.rs; Coucou starts it)
+//   claude  the desktop app's claude.exe is on disk, and which version
+//   sesion  that Claude Code is logged in on Lucas's plan (`auth status`)
+//   skill   %USERPROFILE%\.claude\skills\conciliar-resumen\SKILL.md
+//   lector  `conciliar:leer` among the scripts of agentes\package.json
+//
+// The agent is asked every time (a local HTTP call). The rest runs a process
+// and reads files, so it is kept for a minute, or until a login changes it.
+
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::{Duration, Instant};
+
+use serde::Serialize;
+use serde_json::Value;
+
+use crate::claude_code::{self, Sesion};
+use crate::plata_agent;
+
+/// The same answer, pushed to the page when the check at launch finishes.
+pub const EVENT: &str = "plata-readiness";
+const TTL: Duration = Duration::from_secs(60);
+
+#[derive(Serialize, Clone, Debug, PartialEq, Default)]
+#[serde(rename_all = "camelCase")]
+pub struct Agente {
+    pub ok: bool,
+    /// Started less than a minute ago and not listening yet.
+    pub arrancando: bool,
+    /// The agentes folder is on disk, so it can be started.
+    pub instalado: bool,
+}
+
+#[derive(Serialize, Clone, Debug, PartialEq, Default)]
+#[serde(rename_all = "camelCase")]
+pub struct Claude {
+    pub ok: bool,
+    pub version: Option<String>,
+}
+
+#[derive(Serialize, Clone, Debug, PartialEq, Default)]
+#[serde(rename_all = "camelCase")]
+pub struct Pieza {
+    pub ok: bool,
+}
+
+#[derive(Serialize, Clone, Debug, PartialEq, Default)]
+#[serde(rename_all = "camelCase")]
+pub struct Readiness {
+    pub agente: Agente,
+    pub claude: Claude,
+    pub sesion: Sesion,
+    pub skill: Pieza,
+    pub lector: Pieza,
+    /// The first piece missing, in the order they have to be fixed; None when
+    /// all is ready. The page shows the button for this one.
+    pub falta: Option<&'static str>,
+}
+
+/// Everything but the agent: what is cached.
+#[derive(Clone, Debug, PartialEq, Default)]
+struct Local {
+    claude: Claude,
+    sesion: Sesion,
+    skill: Pieza,
+    lector: Pieza,
+}
+
+static CACHE: tokio::sync::Mutex<Option<(Instant, Local)>> = tokio::sync::Mutex::const_new(None);
+static STALE: AtomicBool = AtomicBool::new(false);
+
+/// The next check runs everything again (after a login, say).
+pub fn invalidate() {
+    STALE.store(true, Ordering::SeqCst);
+}
+
+/// Does the agentes repo have the reader the skill calls (`npm run conciliar:leer`)?
+pub(crate) fn lector_ok(agentes: &Path) -> bool {
+    std::fs::read_to_string(agentes.join("package.json"))
+        .ok()
+        .and_then(|s| serde_json::from_str::<Value>(s.trim_start_matches('\u{feff}')).ok())
+        .and_then(|v| v.pointer("/scripts/conciliar:leer").and_then(Value::as_str).map(|s| !s.trim().is_empty()))
+        .unwrap_or(false)
+}
+
+/// Blocking: runs `claude auth status` when Claude Code is there.
+fn check_local() -> Local {
+    let exe = plata_agent::claude_exe();
+    let claude = Claude { ok: exe.is_some(), version: exe.as_deref().and_then(plata_agent::claude_version) };
+    let sesion = match &exe {
+        Some(exe) => claude_code::auth_status(exe),
+        None => Sesion::default(),
+    };
+    Local {
+        claude,
+        sesion,
+        skill: Pieza { ok: claude_code::skill_dir().is_some() },
+        lector: Pieza { ok: plata_agent::agent_dir().is_some_and(|d| lector_ok(&d)) },
+    }
+}
+
+/// Which piece to fix first: the agent (the chat needs it), then Claude Code,
+/// its login, and the two halves of the reconciliation recipe.
+fn first_missing(agente: &Agente, local: &Local) -> Option<&'static str> {
+    if !agente.ok {
+        Some("agente")
+    } else if !local.claude.ok {
+        Some("claude")
+    } else if !local.sesion.ok {
+        Some("sesion")
+    } else if !local.skill.ok {
+        Some("skill")
+    } else if !local.lector.ok {
+        Some("lector")
+    } else {
+        None
+    }
+}
+
+fn assemble(agente: Agente, local: Local) -> Readiness {
+    let falta = first_missing(&agente, &local);
+    Readiness { agente, claude: local.claude, sesion: local.sesion, skill: local.skill, lector: local.lector, falta }
+}
+
+/// The state of every piece. `force` skips the one-minute cache.
+pub async fn readiness(force: bool) -> Readiness {
+    let st = plata_agent::status().await;
+    let agente = Agente { ok: st.up, arrancando: !st.up && plata_agent::starting(), instalado: st.dir.is_some() };
+    // Held while checking: a second caller waits for this answer instead of
+    // running `auth status` again.
+    let mut cache = CACHE.lock().await;
+    let stale = STALE.swap(false, Ordering::SeqCst);
+    let fresh = cache.as_ref().filter(|(at, _)| !force && !stale && at.elapsed() < TTL).map(|(_, l)| l.clone());
+    let local = match fresh {
+        Some(l) => l,
+        None => {
+            let l = tauri::async_runtime::spawn_blocking(check_local).await.unwrap_or_default();
+            *cache = Some((Instant::now(), l.clone()));
+            l
+        }
+    };
+    assemble(agente, local)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn all_ok() -> (Agente, Local) {
+        (
+            Agente { ok: true, arrancando: false, instalado: true },
+            Local {
+                claude: Claude { ok: true, version: Some("2.1.286".into()) },
+                sesion: Sesion { ok: true, plan: Some("Pro".into()), detalle: None },
+                skill: Pieza { ok: true },
+                lector: Pieza { ok: true },
+            },
+        )
+    }
+
+    #[test]
+    fn the_first_missing_piece_is_the_one_to_fix() {
+        let (a, l) = all_ok();
+        assert_eq!(assemble(a.clone(), l.clone()).falta, None);
+
+        let mut off = a.clone();
+        off.ok = false;
+        off.arrancando = true;
+        // Everything is missing: the agent goes first.
+        assert_eq!(assemble(off, Local::default()).falta, Some("agente"));
+        assert_eq!(assemble(a.clone(), Local::default()).falta, Some("claude"));
+
+        let mut no_login = l.clone();
+        no_login.sesion = Sesion::default();
+        no_login.skill.ok = false;
+        assert_eq!(assemble(a.clone(), no_login).falta, Some("sesion"));
+
+        let mut no_skill = l.clone();
+        no_skill.skill.ok = false;
+        no_skill.lector.ok = false;
+        assert_eq!(assemble(a.clone(), no_skill).falta, Some("skill"));
+
+        let mut no_reader = l;
+        no_reader.lector.ok = false;
+        assert_eq!(assemble(a, no_reader).falta, Some("lector"));
+    }
+
+    #[test]
+    fn the_page_gets_the_shape_it_reads() {
+        let (a, l) = all_ok();
+        let v = serde_json::to_value(assemble(a, l)).unwrap();
+        assert_eq!(v["agente"], serde_json::json!({ "ok": true, "arrancando": false, "instalado": true }));
+        assert_eq!(v["claude"], serde_json::json!({ "ok": true, "version": "2.1.286" }));
+        assert_eq!(v["sesion"]["plan"], "Pro");
+        assert_eq!((v["skill"]["ok"].as_bool(), v["lector"]["ok"].as_bool()), (Some(true), Some(true)));
+        assert!(v["falta"].is_null());
+    }
+
+    #[test]
+    fn the_reader_is_a_script_of_agentes() {
+        let dir = std::env::temp_dir().join(format!("coucou-ready-test-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        assert!(!lector_ok(&dir)); // no package.json
+        std::fs::write(dir.join("package.json"), r#"{"scripts":{"servir":"tsx plata/servir.ts"}}"#).unwrap();
+        assert!(!lector_ok(&dir));
+        std::fs::write(
+            dir.join("package.json"),
+            "\u{feff}{\"scripts\":{\"servir\":\"tsx plata/servir.ts\",\"conciliar:leer\":\"tsx plata/conciliar-leer.ts\"}}",
+        )
+        .unwrap();
+        assert!(lector_ok(&dir));
+        std::fs::write(dir.join("package.json"), "no es json").unwrap();
+        assert!(!lector_ok(&dir));
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}
