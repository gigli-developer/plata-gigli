+}
+
+.lz-now {
+  position: absolute;
+  top: 3px;
+  width: 2px;
+  height: 24px;
+  background: rgb(var(--rgb));
+  border-radius: 1px;
+}
+
+.lz-now::before {
+  content: "";
+  position: absolute;
+  top: -2px;
+  left: -2.5px;
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: rgb(var(--rgb));
+}
+
+.lz-lbl {
+  position: absolute;
+  top: -6px;
+  font: 500 9px var(--mono);
+  color: var(--dim-4);
+  transform: translateX(-50%);
+}
+
+/* Lists, pills */
+.lz-li {
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  gap: 8px;
+  align-items: center;
+  padding: 4px 2px;
+  font-size: 12.5px;
+  min-width: 0;
+}
+
+.lz-li > span:nth-child(2) {
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  min-width: 0;
+}
+
+.lz-bar4 {
+  width: 4px;
+  height: 14px;
+  border-radius: 2px;
+  background: var(--c);
+}
+
+.lz-pill {
+  font: 600 10px var(--mono);
+  padding: 2px 7px;
+  border-radius: 99px;
+  background: rgba(255, 255, 255, 0.06);
+  color: var(--dim-2);
+  white-space: nowrap;
+}
+
+.lz-pill.late { background: rgba(244, 80, 94, 0.13); color: var(--red-text); }
+.lz-pill.soon { background: rgba(245, 165, 36, 0.13); color: #ffc65c; }
+.lz-pill.ok { background: rgba(34, 197, 94, 0.14); color: #6ee7a8; }
+
+.lz-task {
+  font: 600 16px var(--font);
+}
+
+.lz-one {
+  display: grid;
+  gap: 6px;
+  padding: 14px 16px;
+}
+
+/* Notices ladder */
+.lz-ladder {
