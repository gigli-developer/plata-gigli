+// Atajos de la isla — the 16 skills and the "portero" that picks one from what
+// Lucas said or typed. Pure: no DOM, no Tauri, no relative imports, so it runs
+// under `node --test` as is (see windows/tests).
+//
+// The rules are the approved prototype's (atajos-de-la-isla.html, RULES), with
+// two changes in the order, both cases the prototype could never reach:
+// "conciliar" is checked before "resumen" ("conciliar el resumen" opened
+// Resúmenes de tarjeta) and "en qué gasté" before "gasté" (it opened
+// Registrar gasto instead of ¿Cómo voy este mes?).
+
+export type AgentId = "cdc" | "plata";
+
+export type SkillId =
+  | "dia" | "ahora" | "avisos" | "cierre" | "manana" | "vence" | "huecos" | "tarea"
+  | "gasto" | "situacion" | "saldo" | "mes" | "resumenes" | "deuda" | "dolar" | "conciliar";
+
+export type IconName =
+  | "sun" | "play" | "bell" | "moon" | "cal" | "flag" | "gap" | "plus"
+  | "minus" | "story" | "wallet" | "chart" | "card" | "swap" | "usd" | "doc";
+
+export interface Skill {
+  id: SkillId;
+  agent: AgentId;
+  icon: IconName;
+  /** Name on the list and on the card. */
+  name: string;
+  /** One line under the name; also what the AI router reads. */
+  desc: string;
+}
+
+export const SKILLS: readonly Skill[] = [
+  { id: "dia", agent: "cdc", icon: "sun", name: "Mi día", desc: "lo de hoy, de un vistazo" },
+  { id: "ahora", agent: "cdc", icon: "play", name: "¿Qué hago ahora?", desc: "una sola tarea según tu hueco" },
+  { id: "avisos", agent: "cdc", icon: "bell", name: "Avisos de Mochi", desc: "lo que te viene preguntando" },
+  { id: "cierre", agent: "cdc", icon: "moon", name: "Cerrar el día", desc: "hábitos, pendientes y mañana" },
+  { id: "manana", agent: "cdc", icon: "cal", name: "Planificar mañana", desc: "agenda y dos tareas sugeridas" },
+  { id: "vence", agent: "cdc", icon: "flag", name: "Lo que vence", desc: "próximos 10 días" },
+  { id: "huecos", agent: "cdc", icon: "gap", name: "Huecos de la semana", desc: "cuándo tenés tiempo libre" },
+  { id: "tarea", agent: "cdc", icon: "plus", name: "Tarea rápida", desc: "\"mañana llamar al contador\"" },
+  { id: "gasto", agent: "plata", icon: "minus", name: "Registrar gasto", desc: "un monto y listo" },
+  { id: "situacion", agent: "plata", icon: "story", name: "Contar una situación", desc: "la IA arma el plan de registro" },
+  { id: "saldo", agent: "plata", icon: "wallet", name: "¿Cuánto tengo?", desc: "pesos, dólares y cripto" },
+  { id: "mes", agent: "plata", icon: "chart", name: "¿Cómo voy este mes?", desc: "contra el mes pasado" },
+  { id: "resumenes", agent: "plata", icon: "card", name: "Resúmenes de tarjeta", desc: "qué vence y cuánto" },
+  { id: "deuda", agent: "plata", icon: "swap", name: "Me pagaron / pagué", desc: "deudas con personas" },
+  { id: "dolar", agent: "plata", icon: "usd", name: "Dólar hoy", desc: "blue, cripto y oficial" },
+  { id: "conciliar", agent: "plata", icon: "doc", name: "Conciliar un resumen", desc: "PDF del banco, con Claude Code" },
+];
+
+export const AGENTS: Record<AgentId, { name: string; color: string; rgb: string }> = {
+  cdc: { name: "Centro de Control", color: "#7cc4ff", rgb: "124, 196, 255" },
+  plata: { name: "Plata", color: "#ff9e1b", rgb: "255, 158, 27" },
+};
+
+export function skillById(id: string | null | undefined): Skill | null {
+  return SKILLS.find((s) => s.id === id) ?? null;
+}
+
+/**
+ * Lower case, no accents. JS's `\b` only knows ASCII word characters, so a rule
+ * like /\bgaste\b/ never matched "gasté" next to the accented letter: the text
+ * is normalized first and the rules are written without accents.
+ */
+export function norm(s: string): string {
+  return s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
+}
+
+/** [pattern on the normalized text, skill, why — shown as "Entendí: X · regla · why"]. */
+export const RULES: ReadonlyArray<readonly [RegExp, SkillId, string]> = [
+  [/\b(gaste|pague|compre|cene|almorce)\b.*\b(me debe|la mitad|dividimos|entre los dos)\b/, "situacion", "gasto compartido"],
+  [/\b(me debe|la mitad|dividimos)\b.*\b(pague|gaste)\b/, "situacion", "gasto compartido"],
+  [/\b(me pago|me devolvio|le pague a|le devolvi)\b/, "deuda", "pago de deuda"],
+  [/\ben que gaste\b/, "mes", "gasto del mes"],
+  [/\b(gaste|pague|compre|me cobraron|salio)\b/, "gasto", "dice gasté o pagué"],
+  [/\b(cuanto tengo|cuanta plata|me queda|mi saldo)\b/, "saldo", "pregunta por saldo"],
+  [/\b(dolar|blue|cripto|cotizacion)\b/, "dolar", "dólar"],
+  [/\b(como voy|este mes|en que gaste)\b/, "mes", "gasto del mes"],
+  [/\bconcili/, "conciliar", "conciliar"],
+  [/\b(resumen|resumenes|tarjeta)\b/, "resumenes", "resúmenes"],
+  [/\b(recordame|anota|agenda|tengo que)\b/, "tarea", "recordame o anotá"],
+  [/\b(que tengo|como viene|planific).*\bmanana\b/, "manana", "pregunta por mañana"],
+  [/\b(que tengo hoy|mi dia|como viene el dia)\b/, "dia", "pregunta por hoy"],
+  [/\b(que hago|por donde arranco)\b/, "ahora", "qué hago"],
+  [/\b(vence|vencimiento)/, "vence", "vencimientos"],
+  [/\b(hueco|libre)\b/, "huecos", "tiempo libre"],
+  [/\b(cerrar el dia|cierro el dia|cierre)\b/, "cierre", "cierre del día"],
+  [/\baviso/, "avisos", "avisos"],
+];
+
+export interface RuleHit {
+  id: SkillId;
+  why: string;
+}
+
+/** The fixed rules, in order; null when none matches. */
+export function routeByRules(text: string): RuleHit | null {
+  const n = norm(text);
+  for (const [re, id, why] of RULES) if (re.test(n)) return { id, why };
+  return null;
+}
+
+/** What the AI router (Bridge.routeSkill) answered. */
+export interface AiAnswer {
+  skill: string | null;
+  confianza: number;
+}
+
+/** At or above this confidence the AI's skill opens without asking. */
+export const AI_MIN_CONFIDENCE = 60;
+
+export type Decision =
+  | { kind: "open"; id: SkillId; how: "regla"; why: string }
+  | { kind: "open"; id: SkillId; how: "IA"; confianza: number }
+  | { kind: "ask"; alts: SkillId[] };
+
+/**
+ * Rules first; if none matches, the AI's answer (when it names a real skill
+ * with enough confidence); otherwise three options to pick from.
+ */
+export function decide(text: string, ai: AiAnswer | null, personas: string[] = []): Decision {
+  const hit = routeByRules(text);
+  if (hit) return { kind: "open", id: hit.id, how: "regla", why: hit.why };
+  const s = skillById(ai?.skill ?? null);
+  const conf = Number(ai?.confianza);
+  if (s && Number.isFinite(conf) && conf >= AI_MIN_CONFIDENCE) {
+    return { kind: "open", id: s.id, how: "IA", confianza: Math.round(conf) };
+  }
+  return { kind: "ask", alts: alternatives(text, s?.id ?? null, personas) };
+}
+
+/**
+ * The three buttons of "No estoy seguro. ¿Cuál?": the AI's low-confidence guess
+ * first, then by topic — money owed between people, or the everyday three.
+ */
+export function alternatives(text: string, aiGuess: SkillId | null, personas: string[] = []): SkillId[] {
+  const n = norm(text);
+  const people = personas.map(norm).filter((p) => p.length > 1);
+  const aboutDebt =
+    /\b(plata|debe|debo|debes|deuda|presta|devuelv|devolv|pagar|cobrar)/.test(n) ||
+    people.some((p) => new RegExp(`\\b${p.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\b`).test(n));
+  const base: SkillId[] = aboutDebt ? ["deuda", "situacion", "saldo"] : ["dia", "gasto", "saldo"];
+  const out: SkillId[] = [];
+  for (const id of [aiGuess, ...base, "ahora", "situacion"] as Array<SkillId | null>) {
+    if (id && !out.includes(id)) out.push(id);
+    if (out.length === 3) break;
+  }
+  return out;
+}
+
+/** A typed amount ("12500 super") narrows the list to the two skills that take one. */
+export function hasAmount(text: string): boolean {
+  return /\d{3,}/.test(text.replace(/[.,]/g, ""));
+}
+
+/**
+ * Which skills stay on the list for what is in the field. Empty field: all of
+ * them. While dictation is still writing, the caller doesn't filter at all.
+ */
+export function filterSkills(q: string): SkillId[] {
+  const text = q.trim();
+  if (!text) return SKILLS.map((s) => s.id);
+  if (hasAmount(text)) return ["gasto", "situacion"];
+  const n = norm(text);
+  return SKILLS.filter((s) => norm(`${s.name} ${s.desc}`).includes(n)).map((s) => s.id);
+}
+
+/** What the AI router gets for each skill (contract §3, SkillHint). */
+export function skillHints(): Array<{ id: string; nombre: string; descripcion: string }> {
+  return SKILLS.map((s) => ({ id: s.id, nombre: s.name, descripcion: `${AGENTS[s.agent].name}: ${s.desc}` }));
+}
