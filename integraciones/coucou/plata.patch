+// ── Changes to the app go to Claude Code, not to the agent ──────────────────
+
+/// The Plata checkout: a folder whose git remote is plata-gigli.
+pub(crate) fn plata_repo_dir() -> Option<PathBuf> {
+    let home = PathBuf::from(std::env::var_os("USERPROFILE")?);
+    [
+        home.join("OneDrive").join("Desktop").join("Claude").join("finanzas-app"),
+        home.join("Desktop").join("Claude").join("finanzas-app"),
+        home.join("plata-gigli"),
+    ]
+    .into_iter()
+    .find(|p| {
+        std::fs::read_to_string(p.join(".git").join("config"))
+            .map(|c| c.contains("plata-gigli"))
+            .unwrap_or(false)
+    })
+}
+
+/// The newest Claude Code the desktop app ships (claude-code\<version>\claude.exe).
+///
+/// The Store (MSIX) build of the app writes %APPDATA%\Claude into its package:
+/// %LOCALAPPDATA%\Packages\Claude_<id>\LocalCache\Roaming\Claude. Only the app
+/// itself sees it at %APPDATA%; from Coucou (outside the package) that path does
+/// not exist, so the package folder is searched too.
+pub(crate) fn claude_exe() -> Option<PathBuf> {
+    let mut bases = Vec::new();
+    if let Some(local) = std::env::var_os("LOCALAPPDATA") {
+        if let Ok(pkgs) = std::fs::read_dir(PathBuf::from(local).join("Packages")) {
+            for p in pkgs.flatten() {
+                if p.file_name().to_string_lossy().starts_with("Claude_") {
+                    bases.push(p.path().join("LocalCache").join("Roaming").join("Claude").join("claude-code"));
+                }
+            }
+        }
+    }
+    if let Some(roaming) = std::env::var_os("APPDATA") {
+        bases.push(PathBuf::from(roaming).join("Claude").join("claude-code"));
+    }
+    bases
+        .into_iter()
+        .filter_map(|b| std::fs::read_dir(b).ok())
+        .flat_map(|dir| dir.flatten())
+        .filter_map(|e| {
+            let version: Vec<u64> = e.file_name().to_string_lossy().split('.').map(|n| n.parse().unwrap_or(0)).collect();
+            exe_in_version(&e.path()).map(|exe| (version, exe))
+        })
+        .max_by(|a, b| a.0.cmp(&b.0))
+        .map(|(_, exe)| exe)
+}
+
+/// The version of a `claude.exe` found by `claude_exe`: the folder right under
+/// `claude-code` (`…\claude-code\2.1.286\635c1867224a\claude.exe` → 2.1.286).
+pub(crate) fn claude_version(exe: &std::path::Path) -> Option<String> {
+    let parts: Vec<String> = exe.components().map(|c| c.as_os_str().to_string_lossy().to_string()).collect();
+    let i = parts.iter().position(|p| p.eq_ignore_ascii_case("claude-code"))?;
+    parts.get(i + 1).filter(|v| v.chars().next().is_some_and(|c| c.is_ascii_digit())).cloned()
+}
+
+/// `<version>\claude.exe` (up to 2.1.284) or `<version>\<hash>\claude.exe`
+/// (the app's layout since its 2.19675 update, 1 Oct 2026).
+fn exe_in_version(dir: &std::path::Path) -> Option<PathBuf> {
+    let direct = dir.join("claude.exe");
+    if direct.is_file() {
+        return Some(direct);
+    }
+    std::fs::read_dir(dir)
+        .ok()?
+        .flatten()
+        .map(|e| e.path().join("claude.exe"))
+        .filter(|p| p.is_file())
+        .max_by_key(|p| std::fs::metadata(p).and_then(|m| m.modified()).ok())
+}
+
+/// Opens a terminal in the Plata repo with Claude Code working on `pedido`.
+/// The session shows up in the island through the hooks, and its permission
+/// requests are answered there. Returns the folder it opened in.
+pub fn open_claude_code(pedido: &str) -> Result<String, String> {
+    let repo = plata_repo_dir().ok_or_else(|| "No encuentro el repo de Plata (finanzas-app).".to_string())?;
+    let exe = claude_exe().ok_or_else(|| "No encuentro Claude Code (viene con la app de escritorio de Claude).".to_string())?;
+
+    // The request travels in a file: a prompt on the command line would have to
+    // survive the quoting of wt, PowerShell and the shell, and `;` splits wt tabs.
+    let dir = crate::settings::local_dir().join("pedidos");
+    std::fs::create_dir_all(&dir).map_err(|e| e.to_string())?;
+    let stamp = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0);
+    let file = dir.join(format!("pedido-{stamp}.txt"));
+    let prompt = format!(
+        "Pedido que Lucas mandó desde la isla de Coucou, para la app Plata:\n\n{pedido}\n\n\
+         Antes de cambiar nada, creá una rama nueva desde la rama actual. \
+         No hagas push, merge ni deploy sin preguntarme."
+    );
+    std::fs::write(&file, prompt).map_err(|e| e.to_string())?;
+
+    let q = |p: &PathBuf| p.to_string_lossy().replace('\'', "''");
+    let ps = format!("& '{}' (Get-Content -Raw -Encoding UTF8 '{}')", q(&exe), q(&file));
+    let opened = Command::new("wt")
+        .args(["-d", &repo.to_string_lossy(), "--title", "Plata · Claude Code", "powershell", "-NoExit", "-Command", &ps])
+        .spawn();
+    if opened.is_err() {
+        // No Windows Terminal: a plain console window.
+        Command::new("cmd")
+            .args(["/C", "start", "Plata · Claude Code", "powershell", "-NoExit", "-Command", &ps])
+            .current_dir(&repo)
+            .creation_flags(CREATE_NO_WINDOW)
+            .spawn()
+            .map_err(|e| format!("No pude abrir la terminal: {e}"))?;
+    }
+    crate::log::line(format!("claude code opened in {} ({})", repo.display(), file.display()));
+    Ok(repo.file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_default())
+}
+
+/// At launch: if the agent is installed and not listening, start it, so the
+/// Plata tab is ready without asking. It keeps running if Coucou quits, and the
+/// next launch finds it up.
+pub async fn ensure_running() {
+    let st = status().await;
+    if st.up || st.dir.is_none() {
+        return;
+    }
+    if let Err(err) = start() {
+        crate::log::line(format!("plata agent autostart failed: {err}"));
+    }
+}
