+}
+
+.lz-big small {
+  font-size: 12px;
+  font-weight: 500;
+  color: var(--dim-2);
+}
+
+.lz-sub {
+  font-size: 11.5px;
+  color: var(--dim-3);
+}
+
+.lz-sub.lz-strong {
+  color: var(--ink-2);
+}
+
+.lz-push {
+  margin-left: auto;
+}
+
+.lz-missing,
+.lz-err {
+  color: var(--red-text);
+  font-size: 12px;
+}
+
+.lz-errbox {
+  display: grid;
+  gap: 8px;
+  padding: 10px 12px;
+  border-radius: 14px;
+  background: rgba(244, 80, 94, 0.08);
+  border: 1px solid rgba(244, 80, 94, 0.25);
+}
+
+.lz-note {
+  font-size: 11.5px;
+  color: var(--dim-3);
+}
+
+.lz-acts {
+  display: flex;
+  gap: 6px;
+  flex-wrap: wrap;
+  align-items: center;
+}
+
+.lz-btn {
