@@ -0,0 +1,1611 @@
+// Plata view — a chat with Plata's agent (the `agentes` repo, `npm run servir`).
+//
+// The agent answers with a stream of events (CONTRATOS.md §9 in that repo):
+// `texto`, `tool`, `aviso`, `propuesta`, `error` and `fin`. Each one is drawn as
+// it arrives. A proposal gets a card with Approve / Reject: the answer goes back
+// to the agent as the next message, which is the only way the base accepts a
+// write (it refuses a confirmation made in the same turn that proposed it).
+//
+// Attachments, to reconcile a card statement against Plata: a PDF or screenshot
+// dropped on this tab (the island routes the drop here instead of the upload
+// sequence), or a long paste (the statement as it arrives on WhatsApp). Files
+// travel as paths and Rust reads them; pasted text goes inside `texto`.
+//
+// A message with attachments doesn't go to the agent, though: reconciling is
+// done by Claude Code, headless, on Lucas's plan instead of the API (Rust:
+// claude_code.rs). Its progress arrives as `plata-delegado` and the result is a
+// card drawn from the `datos.json` it leaves. The agent can also suggest it
+// (a `delegar` event); its "Hacerlo" reuses the last attachments, if any.
+//
+// Under the header, one dot per piece all this needs (plata_ready.rs: agent,
+// Claude Code, its login on Lucas's plan, the skill and its reader). When one
+// is missing there is one button for it: "Encender agente", or "Conectar
+// Claude Code", which logs in through the browser with no terminal and then
+// retries the reconciliation that was waiting for it.
+
+import { h, svg, clear } from "./dom";
+import { ICONS } from "./icons";
+import { Bridge, onEvent, type PlataAgentStatus, type PlataLoginEvent, type PlataReadiness } from "../core/bridge";
+import { Sound } from "../core/sound";
+import { State } from "../core/state";
+import { renderMarkdown, splitAcciones, type Accion } from "./plata-markdown";
+import type { ViewActions, ViewHost } from "./views";
+import { chatHead, onBigChange, registerReset, reportChat, reportMessage } from "./chats";
+
+type Propuesta = {
+  id: number;
+  tipo: string;
+  estado: string;
+  motivo_confirmacion: string | null;
+  resumen: string | null;
+  monto_ars: number | null;
+  expira_en: string | null;
+};
+
+type Evento =
+  | { tipo: "texto"; texto: string }
+  | { tipo: "tool"; nombre: string; entrada: unknown }
+  | { tipo: "aviso"; texto: string }
+  | { tipo: "propuesta"; propuesta: Propuesta }
+  | { tipo: "error"; texto: string }
+  | { tipo: "resultado"; nombre: string; datos: unknown }
+  | { tipo: "fin"; usos: Array<{ usd: number; precio_conocido: boolean }>; duracionMs: number }
+  | { tipo: "delegar"; tarea: string; detalle: string };
+
+/** Events of a run of Claude Code (`plata-delegado`). */
+type Delegado =
+  | { tipo: "progreso"; texto: string }
+  | {
+      tipo: "fin";
+      ok: boolean;
+      mensaje: string;
+      datos: Record<string, unknown> | null;
+      informe: string | null;
+      carpeta: string;
+      segundos: number;
+    }
+  | { tipo: "error"; texto: string; login?: boolean; cancelado?: boolean };
+
+const ars = new Intl.NumberFormat("es-AR", { maximumFractionDigits: 2 });
+const ars0 = new Intl.NumberFormat("es-AR", { maximumFractionDigits: 0 });
+const usd = new Intl.NumberFormat("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 3 });
+
+/** A paste longer than this becomes an attachment instead of filling the one-line field. */
+const PASTE_AS_ATTACHMENT = 600;
+/** The agent's limits (CONTRATOS §9 in agentes): 3 files, 60,000 characters of text. */
+const MAX_FILES = 3;
+const MAX_TEXT = 60_000;
+const DEFAULT_ASK = "Compará esto del banco (resumen de tarjeta o extracto de la cuenta) con lo que tengo en Plata y decime las diferencias.";
+
+type FileAttachment = { kind: "file"; path: string; name: string; size: number };
+type TextAttachment = { kind: "text"; text: string; lines: number };
+type Attachment = FileAttachment | TextAttachment;
+
+function attachmentLabel(a: Attachment): string {
+  if (a.kind === "text") return `Texto pegado ·${a.lines} ${a.lines === 1 ? "línea" : "líneas"}`;
+  const kb = a.size / 1024;
+  return `${a.name} · ${kb < 1024 ? `${Math.max(1, Math.round(kb))} KB` : `${ars.format(Math.round(kb / 102.4) / 10)} MB`}`;
+}
+
+/** The message as the agent gets it: what Lucas typed, then each pasted text, delimited. */
+function composeText(ask: string, atts: Attachment[]): string {
+  const pasted = atts.filter((a): a is TextAttachment => a.kind === "text");
+  return [
+    ask,
+    ...pasted.map((p) => `--- Resumen pegado (${p.lines} líneas) ---\n${p.text}\n--- Fin del resumen pegado ---`),
+  ].join("\n\n");
+}
+
+function newSession(): string {
+  return `isla-${crypto.randomUUID()}`;
+}
+
+/** `mcp__plata__gastos_por_categoria` → `gastos por categoria`. */
+function toolLabel(name: string): string {
+  return name.replace(/^mcp__[^_]+__/, "").replace(/_/g, " ");
+}
+
+/** The island draws plain text: drop Markdown's emphasis and heading marks. */
+function plain(text: string): string {
+  return text
+    .replace(/\*\*(.+?)\*\*/g, "$1")
+    .replace(/^#{1,6}\s+/gm, "")
+    .replace(/`([^`]+)`/g, "$1")
+    .trim();
+}
+
+// ── Cards for the agent's read results ─────────────────────────────────────
+// They draw exactly what the tool returned (the `resultado` event, CONTRATOS §9
+// in agentes): no sums, no conversions. Plata's numbers come from its SQL.
+
+type Obj = Record<string, unknown>;
+const obj = (v: unknown): Obj => (v && typeof v === "object" && !Array.isArray(v) ? (v as Obj) : {});
+const arr = (v: unknown): Obj[] => (Array.isArray(v) ? v.map(obj) : []);
+const num = (v: unknown): number | null =>
+  v === null || v === undefined || v === "" || !Number.isFinite(Number(v)) ? null : Number(v);
+const money = (n: number | null, moneda = "ARS") =>
+  n === null ? "—" : moneda === "ARS" ? `$ ${ars0.format(n)}` : moneda === "USD" ? `US$ ${ars.format(n)}` : `${ars.format(n)} ${moneda}`;
+
+const MESES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
+function mesLargo(ym: string): string {
+  const [y, m] = ym.split("-").map(Number);
+  return m ? `${MESES[m - 1]} ${y}` : ym;
+}
+
+function dataCard(title: string, stamp: string, ...body: (Node | null)[]): HTMLElement {
+  return h(
+    "div",
+    { class: "plata-data" },
+    h(
+      "div",
+      { class: "plata-prop-head" },
+      h("span", { class: "plata-data-kind", text: title }),
+      stamp ? h("span", { class: "plata-prop-exp", text: stamp }) : null,
+    ),
+    ...body,
+  );
+}
+
+function kv(label: string, value: string, cls = ""): HTMLElement {
+  return h("div", { class: "plata-kv" }, h("span", { text: label }), h("span", { class: `plata-kv-v ${cls}`, text: value }));
+}
+
+function cardSaldos(d: Obj): HTMLElement | null {
+  const liquido = arr(d.liquido);
+  if (!liquido.length) return null;
+  const en = (m: string) => num(liquido.find((l) => l.moneda === m)?.monto);
+  const cot = arr(d.cotizaciones_de_valuacion)
+    .map((c) => `${c.moneda === "USD" ? "blue" : "cripto"} ${money(num(c.ars_por_unidad))}`)
+    .join(" · ");
+  const vencida = num(obj(d.deuda_vencida_tarjeta).monto);
+  return dataCard(
+    "Saldos · líquido",
+    cot,
+    h("div", { class: "plata-big", text: money(en("ARS")) }),
+    h("div", { class: "plata-row3" }, h("span", { text: money(en("USD"), "USD") }), h("span", { text: money(en("USDT"), "USDT") })),
+    kv("Te deben", money(num(obj(d.te_deben_personas).monto)), "pos"),
+    kv("Debés a personas", money(num(obj(d.debes_a_personas).monto))),
+    kv("Cuotas de tarjeta", money(num(obj(d.deuda_cuotas_tarjeta).monto))),
+    kv("Vencido de tarjeta", money(vencida), vencida ? "neg" : ""),
+  );
+}
+
+function cardResumen(d: Obj): HTMLElement | null {
+  const egresos = arr(d.por_categoria).filter((c) => c.tipo === "egreso" && typeof c.mes === "string");
+  if (!egresos.length) return null;
+  const mes = egresos.map((c) => String(c.mes)).sort().at(-1)!;
+  const delMes = egresos
+    .filter((c) => c.mes === mes)
+    .sort((a, b) => (num(b.total_ars) ?? 0) - (num(a.total_ars) ?? 0));
+  const top = delMes.slice(0, 6);
+  const max = Math.max(...top.map((c) => num(c.total_ars) ?? 0), 1);
+  // por_mes is keyed by month: { "2026-09": { egreso_ars, ingreso_ars, ... } }.
+  const total = num(obj(obj(d.por_mes)[mes]).egreso_ars);
+  return dataCard(
+    `Gastos de ${mesLargo(mes)}`,
+    "incluye cuotas",
+    total !== null ? h("div", { class: "plata-big", text: money(total) }) : null,
+    h(
+      "div",
+      { class: "plata-bars" },
+      ...top.map((c) => {
+        const v = num(c.total_ars) ?? 0;
+        const bar = h("span", { class: "plata-bar-fill" });
+        bar.style.width = `${Math.max(2, (v / max) * 100)}%`;
+        return h(
+          "div",
+          { class: "plata-bar" },
+          h("span", { class: "plata-bar-name", text: `${c.emoji ?? ""} ${c.categoria ?? ""}`.trim() }),
+          h("span", { class: "plata-bar-v", text: money(v) }),
+          h("span", { class: "plata-bar-track" }, bar),
+        );
+      }),
+    ),
+    delMes.length > top.length ? h("div", { class: "plata-note", text: `y ${delMes.length - top.length} categorías más` }) : null,
+  );
+}
+
+function cardPatrimonio(d: unknown): HTMLElement | null {
+  const serie = arr(d).filter((p) => num(p.patrimonio) !== null);
+  if (!serie.length) return null;
+  const ultimo = serie.at(-1)!;
+  const max = Math.max(...serie.map((p) => Math.abs(num(p.patrimonio) ?? 0)), 1);
+  const cols = h("div", { class: "plata-cols" });
+  for (const p of serie) {
+    const v = num(p.patrimonio) ?? 0;
+    const c = h("span", { class: v < 0 ? "neg" : "" });
+    c.style.height = `${Math.max(3, (Math.abs(v) / max) * 100)}%`;
+    c.title = `${mesLargo(String(p.month ?? ""))}: ${money(v)}`;
+    cols.append(c);
+  }
+  return dataCard(
+    "Patrimonio neto",
+    `hoy · ${serie.length} meses`,
+    h("div", { class: "plata-big", text: money(num(ultimo.patrimonio)) }),
+    cols,
+    kv("Activos", money(num(ultimo.activos))),
+    kv("Pasivos", money(num(ultimo.pasivos))),
+  );
+}
+
+function cardFor(nombre: string, datos: unknown): HTMLElement | null {
+  if (nombre === "saldos") return cardSaldos(obj(datos));
+  if (nombre === "resumen_mensual") return cardResumen(obj(datos));
+  if (nombre === "serie_patrimonio") return cardPatrimonio(datos);
+  return null;
+}
+
+// ── The reconciliation, as Claude Code left it in datos.json ──────────────
+// Same shape as the DATOS object of the skills' informe: conciliar-resumen, and
+// conciliar-extracto for the bank account's statement (`plata_resumen.id` null,
+// `last4` maybe "", every amount signed: negative = out of the account).
+
+const dec2 = new Intl.NumberFormat("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+/** Money the way the informe writes it, so the copied message matches it. */
+const money2 = (n: number | null, moneda: string) =>
+  n === null
+    ? "—"
+    : `${n < 0 ? "−" : ""}${moneda === "USD" ? "US$ " : moneda === "ARS" ? "$ " : ""}${dec2.format(Math.abs(n))}${moneda && moneda !== "ARS" && moneda !== "USD" ? ` ${moneda}` : ""}`;
+const str = (v: unknown) => (v === null || v === undefined ? "" : String(v));
+
+/** A bank account's statement (conciliar-extracto): no Plata statement behind it. */
+const esExtracto = (d: Obj) => obj(d.plata_resumen).id == null;
+/** «resumen» or «extracto», for the texts that name the document. */
+const docName = (d: Obj) => (esExtracto(d) ? "extracto" : "resumen");
+
+/** Each kind of difference keeps the color it has in the informe. */
+const DIF_COLOR: Record<string, string> = {
+  "falta en Plata": "#ff8a84",
+  "en otro resumen": "#5ec8ff",
+  "sobra en Plata": "#b69cff",
+  "monto distinto": "#ffbf47",
+  "moneda distinta": "#ffbf47",
+  "cuota distinta": "#ffbf47",
+  duplicado: "#ff9e1b",
+};
+const DIFS_SHOWN = 8;
+
+function fmtSecs(s: number): string {
+  s = Math.max(0, Math.round(s));
+  return s < 60 ? `${s} s` : `${Math.floor(s / 60)} min ${String(s % 60).padStart(2, "0")} s`;
+}
+
+/** The message to load what is missing, word for word as the informe has it. Null if nothing is. */
+function faltantesMensaje(d: Obj): string | null {
+  const faltan = arr(d.diferencias).filter((x) => x.tipo === "falta en Plata" && x.banco);
+  if (!faltan.length) return null;
+  const periodo = str(obj(d.plata_resumen).periodo);
+  if (esExtracto(d)) {
+    // Signed amounts: the sign becomes a word, as the extracto's informe writes it.
+    const cuenta = `${str(d.tarjeta)}${d.last4 ? ` (··${str(d.last4)})` : ""}`;
+    return (
+      `Cargá estos movimientos de la cuenta ${cuenta}, del extracto ${periodo}, como propuesta:\n` +
+      faltan
+        .map((x) => {
+          const b = obj(x.banco);
+          const monto = num(b.monto);
+          const sentido = monto !== null && monto < 0 ? "egreso" : "ingreso";
+          return `- ${str(x.fecha)} · ${str(x.comercio)} · ${sentido} ${money2(monto === null ? null : Math.abs(monto), str(b.moneda))}`;
+        })
+        .join("\n")
+    );
+  }
+  return (
+    `Cargá estos consumos de la tarjeta ${str(d.tarjeta)} (··${str(d.last4)}), del resumen ${periodo}, como propuesta:\n` +
+    faltan
+      .map((x) => {
+        const b = obj(x.banco);
+        return `- ${str(x.fecha)} · ${str(x.comercio)} · ${money2(num(b.monto), str(b.moneda))}${b.cuota ? ` · cuota ${str(b.cuota)}` : ""}`;
+      })
+      .join("\n")
+  );
+}
+
+function ccButton(label: string, primary: boolean, onClick: () => void, title = ""): HTMLButtonElement {
+  const b = h(
+    "button",
+    { type: "button", class: `btn ${primary ? "primary" : "secondary"} plata-btn plata-cc-btn`, title: title || undefined },
+    h("span", { text: label }),
+  );
+  b.addEventListener("click", onClick);
+  return b;
+}
+
+type CardActions = {
+  openReport: (path: string) => void;
+  copy: (msg: string, btn: HTMLButtonElement) => void;
+  load: (msg: string) => void;
+  /** Asks the agent to fix what it can, with the differences attached. */
+  fix: () => void;
+};
+
+/** Marker the agent's prompt looks for ("Corregir según una conciliación"). */
+const CONC_HEAD = "--- Conciliación de Claude Code ---";
+
+/**
+ * The reconciliation, for the agent: it ran in Claude Code, so the agent's
+ * conversation never saw it. Only what the agent needs to fix it.
+ */
+function conciliacionContexto(d: Obj): string {
+  const { tarjeta, last4, banco, banco_periodo, plata_resumen, totales, diferencias } = d;
+  const json = JSON.stringify({ tarjeta, last4, banco, banco_periodo, plata_resumen, totales, diferencias });
+  return `${CONC_HEAD}\n${json}\n--- fin de la conciliación ---`;
+}
+
+const pedidoCorregir = (d: Obj) =>
+  `Corregí en Plata lo que se pueda para igualar el ${docName(d)} del banco: armá una sola propuesta para que la apruebe, y lo dudoso preguntámelo.`;
+
+/** Totals per currency, counts per kind, the first differences, and what to do next. */
+function conciliacionCard(d: Obj, informe: string | null, act: CardActions): HTMLElement {
+  const resumen = obj(d.plata_resumen);
+  const doc = docName(d);
+  const titulo = [str(d.tarjeta) || (esExtracto(d) ? "Cuenta" : "Tarjeta"), d.last4 ? `··${str(d.last4)}` : ""].filter(Boolean).join(" ");
+  const card = h(
+    "div",
+    { class: "plata-data plata-cc-result" },
+    h(
+      "div",
+      { class: "plata-prop-head" },
+      h("span", { class: "plata-data-kind", text: `Conciliación · ${titulo}` }),
+      h("span", { class: "plata-prop-exp", text: resumen.periodo ? `${doc} ${str(resumen.periodo)}` : esExtracto(d) ? "Extracto" : str(d.banco) }),
+    ),
+  );
+  if (d.ejemplo) card.append(h("div", { class: "plata-note", text: `Datos de ejemplo, no de tu ${doc}.` }));
+
+  const totales = arr(d.totales);
+  if (totales.length) {
+    const box = h("div", { class: "plata-cc-totals" });
+    for (const t of totales) {
+      const moneda = str(t.moneda);
+      const banco = num(t.banco);
+      const plata = num(t.plata);
+      const ok = banco !== null && plata !== null && banco.toFixed(2) === plata.toFixed(2);
+      box.append(
+        h(
+          "div",
+          { class: "plata-cc-tot" },
+          h(
+            "div",
+            { class: "plata-cc-tot-head" },
+            h("span", { text: moneda }),
+            h("span", { class: `plata-cc-state ${ok ? "ok" : "bad"}`, text: ok ? "coinciden" : "no coinciden" }),
+          ),
+          h("span", { class: "plata-cc-k", text: "Banco" }),
+          h("span", { class: "plata-cc-k", text: "Plata" }),
+          h("span", { class: "plata-cc-v", text: money2(banco, moneda) }),
+          h("span", { class: `plata-cc-v ${ok ? "" : "bad"}`, text: money2(plata, moneda) }),
+        ),
+      );
+    }
+    card.append(box);
+  }
+
+  const difs = arr(d.diferencias);
+  const chips = h("div", { class: "plata-cc-chips" });
+  const chip = (n: number, label: string, color: string) => {
+    const c = h("span", { class: "plata-cc-chip" }, h("i"), h("b", { text: String(n) }), ` ${label}`);
+    c.style.setProperty("--c", color);
+    return c;
+  };
+  chips.append(chip(num(d.coinciden) ?? 0, "coinciden", "#35e08a"));
+  for (const tipo of [...new Set(difs.map((x) => str(x.tipo)))]) {
+    chips.append(chip(difs.filter((x) => x.tipo === tipo).length, tipo, DIF_COLOR[tipo] ?? "#9a9fa8"));
+  }
+  card.append(chips);
+
+  if (!difs.length) {
+    card.append(h("div", { class: "plata-cc-clean", text: `Sin diferencias: todo lo del ${doc} está en Plata.` }));
+  } else {
+    const list = h("ul", { class: "plata-cc-difs" });
+    for (const x of difs.slice(0, DIFS_SHOWN)) {
+      const b = x.banco ? obj(x.banco) : null;
+      const p = x.plata ? obj(x.plata) : null;
+      const bancoTxt = b ? `${money2(num(b.monto), str(b.moneda))}${b.cuota ? ` (cuota ${str(b.cuota)})` : ""}` : "—";
+      const plataTxt = p
+        ? `${money2(num(p.monto), str(p.moneda))}${p.cuota ? ` (cuota ${str(p.cuota)})` : ""}${p.resumen ? ` · resumen ${str(p.resumen)}` : ""}`
+        : "—";
+      const tipo = str(x.tipo);
+      const kind = h("span", { class: "plata-cc-kind" }, h("i"), tipo);
+      kind.style.setProperty("--c", DIF_COLOR[tipo] ?? "#9a9fa8");
+      list.append(
+        h(
+          "li",
+          { class: "plata-cc-dif" },
+          h("div", { class: "plata-cc-dif-top" }, kind, h("span", { class: "plata-cc-date", text: str(x.fecha) })),
+          h(
+            "div",
+            { class: "plata-cc-dif-name" },
+            p && p.id != null ? h("span", { class: "plata-cc-id", text: `#${str(p.id)}` }) : null,
+            h("span", { text: str(x.comercio) }),
+          ),
+          h("div", { class: "plata-cc-dif-amt", text: `Banco ${bancoTxt} → Plata ${plataTxt}` }),
+          x.que_hacer ? h("div", { class: "plata-cc-dif-do", text: str(x.que_hacer) }) : null,
+        ),
+      );
+    }
+    card.append(list);
+    if (difs.length > DIFS_SHOWN) {
+      const more = difs.length - DIFS_SHOWN;
+      card.append(h("div", { class: "plata-note", text: `y ${more} ${more === 1 ? "diferencia más" : "diferencias más"} en el informe` }));
+    }
+  }
+
+  const actions = h("div", { class: "plata-actions plata-cc-actions" });
+  if (difs.length) {
+    actions.append(ccButton("Corregir en Plata", true, act.fix, "El agente de Plata arma una propuesta con los arreglos, para que la apruebes"));
+  }
+  if (informe) actions.append(ccButton("Abrir informe", !difs.length, () => act.openReport(informe), "Abre el informe completo en el navegador"));
+  const msg = faltantesMensaje(d);
+  if (msg) {
+    const copy = ccButton("Copiar faltantes", false, () => act.copy(msg, copy), "Copia el mensaje para cargar lo que falta");
+    actions.append(
+      copy,
+      ccButton("Cargar faltantes con Plata", false, () => act.load(msg), "Se lo manda al agente de Plata, que te los propone para aprobar"),
+    );
+  }
+  if (actions.childElementCount) card.append(actions);
+  return card;
+}
+
+function hhmm(iso: string | null): string {
+  if (!iso) return "";
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return "";
+  return d.toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" });
+}
+
+/** Prefix for a request Claude Code could not do: the agent does it itself. */
+const NO_DELEGAR = "Hacelo vos, sin delegar a Claude Code (no pudo).";
+
+export function buildPlata(actions?: ViewActions): ViewHost {
+  let sesionId = newSession();
+  let sending = false;
+  /** The last Claude Code run failed for lack of a login. */
+  let ccNeedsLogin = false;
+  /** A reconciliation the agent has not seen yet: rides on the next message. */
+  let pendingConc: string | null = null;
+  let lastText = "";
+  let status: PlataAgentStatus | null = null;
+  // Per turn: the reply paragraph being filled and the running tools line.
+  let replyEl: HTMLElement | null = null;
+  /** The turn's last answer paragraph: its `acciones` become chips at `fin`. */
+  let turnReply: HTMLElement | null = null;
+  let toolsEl: HTMLElement | null = null;
+  let toolsSeen: string[] = [];
+  // Claude Code: the run in progress (one at a time) and the last attachments
+  // sent, which the agent's "hacelo con Claude Code" suggestion reuses.
+  let ccRun: {
+    sesion: string;
+    step: HTMLElement;
+    box: HTMLElement;
+    timer: number;
+    started: number;
+    text: string;
+    atts: Attachment[];
+  } | null = null;
+  let lastAtts: { text: string; atts: Attachment[] } | null = null;
+  // Readiness (plata_ready.rs) and the fixes it offers.
+  let readiness: PlataReadiness | null = null;
+  let readyTimer: number | null = null;
+  let startingAgent = false;
+  /** Claude Code is being connected: the browser is open to authorize. */
+  let connecting: { url: string | null; codeOpen: boolean } | null = null;
+  /** Why the last connection didn't work; shown until the next try. */
+  let connectError: string | null = null;
+  /** "Claude Code conectado · plan Pro", for a few seconds. */
+  let connectedFlash: string | null = null;
+  /** A reconciliation that stopped for lack of a login: it runs again once connected. */
+  let afterLogin: { text: string; atts: Attachment[]; box: HTMLElement | null; btn: HTMLButtonElement | null } | null = null;
+
+  const resetBtn = h("button", { type: "button", class: "plata-link chat-reset", text: "Nueva", title: "Empezar otra conversación" });
+  // Name and model, "Nueva", and the size button (chats.ts: the same in every chat).
+  const head = chatHead("plata", resetBtn);
+  head.el.classList.add("plata-head");
+
+  // Under the header: one dot per piece the tab uses, and when one is
+  // missing, what fixes it (plata_ready.rs decides which goes first).
+  const readyLine = h("div", { class: "plata-ready-line", role: "status", "aria-live": "polite" });
+  const fixLine = h("div", { class: "plata-fix" });
+  fixLine.hidden = true;
+  const ready = h("div", { class: "plata-ready" }, readyLine, fixLine);
+
+  // The quick answers (Atajos de la isla): a card each, no chat and no model.
+  const quick = h("div", { class: "plata-quick", role: "group", "aria-label": "Atajos de Plata" });
+  if (actions) {
+    const QUICK = [
+      ["saldo", "¿Cuánto tengo?"],
+      ["mes", "Este mes"],
+      ["resumenes", "Resúmenes"],
+      ["deuda", "Deudas"],
+      ["dolar", "Dólar"],
+      ["gasto", "+ Gasto"],
+    ] as const;
+    for (const [id, label] of QUICK) {
+      const b = h("button", { type: "button", class: "plata-quick-btn", text: label, title: "Atajo: respuesta al toque, sin chat" });
+      b.addEventListener("click", () => actions.openSkill(id));
+      quick.append(b);
+    }
+  }
+
+  // Enlarged or back (chats.ts setBig): the island resizes, the log stays at its end.
