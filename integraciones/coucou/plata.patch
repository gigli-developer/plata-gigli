+}
+
+.lz-steps {
+  display: flex;
+  gap: 3px;
+}
+
+.lz-steps i {
+  width: 16px;
+  height: 4px;
+  border-radius: 2px;
+  background: rgba(255, 255, 255, 0.08);
+}
+
+.lz-steps i.on {
+  background: var(--red);
+}
+
+/* Habits: toggles (Cerrar el día) */
+.lz-habits {
+  display: flex;
+  gap: 6px;
+  flex-wrap: wrap;
+}
+
+.lz-habit {
+  display: inline-flex;
+  gap: 6px;
