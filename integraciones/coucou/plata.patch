diff --git a/windows/src-tauri/src/plata_agent.rs b/windows/src-tauri/src/plata_agent.rs
new file mode 100644
index 0000000..56e7b98
--- /dev/null
+++ b/windows/src-tauri/src/plata_agent.rs
@@ -0,0 +1,476 @@
+// Plata's agent in the island. The agent itself lives in the `agentes` repo and
+// runs on this PC with `npm run servir`, on 127.0.0.1:8787, with Lucas's own
+// Supabase session (never the service role): see CONTRATOS.md §9 over there.
+//
+// The island only talks to it: one POST per message, answered as a stream of
+// server-sent events that are forwarded to the page unchanged as `plata-event`.
+// Writes are never applied from here. The agent turns them into proposals, and
+// Lucas approves them in a later message, which is what the base checks.
+
+use std::os::windows::process::CommandExt;
+use std::path::PathBuf;
+use std::process::{Command, Stdio};
+
+use serde::Serialize;
+use serde_json::{json, Value};
+use tauri::{AppHandle, Emitter};
+
+pub(crate) const BASE: &str = "http://127.0.0.1:8787";
+/// `npm run servir` takes a few seconds to listen (it checks the session first).
+/// Within this window a second start would only fight the first one for the port.
+const START_GRACE: std::time::Duration = std::time::Duration::from_secs(60);
+
+static LAST_START: std::sync::Mutex<Option<std::time::Instant>> = std::sync::Mutex::new(None);
+pub(crate) const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+
+#[derive(Serialize, Clone)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentStatus {
+    pub up: bool,
+    pub model: Option<String>,
+    /// The `agentes` folder found on disk, so the page can offer to start it.
+    pub dir: Option<String>,
+}
+
+#[derive(Serialize, Clone)]
+#[serde(rename_all = "camelCase")]
+struct PlataEvent {
+    sesion_id: String,
+    ev: Value,
+}
+
+/// Where the `agentes` repo is checked out. First match wins.
+pub(crate) fn agent_dir() -> Option<PathBuf> {
+    let home = PathBuf::from(std::env::var_os("USERPROFILE")?);
+    [
+        home.join("OneDrive").join("Desktop").join("Claude").join("agentes"),
+        home.join("Desktop").join("Claude").join("agentes"),
+        home.join("agentes"),
+    ]
+    .into_iter()
+    .find(|p| p.join("plata").join("servir.ts").is_file())
+}
+
+pub async fn status() -> AgentStatus {
+    let dir = agent_dir().map(|p| p.to_string_lossy().to_string());
+    let client = match reqwest::Client::builder().timeout(std::time::Duration::from_secs(2)).build() {
+        Ok(c) => c,
+        Err(_) => return AgentStatus { up: false, model: None, dir },
+    };
+    match client.get(format!("{BASE}/salud")).send().await {
+        Ok(r) if r.status().is_success() => {
+            let v: Value = r.json().await.unwrap_or(Value::Null);
+            AgentStatus {
+                up: true,
+                model: v.get("modelo").and_then(Value::as_str).map(str::to_string),
+                dir,
+            }
+        }
+        _ => AgentStatus { up: false, model: None, dir },
+    }
+}
+
+/// A start is under way: `npm run servir` was launched less than a minute ago
+/// and the agent may not be listening yet.
+pub fn starting() -> bool {
+    LAST_START.lock().unwrap().is_some_and(|t| t.elapsed() < START_GRACE)
+}
+
+/// Starts `npm run servir` in the `agentes` folder, detached and without a
+/// console. Its output goes to %LOCALAPPDATA%\Coucou\plata-agent.log.
+pub fn start() -> Result<(), String> {
+    {
+        let mut last = LAST_START.lock().unwrap();
+        if last.is_some_and(|t| t.elapsed() < START_GRACE) {
+            return Ok(()); // already starting: the caller just waits for /salud
+        }
+        *last = Some(std::time::Instant::now());
+    }
+    let dir = agent_dir().ok_or_else(|| "No encuentro la carpeta del agente (agentes\\plata\\servir.ts).".to_string())?;
+    let log_path = crate::settings::local_dir().join("plata-agent.log");
+    let log = std::fs::File::create(&log_path).map_err(|e| e.to_string())?;
+    let err = log.try_clone().map_err(|e| e.to_string())?;
+    Command::new("cmd")
+        .args(["/C", "npm", "run", "servir"])
+        .current_dir(&dir)
+        .stdin(Stdio::null())
+        .stdout(log)
+        .stderr(err)
+        .creation_flags(CREATE_NO_WINDOW)
+        .spawn()
+        .map_err(|e| format!("No se pudo arrancar el agente: {e}"))?;
+    crate::log::line(format!("plata agent started in {}", dir.display()));
+    Ok(())
+}
+
+// ── Attachments: a card statement (PDF) or a screenshot to reconcile ────────
+// The page only ever holds paths. The bytes are read here, checked against the
+// agent's limits (CONTRATOS §9: 3 files, 8 MB decoded in total, PDF / PNG /
+// JPEG / WebP) and sent as base64 in `adjuntos`, so they never cross the IPC.
+
+pub const MAX_ATTACHMENTS: usize = 3;
+pub const MAX_ATTACHMENT_BYTES: u64 = 8 * 1024 * 1024;
+
+#[derive(Serialize, Clone, Debug)]
+#[serde(rename_all = "camelCase")]
+pub struct AttachmentInfo {
+    pub name: String,
+    pub size: u64,
+    pub media_type: &'static str,
+}
+
+/// The type is read from the first bytes, not trusted to the extension: the
+/// agent rejects a file whose content doesn't match the declared type.
+fn sniff(head: &[u8]) -> Option<&'static str> {
+    if head.starts_with(b"%PDF-") {
+        Some("application/pdf")
+    } else if head.starts_with(&[0x89, b'P', b'N', b'G', 0x0d, 0x0a, 0x1a, 0x0a]) {
+        Some("image/png")
+    } else if head.starts_with(&[0xff, 0xd8, 0xff]) {
+        Some("image/jpeg")
+    } else if head.len() >= 12 && &head[..4] == b"RIFF" && &head[8..12] == b"WEBP" {
+        Some("image/webp")
+    } else {
+        None
+    }
+}
+
+fn file_name(path: &std::path::Path) -> String {
+    path.file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| "archivo".into())
+}
+
+fn mb(bytes: u64) -> String {
+    format!("{:.1} MB", bytes as f64 / 1024.0 / 1024.0).replace('.', ",")
+}
+
+/// Checks a dropped file without reading all of it: the chip shows up (or the
+/// reason it can't) as soon as the file is dropped, not when the message goes.
+pub fn attachment_info(path: &str) -> Result<AttachmentInfo, String> {
+    use std::io::Read;
+    let p = std::path::Path::new(path);
+    let name = file_name(p);
+    let meta = std::fs::metadata(p).map_err(|e| format!("No pude leer «{name}»: {e}"))?;
+    if !meta.is_file() {
+        return Err(format!("«{name}» es una carpeta: soltá el PDF o la captura del resumen."));
+    }
+    if meta.len() > MAX_ATTACHMENT_BYTES {
+        return Err(format!("«{name}» pesa {}: el agente acepta hasta {} entre todos los adjuntos.", mb(meta.len()), mb(MAX_ATTACHMENT_BYTES)));
+    }
+    let mut head = [0u8; 16];
+    let n = std::fs::File::open(p)
+        .and_then(|mut f| f.read(&mut head))
+        .map_err(|e| format!("No pude leer «{name}»: {e}"))?;
+    let media_type = sniff(&head[..n]).ok_or_else(|| format!("«{name}» no es un PDF ni una imagen (PNG, JPG o WebP)."))?;
+    Ok(AttachmentInfo { name, size: meta.len(), media_type })
+}
+
+/// Reads every attachment and builds the `adjuntos` array, enforcing the same
+/// limits the agent does so a bad file fails here with a clear message.
+fn read_attachments(paths: &[String]) -> Result<Vec<Value>, String> {
+    if paths.len() > MAX_ATTACHMENTS {
+        return Err(format!("Hasta {MAX_ATTACHMENTS} adjuntos por mensaje."));
+    }
+    let mut total: u64 = 0;
+    let mut out = Vec::with_capacity(paths.len());
+    for path in paths {
+        let p = std::path::Path::new(path);
+        let name = file_name(p);
+        // The size first, so a file that grew since it was dropped isn't read whole.
+        let size = std::fs::metadata(p).map_err(|e| format!("No pude leer «{name}»: {e}"))?.len();
+        if total + size > MAX_ATTACHMENT_BYTES {
+            return Err(format!("Los adjuntos pasan de {} entre todos: sacá alguno.", mb(MAX_ATTACHMENT_BYTES)));
+        }
+        let bytes = std::fs::read(p).map_err(|e| format!("No pude leer «{name}»: {e}"))?;
+        total += bytes.len() as u64;
+        if total > MAX_ATTACHMENT_BYTES {
+            return Err(format!("Los adjuntos pasan de {} entre todos: sacá alguno.", mb(MAX_ATTACHMENT_BYTES)));
+        }
+        let media_type = sniff(&bytes).ok_or_else(|| format!("«{name}» no es un PDF ni una imagen (PNG, JPG o WebP)."))?;
+        out.push(json!({ "nombre": name, "media_type": media_type, "base64": crate::claude::base64_for(&bytes) }));
+    }
+    Ok(out)
+}
+
+/// %LOCALAPPDATA%\Coucou\plata-chat.log: the Plata chat, one line per message
+/// and per event, so a turn that went wrong can be read afterwards (the agent
+/// keeps conversations in memory only). Local file; restarted past 5 MB.
+pub(crate) fn transcript(sesion_id: &str, kind: &str, body: &str) {
+    use std::io::Write;
+    let path = crate::settings::local_dir().join("plata-chat.log");
+    if std::fs::metadata(&path).map(|m| m.len() > 5_000_000).unwrap_or(false) {
+        let _ = std::fs::remove_file(&path);
+    }
+    let stamp = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0);
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(f, "{stamp} {sesion_id} {kind} {}", body.replace('\n', "\\n"));
+    }
+}
+
+/// What an event looks like in the transcript: text in full, data results
+/// reduced to the tool name (they can be large).
+fn transcript_event(sesion_id: &str, ev: &Value) {
+    let tipo = ev.get("tipo").and_then(Value::as_str).unwrap_or("?");
+    let body = match tipo {
+        "resultado" => ev.get("nombre").and_then(Value::as_str).unwrap_or("").to_string(),
+        _ => ev.to_string(),
+    };
+    transcript(sesion_id, tipo, &body);
+}
+
+/// One message. Every event of the stream reaches the page as it arrives; the
+/// call returns when the turn ends. `adjuntos` are file paths (see above).
+pub async fn send(app: AppHandle, texto: String, sesion_id: String, adjuntos: Vec<String>) -> Result<(), String> {
+    // Up to 8 MB of reading and encoding: off the async runtime's threads.
+    let adjuntos = tauri::async_runtime::spawn_blocking(move || read_attachments(&adjuntos))
+        .await
+        .map_err(|e| e.to_string())??;
+
+    let mut body = json!({ "texto": texto, "sesion_id": sesion_id, "resultados": true });
+    let nombres: Vec<String> = adjuntos
+        .iter()
+        .filter_map(|a| a.get("nombre").and_then(Value::as_str).map(str::to_string))
+        .collect();
+    transcript(
+        &sesion_id,
+        "lucas",
+        &if nombres.is_empty() { texto.clone() } else { format!("{texto} [adjuntos: {}]", nombres.join(", ")) },
+    );
+    if !adjuntos.is_empty() {
+        body["adjuntos"] = Value::Array(adjuntos);
+    }
+
+    let client = reqwest::Client::builder()
+        .connect_timeout(std::time::Duration::from_secs(3))
+        // A turn with several tools and a proposal takes a while; this is only
+        // the backstop for a server that stops answering altogether.
+        .timeout(std::time::Duration::from_secs(600))
+        .build()
+        .map_err(|e| e.to_string())?;
+
+    let mut response = client
+        .post(format!("{BASE}/agentes/plata/mensaje"))
+        // `resultados`: the data behind saldos / resumen_mensual / serie_patrimonio
+        // comes as its own event, so the island draws cards from it.
+        .json(&body)
+        .send()
+        .await
+        .map_err(|e| {
+            if e.is_connect() {
+                "agent_down".to_string()
+            } else {
+                format!("No pude hablar con el agente: {e}")
+            }
+        })?;
+
+    if !response.status().is_success() {
+        let status = response.status();
+        let body: Value = response.json().await.unwrap_or(Value::Null);
+        let msg = body.get("error").and_then(Value::as_str).unwrap_or("sin detalle");
+        return Err(format!("El agente respondió {status}: {msg}"));
+    }
+
+    // Server-sent events: frames end in a blank line; we only care about `data:`.
+    let mut buf: Vec<u8> = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|e| format!("Se cortó la respuesta: {e}"))? {
+        buf.extend_from_slice(&chunk);
+        while let Some(end) = find_frame_end(&buf) {
+            let frame: Vec<u8> = buf.drain(..end + 2).collect();
+            let text = String::from_utf8_lossy(&frame);
+            for line in text.lines() {
+                let Some(data) = line.strip_prefix("data:") else { continue };
+                let Ok(ev) = serde_json::from_str::<Value>(data.trim_start()) else { continue };
+                transcript_event(&sesion_id, &ev);
+                let _ = app.emit_to(
+                    crate::island::WINDOW_LABEL,
+                    "plata-event",
+                    PlataEvent { sesion_id: sesion_id.clone(), ev },
+                );
+            }
+        }
+    }
+    Ok(())
+}
+
+fn find_frame_end(buf: &[u8]) -> Option<usize> {
+    buf.windows(2).position(|w| w == b"\n\n")
+}
