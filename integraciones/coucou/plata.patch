+// ── Plata ─────────────────────────────────────────────────────────────────────
+// Windows-only, no Swift twin. Spanish on purpose: it is the app's own language.
+
+const PLATA = "#FF9E1B";
+
+/** `$ 6.791,50`, `US$ 4,11` — how Plata writes money. */
+function money(amount: unknown, currency: unknown): string {
+  const n = Number(amount ?? 0);
+  const cur = String(currency ?? "ARS");
+  const symbol = cur === "ARS" ? "$" : cur === "USD" ? "US$" : cur;
+  const digits = Number.isInteger(n) ? 0 : 2;
+  const text = Math.abs(n).toLocaleString("es-AR", { minimumFractionDigits: digits, maximumFractionDigits: 2 });
+  return `${n < 0 ? "-" : ""}${symbol} ${text}`;
+}
+
+function plataCard(onDetail: () => void): HTMLElement {
+  const d = get("integration_plata");
+  const problems = Array.isArray(d.problems) ? (d.problems as string[]) : [];
+  const importer = (d.importer ?? {}) as Record<string, unknown>;
+  const fx = (d.fx ?? {}) as Record<string, unknown>;
+  const tx = (d.lastTx ?? null) as Record<string, unknown> | null;
+
+  const rows = h("div", { class: "int-rows" });
+  if (problems.length > 0) {
+    const more = h("button", { class: "int-more", title: "Detalle", onclick: onDetail }, svg(ICONS.ellipsis, 8));
+    rows.append(listRow("#F4505E", true, h("span", { class: "int-name", text: problems[0] }), more));
+  } else {
