+// ── Tarea rápida ───────────────────────────────────────────────────────────
+
+test("tarea rápida: the day comes out of the text, the rest is the title", () => {
+  const hoy = "2026-10-07"; // miércoles
+  const cases: Array<[string, string, string | null]> = [
+    ["mañana a la noche llamar al contador", "Llamar al contador a la noche", "2026-10-08"],
+    ["recordame el jueves llamar al contador", "Llamar al contador", "2026-10-08"],
+    ["Recordame que el viernes, pagar la luz", "Pagar la luz", "2026-10-09"],
+    ["pasado mañana gimnasio", "Gimnasio", "2026-10-09"],
+    ["hoy a las 18 hs reunión", "Reunión a las 18 hs", "2026-10-07"],
+    ["pagar expensas el 10", "Pagar expensas", "2026-10-10"],
+    ["pagar expensas el 5", "Pagar expensas", "2026-11-05"],
+    ["turno médico 15/10", "Turno médico", "2026-10-15"],
+    ["turno 3/1", "Turno", "2027-01-03"],
+    ["reunión el 10 de noviembre", "Reunión", "2026-11-10"],
+    ["en 3 días mandar mail", "Mandar mail", "2026-10-10"],
+    ["semana que viene ver depto", "Ver depto", "2026-10-14"],
+    // Said on a Wednesday, "el miércoles" is next week's.
+    ["el miércoles revisar", "Revisar", "2026-10-14"],
+    // A time of day isn't a day.
+    ["llamar a mamá esta mañana", "Llamar a mamá esta mañana", null],
+    ["comprar pan", "Comprar pan", null],
+    ["llamar el 12 a las 15", "Llamar a las 15", "2026-10-12"],
+    ["mañana", "", "2026-10-08"],
+  ];
+  for (const [text, titulo, vence] of cases) {
+    assert.deepEqual(parseTareaRapida(text, hoy), { titulo, vence }, text);
+  }
+});
+
+test("tarea rápida: impossible dates don't become a day", () => {
+  assert.equal(parseTareaRapida("algo 31/2", "2026-10-07").vence, null);
+  assert.equal(parseTareaRapida("algo el 31", "2026-11-05").vence, "2026-12-31");
+  assert.equal(parseTareaRapida("cierre el 31", "2026-12-31").vence, "2026-12-31");
+});
