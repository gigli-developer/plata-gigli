+
+.lz-dayline span {
+  position: absolute;
+  left: 0;
+  right: 0;
+  border-radius: 3px;
+}
+
+.lz-dayline .busy { background: rgba(255, 255, 255, 0.12); }
+.lz-dayline .free { background: rgba(var(--rgb), 0.35); border: 1px solid rgba(var(--rgb), 0.7); }
+.lz-dayline .past { background: repeating-linear-gradient(135deg, rgba(0, 0, 0, 0.45) 0 3px, transparent 3px 6px); border-radius: 0; }
+
+/* Drop zone (Conciliar) and "coming soon" notes */
+.lz-drop {
