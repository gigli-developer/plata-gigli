+        SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_ASYNCWINDOWPOS;
+    unsafe {
+        let _ = SetWindowPos(hwnd, None, x, y, 0, 0, flags);
+    }
