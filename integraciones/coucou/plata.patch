+  font: 500 10.5px var(--mono);
+  color: var(--dim-3);
+}
+
+.lz-cost-line {
+  margin-left: 0;
+  text-align: right;
+}
+
+.lz-falta {
+  color: #ffc65c;
+  padding: 4px 2px;
+}
+
+/* Bars (¿Cómo voy este mes?) */
+.lz-bars {
+  display: grid;
+  gap: 5px;
+}
+
+.lz-bar-r {
+  display: grid;
+  grid-template-columns: 96px 1fr 88px;
+  gap: 8px;
+  align-items: center;
+  font-size: 12px;
