+/// Decides the dock from where the island was dropped and stores it.
+fn dock_after_drag(app: &AppHandle, win: &WebviewWindow) -> Option<crate::settings::Settings> {
+    let shared = app.try_state::<crate::Shared>()?;
+    let pref = shared.settings.lock().unwrap().screen.clone();
+    let m = target_monitor(app, &pref)?;
+    let scale = m.scale_factor();
+    let mp = *m.position();
+    let wa = m.work_area();
+    let origin = win.outer_position().ok()?;
+    let r = *shared.gate.rect.lock().unwrap();
+
+    // The island's edges on screen, in physical px.
+    let left = origin.x as f64 + r.x * scale;
+    let right = left + r.w * scale;
+    let top = origin.y as f64 + r.y * scale;
+    let from_left = (left - wa.position.x as f64) / scale;
+    let from_right = ((wa.position.x + wa.size.width as i32) as f64 - right) / scale;
+    let from_top = (top - mp.y as f64) / scale;
+
+    let dock = if from_left < SNAP {
+        "left"
+    } else if from_right < SNAP {
+        "right"
+    } else if from_top < SNAP {
+        "top"
+    } else {
+        "float"
+    };
