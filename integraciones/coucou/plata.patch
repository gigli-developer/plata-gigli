+      taskBox(t),
+      acts(go, done, later, other, st, opts.length > 1 ? h("span", { class: "lz-sub lz-push", text: `${i + 1} de ${opts.length}` }) : null),
+    );
+  };
+  paint();
+}
+
+// ── Avisos de Mochi ─────────────────────────────────────────────────────────
+
+async function avisos(c: Card) {
+  const r = await load(c, false, "avisos");
+  if (!r) return;
+  const { f } = r;
+  if (!f.avisos) {
+    c.says("No pude leer los avisos de hoy.");
+    c.set(errLine("coucou-foco no trajo la lista de avisos."));
+    return;
+  }
+  const groups = groupAvisos(f.avisos);
+  const n = f.avisos.length;
+  const sinEntregar = f.avisos.filter((a) => !a.entregado).length;
+  if (!n) {
+    c.says("Hoy no te mandé ningún aviso. **Tranqui.**");
+  } else {
+    c.says(
+      `Hoy te mandé **${palabra(n)} ${plural(n, "aviso", "avisos")}** sobre ${palabra(groups.length)} ${plural(groups.length, "tema", "temas")}` +
+        (sinEntregar ? `; ${palabra(sinEntregar)} no ${plural(sinEntregar, "llegó", "llegaron")} a salir.` : "."),
+    );
+  }
+  const ladder = h("div", { class: "lz-ladder" });
+  for (const g of groups) {
+    const rungs = Math.max(4, g.nivel);
+    const steps = h("span", { class: "lz-steps", title: "Escalones del aviso" });
+    for (let k = 1; k <= rungs; k++) steps.append(h("i", { class: k <= g.nivel ? "on" : "" }));
+    const tail = [horaDe(g.ultimo.hora), g.ultimo.cuerpo, g.cantidad > 1 ? `${g.cantidad} avisos` : null, g.nivel === 0 && g.ultimo.nivelTexto ? `nivel ${g.ultimo.nivelTexto}` : null]
+      .filter(Boolean)
+      .join(" · ");
+    ladder.append(h("div", { class: "lz-lq" }, h("b", { text: g.ultimo.titulo || g.tipo }), steps, h("small", { text: tail })));
+  }
+  c.set(
+    groups.length ? ladder : null,
+    acts(
+      btn("Ir al cierre", "prim", () => c.host.open("cierre"), { enter: true }),
+      btn("Mi día", "sec", () => c.host.open("dia")),
+    ),
+  );
+}
+
+// ── Cerrar el día ───────────────────────────────────────────────────────────
+
+async function cierre(c: Card) {
+  const r = await load(c, true, "cierre");
+  if (!r) return;
+  const { f, cal } = r;
+  const now = arClock();
+  const habitos = f.habitos;
+  const sayLine = () => {
+    const hechos = habitos?.filter((x) => x.hecho_hoy).length ?? 0;
+    const parts = [`Cierre del ${DIAS[now.weekday]}.`];
+    if (f.hechasHoy !== null) parts.push(`**${palabra(f.hechasHoy, true)} ${plural(f.hechasHoy, "tarea hecha", "tareas hechas")}**`);
+    if (habitos?.length) parts.push(`${f.hechasHoy !== null ? "y " : ""}${hechos === 0 ? "ningún hábito marcado" : `${hechos} de ${habitos.length} hábitos marcados`}.`);
+    else if (f.hechasHoy !== null) parts[parts.length - 1] += ".";
+    c.says(parts.join(" "));
+  };
+  sayLine();
+
+  // Each habit is a toggle: it changes right away and goes back if the write fails.
+  const habSt = statusEl();
+  const habBox = habitos
+    ? box(
+        "Hábitos de hoy",
+        habitos.length ? "tocá para marcar" : null,
+        habitos.length
+          ? h(
+              "div",
+              { class: "lz-habits" },
+              ...habitos.map((x) => {
+                const b = h("button", { type: "button", class: "lz-habit", "aria-pressed": String(x.hecho_hoy), title: x.hecho_hoy ? "Hecho: tocá para desmarcar" : "Tocá para marcarlo" }, h("i"), x.nombre) as HTMLButtonElement;
+                b.style.setProperty("--hc", x.color ?? CDC);
+                b.disabled = !x.id;
+                b.addEventListener("click", async (e) => {
+                  e.stopPropagation();
+                  if (b.disabled) return;
+                  const want = !x.hecho_hoy;
+                  b.setAttribute("aria-pressed", String(want));
+                  const r = await hacer(c, habSt, [b], "habito", { id: x.id, hecho: want }, want ? "Marcando…" : "Desmarcando…");
+                  if (!c.alive()) return;
+                  if (!r) {
+                    b.setAttribute("aria-pressed", String(x.hecho_hoy));
+                    return;
+                  }
+                  x.hecho_hoy = want;
+                  b.title = want ? "Hecho: tocá para desmarcar" : "Tocá para marcarlo";
+                  if (want) c.happy();
+                  sayLine();
+                });
+                return b;
+              }),
+              habSt,
+            )
+          : h("div", { class: "lz-sub", text: "No tenés hábitos cargados." }),
+      )
+    : box("Hábitos de hoy", null, h("div", { class: "lz-sub lz-missing", text: "No pude leer los hábitos." }));
+
+  const count = (n: number | null | undefined, one: string, many: string) => (n == null ? null : `${n} ${plural(n, one, many)}`);
+  const pendTipos = new Map<string, number>();
+  for (const p of f.pendientes ?? []) pendTipos.set(p.tipo, (pendTipos.get(p.tipo) ?? 0) + 1);
+  const pendLine = [
+    count(f.atrasadas?.length, "atrasada", "atrasadas"),
+    count(f.paraHoy?.length, "para hoy", "para hoy"),
+    count(f.sinFecha, "sin fecha", "sin fecha"),
+  ].filter(Boolean).join(" · ");
+  // What's due today or late and still open: one button passes it all to tomorrow.
+  const arrastrar = [...(f.atrasadas ?? []), ...(f.paraHoy ?? [])].filter((t) => t.id);
+  const pendBox = box(
+    "Pendiente",
+    f.pendientes ? `${f.pendientes.length} por decidir` : null,
+    h("div", { class: "lz-sub lz-strong", text: pendLine || "No pude leer los pendientes." }),
+    pendTipos.size ? h("div", { class: "lz-sub", text: [...pendTipos].map(([t, n]) => `${t.replace(/_/g, " ")}: ${n}`).join(" · ") }) : null,
+    arrastrar.length
+      ? moverGrupo(c, arrastrar, arrastrar.length === 1 ? "Pasarla a mañana" : `Pasar las ${palabra(arrastrar.length, true)} a mañana`)
+      : null,
+  );
+
+  let manana: string | null = null;
+  if (cal.ok) {
+    const tomorrow = addDays(now.date, 1);
+    const { timed } = dayEvents(cal.data, tomorrow);
+    const big = [...timed].sort((a, b) => (b.end - b.start) - (a.end - a.start))[0];
+    const base = arMs(tomorrow);
+    manana = big ? `Mañana: ${big.title} de ${hm((big.start - base) / 60_000)} a ${hm((big.end - base) / 60_000)}.` : "Mañana: calendario libre.";
+  }
+  c.set(
+    habBox,
+    pendBox,
+    acts(
+      btn("Planificar mañana", "prim", () => c.host.open("manana"), { enter: true }),
+      appButton(c, f),
+      manana ? h("span", { class: "lz-sub", text: manana }) : null,
+    ),
+  );
+}
+
+// ── Planificar mañana ───────────────────────────────────────────────────────
+
+async function manana(c: Card) {
+  const r = await load(c, true, "manana");
+  if (!r) return;
+  const { f, cal } = r;
+  const now = arClock();
+  const tomorrow = addDays(now.date, 1);
+  const sugg = suggestTomorrow(f);
+  const parts: string[] = [];
+  let slot: Span | null = null;
+  const planned: Array<{ t: Candidate; s: number; e: number }> = [];
+  if (cal.ok) {
+    const { timed } = dayEvents(cal.data, tomorrow);
+    const base = arMs(tomorrow);
+    const big = [...timed].sort((a, b) => (b.end - b.start) - (a.end - a.start))[0];
+    if (!timed.length) parts.push("Mañana tenés **el calendario libre**.");
+    else if (big && big.end - big.start >= 3 * 3_600_000) parts.push(`Mañana tenés **${big.title} de ${hm((big.start - base) / 60_000)} a ${hm((big.end - base) / 60_000)}**.`);
+    else parts.push(`Mañana tenés **${palabra(timed.length, true)} ${plural(timed.length, "cosa", "cosas")}** en el calendario.`);
+    slot = longest(freeSlots(dayBusy(timed, base)));
+    if (slot) {
+      parts.push(`El hueco más grande es de **${hm(slot.s)} a ${hm(slot.e)}**.`);
+      let at = nextHalfHour(slot.s);
+      for (const t of sugg) {
+        const len = Math.min(60, slot.e - at);
+        if (len < 30) break;
+        planned.push({ t, s: at, e: at + len });
+        at = nextHalfHour(at + len + 15);
+      }
+    } else parts.push("No te queda ningún hueco de media hora entre las 7 y las 23.");
+  }
+  if (sugg.length) parts.push(sugg.length === 1 ? "Te sugiero una cosa:" : `Te sugiero dos cosas${planned.length ? " para ahí" : ""}:`);
+  else parts.push("No hay tareas que empujar para mañana.");
+  c.says(parts.join(" "));
+
+  const extra: TlEvent[] = planned.map((p, k) => ({ s: p.s, e: p.e, label: p.t.titulo, color: k === 0 ? "rgba(124,196,255,.8)" : "rgba(124,196,255,.55)" }));
+  const list = sugg.length
+    ? box(
+        null,
+        null,
+        ...sugg.map((t) => {
+          const p = planned.find((x) => x.t === t);
+          const tone = t.why === "atrasada" ? "late" : t.dias <= 1 ? "soon" : "";
+          const label = t.why === "atrasada" ? `${t.dias} d tarde` : t.vence ? `vence ${fechaCorta(t.vence)}` : enDias(t.dias);
+          return li(t.color ?? CDC, `${t.titulo}${p ? ` · ${hhmm(p.s)} a ${hhmm(p.e)}` : ""}`, pill(label, tone));
+        }),
+      )
+    : null;
+  c.set(
+    dayBox(c, fechaLarga(tomorrow), cal, tomorrow, null, "manana", extra),
+    list,
+    // Give them tomorrow's date (those that don't have it yet). The calendar isn't touched.
+    sugg.some((t) => t.id && t.vence !== tomorrow)
+      ? moverGrupo(c, sugg.filter((t) => t.id && t.vence !== tomorrow), sugg.length === 1 ? "Ponerla para mañana" : "Ponerlas para mañana", { confirm: false })
+      : null,
+    planned.length ? note("Les pongo fecha; en el calendario no las agendo.") : null,
+    acts(
+      btn("Ver huecos", "prim", () => c.host.open("huecos"), { enter: true }),
+      btn("Lo que vence", "sec", () => c.host.open("vence")),
+    ),
+  );
+}
+
+// ── Lo que vence ────────────────────────────────────────────────────────────
+
+async function vence(c: Card) {
+  const r = await load(c, false, "vence");
+  if (!r) return;
+  const { f } = r;
+  if (!f.proximas) {
+    c.says("No pude leer lo que vence.");
+    c.set(errLine("coucou-foco no trajo la lista de próximas."));
+    return;
+  }
+  const prox = [...f.proximas].sort((a, b) => a.en_dias - b.en_dias);
+  const atr = [...(f.atrasadas ?? [])].sort((a, b) => b.dias_atraso - a.dias_atraso);
+  const n = prox.length;
+  let line =
+    n === 0
+      ? "En los próximos 10 días **no vence nada**."
+      : n === 1
+        ? `En los próximos 10 días vence **una sola cosa**: ${prox[0].titulo}${prox[0].vence ? `, el **${fechaCorta(prox[0].vence)}**` : ""}.`
+        : `En los próximos 10 días vencen **${palabra(n, true)} cosas**; la primera, **${prox[0].titulo}**${prox[0].vence ? `, el **${fechaCorta(prox[0].vence)}**` : ""}.`;
+  if (atr.length) line += ` Y arrastrás **${palabra(atr.length, true)} ${plural(atr.length, "atrasada", "atrasadas")}**.`;
+  c.says(line);
+  // Each row can be ticked (✓) or passed to tomorrow (→) right here.
+  const st = statusEl();
+  const rows = [
+    ...atr.slice(0, 3).map((t) => taskRow(c, st, t, pill(`${t.dias_atraso} d tarde`, "late"))),
+    ...prox.slice(0, 7).map((t) => taskRow(c, st, t, pill(`${t.vence ? `${fechaCorta(t.vence)} · ` : ""}${enDias(t.en_dias)}`, t.en_dias <= 3 ? "soon" : ""))),
+  ];
+  const resto = [
+    atr.length > 3 ? `${atr.length - 3} ${plural(atr.length - 3, "atrasada", "atrasadas")}` : null,
+    prox.length > 7 ? `${prox.length - 7} ${plural(prox.length - 7, "próxima", "próximas")}` : null,
+  ].filter(Boolean);
+  c.set(
+    rows.length ? box(null, null, ...rows) : null,
+    h("div", { class: "lz-acts" }, resto.length ? note(`y ${resto.join(" y ")} más`) : null, st),
+    acts(
+      btn("Planificar mañana", "prim", () => c.host.open("manana"), { enter: true }),
+      btn("Ver huecos", "sec", () => c.host.open("huecos")),
+    ),
+  );
+}
+
+// ── Huecos de la semana ─────────────────────────────────────────────────────
+
+async function huecos(c: Card) {
+  c.loading("Miro tu calendario…");
+  let cal: data.CalendarData;
+  try {
+    cal = await data.calendar();
+  } catch (err) {
+    if (!c.alive()) return;
+    c.think(false);
+    c.says("Para ver tus huecos necesito **tu calendario**.");
+    c.set(calProblem(c, err, "huecos"));
+    return;
+  }
+  if (!c.alive()) return;
+  c.think(false);
+  const now = arClock();
+  const startToday = now.min < 18 * 60;
+  const first = startToday ? now.date : addDays(now.date, 1);
+  const days = Array.from({ length: 5 }, (_, k) => addDays(first, k));
+  const span = DAY_TO - DAY_FROM;
+  let best: { date: string; slot: Span } | null = null;
+  let sum = 0;
+  const grid = h("div", { class: "lz-slots" });
+  for (const date of days) {
+    const base = arMs(date);
+    const evs = cal.between(base, base + DAY_MS);
+    const busy = dayBusy(evs, base);
+    const free = freeSlots(busy, { notBefore: date === now.date ? now.min : undefined });
+    const big = longest(free);
+    sum += total(free);
+    if (big && (!best || big.e - big.s > best.slot.e - best.slot.s)) best = { date, slot: big };
+    const line = h("div", { class: "lz-dayline" });
+    const put = (cls: string, x: Span) => {
+      const s = Math.max(x.s, DAY_FROM);
+      const e = Math.min(x.e, DAY_TO);
+      if (e <= s) return;
+      const el = h("span", { class: cls });
+      el.style.top = `${((s - DAY_FROM) / span) * 100}%`;
+      el.style.height = `${((e - s) / span) * 100}%`;
+      line.append(el);
+    };
+    busy.forEach((b) => put("busy", b));
+    free.forEach((f) => put("free", f));
+    if (date === now.date) put("past", { s: DAY_FROM, e: now.min });
+    const fullDay = free.length === 1 && free[0].s === DAY_FROM && free[0].e === DAY_TO;
+    const label = fullDay ? "todo el día" : big ? `${hm(big.s)}–${hm(big.e)}` : "sin huecos";
+    const [wd, dn] = fechaCorta(date).split(" ");
+    grid.append(h("div", { class: "lz-slot-d" }, h("h6", {}, `${date === now.date ? "hoy" : wd} `, h("b", { text: dn })), line, h("small", { class: big ? "" : "none", text: label })));
+  }
+  const hours = Math.round(sum / 60);
+  const dayName = (d: string) => (d === now.date ? "hoy" : d === addDays(now.date, 1) ? "mañana" : `el ${fechaCorta(d)}`);
+  c.says(
+    hours === 0
+      ? "En estos cinco días **no te queda tiempo libre** entre las 7 y las 23."
+      : `En estos cinco días tenés **unas ${palabra(hours, true)} horas libres** entre las 7 y las 23.` +
+          (best ? ` El mejor bloque es **${dayName(best.date)} de ${hm(best.slot.s)} a ${hm(best.slot.e)}**.` : ""),
+  );
+  c.set(grid, cal.failed ? note(`${cal.failed} ${plural(cal.failed, "calendario no se pudo", "calendarios no se pudieron")} leer.`) : null, acts(btn("Planificar mañana", "sec", () => c.host.open("manana"))));
+}
+
+// ── Tarea rápida ────────────────────────────────────────────────────────────
+
+/** "para hoy", "para mañana (jue 8)", "para el vie 9", "sin fecha" */
+function cuandoTexto(vence: string | null): string {
+  if (!vence) return "sin fecha";
+  const hoy = arClock().date;
+  if (vence === hoy) return "para hoy";
+  if (vence === addDays(hoy, 1)) return `para mañana (${fechaCorta(vence)})`;
+  return `para el ${fechaCorta(vence)}`;
+}
+
+function tarea(c: Card, pre: string | null) {
+  c.says("Escribila como te sale. Yo le pongo el día.");
+  const input = h("input", { type: "text", placeholder: "Ej: mañana a la noche llamar al contador", "aria-label": "Tarea nueva", autocomplete: "off", spellcheck: "false" }) as HTMLInputElement;
+  input.value = pre ?? "";
+  // What it understood, live: the title and the day.
+  const hint = h("div", { class: "lz-sub lz-hint" });
+  const st = statusEl();
+  const parse = () => parseTareaRapida(input.value, arClock().date);
+  const paintHint = () => {
+    const p = parse();
+    hint.replaceChildren();
+    if (!input.value.trim()) {
+      hint.textContent = "Entiendo hoy, mañana, el viernes, el 15, 15/10, en 3 días…";
+      return;
+    }
+    if (!p.titulo) {
+      hint.textContent = `${capital(cuandoTexto(p.vence))}: falta qué hay que hacer.`;
+      return;
+    }
+    hint.append(h("b", { text: p.titulo }), ` · ${cuandoTexto(p.vence)}`);
+  };
+  let busy = false;
+  const guardar = async () => {
+    if (busy) return;
+    const p = parse();
+    if (!p.titulo) {
+      tell(st, "Escribí qué hay que hacer.", "bad");
+      input.focus();
+      return;
+    }
+    busy = true;
+    input.disabled = true;
+    const r = await hacer(c, st, [save], "nueva", { titulo: p.titulo, vence: p.vence }, "Guardando…");
+    busy = false;
+    input.disabled = false;
+    if (!r || !c.alive()) return;
+    c.happy();
+    const id = String(r.id ?? "");
+    c.says(`Anotada: **${p.titulo}**, ${cuandoTexto(p.vence)}.`);
+    const st2 = statusEl();
+    const otra = btn("Otra tarea", "prim", () => c.host.open("tarea", null, { send: false }), { enter: true });
+    const undo: HTMLButtonElement | null = id
+      ? btn("Deshacer", "sec", async () => {
+          if (!(await hacer(c, st2, [otra, undo], "borrar_nueva", { id }, "Borrando…")) || !c.alive()) return;
+          c.says("Listo, **no la anoté**.");
+          undo?.remove();
+        })
+      : null;
+    c.set(acts(otra, undo, st2));
+  };
+  const save = btn("Guardar", "prim", () => void guardar(), { enter: true });
+  input.addEventListener("input", () => {
+    paintHint();
+    if (st.classList.contains("bad")) tell(st, "");
+  });
+  input.addEventListener("keydown", (e) => {
+    if (e.key === "Enter" && !e.isComposing) {
+      e.preventDefault();
+      void guardar();
+    }
+  });
+  paintHint();
+  c.set(
+    h("label", { class: "lz-qin" }, input, h("span", { class: "lz-mic" }, h("kbd", { text: "Win" }), " ", h("kbd", { text: "H" }), " dictar")),
+    hint,
+    acts(save, st),
+  );
+  window.setTimeout(() => {
+    if (!c.alive()) return;
+    input.focus();
+    input.setSelectionRange(input.value.length, input.value.length);
+  }, 150);
+  // "Abrir en la app", if the Centro said where it lives (cached, no new request).
+  void data.foco().then((f) => {
+    const b = c.alive() ? appButton(c, f) : null;
+    if (b) save.after(b);
+  }, () => {});
+}
+
+export const CENTRO_RUN: Record<"dia" | "ahora" | "avisos" | "cierre" | "manana" | "vence" | "huecos" | "tarea", Runner> = {
+  dia: (c) => void dia(c),
+  ahora: (c) => void ahora(c),
+  avisos: (c) => void avisos(c),
+  cierre: (c) => void cierre(c),
+  manana: (c) => void manana(c),
+  vence: (c) => void vence(c),
+  huecos: (c) => void huecos(c),
+  tarea: (c, pre) => tarea(c, pre),
+};
+
