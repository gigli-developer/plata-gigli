+
+function deuda(c: Card) {
+  c.loading("Miro quién te debe y a quién le debés…");
+  data.plata("deudas").then((d) => {
+    if (!c.alive()) return;
+    c.think(false);
+    const list = arr(d.personas);
+    if (!list) {
+      c.fail(new Error("la respuesta no trae la lista de personas"), "tus deudas", () => c.host.open("deuda"));
+      return;
+    }
+    type Entry = { persona: string; dir: "te debe" | "debés"; monto: number; moneda: string };
+    const entries: Entry[] = [];
+    for (const x of list) {
+      const persona = str(x.persona) || "(sin nombre)";
+      const moneda = str(x.moneda) || "ARS";
+      const teDebe = num(x.te_debe);
+      const debes = num(x.debes);
+      if (teDebe && teDebe > 0) entries.push({ persona, dir: "te debe", monto: teDebe, moneda });
+      if (debes && debes > 0) entries.push({ persona, dir: "debés", monto: debes, moneda });
+    }
+    data.rememberPersonas(entries.map((e) => e.persona));
+    if (!entries.length) {
+      c.says("No tenés deudas pendientes con nadie. **Todo saldado.**");
+      c.set(acts(btn("Contar una situación", "sec", () => c.host.open("situacion"))));
