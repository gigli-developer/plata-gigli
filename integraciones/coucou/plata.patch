+    const out = h("div");
+    const grid = h("div", { class: "lz-row3 lz-picks" });
+    entries.slice(0, 9).forEach((x) => {
+      const b = h(
+        "button",
+        { type: "button", class: "lz-box lz-pick" },
+        h("h5", {}, h("span", { text: x.persona })),
+        h("div", { class: `lz-big${x.dir === "debés" ? " late" : ""}`, style: "font-size:16px", text: money(x.monto, x.moneda) }),
+        h("div", { class: "lz-sub", text: x.dir }),
+      );
+      b.addEventListener("click", () => {
+        grid.querySelectorAll(".lz-pick").forEach((p) => p.classList.toggle("sel", p === b));
+        pick(x);
+      });
+      grid.append(b);
+    });
+    const pick = (x: Entry) => {
+      const amount = money(x.monto, x.moneda);
+      const full = x.dir === "te debe" ? `${x.persona} me pagó ${amount}, todo lo que me debía.` : `Le pagué a ${x.persona} ${amount}, todo lo que le debía.`;
+      const partial = x.dir === "te debe" ? `${x.persona} me pagó ` : `Le pagué a ${x.persona} `;
+      clear(out);
+      out.append(
+        h(
+          "div",
+          { class: "lz-prop" },
+          h(
+            "div",
+            { class: "lz-fields" },
+            field(x.dir === "te debe" ? "Te paga" : "Le pagás a", x.persona),
+            field("Monto", amount, true),
+            field("Queda", `${money(0, x.moneda)} · saldada`),
+          ),
+          h(
+            "div",
+            { class: "lz-pfoot" },
+            btn("Registrar todo", "prim", () => c.host.open("situacion", full, { send: true }), { enter: true }),
+            btn("Pago parcial", "sec", () => c.host.open("situacion", partial, { send: false })),
+            h("span", { class: "lz-cost", text: "lo arma el agente de Plata" }),
