@@ -0,0 +1,142 @@
+// Plata's agent in the island. The agent itself lives in the `agentes` repo and
+// runs on this PC with `npm run servir`, on 127.0.0.1:8787, with Lucas's own
+// Supabase session (never the service role): see CONTRATOS.md §9 over there.
+//
+// The island only talks to it: one POST per message, answered as a stream of
+// server-sent events that are forwarded to the page unchanged as `plata-event`.
+// Writes are never applied from here. The agent turns them into proposals, and
+// Lucas approves them in a later message, which is what the base checks.
+
+use std::os::windows::process::CommandExt;
+use std::path::PathBuf;
+use std::process::{Command, Stdio};
+
+use serde::Serialize;
+use serde_json::{json, Value};
+use tauri::{AppHandle, Emitter};
+
+const BASE: &str = "http://127.0.0.1:8787";
+const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+
+#[derive(Serialize, Clone)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentStatus {
+    pub up: bool,
+    pub model: Option<String>,
+    /// The `agentes` folder found on disk, so the page can offer to start it.
+    pub dir: Option<String>,
+}
+
+#[derive(Serialize, Clone)]
+#[serde(rename_all = "camelCase")]
+struct PlataEvent {
+    sesion_id: String,
+    ev: Value,
+}
+
+/// Where the `agentes` repo is checked out. First match wins.
+fn agent_dir() -> Option<PathBuf> {
+    let home = PathBuf::from(std::env::var_os("USERPROFILE")?);
+    [
+        home.join("OneDrive").join("Desktop").join("Claude").join("agentes"),
+        home.join("Desktop").join("Claude").join("agentes"),
+        home.join("agentes"),
+    ]
+    .into_iter()
+    .find(|p| p.join("plata").join("servir.ts").is_file())
+}
+
+pub async fn status() -> AgentStatus {
+    let dir = agent_dir().map(|p| p.to_string_lossy().to_string());
+    let client = match reqwest::Client::builder().timeout(std::time::Duration::from_secs(2)).build() {
+        Ok(c) => c,
+        Err(_) => return AgentStatus { up: false, model: None, dir },
+    };
+    match client.get(format!("{BASE}/salud")).send().await {
+        Ok(r) if r.status().is_success() => {
+            let v: Value = r.json().await.unwrap_or(Value::Null);
+            AgentStatus {
+                up: true,
+                model: v.get("modelo").and_then(Value::as_str).map(str::to_string),
+                dir,
+            }
+        }
+        _ => AgentStatus { up: false, model: None, dir },
+    }
+}
+
+/// Starts `npm run servir` in the `agentes` folder, detached and without a
+/// console. Its output goes to %LOCALAPPDATA%\Coucou\plata-agent.log.
+pub fn start() -> Result<(), String> {
+    let dir = agent_dir().ok_or_else(|| "No encuentro la carpeta del agente (agentes\\plata\\servir.ts).".to_string())?;
+    let log_path = crate::settings::local_dir().join("plata-agent.log");
+    let log = std::fs::File::create(&log_path).map_err(|e| e.to_string())?;
+    let err = log.try_clone().map_err(|e| e.to_string())?;
+    Command::new("cmd")
+        .args(["/C", "npm", "run", "servir"])
+        .current_dir(&dir)
+        .stdin(Stdio::null())
+        .stdout(log)
+        .stderr(err)
+        .creation_flags(CREATE_NO_WINDOW)
+        .spawn()
+        .map_err(|e| format!("No se pudo arrancar el agente: {e}"))?;
+    crate::log::line(format!("plata agent started in {}", dir.display()));
+    Ok(())
+}
+
+/// One message. Every event of the stream reaches the page as it arrives; the
+/// call returns when the turn ends.
+pub async fn send(app: AppHandle, texto: String, sesion_id: String) -> Result<(), String> {
+    let client = reqwest::Client::builder()
+        .connect_timeout(std::time::Duration::from_secs(3))
+        // A turn with several tools and a proposal takes a while; this is only
+        // the backstop for a server that stops answering altogether.
+        .timeout(std::time::Duration::from_secs(600))
+        .build()
+        .map_err(|e| e.to_string())?;
+
+    let mut response = client
+        .post(format!("{BASE}/agentes/plata/mensaje"))
+        .json(&json!({ "texto": texto, "sesion_id": sesion_id }))
+        .send()
+        .await
+        .map_err(|e| {
+            if e.is_connect() {
+                "agent_down".to_string()
+            } else {
+                format!("No pude hablar con el agente: {e}")
+            }
+        })?;
+
+    if !response.status().is_success() {
+        let status = response.status();
+        let body: Value = response.json().await.unwrap_or(Value::Null);
+        let msg = body.get("error").and_then(Value::as_str).unwrap_or("sin detalle");
+        return Err(format!("El agente respondió {status}: {msg}"));
+    }
+
+    // Server-sent events: frames end in a blank line; we only care about `data:`.
+    let mut buf: Vec<u8> = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|e| format!("Se cortó la respuesta: {e}"))? {
+        buf.extend_from_slice(&chunk);
+        while let Some(end) = find_frame_end(&buf) {
+            let frame: Vec<u8> = buf.drain(..end + 2).collect();
+            let text = String::from_utf8_lossy(&frame);
+            for line in text.lines() {
+                let Some(data) = line.strip_prefix("data:") else { continue };
+                let Ok(ev) = serde_json::from_str::<Value>(data.trim_start()) else { continue };
+                let _ = app.emit_to(
+                    crate::island::WINDOW_LABEL,
+                    "plata-event",
+                    PlataEvent { sesion_id: sesion_id.clone(), ev },
+                );
+            }
+        }
+    }
+    Ok(())
+}
+
+fn find_frame_end(buf: &[u8]) -> Option<usize> {
+    buf.windows(2).position(|w| w == b"\n\n")
+}
