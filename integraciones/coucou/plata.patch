+    }
+
+    #[test]
+    fn scaled_display_and_offset_origin() {
+        let mon = Area { x: -2880, y: 0, w: 2880, h: 1620 };
+        let wa = Area { x: -2880, y: 0, w: 2880, h: 1560 };
+        let (pw, ph) = ((1140.0 * 1.5) as i32, (924.0 * 1.5) as i32);
+        let p = place("top", mon, wa, 1.5, pw, ph, (0.0, 0.0), None);
+        assert_eq!(p.x, -2880 + (2880 - pw) / 2);
+        assert!((p.anchor_x - 570.0).abs() < 1.0);
+    }
