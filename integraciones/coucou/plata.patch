+/// inside the window — a change the page and the OS cannot make in the same frame.
+#[allow(clippy::too_many_arguments)]
+pub fn place(
+    dock: &str,
+    mon: Area,
+    wa: Area,
+    scale: f64,
+    pw: i32,
+    ph: i32,
+    want: (f64, f64),
+    keep: Option<(f64, f64)>,
+) -> Placement {
+    let clamp_x = |x: f64| (x.round() as i32).clamp(wa.x, (wa.x + wa.w - pw).max(wa.x));
+    let clamp_y = |y: f64| (y.round() as i32).clamp(wa.y, (wa.y + wa.h - ph).max(wa.y));
+    if dock != "left" && dock != "right" && dock != "float" {
+        let x = mon.x + (mon.w - pw) / 2;
+        let centre = mon.x as f64 + mon.w as f64 / 2.0;
+        return Placement { x, y: mon.y, anchor_x: (centre - x as f64) / scale, anchor_y: 0.0 };
