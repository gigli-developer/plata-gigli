+
+/** A big number with a line under it. `late` paints it red. */
+export function stat(title: string, value: string | null, sub: string | null, opts: { late?: boolean; small?: string; size?: number; missing?: string } = {}): HTMLElement {
+  if (value === null) {
+    return box(title, null, h("div", { class: "lz-sub lz-missing", text: opts.missing ?? `No pude leer ${title.toLowerCase()}` }));
+  }
+  const big = h("div", { class: `lz-big${opts.late ? " late" : ""}`, text: value });
+  if (opts.small) big.append(h("small", { text: opts.small }));
+  if (opts.size) big.style.fontSize = `${opts.size}px`;
+  return box(title, null, big, sub ? h("div", { class: "lz-sub", text: sub }) : null);
+}
+
+export function typing(): HTMLElement {
+  return h("div", { class: "lz-typing", "aria-label": "Cargando" }, h("i"), h("i"), h("i"));
+}
+
+export function row(cls: "lz-row2" | "lz-row3", ...children: HTMLElement[]): HTMLElement {
+  return h("div", { class: cls }, ...children);
+}
+
+/** A list row: colour bar, text, pill. */
+export function li(color: string | null, text: Node | string, pill: HTMLElement | null): HTMLElement {
+  const bar = h("span", { class: "lz-bar4" });
+  bar.style.setProperty("--c", color || "rgb(var(--rgb))");
+  return h("div", { class: "lz-li" }, bar, typeof text === "string" ? h("span", { text }) : text, pill ?? h("span"));
+}
+
+export function pill(text: string, tone: "" | "late" | "soon" | "ok" = ""): HTMLElement {
+  return h("span", { class: `lz-pill${tone ? ` ${tone}` : ""}`, text });
+}
+
+export interface TlEvent {
+  /** Minutes since local midnight. */
+  s: number;
+  e: number;
+  label: string;
+  color: string;
+}
+
+/**
+ * The day as a bar: hours `from`–`to`, the events on it, the part that already
+ * went by hatched and a marker for now (null: a day that isn't today).
+ */
+export function timeline(events: readonly TlEvent[], now: number | null, from: number, to: number): HTMLElement {
+  const span = (to - from) * 60;
+  const pos = (min: number) => `${Math.max(0, Math.min(100, ((min - from * 60) / span) * 100))}%`;
+  const tl = h("div", { class: "lz-tl" }, h("span", { class: "lz-track" }));
+  if (now !== null && now > from * 60) {
+    const past = h("span", { class: "lz-past" });
+    past.style.width = pos(now);
+    tl.append(past);
+  }
+  for (const e of events) {
+    const s = Math.max(e.s, from * 60);
+    const en = Math.min(e.e, to * 60);
+    if (en <= s) continue;
+    const ev = h("span", { class: "lz-ev", title: e.label }, h("span", { text: e.label }));
+    ev.style.left = pos(s);
+    ev.style.width = `calc(${((en - s) / span) * 100}% - 2px)`;
+    ev.style.setProperty("--c", e.color);
+    tl.append(ev);
+  }
+  for (let x = from; x <= to; x += 4) {
+    const l = h("span", { class: "lz-lbl", text: String(x) });
+    l.style.left = pos(x * 60);
+    tl.append(l);
+  }
+  if (now !== null && now >= from * 60 && now <= to * 60) {
+    const n = h("span", { class: "lz-now" });
+    n.style.left = pos(now);
+    tl.append(n);
+  }
+  return tl;
+}
+
+/** Google Calendar's default event colour when the feed brings none. */
+export const DEFAULT_EVENT_COLOR = "#9aa0a6";
