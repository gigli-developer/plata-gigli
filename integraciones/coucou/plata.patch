+  "SUMMARY:JP Morgan presencial",
+  "DTSTART:20261007T090000Z",
+  "DTEND:20261007T200000Z",
+  "END:VEVENT",
+  // An all-day event.
+  "BEGIN:VEVENT",
+  "UID:fin@test",
+  "SUMMARY:Finalización del período",
+  "DTSTART;VALUE=DATE:20261010",
