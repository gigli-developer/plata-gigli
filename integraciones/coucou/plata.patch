+// Atajos — the eight Centro de Control skills. Data: Bridge.centroFoco()
+// (coucou-foco, contract §2) and Lucas's calendars (Bridge.calendarIcs,
+// expanded with ical.js in calendar.ts). Writes (entrega 2) go through
+// data.accion → coucou-foco with {accion, args} (coucou_accion.sql): tildar,
+// empezar / pausar el cronómetro, mover de día, soltar, hábitos, "hoy no
+// trabajo" y la tarea rápida. Each one offers "Deshacer" when it can.
+
+import { h } from "../dom";
+import { Sound } from "../../core/sound";
+import type { CentroAccion } from "../../core/bridge";
+import { Card, errLine, errorBlock, note } from "./card";
+import * as data from "./data";
+import {
+  DIAS, addDays, arClock, arMs, classifyError, duracion, enDias, fechaCorta, fechaLarga, hm, hhmm, palabra, plural, type ArClock,
+} from "./format";
+import {
+  DAY_FROM, DAY_TO, dayBusy, freeSlots, groupAvisos, horaDe, longest, nextHalfHour, parseTareaRapida, pickTasks, suggestTomorrow, total,
+  type CalEvent, type Candidate, type Foco, type Span,
+} from "./plan";
+import { DEFAULT_EVENT_COLOR, acts, box, btn, li, pill, row, stat, timeline, type TlEvent } from "./ui";
+import type { Runner } from "./skills-plata";
+
+const DAY_MS = 86_400_000;
+const CDC = "rgb(124, 196, 255)";
+
+type Cal = { ok: true; data: data.CalendarData } | { ok: false; err: unknown };
+
+/**
+ * Loads the Centro (and the calendar when the card draws one). Without the
+ * Centro the card fails as a whole; without the calendar only its box does.
+ */
+async function load(c: Card, withCal: boolean, retryId: Parameters<Card["host"]["open"]>[0]): Promise<{ f: Foco; cal: Cal } | null> {
+  c.loading("Miro el Centro de Control…");
+  const [fr, cr] = await Promise.allSettled([data.foco(), withCal ? data.calendar() : Promise.reject(new Error("no pedido"))]);
+  if (!c.alive()) return null;
+  if (fr.status === "rejected") {
+    c.fail(fr.reason, "el Centro de Control", () => c.host.open(retryId));
+    return null;
+  }
+  c.think(false);
+  return { f: fr.value, cal: cr.status === "fulfilled" ? { ok: true, data: cr.value } : { ok: false, err: cr.reason } };
+}
+
+/** The calendar couldn't be read: what's missing, and the button for it. */
+function calProblem(c: Card, err: unknown, retryId: Parameters<Card["host"]["open"]>[0]): HTMLElement {
+  if (err instanceof data.NoCalendarError) {
+    return errorBlock({ kind: "config", text: "Falta la dirección iCal de tu calendario." }, c.actions, () => {});
+  }
+  return errorBlock(classifyError(err, "tu calendario"), c.actions, () => {
+    void data.calendar(true).catch(() => {});
+    c.host.open(retryId);
+  });
+}
+
+function dayEvents(cal: data.CalendarData, date: string): { timed: CalEvent[]; allDay: CalEvent[] } {
+  const start = arMs(date);
+  const evs = cal.between(start, start + DAY_MS);
+  return { timed: evs.filter((e) => !e.allDay), allDay: evs.filter((e) => e.allDay && e.start < start + DAY_MS && e.end > start) };
+}
+
+function toTl(evs: readonly CalEvent[], date: string): TlEvent[] {
+  const start = arMs(date);
+  return evs.map((e) => ({
+    s: (e.start - start) / 60_000,
+    e: (e.end - start) / 60_000,
+    label: e.title,
+    color: e.color ?? DEFAULT_EVENT_COLOR,
+  }));
+}
+
+/** 6 to 24 unless something starts earlier. */
+function tlRange(tl: readonly TlEvent[]): [number, number] {
+  const first = Math.min(6 * 60, ...tl.map((e) => Math.max(0, e.s)));
+  return [Math.floor(first / 60), 24];
+}
+
+function dayBox(c: Card, title: string, cal: Cal, date: string, now: number | null, retryId: Parameters<Card["host"]["open"]>[0], extra: TlEvent[] = []): HTMLElement {
+  if (!cal.ok) return box(title, null, calProblem(c, cal.err, retryId));
+  const { timed, allDay } = dayEvents(cal.data, date);
+  const tl = [...toTl(timed, date), ...extra];
+  const [from, to] = tlRange(tl);
+  return box(
+    title,
+    `${from} a ${to}`,
+    timeline(tl, now, from, to),
+    allDay.length ? h("div", { class: "lz-sub", text: `Todo el día: ${allDay.map((e) => e.title).join(" · ")}` }) : null,
+    !timed.length && !allDay.length ? h("div", { class: "lz-sub", text: "Nada en el calendario." }) : null,
+  );
+}
+
+function appButton(c: Card, f: Foco | null, kind: "prim" | "sec" = "sec"): HTMLButtonElement | null {
+  if (!f?.appUrl) return null;
+  const url = f.appUrl;
+  return btn("Abrir en la app", kind, () => c.actions.openUrl(url), { enter: kind === "prim" });
+}
+
+const capital = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
+
+// ── Writing to the Centro ───────────────────────────────────────────────────
+
+type Args = Record<string, unknown>;
+
+const CHECK_SVG = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
+const LATER_SVG = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"/></svg>';
+
+const manana1 = () => addDays(arClock().date, 1);
+
+/** The line next to the buttons: "Guardando…", then nothing, ok or the error. */
+function statusEl(): HTMLElement {
+  return h("span", { class: "lz-pstatus", role: "status" });
+}
+
+function tell(st: HTMLElement, text: string, tone: "" | "ok" | "bad" = "") {
+  st.className = `lz-pstatus${tone ? ` ${tone}` : ""}`;
+  st.textContent = text;
+}
+
+/**
+ * One write: `lock` is disabled while it goes and `st` says how it ended.
+ * Resolves the answer, or null when it failed (the reason is already on screen).
+ */
+async function hacer(c: Card, st: HTMLElement, lock: Array<HTMLButtonElement | null>, nombre: CentroAccion, args: Args, working: string): Promise<Args | null> {
+  const bs = lock.filter((b): b is HTMLButtonElement => !!b);
+  bs.forEach((b) => (b.disabled = true));
+  tell(st, working);
+  try {
+    const r = await data.accion(nombre, args);
+    if (c.alive()) tell(st, "");
+    return r;
+  } catch (err) {
+    if (c.alive()) {
+      tell(st, classifyError(err, "el Centro de Control").text.replace(/^No pude leer el Centro de Control/, "No pude guardarlo"), "bad");
+      Sound.play("error");
+    }
+    return null;
+  } finally {
+    bs.forEach((b) => (b.disabled = false));
+  }
+}
+
+/** A button that asks once more ("¿Seguro?") before doing it; it forgets after 4 s. */
+function confirmBtn(label: string, ask: string, onYes: () => void): HTMLButtonElement {
+  let armed = false;
+  let timer = 0;
+  const b = btn(label, "sec", () => {
+    if (!armed) {
+      armed = true;
+      b.classList.add("armed");
+      text.textContent = ask;
+      timer = window.setTimeout(disarm, 4000);
+      return;
+    }
+    disarm();
+    onYes();
+  });
+  const text = b.querySelector<HTMLElement>("span:not(.lz-btn-ic)")!;
+  const disarm = () => {
+    window.clearTimeout(timer);
+    armed = false;
+    b.classList.remove("armed");
+    text.textContent = label;
+  };
+  return b;
+}
+
+/**
+ * A task row with its two quick actions: tildarla (✓) and pasarla a mañana (→).
+ * Once done, the row dims and offers "Deshacer" instead.
+ */
+function taskRow(c: Card, st: HTMLElement, t: { id: string; titulo: string; color: string | null }, tag: HTMLElement): HTMLElement {
+  const bar = h("span", { class: "lz-bar4" });
+  bar.style.setProperty("--c", t.color || CDC);
+  const name = h("span", { text: t.titulo });
+  const tools = h("span", { class: "lz-minis" });
+  const el = h("div", { class: "lz-li lz-li-act" }, bar, name, tag, tools);
+  if (!t.id) return el;
+  const mini = (svg: string, title: string, on: () => void) => {
+    const b = h("button", { type: "button", class: "lz-mini", title, "aria-label": `${title}: ${t.titulo}`, html: svg }) as HTMLButtonElement;
+    b.addEventListener("click", (e) => {
+      e.stopPropagation();
+      if (!b.disabled) on();
+    });
+    return b;
+  };
+  const idle = () => {
+    el.classList.remove("gone");
+    tools.replaceChildren(ok, later);
+  };
+  const gone = (line: string, nombre: CentroAccion, args: Args) => {
+    el.classList.add("gone");
+    tell(st, line, "ok");
+    const undo = h("button", { type: "button", class: "lz-mini txt", text: "Deshacer" }) as HTMLButtonElement;
+    undo.addEventListener("click", async (e) => {
+      e.stopPropagation();
+      if (await hacer(c, st, [undo], nombre, args, "Deshaciendo…")) {
+        idle();
+        tell(st, "Listo, como estaba.");
+      }
+    });
+    tools.replaceChildren(undo);
+  };
+  const ok = mini(CHECK_SVG, "Hecha", async () => {
+    const r = await hacer(c, st, [ok, later], "hecha", { id: t.id }, "Tildando…");
+    if (!r || !c.alive()) return;
+    c.happy();
+    gone(`Hecha: ${t.titulo}.`, "reabrir", { id: t.id, estado: r.antes === "in_progress" ? "in_progress" : "not_started" });
+  });
+  const later = mini(LATER_SVG, "Para mañana", async () => {
+    const r = await hacer(c, st, [ok, later], "mover", { id: t.id, vence: manana1() }, "Moviendo…");
+    if (!r || !c.alive()) return;
+    gone(`${t.titulo}: para mañana.`, "mover", { id: t.id, vence: r.antes ?? null });
+  });
+  idle();
+  return el;
+}
+
+/**
+ * Moves several tasks to `vence`, one by one. Stops at the first that fails;
+ * resolves what moved (with where each was) so "Deshacer" can put them back.
+ */
+async function moverVarias(ts: ReadonlyArray<{ id: string }>, vence: string | null): Promise<{ moved: Array<{ id: string; antes: unknown }>; err: unknown }> {
+  const moved: Array<{ id: string; antes: unknown }> = [];
+  for (const t of ts) {
+    try {
+      const r = await data.accion("mover", { id: t.id, vence });
+      moved.push({ id: t.id, antes: r.antes ?? null });
+    } catch (err) {
+      return { moved, err };
+    }
+  }
+  return { moved, err: null };
+}
+
+async function devolver(moved: ReadonlyArray<{ id: string; antes: unknown }>): Promise<void> {
+  for (const m of moved) await data.accion("mover", { id: m.id, vence: m.antes ?? null });
+}
+
+/**
+ * "Pasar a mañana" for a group of tasks, with its confirmation, its result
+ * line and its "Deshacer". `label` is the button's text.
+ */
+function moverGrupo(c: Card, ts: ReadonlyArray<{ id: string }>, label: string, opts: { confirm?: boolean } = {}): HTMLElement {
+  const st = statusEl();
+  const wrap = h("div", { class: "lz-acts" });
+  const n = ts.length;
+  const run = async () => {
+    go.disabled = true;
+    tell(st, "Moviendo…");
+    const { moved, err } = await moverVarias(ts, manana1());
+    if (!c.alive()) return;
+    go.disabled = false;
+    if (err) {
+      tell(st, `${moved.length ? `Moví ${moved.length} de ${n}; ` : ""}${classifyError(err, "el Centro de Control").text}`, "bad");
+      Sound.play("error");
+    } else {
+      c.happy();
+      tell(st, `Listo: ${n === 1 ? "una tarea pasó" : `${palabra(n, true)} tareas pasaron`} a mañana.`, "ok");
+    }
+    if (!moved.length) return;
+    go.remove();
+    const undo = btn("Deshacer", "sec", async () => {
+      undo.disabled = true;
+      tell(st, "Deshaciendo…");
+      try {
+        await devolver(moved);
+        if (c.alive()) {
+          tell(st, "Listo, como estaban.");
+          undo.remove();
+        }
+      } catch (e) {
+        undo.disabled = false;
+        tell(st, classifyError(e, "el Centro de Control").text, "bad");
+      }
+    });
+    wrap.prepend(undo);
+  };
+  const go = opts.confirm === false ? btn(label, "sec", () => void run()) : confirmBtn(label, `¿Muevo ${n === 1 ? "una" : palabra(n, true)}? Sí`, () => void run());
+  wrap.append(go, st);
+  return wrap;
+}
+
+/** "6 atrasadas" for the launcher's group line; empty when nothing stands out. */
+export function centroLine(f: Foco): string {
+  const a = f.atrasadas?.length ?? 0;
+  if (a) return `${a} ${plural(a, "atrasada", "atrasadas")}`;
+  const hoy = f.paraHoy?.length ?? 0;
+  return hoy ? `${hoy} para hoy` : "";
+}
+
+// ── Mi día ──────────────────────────────────────────────────────────────────
+
+async function dia(c: Card) {
+  const r = await load(c, true, "dia");
+  if (!r) return;
+  const { f, cal } = r;
+  const now = arClock();
+  const parts: string[] = [`${capital(DIAS[now.weekday])}.`];
+  if (f.noTrabaja) parts.push("Hoy no trabajás.");
+  if (cal.ok) {
+    const { timed } = dayEvents(cal.data, now.date);
+    const nowMs = Date.now();
+    const current = timed.find((e) => e.start <= nowMs && e.end > nowMs);
+    const next = timed.find((e) => e.start > nowMs);
+    if (!timed.length) parts.push("No tenés nada en el calendario hoy.");
+    else if (current) parts.push(`Ahora: **${current.title}**, hasta las ${hhmm(minOf(current.end, now))}.`);
+    else if (next) parts.push(`Queda **${next.title} a las ${hhmm(minOf(next.start, now))}**.`);
+    else parts.push("Ya no te queda nada en el calendario.");
+  }
+  const atr = f.atrasadas;
+  if (atr && atr.length) parts.push(`Lo urgente: **${palabra(atr.length, true)} ${plural(atr.length, "atrasada", "atrasadas")}**.`);
+  else if (f.paraHoy?.length) parts.push(`Para hoy tenés **${palabra(f.paraHoy.length, true)} ${plural(f.paraHoy.length, "tarea", "tareas")}**.`);
