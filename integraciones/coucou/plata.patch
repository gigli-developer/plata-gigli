+    default:
+      return "#F5A524"; // queued / building / deploying
+  }
+}
+
+function railwayLabel(status: unknown): string {
+  // Railway's own words, untranslated like the service name — except "Failed",
+  // which the catalog already carries in every language.
+  const labels: Record<string, string> = {
+    SUCCESS: "Live", FAILED: t("Failed"), CRASHED: "Crashed", REMOVED: "Replaced", SKIPPED: "Skipped",
+    QUEUED: "Queued", INITIALIZING: "Starting", BUILDING: "Building", DEPLOYING: "Deploying",
+    WAITING: "Waiting", SLEEPING: "Sleeping",
+  };
+  return labels[String(status)] ?? String(status ?? "");
+}
+
+function railwayCard(onDetail: () => void): HTMLElement {
+  const rows = h("div", { class: "int-rows" });
+  arr("integration_railway", "deployments").slice(0, 3).forEach((d, i) => {
+    const accent = railwayAccent(d.status);
+    const name = h("span", { class: "int-name", text: String(d.service ?? "") });
+    const state = h("span", { class: "int-ago", style: `color:${accent}`, text: railwayLabel(d.status) });
+    const ago = h("span", { class: "int-ago", text: timeAgo(d.createdAt) });
+    if (i === 0) {
+      const more = h("button", { class: "int-more", title: t("Details"), onclick: onDetail }, svg(ICONS.ellipsis, 8));
+      rows.append(listRow(accent, true, name, state, ago, more));
+    } else {
+      rows.append(listRow(accent, false, name, state, ago));
+    }
+  });
+  return h("div", { class: "int-card" }, header(RAILWAY, "Railway", t("Deployments")), rows);
+}
+
+function railwayDetail(onBack: () => void): HTMLElement {
+  const d = arr("integration_railway", "deployments")[0] ?? {};
+  const accent = railwayAccent(d.status);
+  const body = h("div", { class: "int-detail-body" });
+  if (d.commitMessage) body.append(h("div", { class: "int-commit", text: String(d.commitMessage) }));
+  const meta = h("div", { class: "int-meta" });
+  if (d.branch) meta.append(h("span", { text: String(d.branch) }));
+  meta.append(h("span", { text: `${timeAgo(d.createdAt)} ago` }));
+  body.append(meta);
+  if (d.url) {
+    body.append(
+      h("button", {
+        class: "int-link",
+        text: String(d.url),
+        onclick: () => void Bridge.openUrl(`https://${d.url}`),
+      }),
+    );
+  }
+  return h(
+    "div",
+    { class: "int-card detail" },
+    h(
+      "div",
+      { class: "int-detail-head" },
+      h("button", { class: "int-back", onclick: onBack }, svg(ICONS.chevronLeft, 10, { stroke: 2.4 })),
+      dot(accent, 6),
+      h("b", { text: String(d.service ?? t("Deployment")) }),
+      h("span", { class: "int-badge", style: `color:${accent};background:${accent}24`, text: railwayLabel(d.status) }),
+    ),
+    body,
+  );
+}
