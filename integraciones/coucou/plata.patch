diff --git a/windows/src-tauri/src/actualizar.rs b/windows/src-tauri/src/actualizar.rs
new file mode 100644
index 0000000..77ab056
--- /dev/null
+++ b/windows/src-tauri/src/actualizar.rs
@@ -0,0 +1,69 @@
+// Keeping this PC's Coucou up to date, without opening Claude Code.
+//
+// The work is done by `integraciones\coucou\actualizar.ps1` in the Plata repo:
+// it fetches main, rebuilds Coucou from plata.patch when the patch changed,
+// installs it silently and starts it again (closing this process on the way),
+// and pulls the `agentes` repo. The island only starts it: five minutes after
+// launch, then every three hours. A scheduled task could do the same, but on
+// some PCs Task Scheduler leaves user tasks queued forever, and the island is
+// running whenever there is something to update.
+//
+// The script runs detached through wscript (no console window) and outlives
+// this process when the installer closes it. It holds its own lock, so two
+// launches never build at the same time.
+
+use std::os::windows::process::CommandExt;
+use std::path::PathBuf;
+use std::process::Command;
+use std::time::Duration;
+
+const FIRST: Duration = Duration::from_secs(5 * 60);
+const EVERY: Duration = Duration::from_secs(3 * 60 * 60);
+
+const DETACHED_PROCESS: u32 = 0x0000_0008;
+const CREATE_NEW_PROCESS_GROUP: u32 = 0x0000_0200;
+const CREATE_BREAKAWAY_FROM_JOB: u32 = 0x0100_0000;
+
+/// `actualizar.vbs` next to the script, in the Plata repo this PC uses.
+fn launcher() -> Option<PathBuf> {
+    let p = crate::plata_agent::plata_repo_dir()?
+        .join("integraciones")
+        .join("coucou")
+        .join("actualizar.vbs");
+    p.is_file().then_some(p)
+}
+
+fn run_once() {
+    let Some(vbs) = launcher() else {
+        crate::log::line("actualizar: no está integraciones\\coucou\\actualizar.vbs en el repo de Plata".to_string());
+        return;
+    };
+    let spawn = |flags: u32| {
+        Command::new("wscript.exe")
+            .args(["//B", "//Nologo"])
+            .arg(&vbs)
+            .creation_flags(flags)
+            .spawn()
+    };
+    let flags = DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP;
+    // Out of any job this process sits in, so the update survives it. A job
+    // that forbids breaking away refuses the flag: then without it.
+    match spawn(flags | CREATE_BREAKAWAY_FROM_JOB).or_else(|_| spawn(flags)) {
+        Ok(_) => crate::log::line("actualizar: buscando actualizaciones".to_string()),
+        Err(e) => crate::log::line(format!("actualizar: no pude lanzar wscript: {e}")),
+    }
+}
+
+pub fn start() {
+    // `tauri dev` is a checkout being worked on: it must not rebuild itself.
+    if cfg!(debug_assertions) {
+        return;
+    }
+    std::thread::spawn(|| {
+        std::thread::sleep(FIRST);
+        loop {
+            run_once();
+            std::thread::sleep(EVERY);
+        }
+    });
+}
diff --git a/windows/src-tauri/src/atajos.rs b/windows/src-tauri/src/atajos.rs
new file mode 100644
index 0000000..bd693c0
--- /dev/null
+++ b/windows/src-tauri/src/atajos.rs
@@ -0,0 +1,837 @@
+// Atajos de la isla: one global key opens the island as a launcher that is
+// already listening, a doorman picks one of the ready-made skills, and the
+// answer comes back as a card instead of a chat (CONTRATO-ATAJOS.md §3).
+//
+// Everything that leaves the machine goes through here and not through the
+// page, for the same reasons as the rest of Coucou:
+//   · the secrets (Centro de Control, iCal addresses, Anthropic key) never
+//     cross the IPC — the page only learns whether they exist;
+//   · Plata's agent is only reachable on 127.0.0.1, and only Rust can wake it
+//     up when it is down (plata_agent::ensure_running);
+//   · the key is a real Windows hotkey (RegisterHotKey through
+//     tauri-plugin-global-shortcut), so it works from any program, and it is
+//     registered here so a key that is already taken never breaks the app:
+//     it is logged, reported as `launcher-hotkey-error`, and Coucou carries on.
+//
+// None of the skills write anything on their own. A quick expense comes back
+// as a proposal from the agent and is only applied by `proposal_decide`, which
+// the card calls when Lucas presses Aprobar.
+
+use std::str::FromStr;
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use tauri::{AppHandle, Emitter};
+use tauri_plugin_global_shortcut::{GlobalShortcutExt, Shortcut, ShortcutState};
+
+use crate::{island, plata_agent, secrets};
+
+// ── The global key ────────────────────────────────────────────────────────────
+
+pub const DEFAULT_HOTKEY: &str = "F8";
+/// Emitted to the island when the key is pressed. Payload `{ source: "hotkey" }`.
+pub const LAUNCHER_EVENT: &str = "launcher-open";
+/// Emitted to every window when the key could not be registered. Payload: the
+/// reason, as a sentence that can be shown as is.
+pub const HOTKEY_ERROR_EVENT: &str = "launcher-hotkey-error";
+
+/// Modifiers, in the order they are written and shown.
+const MODIFIERS: [&str; 4] = ["Ctrl", "Alt", "Shift", "Win"];
+
+#[derive(Serialize, Clone, Debug, Default)]
+#[serde(rename_all = "camelCase")]
+pub struct HotkeyStatus {
+    /// Canonical form ("Ctrl+Alt+Space"), as stored in settings.json.
+    pub hotkey: String,
+    /// For people: "Ctrl + Alt + Espacio".
+    pub display: String,
+    pub registered: bool,
+    /// Why it is not registered, if it isn't (and it isn't just suspended).
+    pub error: Option<String>,
+}
+
+struct Registered {
+    status: HotkeyStatus,
+    shortcut: Option<Shortcut>,
+}
+
+static CURRENT: Mutex<Option<Registered>> = Mutex::new(None);
+/// Holding the key down must not open the launcher ten times.
+static LAST_PRESS: Mutex<Option<Instant>> = Mutex::new(None);
+const PRESS_DEBOUNCE: Duration = Duration::from_millis(400);
+
+fn modifier_index(token: &str) -> Option<usize> {
+    match token {
+        "CTRL" | "CONTROL" | "CTL" => Some(0),
+        "ALT" | "OPTION" => Some(1),
+        "SHIFT" | "MAYUS" | "MAYÚS" => Some(2),
+        "WIN" | "WINDOWS" | "SUPER" | "META" | "CMD" | "COMMAND" => Some(3),
+        _ => None,
+    }
+}
+
+/// A key name — ours, KeyboardEvent.code or a Spanish label — to the canonical
+/// name, which is also one global-hotkey's parser accepts.
+fn canonical_key(token: &str) -> Option<String> {
+    let t = token.to_uppercase();
+    let t = t.as_str();
+    // Letters and digits: "A", "KEYA", "1", "DIGIT1".
+    let letter = t.strip_prefix("KEY").filter(|r| r.len() == 1).unwrap_or(t);
+    if letter.len() == 1 && letter.chars().all(|c| c.is_ascii_uppercase()) {
+        return Some(letter.to_string());
+    }
+    let digit = t.strip_prefix("DIGIT").unwrap_or(t);
+    if digit.len() == 1 && digit.chars().all(|c| c.is_ascii_digit()) {
+        return Some(digit.to_string());
+    }
+    if let Some(n) = t.strip_prefix('F').and_then(|n| n.parse::<u8>().ok()) {
+        if (1..=24).contains(&n) && !t.starts_with("F0") {
+            return Some(format!("F{n}"));
+        }
+    }
+    if let Some(n) = t.strip_prefix("NUMPAD").or_else(|| t.strip_prefix("NUM")) {
+        if n.len() == 1 && n.chars().all(|c| c.is_ascii_digit()) {
+            return Some(format!("Numpad{n}"));
+        }
+    }
+    let name = match t {
+        "SPACE" | "ESPACIO" | "SPACEBAR" => "Space",
+        "ENTER" | "RETURN" | "INTRO" => "Enter",
+        "TAB" => "Tab",
+        "ESC" | "ESCAPE" => "Escape",
+        "BACKSPACE" | "RETROCESO" => "Backspace",
+        "DELETE" | "DEL" | "SUPR" | "SUPRIMIR" => "Delete",
+        "INSERT" | "INS" => "Insert",
+        "HOME" | "INICIO" => "Home",
+        "END" | "FIN" => "End",
+        "PAGEUP" | "REPAG" => "PageUp",
+        "PAGEDOWN" | "AVPAG" => "PageDown",
+        "ARROWUP" | "UP" => "ArrowUp",
+        "ARROWDOWN" | "DOWN" => "ArrowDown",
+        "ARROWLEFT" | "LEFT" => "ArrowLeft",
+        "ARROWRIGHT" | "RIGHT" => "ArrowRight",
+        "PAUSE" | "PAUSA" => "Pause",
+        "PRINTSCREEN" | "IMPPNT" => "PrintScreen",
+        "SCROLLLOCK" => "ScrollLock",
+        "NUMPADADD" => "NumpadAdd",
+        "NUMPADSUBTRACT" => "NumpadSubtract",
+        "NUMPADMULTIPLY" => "NumpadMultiply",
+        "NUMPADDIVIDE" => "NumpadDivide",
+        "NUMPADDECIMAL" => "NumpadDecimal",
+        "NUMPADENTER" => "NumpadEnter",
+        "BACKQUOTE" => "Backquote",
+        "MINUS" => "Minus",
+        "EQUAL" => "Equal",
+        "BRACKETLEFT" => "BracketLeft",
+        "BRACKETRIGHT" => "BracketRight",
+        "BACKSLASH" => "Backslash",
+        "SEMICOLON" => "Semicolon",
+        "QUOTE" => "Quote",
+        "COMMA" => "Comma",
+        "PERIOD" => "Period",
+        "SLASH" => "Slash",
+        "MEDIAPLAYPAUSE" => "MediaPlayPause",
+        "MEDIASTOP" => "MediaStop",
+        "MEDIATRACKNEXT" => "MediaTrackNext",
+        "MEDIATRACKPREVIOUS" | "MEDIATRACKPREV" => "MediaTrackPrevious",
+        "AUDIOVOLUMEUP" => "AudioVolumeUp",
+        "AUDIOVOLUMEDOWN" => "AudioVolumeDown",
+        "AUDIOVOLUMEMUTE" => "AudioVolumeMute",
+        _ => return None,
+    };
+    Some(name.to_string())
+}
+
+/// Keys that may be a hotkey on their own (or with Shift only): nobody types
+/// with them, so taking them system-wide doesn't eat anyone's text.
+fn works_alone(key: &str) -> bool {
+    (key.starts_with('F') && key.len() > 1 && key[1..].chars().all(|c| c.is_ascii_digit()))
+        || key.starts_with("Media")
+        || key.starts_with("AudioVolume")
+        || matches!(key, "Pause" | "ScrollLock" | "PrintScreen")
+}
+
+/// "ctrl + alt + espacio", "Control+Alt+Space", "KeyG" … → "Ctrl+Alt+Space".
+/// Refuses what would make a bad global key: no main key, two main keys, or a
+/// letter that would stop being typeable everywhere.
+pub fn normalize_hotkey(raw: &str) -> Result<String, String> {
+    let raw = raw.trim();
+    if raw.is_empty() {
+        return Err("No hay ninguna tecla elegida.".into());
+    }
+    let mut mods = [false; 4];
+    let mut key: Option<String> = None;
+    for token in raw.split('+').map(str::trim) {
+        if token.is_empty() {
+            return Err(format!("No entiendo «{raw}» como combinación de teclas."));
+        }
+        if let Some(i) = modifier_index(&token.to_uppercase()) {
+            mods[i] = true;
+            continue;
+        }
+        let k = canonical_key(token).ok_or_else(|| format!("La tecla «{token}» no se puede usar como atajo."))?;
+        if key.is_some() {
+            return Err("Elegí una sola tecla, con Ctrl, Alt, Shift o Win si querés.".into());
+        }
+        key = Some(k);
+    }
+    let key = key.ok_or_else(|| "Falta una tecla además de Ctrl, Alt, Shift o Win.".to_string())?;
+    let strong = mods[0] || mods[1] || mods[3];
+    if !strong && !works_alone(&key) {
+        return Err(format!(
+            "{} sola taparía lo que escribís en cualquier programa: sumale Ctrl, Alt o Win, o usá una tecla F.",
+            display_key(&key)
+        ));
+    }
+    let mut parts: Vec<&str> = MODIFIERS.iter().zip(mods).filter(|(_, on)| *on).map(|(m, _)| *m).collect();
+    parts.push(&key);
+    Ok(parts.join("+"))
+}
+
+/// What global-hotkey's parser expects: the same, with Win spelled Super.
+fn to_accelerator(canonical: &str) -> String {
+    canonical.split('+').map(|t| if t == "Win" { "Super" } else { t }).collect::<Vec<_>>().join("+")
+}
+
+fn display_key(key: &str) -> String {
+    let named = match key {
+        "Space" => "Espacio",
+        "Escape" => "Esc",
+        "Backspace" => "Retroceso",
+        "Delete" => "Supr",
+        "Home" => "Inicio",
+        "End" => "Fin",
+        "PageUp" => "RePág",
+        "PageDown" => "AvPág",
+        "ArrowUp" => "↑",
+        "ArrowDown" => "↓",
+        "ArrowLeft" => "←",
+        "ArrowRight" => "→",
+        "Pause" => "Pausa",
+        "PrintScreen" => "ImpPnt",
+        "ScrollLock" => "Bloq Despl",
+        "NumpadAdd" => "Num +",
+        "NumpadSubtract" => "Num −",
+        "NumpadMultiply" => "Num *",
+        "NumpadDivide" => "Num /",
+        "NumpadDecimal" => "Num .",
+        "NumpadEnter" => "Num Enter",
+        "Backquote" => "`",
+        "Minus" => "-",
+        "Equal" => "=",
+        "BracketLeft" => "[",
+        "BracketRight" => "]",
+        "Backslash" => "\\",
+        "Semicolon" => ";",
+        "Quote" => "'",
+        "Comma" => ",",
+        "Period" => ".",
+        "Slash" => "/",
+        "MediaPlayPause" => "Play/Pausa",
+        "MediaStop" => "Stop",
+        "MediaTrackNext" => "Siguiente",
+        "MediaTrackPrevious" => "Anterior",
+        "AudioVolumeUp" => "Vol +",
+        "AudioVolumeDown" => "Vol −",
+        "AudioVolumeMute" => "Silencio",
+        other => {
+            if let Some(n) = other.strip_prefix("Numpad") {
+                return format!("Num {n}");
+            }
+            return other.to_string();
+        }
+    };
+    named.to_string()
+}
+
+/// "Ctrl+Alt+Space" → "Ctrl + Alt + Espacio". Anything unparseable is shown as is.
+pub fn display_hotkey(hotkey: &str) -> String {
+    match normalize_hotkey(hotkey) {
+        Ok(canon) => canon
+            .split('+')
+            .map(|t| if MODIFIERS.contains(&t) { t.to_string() } else { display_key(t) })
+            .collect::<Vec<_>>()
+            .join(" + "),
+        Err(_) => hotkey.trim().to_string(),
+    }
+}
+
+fn unregister_current(app: &AppHandle) {
+    let previous = CURRENT.lock().unwrap().as_mut().and_then(|r| r.shortcut.take());
+    if let Some(sc) = previous {
+        if let Err(err) = app.global_shortcut().unregister(sc) {
+            crate::log::line(format!("launcher hotkey: unregister failed: {err}"));
+        }
+    }
+}
+
+fn on_press(app: &AppHandle) {
+    {
+        let mut last = LAST_PRESS.lock().unwrap();
+        if last.is_some_and(|t| t.elapsed() < PRESS_DEBOUNCE) {
+            return;
+        }
+        *last = Some(Instant::now());
+    }
+    // The launcher's field has to receive keys and Win+H dictation, so the
+    // island may take focus — the same switch the chats use (focus_window).
+    // The page hands it back with focusWindow(false) when the launcher closes.
+    // Windows lets us take the foreground here because the hotkey was our input.
+    if let Some(win) = island::window(app) {
+        crate::platform::set_activating(&win, true);
+        let _ = win.set_focus();
+    }
+    let _ = app.emit_to(island::WINDOW_LABEL, LAUNCHER_EVENT, json!({ "source": "hotkey" }));
+}
+
+fn fail(app: &AppHandle, hotkey: &str, reason: String) -> HotkeyStatus {
+    crate::log::line(format!("launcher hotkey {hotkey:?}: {reason}"));
+    let status = HotkeyStatus {
+        hotkey: hotkey.to_string(),
+        display: display_hotkey(hotkey),
+        registered: false,
+        error: Some(reason.clone()),
+    };
+    *CURRENT.lock().unwrap() = Some(Registered { status: status.clone(), shortcut: None });
+    let _ = app.emit(HOTKEY_ERROR_EVENT, reason);
+    status
+}
+
+/// Registers `raw` as the launcher key, replacing the previous one. Never
+/// fails the caller: a bad or taken key is logged and reported as an event.
+pub fn apply_hotkey(app: &AppHandle, raw: &str) -> HotkeyStatus {
+    unregister_current(app);
+    let canon = match normalize_hotkey(raw) {
+        Ok(c) => c,
+        Err(reason) => return fail(app, raw, format!("No pude usar «{}» como atajo: {reason}", raw.trim())),
+    };
+    let display = display_hotkey(&canon);
+    let shortcut = match Shortcut::from_str(&to_accelerator(&canon)) {
+        Ok(s) => s,
+        Err(err) => return fail(app, &canon, format!("No pude usar {display} como atajo ({err}).")),
+    };
+    let registered = app.global_shortcut().on_shortcut(shortcut, |app, _shortcut, event| {
+        if event.state == ShortcutState::Pressed {
+            on_press(app);
+        }
+    });
+    if let Err(err) = registered {
+        crate::log::line(format!("launcher hotkey register error: {err}"));
+        return fail(
+            app,
+            &canon,
+            format!("No pude tomar {display}: la está usando otro programa o Windows la reserva. Elegí otra en Ajustes → Atajos."),
+        );
+    }
+    crate::log::line(format!("launcher hotkey registered: {canon}"));
+    let status = HotkeyStatus { hotkey: canon, display, registered: true, error: None };
+    *CURRENT.lock().unwrap() = Some(Registered { status: status.clone(), shortcut: Some(shortcut) });
+    status
+}
+
+pub fn hotkey_status() -> HotkeyStatus {
+    CURRENT.lock().unwrap().as_ref().map(|r| r.status.clone()).unwrap_or_default()
+}
+
+/// While the settings window is listening for a new combination, the current
+/// key is let go: otherwise pressing it again would open the launcher instead
+/// of reaching the field. `false` registers the stored one again.
+pub fn suspend_hotkey(app: &AppHandle, suspend: bool, stored: &str) -> HotkeyStatus {
+    if suspend {
+        unregister_current(app);
+        let mut current = CURRENT.lock().unwrap();
+        if let Some(r) = current.as_mut() {
+            r.status.registered = false;
+        }
+        return current.as_ref().map(|r| r.status.clone()).unwrap_or_default();
+    }
+    apply_hotkey(app, stored)
+}
+
+// ── Plata's agent: the quick endpoints ───────────────────────────────────────
+
+pub const QUICK_KINDS: [&str; 5] = ["saldo", "mes", "resumenes", "deudas", "dolar"];
+/// `npm run servir` checks the session before it listens: give it time.
+const WAKE_WAIT: Duration = Duration::from_secs(40);
+
+enum AgentError {
+    /// Nothing listening on 127.0.0.1:8787 — the request never left.
+    Down,
+    Other(String),
+}
+
+async fn agent_once(post: bool, path: &str, body: Option<&Value>) -> Result<Value, AgentError> {
+    let client = reqwest::Client::builder()
+        .connect_timeout(Duration::from_secs(3))
+        .timeout(Duration::from_secs(30))
+        .build()
+        .map_err(|e| AgentError::Other(e.to_string()))?;
+    let url = format!("{}{path}", plata_agent::BASE);
+    let request = if post { client.post(&url).json(body.unwrap_or(&json!({}))) } else { client.get(&url) };
+    let response = request.send().await.map_err(|e| {
+        if e.is_connect() {
+            AgentError::Down
+        } else if e.is_timeout() {
+            AgentError::Other("El agente de Plata no contestó a tiempo.".into())
+        } else {
+            AgentError::Other(format!("No pude hablar con el agente de Plata: {e}"))
+        }
+    })?;
+    let status = response.status();
+    let text = response.text().await.map_err(|e| AgentError::Other(format!("Se cortó la respuesta del agente de Plata: {e}")))?;
+    let value: Option<Value> = serde_json::from_str(&text).ok();
+    if !status.is_success() {
+        let msg = value
+            .as_ref()
+            .and_then(|v| v.get("error"))
+            .and_then(Value::as_str)
+            .map(str::to_string)
+            .unwrap_or_else(|| text.chars().take(160).collect());
+        return Err(AgentError::Other(agent_error_message(status.as_u16(), &msg, path)));
+    }
+    value.ok_or_else(|| AgentError::Other("El agente de Plata devolvió algo que no es JSON.".into()))
+}
+
+fn agent_error_message(status: u16, msg: &str, path: &str) -> String {
+    match (status, msg) {
+        (503, "sin_sesion") => "El agente de Plata no tiene sesión de Supabase (sin_sesion): volvé a iniciarla en el agente.".into(),
+        (404, _) => format!("El agente de Plata no conoce {path}: actualizá el repo agentes y reinicialo."),
+        _ => format!("El agente de Plata respondió {status}: {msg}"),
+    }
+}
+
+/// The agent was down: start it (as at launch) and wait until /salud answers.
+async fn wake_agent() -> Result<(), String> {
+    if plata_agent::agent_dir().is_none() {
+        return Err("El agente de Plata está apagado y no encuentro la carpeta agentes para prenderlo.".into());
+    }
+    crate::log::line("quick plata: agent down, starting it");
+    plata_agent::ensure_running().await;
+    let deadline = Instant::now() + WAKE_WAIT;
+    while Instant::now() < deadline {
+        if plata_agent::status().await.up {
+            return Ok(());
+        }
+        tokio::time::sleep(Duration::from_millis(500)).await;
+    }
+    Err("Prendí el agente de Plata pero todavía no contesta. Probá de nuevo en un ratito.".into())
+}
+
+/// One request; if the agent is down, wake it and try exactly once more. Safe
+/// for POSTs too: a refused connection means the first one never arrived.
+async fn agent(post: bool, path: &str, body: Option<Value>) -> Result<Value, String> {
+    match agent_once(post, path, body.as_ref()).await {
+        Ok(v) => Ok(v),
+        Err(AgentError::Other(msg)) => Err(msg),
+        Err(AgentError::Down) => {
+            wake_agent().await?;
+            match agent_once(post, path, body.as_ref()).await {
+                Ok(v) => Ok(v),
+                Err(AgentError::Other(msg)) => Err(msg),
+                Err(AgentError::Down) => Err("El agente de Plata sigue sin contestar.".into()),
+            }
+        }
+    }
+}
+
+pub async fn quick_plata(kind: &str) -> Result<Value, String> {
+    if !QUICK_KINDS.contains(&kind) {
+        return Err(format!("No conozco la consulta rápida «{kind}»."));
+    }
+    agent(false, &format!("/agentes/plata/rapido/{kind}"), None).await
+}
+
+pub async fn quick_gasto(texto: &str) -> Result<Value, String> {
+    let texto = texto.trim();
+    if texto.is_empty() {
+        return Err("Decime el gasto: por ejemplo «12.500 súper con débito».".into());
+    }
+    agent(true, "/agentes/plata/rapido/gasto", Some(json!({ "texto": texto }))).await
+}
+
+pub async fn proposal_decide(id: i64, approve: bool) -> Result<Value, String> {
+    let action = if approve { "aprobar" } else { "rechazar" };
+    agent(true, &format!("/agentes/plata/propuestas/{id}/{action}"), Some(json!({}))).await
+}
+
+// ── Centro de Control ─────────────────────────────────────────────────────────
+
+const FOCO_URL: &str = "https://cqnlceqghqqrlacbjhzj.supabase.co/functions/v1/coucou-foco";
+
+pub async fn centro_foco() -> Result<Value, String> {
+    centro_post(json!({})).await
+}
+
+/// The actions the island can take on the Centro de Control: the same endpoint
+/// with `{accion, args}`. Answers `{ok, ...}` or `{ok:false, error}`; an
+/// `ok:false` becomes an Err with that text, so the card can show it as is.
+pub const CENTRO_ACCIONES: &[&str] = &["hecha", "reabrir", "por_hacer", "empezar", "pausar", "mover", "nueva", "habito", "no_trabajo", "borrar_nueva"];
+
+pub async fn centro_accion(accion: &str, args: Value) -> Result<Value, String> {
+    if !CENTRO_ACCIONES.contains(&accion) {
+        return Err(format!("Acción desconocida: {accion}"));
+    }
+    let args = if args.is_object() { args } else { json!({}) };
+    let answer = centro_post(json!({ "accion": accion, "args": args })).await?;
+    if answer.get("ok").and_then(Value::as_bool) == Some(true) {
+        return Ok(answer);
+    }
+    Err(answer
+        .get("error")
+        .and_then(Value::as_str)
+        .map(str::to_string)
+        .unwrap_or_else(|| "El Centro de Control no pudo hacerlo.".into()))
+}
+
+async fn centro_post(body: Value) -> Result<Value, String> {
+    let secret = secrets::get("cdc-secret")
+        .ok_or_else(|| "Falta el secreto del Centro de Control: cargalo en Ajustes → Centro de Control.".to_string())?;
+    let client = reqwest::Client::builder()
+        .connect_timeout(Duration::from_secs(5))
+        .timeout(Duration::from_secs(15))
+        .build()
+        .map_err(|e| e.to_string())?;
+    let response = client
+        .post(FOCO_URL)
+        .header("x-coucou-secret", secret)
+        .json(&body)
+        .send()
+        .await
+        .map_err(|e| {
+            if e.is_timeout() {
+                "El Centro de Control no contestó a tiempo.".to_string()
+            } else {
+                format!("No pude llegar al Centro de Control (¿hay internet?): {e}")
+            }
+        })?;
+    let status = response.status();
+    let text = response.text().await.map_err(|e| format!("Se cortó la respuesta del Centro de Control: {e}"))?;
+    if status.as_u16() == 401 {
+        return Err("El Centro de Control rechazó el secreto (401): revisalo en Ajustes → Centro de Control.".into());
+    }
+    if !status.is_success() {
+        let msg = serde_json::from_str::<Value>(&text)
+            .ok()
+            .and_then(|v| v.get("error").and_then(Value::as_str).map(str::to_string))
+            .unwrap_or_else(|| text.chars().take(160).collect());
+        return Err(format!("El Centro de Control respondió {status}: {msg}"));
+    }
+    serde_json::from_str(&text).map_err(|_| "El Centro de Control devolvió algo que no es JSON.".to_string())
+}
+
+/// The stored iCal addresses: one per line; blank lines and `#` notes are
+/// skipped, `webcal://` becomes `https://`, repeats count once.
+pub fn parse_ical_urls(raw: &str) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    for line in raw.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let url = match line.strip_prefix("webcal://") {
+            Some(rest) => format!("https://{rest}"),
+            None => line.to_string(),
+        };
+        if !(url.starts_with("https://") || url.starts_with("http://")) || url.contains(char::is_whitespace) {
+            continue;
+        }
+        if !out.contains(&url) {
+            out.push(url);
+        }
+    }
+    out
+}
+
+const MAX_ICS_BYTES: usize = 15 * 1024 * 1024;
+
+async fn fetch_ics(client: reqwest::Client, url: String) -> Result<String, String> {
+    let response = client.get(&url).send().await.map_err(|e| {
+        if e.is_timeout() { "no contestó a tiempo".to_string() } else { format!("no pude conectarme ({e})") }
+    })?;
+    let status = response.status();
+    if !status.is_success() {
+        return Err(format!("respondió {status}"));
+    }
+    let body = response.text().await.map_err(|e| format!("se cortó la descarga ({e})"))?;
+    if body.len() > MAX_ICS_BYTES {
+        return Err("el calendario pesa demasiado".into());
+    }
+    if !body.trim_start_matches('\u{feff}').trim_start().starts_with("BEGIN:VCALENDAR") {
+        return Err("no devolvió un calendario (¿es la dirección secreta en formato iCal?)".into());
+    }
+    Ok(body)
+}
+
+/// Shown in errors and logs without the secret part of the address.
+fn url_host(url: &str) -> &str {
+    url.split("://").nth(1).and_then(|r| r.split('/').next()).unwrap_or(url)
+}
+
+/// Downloads every stored calendar at once. One that fails is skipped (and
+/// logged); only when none can be read is it an error.
+pub async fn calendar_ics() -> Result<Vec<String>, String> {
+    let urls = secrets::get("cdc-ical-urls").map(|raw| parse_ical_urls(&raw)).unwrap_or_default();
+    if urls.is_empty() {
+        return Err("No hay calendarios configurados: cargá las direcciones iCal en Ajustes → Centro de Control.".into());
+    }
+    let client = reqwest::Client::builder()
+        .connect_timeout(Duration::from_secs(5))
+        .timeout(Duration::from_secs(20))
+        .build()
+        .map_err(|e| e.to_string())?;
+    let tasks: Vec<_> = urls
+        .iter()
+        .map(|u| tauri::async_runtime::spawn(fetch_ics(client.clone(), u.clone())))
+        .collect();
+    let mut bodies = Vec::new();
+    let mut first_error: Option<String> = None;
+    for (url, task) in urls.iter().zip(tasks) {
+        match task.await.map_err(|e| e.to_string()).and_then(|r| r) {
+            Ok(body) => bodies.push(body),
+            Err(err) => {
+                crate::log::line(format!("calendar_ics {}: {err}", url_host(url)));
+                first_error.get_or_insert_with(|| format!("El calendario de {} {err}.", url_host(url)));
+            }
+        }
+    }
+    if bodies.is_empty() {
+        return Err(first_error.unwrap_or_else(|| "No pude leer ningún calendario.".into()));
+    }
+    Ok(bodies)
+}
+
+// ── The doorman's second opinion ─────────────────────────────────────────────
+
+const ROUTER_MODEL: &str = "claude-haiku-4-5";
+const ROUTER_MAX_TOKENS: u32 = 60;
+const ROUTER_TIMEOUT: Duration = Duration::from_secs(10);
+/// A sentence for the launcher, not an essay: longer input is cut here.
+const ROUTER_MAX_INPUT: usize = 600;
+
+#[derive(Deserialize, Debug, Clone)]
+pub struct SkillHint {
+    pub id: String,
+    pub nombre: String,
+    #[serde(default)]
+    pub descripcion: String,
+}
+
+fn no_route() -> Value {
+    json!({ "skill": null, "confianza": 0 })
+}
+
+fn router_system(skills: &[SkillHint]) -> String {
+    let mut s = String::from(
+        "Sos el portero de un lanzador de atajos en la PC de Lucas. Te llega una frase suya, \
+         dictada o escrita en castellano rioplatense, y elegís cuál de estas skills la resuelve:\n",
+    );
+    for k in skills {
+        s.push_str(&format!("- {}: {} — {}\n", k.id, k.nombre, k.descripcion));
+    }
+    s.push_str(
+        "\nSi ninguna encaja con claridad, skill es null. confianza va de 0 a 100: qué tan seguro \
+         estás de que esa skill es la que Lucas quiere. Respondé solo con el JSON \
+         {\"skill\": <id o null>, \"confianza\": <0-100>}, sin texto alrededor.",
+    );
+    s
+}
+
+/// The model's answer → `{ skill, confianza }`. Whatever comes back (fences,
+/// prose around it, an id that doesn't exist, a confidence of "85%" or 0.85)
+/// ends up as a known id with 0..=100, or as null with 0.
+pub fn parse_route(text: &str, ids: &[&str]) -> Value {
+    let (Some(start), Some(end)) = (text.find('{'), text.rfind('}')) else { return no_route() };
+    if end < start {
+        return no_route();
+    }
+    let Ok(v) = serde_json::from_str::<Value>(&text[start..=end]) else { return no_route() };
+    let skill = v
+        .get("skill")
+        .and_then(Value::as_str)
+        .map(str::trim)
+        .and_then(|s| ids.iter().find(|id| id.eq_ignore_ascii_case(s)))
+        .map(|id| id.to_string());
+    let Some(skill) = skill else { return no_route() };
+    let raw = match v.get("confianza") {
+        Some(Value::Number(n)) => n.as_f64(),
+        Some(Value::String(s)) => s.trim().trim_end_matches('%').trim().replace(',', ".").parse::<f64>().ok(),
+        _ => None,
+    };
+    let mut c = raw.filter(|c| c.is_finite()).unwrap_or(0.0);
+    if c > 0.0 && c < 1.0 {
+        c *= 100.0; // a fraction instead of a percentage
+    }
+    let c = c.round().clamp(0.0, 100.0) as u8;
+    json!({ "skill": skill, "confianza": c })
+}
+
+/// Without an Anthropic key there is no second opinion: `{ skill: null, confianza: 0 }`
+/// and the launcher offers its three options. A failed call is the same, with
+/// `error` added, so the launcher never gets stuck on it.
+pub async fn route_skill(texto: &str, skills: &[SkillHint]) -> Value {
+    let texto: String = texto.trim().chars().take(ROUTER_MAX_INPUT).collect();
+    if texto.is_empty() || skills.is_empty() {
+        return no_route();
+    }
+    let Some(key) = secrets::get("anthropic-api-key") else { return no_route() };
+    let ids: Vec<&str> = skills.iter().map(|s| s.id.as_str()).collect();
+    let body = json!({
+        "model": ROUTER_MODEL,
+        "max_tokens": ROUTER_MAX_TOKENS,
+        "system": router_system(skills),
+        "messages": [{ "role": "user", "content": texto }],
+        // Structured outputs: the answer is this JSON or nothing. parse_route
+        // still checks it, since an id list the model never saw is no guarantee.
+        "output_config": { "format": { "type": "json_schema", "schema": {
+            "type": "object",
+            "properties": {
+                "skill": { "anyOf": [ { "type": "string", "enum": ids }, { "type": "null" } ] },
+                "confianza": { "type": "integer" }
+            },
+            "required": ["skill", "confianza"],
+            "additionalProperties": false
+        } } },
+    });
+    let response = match crate::claude::call_with(&key, &body, ROUTER_TIMEOUT, None).await {
+        Ok(v) => v,
+        Err(err) => {
+            crate::log::line(format!("route_skill: {err}"));
+            let mut out = no_route();
+            out["error"] = Value::String(err);
+            return out;
+        }
+    };
+    if response.get("stop_reason").and_then(Value::as_str) == Some("refusal") {
+        return no_route();
+    }
+    let text = response
+        .get("content")
+        .and_then(Value::as_array)
+        .map(|blocks| {
+            blocks
+                .iter()
+                .filter(|b| b.get("type").and_then(Value::as_str) == Some("text"))
+                .filter_map(|b| b.get("text").and_then(Value::as_str))
+                .collect::<Vec<_>>()
+                .join("")
+        })
+        .unwrap_or_default();
+    parse_route(&text, &ids)
+}
+
