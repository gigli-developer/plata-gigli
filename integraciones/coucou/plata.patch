+// ── Suggested actions ─────────────────────────────────────────────────────
+// The agent may end an answer with a fenced block in the `acciones` language,
+// one `label => message` per line. It is never drawn as text: Plata turns it
+// into buttons (plata.ts) once the turn ends.
+
+const ACC_OPEN = /^\s*`{3,}\s*acciones\s*$/i;
+const FENCE_CLOSE = /^\s*`{3,}\s*$/;
+/** A fence still arriving: ``` followed by the start of "acciones". */
+const ACC_PARTIAL = /^\s*`{3,}\s*([a-z]+)$/i;
+
+export interface Accion {
+  label: string;
+  message: string;
+}
+
+const MAX_ACCIONES = 3;
+const MAX_LABEL = 40;
+const MAX_MESSAGE = 300;
+
+/**
+ * Splits the `acciones` blocks off an answer. An unclosed block (the answer
+ * still streaming) is cut from its fence to the end, so it never flashes.
+ */
+export function splitAcciones(text: string): { body: string; acciones: Accion[] } {
+  const lines = text.replace(/\r\n?/g, "\n").split("\n");
+  const body: string[] = [];
+  const acciones: Accion[] = [];
+  let inBlock = false;
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    if (inBlock) {
+      if (FENCE_CLOSE.test(line)) {
+        inBlock = false;
+        continue;
+      }
+      const at = line.indexOf("=>");
+      if (at < 0) continue;
+      const label = line.slice(0, at).trim();
+      const message = line.slice(at + 2).trim();
+      if (!label || !message || label.length > MAX_LABEL || message.length > MAX_MESSAGE) continue;
+      if (acciones.length < MAX_ACCIONES) acciones.push({ label, message });
+      continue;
+    }
+    if (ACC_OPEN.test(line)) {
+      inBlock = true;
+      continue;
+    }
+    // The last line may be the fence itself, half-written.
+    const partial = i === lines.length - 1 ? ACC_PARTIAL.exec(line) : null;
+    if (partial && "acciones".startsWith(partial[1].toLowerCase())) continue;
+    body.push(line);
+  }
+  return { body: body.join("\n").trimEnd(), acciones };
+}
+
+/** The answer as one line of plain text, for previews (the chat list). */
+export function plainLine(text: string): string {
+  return splitAcciones(text)
+    .body.split("\n")
