@@ -0,0 +1,1010 @@
+// Reconciling a card statement, or a bank-account statement, with Claude Code,
+// headless, on Lucas's own plan.
+//
+// The Plata agent (plata_agent.rs) runs on the API and is billed per token.
+// Reconciling a statement is a long read of a PDF against many rows, so the
+// island hands it to Claude Code instead: `claude -p` in the background, with
+// the `conciliar-resumen` skill (a credit-card statement) or `conciliar-extracto`
+// (the bank account's statement; Claude Code reads the file and picks), which
+// leave `datos.json` and `informe.html` in a folder of their own. Both write the
+// same `datos.json` shape. Nothing here writes to Plata.
+//
+// One run per conversation. Its stream-json output is read line by line and
+// turned into short progress lines for the page (`plata-delegado`), then a
+// final event with the parsed `datos.json`.
+
+use std::io::{BufRead, BufReader, Read, Write};
+use std::os::windows::process::CommandExt;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::atomic::{AtomicU8, Ordering};
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use serde::Serialize;
+use serde_json::{json, Value};
+use tauri::{AppHandle, Emitter};
+
+use crate::plata_agent::{self, CREATE_NO_WINDOW};
+
+/// The event every run reports on: `{sesionId, ev}`.
+pub const EVENT: &str = "plata-delegado";
+/// The skill writes and checks a few files; past this the run is stuck.
+const TIMEOUT: Duration = Duration::from_secs(10 * 60);
+/// A credit card's statement. Required: without it nothing is delegated.
+const SKILL: &str = "conciliar-resumen";
+/// The bank account's statement (03/10). Optional: an older PC without it
+/// still reconciles card statements.
+const SKILL_EXTRACTO: &str = "conciliar-extracto";
+
+/// The whole invocation in one place, so it can follow the skills' side of the
+/// contract. The prompt goes in through stdin. `skill_dirs`: the folder of each
+/// skill the run may use, readable with --add-dir.
+fn claude_args(carpeta: &Path, skill_dirs: &[PathBuf]) -> Vec<String> {
+    // --tools: only what the recipe uses (no PowerShell to wander into).
+    // dontAsk: anything not pre-approved is refused at once. In -p a permission
+    // prompt has nobody to answer it and waits until it times out: six of
+    // those made the first real run take 8 minutes instead of ~1.
+    let mut args: Vec<String> = [
+        "-p",
+        "--output-format",
+        "stream-json",
+        "--verbose",
+        "--model",
+        "sonnet",
+        "--permission-mode",
+        "dontAsk",
+        "--tools",
+        "Read,Write,Glob,Skill,Bash",
+        "--allowedTools",
+    ]
+        .iter()
+        .map(|s| s.to_string())
+        .collect();
+    args.extend(
+        [
+            "Read",
+            "Write",
+            "Glob",
+            "Skill",
+            "Bash(npm run -s conciliar:leer*)",
+            "Bash(npm run -s conciliar:leer-cuenta*)",
+            "Bash(node *llenar.mjs*)",
+        ]
+        .iter()
+        .map(|s| s.to_string()),
+    );
+    args.push("--add-dir".into());
+    args.push(carpeta.to_string_lossy().to_string());
+    for dir in skill_dirs {
+        args.push("--add-dir".into());
+        args.push(dir.to_string_lossy().to_string());
+    }
+    args
+}
+
+/// `extracto`: the `conciliar-extracto` skill is there, so Claude Code picks
+/// between the two by reading the file.
+fn prompt(archivos: &[PathBuf], carpeta: &Path, pedido: &str, extracto: bool) -> String {
+    let rutas: Vec<String> = archivos.iter().map(|p| p.to_string_lossy().to_string()).collect();
+    let (skill, comandos) = if extracto {
+        (
+            format!(
+                "Leé el archivo y decidí: si es el resumen de una tarjeta de crédito, usá la skill {SKILL}; \
+                 si es el extracto de una cuenta bancaria (transferencias, débitos, saldo), usá la skill {SKILL_EXTRACTO}."
+            ),
+            "`npm run -s conciliar:leer -- ...`, `npm run -s conciliar:leer-cuenta -- ...` y `node <ruta de la skill>/llenar.mjs ...`",
+        )
+    } else {
+        (format!("Usá la skill {SKILL}."), "`npm run -s conciliar:leer -- ...` y `node <ruta de la skill>/llenar.mjs ...`")
+    };
+    let mut p = format!(
+        "MODO ISLA. {skill} Archivos: {}. Carpeta de salida: {}\n\
+         Comandos: solo con Bash, uno por llamada, sin cd, sin variables y sin encadenar \
+         (el cwd ya es el repo agentes). Los únicos permitidos: {comandos}.",
+        rutas.join(", "),
+        carpeta.display()
+    );
+    let pedido = pedido.trim();
+    if !pedido.is_empty() {
+        p.push_str(&format!("\nPedido de Lucas: {pedido}"));
+    }
+    p
+}
+
+/// Variables that would make the child something other than a plain run on
+/// Lucas's login: an API key (billed per token, the thing this avoids) or the
+/// markers of a Claude Code session it was started from.
+const ENV_DROP: &[&str] = &[
+    "ANTHROPIC_API_KEY",
+    "ANTHROPIC_AUTH_TOKEN",
+    "CLAUDECODE",
+    "CLAUDE_CODE_ENTRYPOINT",
+    "CLAUDE_CODE_SESSION_ID",
+    "CLAUDE_CODE_CHILD_SESSION",
+    "CLAUDE_CODE_HOST_SESSION_ID",
+    "CLAUDE_CODE_SDK_HAS_HOST_AUTH_REFRESH",
+    "CLAUDE_CODE_OAUTH_SCOPES",
+    "CLAUDE_CODE_MESSAGING_SOCKET",
+    "CLAUDE_CODE_MESSAGING_TOKEN",
+];
+
+/// `claude.exe` as every call here runs it: no console window, and none of the
+/// variables above, so it is Lucas's own login and nothing else.
+fn plain_command(exe: &Path) -> Command {
+    let mut cmd = Command::new(exe);
+    cmd.creation_flags(CREATE_NO_WINDOW);
+    for k in ENV_DROP {
+        cmd.env_remove(k);
+    }
+    cmd
+}
+
+// ── Running jobs ────────────────────────────────────────────────────────────
+
+const STOP_NONE: u8 = 0;
+const STOP_CANCEL: u8 = 1;
+const STOP_TIMEOUT: u8 = 2;
+
+struct Run {
+    sesion_id: String,
+    pid: u32,
+    stop: Arc<AtomicU8>,
+}
+
+static RUNNING: Mutex<Vec<Run>> = Mutex::new(Vec::new());
+
+/// Claude Code starts shells and node: the whole tree goes, not just claude.exe.
+fn kill_tree(pid: u32) {
+    let _ = Command::new("taskkill")
+        .args(["/PID", &pid.to_string(), "/T", "/F"])
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .creation_flags(CREATE_NO_WINDOW)
+        .status();
+}
+
+fn stop(sesion_id: &str, why: u8) -> bool {
+    let running = RUNNING.lock().unwrap();
+    let Some(run) = running.iter().find(|r| r.sesion_id == sesion_id) else { return false };
+    run.stop.store(why, Ordering::SeqCst);
+    kill_tree(run.pid);
+    true
+}
+
+pub fn cancel(sesion_id: &str) -> bool {
+    stop(sesion_id, STOP_CANCEL)
+}
+
+// ── The folder of a run ─────────────────────────────────────────────────────
+
+pub fn runs_dir() -> PathBuf {
+    crate::settings::local_dir().join("conciliaciones")
+}
+
+/// `%LOCALAPPDATA%\Coucou\conciliaciones\2026-10-01_2105-33`, local time.
+fn new_run_dir() -> Result<PathBuf, String> {
+    use windows::Win32::System::SystemInformation::GetLocalTime;
+    let t = unsafe { GetLocalTime() };
+    let stamp = format!("{:04}-{:02}-{:02}_{:02}{:02}-{:02}", t.wYear, t.wMonth, t.wDay, t.wHour, t.wMinute, t.wSecond);
+    let base = runs_dir();
+    let mut dir = base.join(&stamp);
+    let mut n = 2;
+    while dir.exists() {
+        dir = base.join(format!("{stamp}-{n}"));
+        n += 1;
+    }
+    std::fs::create_dir_all(&dir).map_err(|e| format!("No pude crear la carpeta de la conciliación: {e}"))?;
+    Ok(dir)
+}
+
+/// Copies the statement into the run folder, so the run reads (and keeps) its
+/// own copy. Same checks as for the agent: PDF or image, within the limits.
+fn stage_inputs(dir: &Path, adjuntos: &[String], pegado: Option<&str>) -> Result<Vec<PathBuf>, String> {
+    if adjuntos.len() > plata_agent::MAX_ATTACHMENTS {
+        return Err(format!("Hasta {} adjuntos por mensaje.", plata_agent::MAX_ATTACHMENTS));
+    }
+    let mut out = Vec::new();
+    for path in adjuntos {
+        let info = plata_agent::attachment_info(path)?;
+        let name: String = info
+            .name
+            .chars()
+            .map(|c| if c.is_alphanumeric() || " ._-()".contains(c) { c } else { '_' })
+            .collect();
+        let mut target = dir.join(&name);
+        let mut n = 2;
+        while target.exists() {
+            target = dir.join(format!("{n}-{name}"));
+            n += 1;
+        }
+        std::fs::copy(path, &target).map_err(|e| format!("No pude copiar «{}»: {e}", info.name))?;
+        out.push(target);
+    }
+    if let Some(text) = pegado.map(str::trim).filter(|t| !t.is_empty()) {
+        let target = dir.join("resumen.txt");
+        std::fs::write(&target, text).map_err(|e| format!("No pude guardar el resumen pegado: {e}"))?;
+        out.push(target);
+    }
+    if out.is_empty() {
+        return Err("No hay nada que conciliar: soltá el PDF o la captura del resumen o del extracto, o pegá el texto.".into());
+    }
+    Ok(out)
+}
+
+// ── stream-json → progress ──────────────────────────────────────────────────
+
+/// What the stream said so far that matters at the end.
+#[derive(Default, Debug)]
+pub(crate) struct Stream {
+    last_progress: Option<String>,
+    /// The `result` line: the final text and whether it is an error.
+    pub result: Option<(String, bool)>,
+    /// The last thing the assistant said, in case no `result` arrives.
+    pub last_text: Option<String>,
+    /// Claude Code has no login (`/login`), so nothing can run.
+    pub auth_failed: bool,
+}
+
+fn file_name_of(input: &Value, key: &str) -> String {
+    let p = input.get(key).and_then(Value::as_str).unwrap_or("");
+    p.rsplit(['\\', '/']).next().unwrap_or(p).to_string()
+}
+
+/// A tool call, said the way Lucas would: what it is doing, not which tool.
+fn tool_phrase(name: &str, input: &Value) -> Option<String> {
+    let path = input.get("file_path").and_then(Value::as_str).unwrap_or("").replace('\\', "/").to_lowercase();
+    let file = file_name_of(input, "file_path");
+    let lower = file.to_lowercase();
+    let ext = lower.rsplit('.').next().unwrap_or("");
+    let phrase = match name {
+        "Skill" => "Usando la receta de conciliación".to_string(),
+        "Read" if path.contains(&format!("/{SKILL}/")) || path.contains(&format!("/{SKILL_EXTRACTO}/")) => {
+            "Usando la receta de conciliación".to_string()
+        }
+        "Read" if ["pdf", "txt", "png", "jpg", "jpeg", "webp"].contains(&ext) => "Leyendo lo del banco".to_string(),
+        "Read" => format!("Leyendo {file}"),
+        "Bash" => {
+            let cmd = input.get("command").and_then(Value::as_str).unwrap_or("");
+            if cmd.contains("conciliar:leer") {
+                "Consultando Plata".to_string()
+            } else if cmd.contains("llenar.mjs") {
+                "Armando el informe".to_string()
+            } else {
+                "Corriendo un comando".to_string()
+            }
+        }
+        "Write" | "Edit" if lower == "datos.json" => "Comparando línea por línea".to_string(),
+        "Write" | "Edit" if lower.ends_with(".html") => "Armando el informe".to_string(),
+        "Write" | "Edit" => format!("Escribiendo {file}"),
+        "Glob" | "Grep" => "Buscando archivos".to_string(),
+        "ToolSearch" | "TodoWrite" => return None,
+        other => format!("Usando {other}"),
+    };
+    Some(phrase)
+}
+
+/// One line of `--output-format stream-json`. Returns the progress events it
+/// produces (none for most lines) and keeps what the final event needs.
+pub(crate) fn parse_line(line: &str, st: &mut Stream) -> Vec<Value> {
+    let Ok(v) = serde_json::from_str::<Value>(line.trim()) else { return vec![] };
+    let mut phrases: Vec<String> = Vec::new();
+    match v.get("type").and_then(Value::as_str) {
+        Some("system") if v.get("subtype").and_then(Value::as_str) == Some("init") => {
+            phrases.push("Claude Code arrancó".into());
+        }
+        Some("assistant") => {
+            if v.get("error").and_then(Value::as_str) == Some("authentication_failed") {
+                st.auth_failed = true;
+            }
+            let content = v.pointer("/message/content").and_then(Value::as_array).cloned().unwrap_or_default();
+            for block in content {
+                match block.get("type").and_then(Value::as_str) {
+                    Some("tool_use") => {
+                        let name = block.get("name").and_then(Value::as_str).unwrap_or("");
+                        let input = block.get("input").cloned().unwrap_or(Value::Null);
+                        if let Some(p) = tool_phrase(name, &input) {
+                            phrases.push(p);
+                        }
+                    }
+                    Some("text") => {
+                        if let Some(t) = block.get("text").and_then(Value::as_str).filter(|t| !t.trim().is_empty()) {
+                            st.last_text = Some(t.trim().to_string());
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+        Some("result") => {
+            let text = v.get("result").and_then(Value::as_str).unwrap_or("").trim().to_string();
+            let is_error = v.get("is_error").and_then(Value::as_bool).unwrap_or(false)
+                || v.get("subtype").and_then(Value::as_str).is_some_and(|s| s != "success");
+            if is_error && (text.contains("Not logged in") || text.contains("/login")) {
+                st.auth_failed = true;
+            }
+            st.result = Some((text, is_error));
+        }
+        _ => {}
+    }
+    let mut out = Vec::new();
+    for p in phrases {
+        // The same step twice in a row (three reads of the PDF) is one line.
+        if st.last_progress.as_deref() == Some(p.as_str()) {
+            continue;
+        }
+        st.last_progress = Some(p.clone());
+        out.push(json!({ "tipo": "progreso", "texto": p }));
+    }
+    out
+}
+
+/// The final event, from what the stream said and what the run left behind.
+pub(crate) fn final_event(st: &Stream, carpeta: &Path, secs: u64, stop: u8, exit_ok: bool, stderr_tail: &str) -> Value {
+    if stop == STOP_CANCEL {
+        return json!({ "tipo": "error", "texto": "Cancelado.", "cancelado": true });
+    }
+    if stop == STOP_TIMEOUT {
+        return json!({ "tipo": "error", "texto": format!("Claude Code tardó más de {} minutos: lo corté.", TIMEOUT.as_secs() / 60) });
+    }
+    if st.auth_failed {
+        return json!({
+            "tipo": "error",
+            "texto": "Claude Code no tiene la sesión iniciada en esta PC. Conectalo con tu cuenta (se abre el navegador para autorizar) y la conciliación se reintenta sola.",
+            "login": true,
+        });
+    }
+    let datos: Option<Value> = std::fs::read_to_string(carpeta.join("datos.json"))
+        .ok()
+        .and_then(|s| serde_json::from_str(s.trim_start_matches('\u{feff}')).ok());
+    let informe = carpeta.join("informe.html");
+    let informe = informe.is_file().then(|| informe.to_string_lossy().to_string());
+    let (mensaje, is_error) = match &st.result {
+        Some((t, e)) => (t.clone(), *e),
+        None => (st.last_text.clone().unwrap_or_default(), true),
+    };
+    if datos.is_none() && st.result.is_none() && !exit_ok {
+        let detail = stderr_tail.trim();
+        return json!({
+            "tipo": "error",
+            "texto": if detail.is_empty() {
+                "Claude Code terminó sin responder.".to_string()
+            } else {
+                format!("Claude Code terminó con un error: {detail}")
+            },
+        });
+    }
+    let ok = !is_error && datos.as_ref().is_some_and(|d| d.get("error").is_none());
+    json!({
+        "tipo": "fin",
+        "ok": ok,
+        "mensaje": mensaje,
+        "datos": datos,
+        "informe": informe,
+        "carpeta": carpeta.to_string_lossy(),
+        "segundos": secs,
+    })
+}
+
+// ── The run ─────────────────────────────────────────────────────────────────
+
+#[derive(Serialize, Clone)]
+#[serde(rename_all = "camelCase")]
+struct Delegado {
+    sesion_id: String,
+    ev: Value,
+}
+
+#[derive(Serialize, Clone)]
+#[serde(rename_all = "camelCase")]
+pub struct Started {
+    pub carpeta: String,
+}
+
+fn emit(app: &AppHandle, sesion_id: &str, ev: Value) {
+    let _ = app.emit_to(crate::island::WINDOW_LABEL, EVENT, Delegado { sesion_id: sesion_id.to_string(), ev });
+}
+
+fn skill_dir_named(name: &str) -> Option<PathBuf> {
+    let p = PathBuf::from(std::env::var_os("USERPROFILE")?).join(".claude").join("skills").join(name);
+    p.join("SKILL.md").is_file().then_some(p)
+}
+
+/// The card statement's skill: the one the Plata tab checks for.
+pub(crate) fn skill_dir() -> Option<PathBuf> {
+    skill_dir_named(SKILL)
+}
+
+/// The bank account statement's skill, if this PC has it.
+pub(crate) fn skill_extracto_dir() -> Option<PathBuf> {
+    skill_dir_named(SKILL_EXTRACTO)
+}
+
+/// Starts the run and returns once Claude Code is up; everything after that
+/// arrives as `plata-delegado` events. An error here means it never started.
+pub fn delegate(app: AppHandle, sesion_id: String, texto: String, adjuntos: Vec<String>, pegado: Option<String>) -> Result<Started, String> {
+    if RUNNING.lock().unwrap().iter().any(|r| r.sesion_id == sesion_id) {
+        return Err("Ya hay una conciliación en curso en esta conversación.".into());
+    }
+    let exe = plata_agent::claude_exe().ok_or_else(|| "No encuentro Claude Code (viene con la app de escritorio de Claude).".to_string())?;
+    let cwd = plata_agent::agent_dir().ok_or_else(|| "No encuentro la carpeta agentes, que es donde corre la conciliación.".to_string())?;
+    let skill = skill_dir().ok_or_else(|| format!("No encuentro la skill {SKILL} en .claude\\skills."))?;
+    let extracto = skill_extracto_dir();
+    let skills: Vec<PathBuf> = std::iter::once(skill).chain(extracto.clone()).collect();
+
+    let carpeta = new_run_dir()?;
+    let inputs = match stage_inputs(&carpeta, &adjuntos, pegado.as_deref()) {
+        Ok(i) => i,
+        Err(e) => {
+            let _ = std::fs::remove_dir_all(&carpeta);
+            return Err(e);
+        }
+    };
+    let names: Vec<String> = inputs.iter().filter_map(|p| p.file_name().map(|n| n.to_string_lossy().to_string())).collect();
+    plata_agent::transcript(&sesion_id, "delegado", &format!("{} [{}] → {}", texto.trim(), names.join(", "), carpeta.display()));
+
+    let stderr = std::fs::File::create(carpeta.join("claude-code.log")).map_err(|e| e.to_string())?;
+    let mut cmd = plain_command(&exe);
+    cmd.args(claude_args(&carpeta, &skills))
+        .current_dir(&cwd)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(stderr);
+    let mut child = cmd.spawn().map_err(|e| format!("No pude arrancar Claude Code: {e}"))?;
+    if let Some(mut stdin) = child.stdin.take() {
+        // Closing stdin is what tells `-p` the prompt is complete.
+        let _ = stdin.write_all(prompt(&inputs, &carpeta, &texto, extracto.is_some()).as_bytes());
+    }
+    let stdout = child.stdout.take().ok_or("Claude Code no dio salida.")?;
+    let stop_flag = Arc::new(AtomicU8::new(STOP_NONE));
+    RUNNING.lock().unwrap().push(Run { sesion_id: sesion_id.clone(), pid: child.id(), stop: stop_flag.clone() });
+    crate::log::line(format!("claude code headless started for {sesion_id} in {}", carpeta.display()));
+
+    // Watchdog: the reader below blocks on stdout, so the deadline lives here.
+    let (done_tx, done_rx) = mpsc::channel::<()>();
+    {
+        let sesion_id = sesion_id.clone();
+        std::thread::spawn(move || {
+            if let Err(mpsc::RecvTimeoutError::Timeout) = done_rx.recv_timeout(TIMEOUT) {
+                stop(&sesion_id, STOP_TIMEOUT);
+            }
+        });
+    }
+
+    let result = Started { carpeta: carpeta.to_string_lossy().to_string() };
+    std::thread::spawn(move || {
+        let started = Instant::now();
+        let mut st = Stream::default();
+        let mut raw = std::fs::File::create(carpeta.join("stream.jsonl")).ok();
+        let mut reader = BufReader::new(stdout);
+        let mut buf = Vec::new();
+        loop {
+            buf.clear();
+            match reader.read_until(b'\n', &mut buf) {
+                Ok(0) | Err(_) => break,
+                Ok(_) => {}
+            }
+            let line = String::from_utf8_lossy(&buf);
+            if let Some(f) = raw.as_mut() {
+                let _ = f.write_all(line.as_bytes());
+            }
+            for ev in parse_line(&line, &mut st) {
+                emit(&app, &sesion_id, ev);
+            }
+        }
+        let exit_ok = child.wait().map(|s| s.success()).unwrap_or(false);
+        let _ = done_tx.send(());
+        let why = stop_flag.load(Ordering::SeqCst);
+        RUNNING.lock().unwrap().retain(|r| r.sesion_id != sesion_id);
+
+        let tail = std::fs::read_to_string(carpeta.join("claude-code.log")).unwrap_or_default();
+        let tail: String = tail.lines().rev().take(3).collect::<Vec<_>>().into_iter().rev().collect::<Vec<_>>().join(" ");
+        let ev = final_event(&st, &carpeta, started.elapsed().as_secs(), why, exit_ok, &tail);
+        let summary = match ev.get("tipo").and_then(Value::as_str) {
+            Some("fin") => format!(
+                "ok={} {}s diferencias={} {}",
+                ev["ok"],
+                ev["segundos"],
+                ev.pointer("/datos/diferencias").and_then(Value::as_array).map_or(0, Vec::len),
+                ev["mensaje"].as_str().unwrap_or("").chars().take(300).collect::<String>()
+            ),
+            _ => ev["texto"].as_str().unwrap_or("").to_string(),
+        };
+        plata_agent::transcript(&sesion_id, "delegado-fin", &summary);
+        crate::log::line(format!("claude code headless ended for {sesion_id}: {summary}"));
+        emit(&app, &sesion_id, ev);
+    });
+    Ok(result)
+}
+
+/// The report of a run, in the default browser. Only files inside the runs
+/// folder: the page hands back a path, and this must not open anything else.
+pub fn open_report(path: &str) -> Result<(), String> {
+    let p = std::fs::canonicalize(path).map_err(|_| "No encuentro el informe.".to_string())?;
+    let base = std::fs::canonicalize(runs_dir()).map_err(|_| "No encuentro el informe.".to_string())?;
+    let is_html = p.extension().is_some_and(|e| e.eq_ignore_ascii_case("html"));
+    if !p.starts_with(&base) || !is_html {
+        return Err("Ese archivo no es un informe de conciliación.".into());
+    }
+    Command::new("explorer").arg(&p).spawn().map_err(|e| format!("No pude abrir el informe: {e}"))?;
+    Ok(())
+}
+
+// ── The login: is Claude Code on Lucas's plan, and connecting it ────────────
+//
+// `claude auth status --json` answers in under a second:
+//   {"loggedIn":true,"authMethod":"claude.ai","subscriptionType":"pro",...}
+// and exits 1 with `"loggedIn":false` when there is no login.
+//
+// `claude auth login --claudeai` needs no console (seen with 2.1.286, stdin a
+// pipe): it prints "Opening browser to sign in…", opens the default browser
+// itself (`rundll32 url,OpenURL`, or $BROWSER) on an authorize URL whose
+// redirect is http://localhost:<port>/callback, and listens on that port.
+// Authorizing there finishes the login with nothing else to do. It also prints
+// "If the browser didn't open, visit: <url>" — a second URL whose redirect is a
+// claude.com page that shows a code — and "Paste code here if prompted >",
+// reading that code from stdin. Both paths race; whichever lands first wins.
+
+/// Lucas's Claude Code login, as the Plata tab needs it.
+#[derive(Serialize, Clone, Debug, PartialEq, Default)]
+#[serde(rename_all = "camelCase")]
+pub struct Sesion {
+    /// Logged in with the subscription (what `-p` runs on), not an API key.
+    pub ok: bool,
+    /// `Pro`, `Max`… from `subscriptionType`.
+    pub plan: Option<String>,
+    /// Why it is not ok, when there is more to say than "no login".
+    pub detalle: Option<String>,
+}
+
+fn plan_name(sub: &str) -> String {
+    let mut c = sub.trim().chars();
+    c.next().map(|f| f.to_uppercase().chain(c).collect()).unwrap_or_default()
+}
+
+/// The JSON of `auth status --json`. None if it isn't that.
+pub(crate) fn parse_auth_status(out: &str) -> Option<Sesion> {
+    let (start, end) = (out.find('{')?, out.rfind('}')?);
+    let v: Value = serde_json::from_str(out.get(start..=end)?).ok()?;
+    let logged_in = v.get("loggedIn")?.as_bool()?;
+    let method = v.get("authMethod").and_then(Value::as_str).unwrap_or("");
+    let plan = v.get("subscriptionType").and_then(Value::as_str).filter(|s| !s.trim().is_empty()).map(plan_name);
+    if !logged_in {
+        return Some(Sesion::default());
+    }
+    // "claude.ai" is the subscription. A Console login or an API key would bill
+    // every reconciliation per token, the thing running in Claude Code avoids.
+    if method.starts_with("claude") || plan.is_some() {
+        return Some(Sesion { ok: true, plan, detalle: None });
+    }
+    Some(Sesion {
+        ok: false,
+        plan: None,
+        detalle: Some(format!("Claude Code está conectado con «{method}» (se cobra por uso), no con tu plan.")),
+    })
+}
+
+/// Runs `cmd` and returns its stdout, or gives up after `limit`.
+fn output_within(mut cmd: Command, limit: Duration) -> Result<String, String> {
+    let mut child = cmd
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|e| e.to_string())?;
+    let mut stdout = child.stdout.take().ok_or("sin salida")?;
+    let reader = std::thread::spawn(move || {
+        let mut s = String::new();
+        let _ = stdout.read_to_string(&mut s);
+        s
+    });
+    let started = Instant::now();
+    loop {
+        if child.try_wait().map_err(|e| e.to_string())?.is_some() {
+            break;
+        }
+        if started.elapsed() > limit {
+            kill_tree(child.id());
+            let _ = child.wait();
+            return Err(format!("no respondió en {} s", limit.as_secs()));
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    reader.join().map_err(|_| "no pude leer la salida".to_string())
+}
+
+/// `claude auth status --json`, blocking (about half a second).
+pub(crate) fn auth_status(exe: &Path) -> Sesion {
+    let mut cmd = plain_command(exe);
+    cmd.args(["auth", "status", "--json"]);
+    match output_within(cmd, Duration::from_secs(20)) {
+        Ok(out) => parse_auth_status(&out).unwrap_or_else(|| Sesion {
+            detalle: Some("No entendí lo que respondió Claude Code sobre la sesión.".into()),
+            ..Sesion::default()
+        }),
+        Err(e) => Sesion { detalle: Some(format!("No pude revisar la sesión de Claude Code: {e}.")), ..Sesion::default() },
+    }
+}
+
+/// The event a connection reports on: `{estado, url?, plan?, texto?}`, where
+/// `estado` is `url` (the fallback URL is known), then one of `conectado`,
+/// `error`, `cancelado` or `vencido`.
+pub const LOGIN_EVENT: &str = "plata-login";
+/// Past this, nobody is authorizing: the login is stopped.
+const LOGIN_TIMEOUT: Duration = Duration::from_secs(5 * 60);
+const LOGIN_POLL: Duration = Duration::from_secs(2);
+
+struct Login {
+    pid: u32,
+    stdin: Option<std::process::ChildStdin>,
+    stop: Arc<AtomicU8>,
+}
+
+static LOGIN: Mutex<Option<Login>> = Mutex::new(None);
+
+#[derive(Serialize, Clone, Debug)]
+#[serde(rename_all = "camelCase")]
+pub struct Connect {
+    /// Already on the plan: nothing was started.
+    pub conectado: bool,
+    pub plan: Option<String>,
+}
+
+/// The "If the browser didn't open, visit: <url>" URL, once it is complete.
+pub(crate) fn manual_login_url(out: &str) -> Option<String> {
+    let rest = out[out.find("visit:")? + "visit:".len()..].trim_start();
+    let end = rest.find(char::is_whitespace)?; // not complete until the line ends
+    let url = &rest[..end];
+    url.starts_with("https://").then(|| url.to_string())
+}
+
+/// What a login that ended without connecting said, in a line.
+pub(crate) fn login_failure(out: &str) -> String {
+    let line = out
+        .lines()
+        .flat_map(|l| l.split(" > ")) // the error lands on the "Paste code here >" line
+        .map(str::trim)
+        .filter(|l| !l.is_empty() && !l.starts_with("Opening browser") && !l.starts_with("If the browser") && !l.starts_with("Paste code"))
+        .last();
+    match line {
+        Some(l) => format!("Claude Code no se pudo conectar: {}", l.chars().take(200).collect::<String>()),
+        None => "Claude Code terminó sin conectarse.".to_string(),
+    }
+}
+
+fn emit_login(app: &AppHandle, ev: Value) {
+    let _ = app.emit_to(crate::island::WINDOW_LABEL, LOGIN_EVENT, ev);
+}
+
+/// Connects Claude Code to Lucas's plan, with no terminal: `auth login
+/// --claudeai` hidden, which opens the browser by itself. Returns at once; the
+/// end arrives as `plata-login`, from polling `auth status` every 2 s.
+/// If it is already connected nothing starts and `conectado` says so.
+pub fn connect(app: AppHandle) -> Result<Connect, String> {
+    let exe = plata_agent::claude_exe()
+        .ok_or_else(|| "No encuentro Claude Code: abrí la app de Claude una vez para que lo descargue.".to_string())?;
+    let mut guard = LOGIN.lock().unwrap();
+    if guard.is_some() {
+        return Ok(Connect { conectado: false, plan: None }); // already waiting for the browser
+    }
+    let now = auth_status(&exe);
+    if now.ok {
+        crate::plata_ready::invalidate();
+        return Ok(Connect { conectado: true, plan: now.plan });
+    }
+
+    let home = std::env::var_os("USERPROFILE").map(PathBuf::from).unwrap_or_else(|| PathBuf::from("."));
+    let mut cmd = plain_command(&exe);
+    cmd.args(["auth", "login", "--claudeai"])
+        .current_dir(&home)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped());
+    let mut child = cmd.spawn().map_err(|e| format!("No pude arrancar Claude Code: {e}"))?;
+    let pid = child.id();
+    let stop = Arc::new(AtomicU8::new(STOP_NONE));
+    *guard = Some(Login { pid, stdin: child.stdin.take(), stop: stop.clone() });
+    drop(guard);
+    crate::log::line("claude code login started");
+
+    // Both streams into one text: the URL is in stdout, an error may be in either.
+    let said = Arc::new(Mutex::new(String::new()));
+    let url_sent = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let readers: Vec<Box<dyn std::io::Read + Send>> = [
+        child.stdout.take().map(|s| Box::new(s) as Box<dyn std::io::Read + Send>),
+        child.stderr.take().map(|s| Box::new(s) as Box<dyn std::io::Read + Send>),
+    ]
+    .into_iter()
+    .flatten()
+    .collect();
+    for mut r in readers {
+        let (said, url_sent, app) = (said.clone(), url_sent.clone(), app.clone());
+        std::thread::spawn(move || {
+            let mut chunk = [0u8; 4096];
+            while let Ok(n) = r.read(&mut chunk) {
+                if n == 0 {
+                    break;
+                }
+                let mut s = said.lock().unwrap();
+                if s.len() < 64 * 1024 {
+                    s.push_str(&String::from_utf8_lossy(&chunk[..n]));
+                }
+                if !url_sent.load(Ordering::SeqCst) {
+                    if let Some(url) = manual_login_url(&s) {
+                        url_sent.store(true, Ordering::SeqCst);
+                        emit_login(&app, json!({ "estado": "url", "url": url }));
+                    }
+                }
+            }
+        });
+    }
+
+    std::thread::spawn(move || {
+        let started = Instant::now();
+        let ev = 'wait: loop {
+            // Short naps, so Cancel answers at once.
+            let nap = Instant::now();
+            while nap.elapsed() < LOGIN_POLL {
+                if stop.load(Ordering::SeqCst) == STOP_CANCEL {
+                    break 'wait json!({ "estado": "cancelado" });
+                }
+                std::thread::sleep(Duration::from_millis(100));
+            }
+            let exited = child.try_wait().ok().flatten().is_some();
+            let st = auth_status(&exe);
+            if st.ok {
+                break json!({ "estado": "conectado", "plan": st.plan });
+            }
+            if exited {
+                break json!({ "estado": "error", "texto": login_failure(&said.lock().unwrap()) });
+            }
+            if started.elapsed() > LOGIN_TIMEOUT {
+                break json!({
+                    "estado": "vencido",
+                    "texto": "Pasaron 5 minutos sin autorizar en el navegador: lo corté. Probá de nuevo cuando quieras.",
+                });
+            }
+        };
+        if child.try_wait().ok().flatten().is_none() {
+            kill_tree(pid);
+        }
+        let _ = child.wait();
+        LOGIN.lock().unwrap().take();
+        crate::plata_ready::invalidate();
+        crate::log::line(format!("claude code login ended: {ev}"));
+        emit_login(&app, ev);
+    });
+    Ok(Connect { conectado: false, plan: None })
+}
+
+/// The code the fallback page shows, typed into the waiting login.
+pub fn connect_code(code: &str) -> Result<(), String> {
+    let code = code.trim();
+    if code.is_empty() || code.len() > 4096 || code.contains(['\r', '\n']) {
+        return Err("Pegá el código tal como lo muestra la página.".into());
+    }
+    let mut guard = LOGIN.lock().unwrap();
+    let stdin = guard
+        .as_mut()
+        .and_then(|l| l.stdin.as_mut())
+        .ok_or_else(|| "No hay una conexión esperando el código: tocá Conectar de nuevo.".to_string())?;
+    writeln!(stdin, "{code}").and_then(|_| stdin.flush()).map_err(|e| format!("No pude pasarle el código: {e}"))
+}
+
+/// Stops a login waiting for the browser. False if none was.
+pub fn connect_cancel() -> bool {
+    let guard = LOGIN.lock().unwrap();
+    let Some(login) = guard.as_ref() else { return false };
+    login.stop.store(STOP_CANCEL, Ordering::SeqCst);
+    kill_tree(login.pid);
+    true
+}
