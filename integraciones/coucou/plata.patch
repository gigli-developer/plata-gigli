+/// Moves and sizes the window in one call, always on top, never activating it.
+/// One SetWindowPos instead of Tauri's separate size and position calls, which
+/// could show the window resized but not yet moved for a frame.
+fn set_bounds(hwnd: HWND, x: i32, y: i32, w: i32, h: i32) {
+    let flags = SWP_NOACTIVATE | SWP_NOOWNERZORDER;
+    unsafe {
+        let _ = SetWindowPos(hwnd, Some(HWND_TOPMOST), x, y, w, h, flags);
+    }
+    // Crossing to a display with another scale makes Windows rescale the window
+    // (WM_DPICHANGED) after the move: put back the size computed for it.
+    if let Some(r) = window_rect(hwnd) {
+        if r.left != x || r.top != y || r.right - r.left != w || r.bottom - r.top != h {
+            unsafe {
+                let _ = SetWindowPos(hwnd, Some(HWND_TOPMOST), x, y, w, h, flags);
+            }
+        }
+    }
+}
