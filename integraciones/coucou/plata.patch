@@ -483,6 +483,7 @@ pub fn run() {
             hooks::ensure_hook_exe(&handle);
             pipe::start(handle.clone());
             integrations::start(handle.clone());
+            tauri::async_runtime::spawn(plata_agent::ensure_running());
             Ok(())
         })
         .run(tauri::generate_context!())
