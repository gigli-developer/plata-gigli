+        .replace(/^\s*#{1,6}\s+/, "")
+        .replace(/^\s*>\s?/, "")
+        .replace(/^\s*([-*•]|\d+[.)])\s+/, "")
+        .replace(/\|/g, " ")
+        .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
+        .replace(/\*\*([^*]+)\*\*/g, "$1")
+        .replace(/`([^`]+)`/g, "$1")
+        .replace(/(^|[^\w*])\*([^*\s][^*]*)\*(?![\w*])/g, "$1$2")
+        .replace(/(^|[^\w_])_([^_\s][^_]*)_(?![\w_])/g, "$1$2"),
+    )
+    .join(" ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
