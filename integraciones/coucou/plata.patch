+  if (opts.icon) b.append(h("span", { class: "lz-btn-ic", html: opts.icon }));
+  b.append(h("span", { text: label }));
+  if (opts.enter) b.append(h("kbd", { text: "Enter" }));
+  b.addEventListener("click", (e) => {
