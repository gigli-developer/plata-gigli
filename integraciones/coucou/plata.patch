     crate::log::line(format!("claude code opened in {} ({})", repo.display(), file.display()));
     Ok(repo.file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_default())
 }
+
+/// At launch: if the agent is installed and not listening, start it, so the
+/// Plata tab is ready without asking. It keeps running if Coucou quits, and the
+/// next launch finds it up.
+pub async fn ensure_running() {
+    let st = status().await;
+    if st.up || st.dir.is_none() {
+        return;
