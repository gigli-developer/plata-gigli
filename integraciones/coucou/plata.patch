+// ── ¿Cómo voy este mes? ─────────────────────────────────────────────────────
+
+function mes(c: Card) {
+  c.loading("Sumo lo que va del mes…");
+  data.plata("mes").then((d) => {
+    if (!c.alive()) return;
+    c.think(false);
+    const ym = str(d.mes);
+    const dia = num(d.dia);
+    const total = num(d.total_ars);
+    const antes = num(d.mes_anterior_mismo_dia_ars);
+    let pct = num(d.variacion_pct);
+    if (pct === null && total !== null && antes) pct = ((total - antes) / antes) * 100;
+    const cats = (arr(d.categorias) ?? [])
+      .map((x) => ({ nombre: str(x.nombre) || "(sin categoría)", total: num(x.total_ars), cantidad: num(x.cantidad) }))
+      .filter((x): x is { nombre: string; total: number; cantidad: number | null } => x.total !== null);
+    const nombre = mesNombre(ym);
+    const Nombre = nombre.charAt(0).toUpperCase() + nombre.slice(1);
+    if (total === null) {
+      c.says(`No pude leer el total de ${nombre}.`);
+    } else {
+      let line = `${Nombre} va **${ars(total)}**${dia !== null ? ` en ${dia} ${plural(dia, "día", "días")}` : ""}`;
+      if (pct !== null && antes) {
+        const p = Math.round(Math.abs(pct));
+        line += p === 0 ? `: **lo mismo** que ${mesAnterior(ym)} a esta altura.` : `: **${p} % ${pct < 0 ? "menos" : "más"}** que ${mesAnterior(ym)} a esta altura.`;
+      } else line += ".";
+      if (cats.length) line += ` Lo que más pesa es ${cats[0].nombre}.`;
+      c.says(line);
+    }
+    const max = Math.max(1, ...cats.map((x) => x.total));
+    const bars = h("div", { class: "lz-bars" });
+    const fills: Array<[HTMLElement, number]> = [];
+    for (const x of cats.slice(0, 6)) {
+      const fill = h("i");
+      fills.push([fill, (x.total / max) * 100]);
+      bars.append(
+        h(
+          "div",
+          { class: "lz-bar-r", title: x.cantidad !== null ? `${x.cantidad} ${plural(x.cantidad, "movimiento", "movimientos")}` : "" },
+          h("span", { text: x.nombre }),
+          h("span", { class: "lz-rail" }, fill),
+          h("span", { class: "lz-v", text: ars(x.total) }),
+        ),
+      );
+    }
+    c.set(
+      cats.length
+        ? box("Por categoría", `${nombre}, en pesos`, bars)
+        : box("Por categoría", null, h("div", { class: "lz-sub", text: arr(d.categorias) ? "Todavía no hay gastos este mes." : "No pude leer las categorías." })),
+      acts(
+        btn("¿Cuánto tengo?", "sec", () => c.host.open("saldo")),
+        btn("Abrir Gastos hormiga", "sec", () => c.actions.openUrl(`${PLATA_URL}/hormiga`)),
+      ),
+    );
+    window.setTimeout(() => fills.forEach(([f, w]) => (f.style.width = `${Math.max(2, w)}%`)), 120);
+  }, (e) => c.fail(e, "el gasto del mes", () => c.host.open("mes")));
+}
