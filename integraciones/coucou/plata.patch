+
+button.lz-habit {
+  cursor: default;
+  transition: background 0.12s, transform 0.08s, opacity 0.15s;
+}
+
+button.lz-habit:hover:not(:disabled) {
+  background: rgba(255, 255, 255, 0.09);
+}
+
+button.lz-habit:active:not(:disabled) {
+  transform: scale(0.95);
+}
+
+button.lz-habit:disabled {
+  opacity: 0.6;
+}
+
+.lz-habits .lz-pstatus {
+  align-self: center;
+}
+
+.lz-habit[aria-pressed="true"] i {
+  background: var(--hc, rgb(var(--rgb)));
+}
+
+/* Quick input (expense, situation, task) */
+.lz-qin {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 9px 12px;
+  border-radius: 14px;
+  background: var(--card);
