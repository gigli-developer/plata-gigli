diff --git a/windows/src/views/plata.ts b/windows/src/views/plata.ts
new file mode 100644
index 0000000..6c6bb30
--- /dev/null
+++ b/windows/src/views/plata.ts
@@ -0,0 +1,316 @@
+// Plata view — a chat with Plata's agent (the `agentes` repo, `npm run servir`).
+//
+// The agent answers with a stream of events (CONTRATOS.md §9 in that repo):
+// `texto`, `tool`, `aviso`, `propuesta`, `error` and `fin`. Each one is drawn as
+// it arrives. A proposal gets a card with Approve / Reject: the answer goes back
+// to the agent as the next message, which is the only way the base accepts a
+// write (it refuses a confirmation made in the same turn that proposed it).
+
+import { h, svg, clear } from "./dom";
+import { ICONS } from "./icons";
+import { Bridge, onEvent, type PlataAgentStatus } from "../core/bridge";
+import { Sound } from "../core/sound";
+import { State } from "../core/state";
+import type { ViewHost } from "./views";
+
+type Propuesta = {
+  id: number;
+  tipo: string;
+  estado: string;
+  motivo_confirmacion: string | null;
+  resumen: string | null;
+  monto_ars: number | null;
+  expira_en: string | null;
+};
+
+type Evento =
+  | { tipo: "texto"; texto: string }
+  | { tipo: "tool"; nombre: string; entrada: unknown }
+  | { tipo: "aviso"; texto: string }
+  | { tipo: "propuesta"; propuesta: Propuesta }
+  | { tipo: "error"; texto: string }
+  | { tipo: "fin"; usos: Array<{ usd: number; precio_conocido: boolean }>; duracionMs: number };
+
+const ars = new Intl.NumberFormat("es-AR", { maximumFractionDigits: 2 });
+const usd = new Intl.NumberFormat("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 3 });
+
+function newSession(): string {
+  return `isla-${crypto.randomUUID()}`;
+}
+
+/** `mcp__plata__gastos_por_categoria` → `gastos por categoria`. */
+function toolLabel(name: string): string {
+  return name.replace(/^mcp__[^_]+__/, "").replace(/_/g, " ");
+}
+
+/** The island draws plain text: drop Markdown's emphasis and heading marks. */
+function plain(text: string): string {
+  return text
+    .replace(/\*\*(.+?)\*\*/g, "$1")
+    .replace(/^#{1,6}\s+/gm, "")
+    .replace(/`([^`]+)`/g, "$1")
+    .trim();
+}
+
+function hhmm(iso: string | null): string {
+  if (!iso) return "";
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return "";
+  return d.toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" });
+}
+
+export function buildPlata(): ViewHost {
+  let sesionId = newSession();
+  let sending = false;
+  let lastText = "";
+  let status: PlataAgentStatus | null = null;
+  // Per turn: the reply paragraph being filled and the running tools line.
+  let replyEl: HTMLElement | null = null;
+  let toolsEl: HTMLElement | null = null;
+  let toolsSeen: string[] = [];
+
+  const dotEl = h("i", { class: "plata-dot" });
+  const statusText = h("span", { class: "plata-status-text", text: "Plata" });
+  const resetBtn = h("button", { class: "plata-link", text: "Nueva", title: "Empezar otra conversación" });
+  const head = h("div", { class: "plata-head" }, dotEl, statusText, resetBtn);
+
+  const log = h("div", { class: "chat-log plata-log" });
+  const input = h("input", {
+    type: "text",
+    class: "chat-input",
+    placeholder: "Preguntale o pedile algo a Plata…",
+    spellcheck: "false",
+  }) as HTMLInputElement;
+  const send = h("button", { class: "send-btn plata-send", title: "Enviar" }, svg(ICONS.arrowUp, 11));
+  const bar = h("div", { class: "chat-bar" }, input, send);
+
+  const el = h(
+    "div",
+    { class: "view" },
+    h("div", { class: "card wash chat-card plata-card" }, h("div", { class: "chat-body plata-body" }, head, log, bar)),
+  );
+  (el.querySelector(".card") as HTMLElement).style.setProperty("--wash", "rgba(255,158,27,0.30)");
+
+  function scroll() {
+    log.scrollTop = log.scrollHeight;
+  }
+
+  function row(child: HTMLElement, cls = "chat-row"): HTMLElement {
+    const r = h("div", { class: cls }, child);
+    log.append(r);
+    scroll();
+    return r;
+  }
+
+  function typing(on: boolean) {
+    log.querySelector(".plata-typing")?.remove();
+    if (on) row(h("div", { class: "typing" }, h("i"), h("i"), h("i")), "chat-row plata-typing");
+  }
+
+  function renderStatus() {
+    const up = status?.up ?? false;
+    dotEl.classList.toggle("up", up);
+    statusText.textContent = up ? `Plata · ${status?.model ?? "agente"}` : "Plata · agente apagado";
+  }
+
+  async function refreshStatus(): Promise<PlataAgentStatus> {
+    let s: PlataAgentStatus;
+    try {
+      s = (await Bridge.plataStatus()) ?? { up: false, model: null, dir: null };
+    } catch {
+      s = { up: false, model: null, dir: null };
+    }
+    status = s;
+    renderStatus();
+    return s;
+  }
+
+  function note(text: string, cls = "plata-note") {
+    row(h("div", { class: cls, text }));
+  }
+
+  /** Card for a proposal: what it does, and the two answers. */
+  function proposalCard(p: Propuesta) {
+    const amount = p.monto_ars != null ? `$ ${ars.format(Number(p.monto_ars))}` : "";
+    const actions = h("div", { class: "plata-actions" });
+    const decide = (ok: boolean) => {
+      clear(actions);
+      actions.append(h("span", { class: "plata-decided", text: ok ? "Aprobada, aplicando…" : "Rechazada" }));
+      void submit(ok ? `Sí, aprobá la propuesta ${p.id}.` : `No, rechazá la propuesta ${p.id}.`);
+    };
+    actions.append(
+      h("button", { class: "btn primary plata-btn", onclick: () => decide(true) }, h("span", { text: "Aprobar" })),
+      h("button", { class: "btn secondary plata-btn", onclick: () => decide(false) }, h("span", { text: "Rechazar" })),
+    );
+    const card = h(
+      "div",
+      { class: "plata-prop" },
+      h(
+        "div",
+        { class: "plata-prop-head" },
+        h("span", { class: "plata-prop-kind", text: `Propuesta #${p.id}` }),
+        p.expira_en ? h("span", { class: "plata-prop-exp", text: `vence ${hhmm(p.expira_en)}` }) : null,
+      ),
+      h("div", { class: "plata-prop-body", text: plain(p.resumen ?? p.tipo) }),
+      amount ? h("div", { class: "plata-prop-amount", text: amount }) : null,
+      p.motivo_confirmacion ? h("div", { class: "plata-prop-why", text: plain(p.motivo_confirmacion) }) : null,
+      actions,
+    );
+    row(card, "chat-row plata-prop-row");
+  }
+
+  function onEvento(ev: Evento) {
+    switch (ev.tipo) {
+      case "texto": {
+        typing(false);
+        toolsEl = null;
+        if (!replyEl) replyEl = row(h("div", { class: "reply" })).firstElementChild as HTMLElement;
+        replyEl.textContent = plain(`${replyEl.textContent ? replyEl.textContent + "\n\n" : ""}${ev.texto}`);
+        scroll();
+        typing(sending);
+        break;
+      }
+      case "tool": {
+        typing(false);
+        replyEl = null;
+        const label = toolLabel(ev.nombre);
+        if (!toolsSeen.includes(label)) toolsSeen.push(label);
+        if (!toolsEl) toolsEl = row(h("div", { class: "plata-tools" })).firstElementChild as HTMLElement;
+        toolsEl.textContent = `Consultando: ${toolsSeen.join(", ")}`;
+        typing(sending);
+        break;
+      }
+      case "aviso":
+        note(plain(ev.texto));
+        break;
+      case "propuesta":
+        typing(false);
+        replyEl = null;
+        toolsEl = null;
+        proposalCard(ev.propuesta);
+        Sound.play("finish");
+        typing(sending);
+        break;
+      case "error":
+        typing(false);
+        note(plain(ev.texto), "plata-error");
+        break;
+      case "fin": {
+        const total = (ev.usos ?? []).reduce((a, u) => a + (u.usd ?? 0), 0);
+        const known = (ev.usos ?? []).every((u) => u.precio_conocido !== false);
+        const secs = Math.round((ev.duracionMs ?? 0) / 1000);
+        const cost = known ? `US$ ${usd.format(total)}` : "costo sin precio";
+        row(h("div", { class: "plata-cost", text: `${cost} · ${secs} s` }), "chat-row plata-cost-row");
+        break;
+      }
+    }
+  }
+
+  /** The agent isn't listening: say so, and offer to start it. */
+  function agentDown(retryText: string) {
+    const box = h("div", { class: "plata-error" }, h("span", { text: "El agente de Plata está apagado." }));
+    if (status?.dir) {
+      const btn = h("button", { class: "btn primary plata-btn" }, h("span", { text: "Prenderlo" }));
+      btn.addEventListener("click", async () => {
+        btn.setAttribute("disabled", "");
+        (btn.firstElementChild as HTMLElement).textContent = "Prendiendo…";
+        try {
+          await Bridge.plataStart();
+        } catch (e) {
+          note(String(e).replace(/^Error:\s*/, ""), "plata-error");
+          return;
+        }
+        // `npm run servir` checks the session before listening: give it time.
+        for (let i = 0; i < 40; i++) {
+          await new Promise((r) => setTimeout(r, 1500));
+          if ((await refreshStatus()).up) {
+            note("Listo, el agente está prendido.");
+            void submit(retryText, true);
+            return;
+          }
+        }
+        note("No arrancó. Mirá %LOCALAPPDATA%\\Coucou\\plata-agent.log.", "plata-error");
+      });
+      box.append(btn);
+    } else {
+      box.append(h("span", { text: " Prendelo con `npm run servir` en la carpeta agentes." }));
+    }
+    row(box);
+  }
+
+  async function submit(text: string, retry = false) {
+    const query = text.trim();
+    if (!query || sending) return;
+    sending = true;
+    lastText = query;
+    replyEl = null;
+    toolsEl = null;
+    toolsSeen = [];
+    if (!retry) row(h("div", { class: "bubble", text: query }), "chat-row user");
+    Sound.play("send");
+    State.stateOverride = "thinking";
+    State.notify();
+    typing(true);
+    try {
+      await Bridge.plataSend(query, sesionId);
+      Sound.play("finish");
+    } catch (err) {
+      const msg = String(err).replace(/^Error:\s*/, "");
+      typing(false);
+      if (msg === "agent_down") {
+        await refreshStatus();
+        agentDown(query);
+      } else {
+        note(msg, "plata-error");
+      }
+      Sound.play("error");
+    } finally {
+      sending = false;
+      typing(false);
+      State.stateOverride = null;
+      State.notify();
+      input.disabled = false;
+      input.focus();
+    }
+  }
+
+  void onEvent<{ sesionId: string; ev: Evento }>("plata-event", (p) => {
+    if (p.sesionId === sesionId) onEvento(p.ev);
+  });
+
+  send.addEventListener("click", () => {
+    const text = input.value;
+    input.value = "";
+    void submit(text);
+  });
+  input.addEventListener("keydown", (e) => {
+    if ((e as KeyboardEvent).key === "Enter") {
+      e.preventDefault();
+      const text = input.value;
+      input.value = "";
+      void submit(text);
+    }
+    e.stopPropagation(); // Escape closes the island, not the chat
+  });
+  resetBtn.addEventListener("click", () => {
+    if (sending) return;
+    sesionId = newSession();
+    lastText = "";
+    clear(log);
+    note("Conversación nueva.");
+  });
+
+  note("Preguntale por tus saldos, gastos o deudas, o pedile que registre algo. Lo que cambie datos te lo muestra antes, para que lo apruebes.");
+
+  return {
+    el,
+    sync() {
+      input.disabled = sending;
+      input.placeholder = lastText ? "Seguí…" : "Preguntale o pedile algo a Plata…";
+    },
+    focus() {
+      void refreshStatus();
+      input.focus();
+    },
+  };
+}
