+        [x.venta !== null ? `venta ${ars(x.venta)}` : null, x.dia && x.dia !== today ? `del ${fechaCorta(x.dia)}` : null].filter(Boolean).join(" · ") || null,
+        { missing: `No pude leer el ${title.toLowerCase()}` },
