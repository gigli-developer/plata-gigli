+
+// ── Changes to the app go to Claude Code, not to the agent ──────────────────
+
+/// The Plata checkout: a folder whose git remote is plata-gigli.
+fn plata_repo_dir() -> Option<PathBuf> {
+    let home = PathBuf::from(std::env::var_os("USERPROFILE")?);
+    [
+        home.join("OneDrive").join("Desktop").join("Claude").join("finanzas-app"),
+        home.join("Desktop").join("Claude").join("finanzas-app"),
+        home.join("plata-gigli"),
+    ]
+    .into_iter()
+    .find(|p| {
