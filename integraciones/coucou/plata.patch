+
+.lz-ev {
+  position: absolute;
+  top: 8px;
+  height: 14px;
+  border-radius: 4px;
+  background: var(--c);
+}
+
+.lz-ev span {
+  position: absolute;
+  top: 15px;
+  left: 0;
