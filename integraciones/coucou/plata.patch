+/// The island plus the panel-sized area around it, window-logical px.
+fn in_drop_zone(r: &IslandRect, x: f64, y: f64) -> bool {
+    let cx = r.x + r.w / 2.0;
+    let half = (PANEL_W / 2.0).max(r.w / 2.0 + HIT_MARGIN);
+    let bottom = (r.y + PANEL_H).max(r.y + r.h + HIT_MARGIN);
