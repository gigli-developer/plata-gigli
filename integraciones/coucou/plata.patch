index 0000000..ce4fffb
--- /dev/null
+++ b/windows/src/views/markdown.ts
@@ -0,0 +1,177 @@
+// The agent answers in Markdown (tables, bold, lists). This draws the subset it
+// uses as real elements. It builds the DOM node by node and only ever sets
+// textContent: the text comes from the model and from bank statements, so it
+// must never reach innerHTML.
+
+import { h } from "./dom";
+
+type Block =
+  | { kind: "p"; lines: string[] }
+  | { kind: "h"; level: number; text: string }
+  | { kind: "ul" | "ol"; items: string[] }
+  | { kind: "table"; head: string[]; rows: string[][]; align: ("l" | "r" | "c")[] }
+  | { kind: "hr" }
+  | { kind: "source"; text: string };
+
+const TABLE_SEP = /^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?\s*$/;
+const BULLET = /^\s*[-*•]\s+(.*)$/;
+const NUMBERED = /^\s*\d+[.)]\s+(.*)$/;
+// A money or plain number cell: right-aligned, tabular figures.
+const NUMERIC = /^[\s(+−-]*(US\$|U\$S|\$|USD|ARS)?\s*[−-]?[\d.,]+(\s*(%|USD|ARS))?\)?\s*$/;
+
+function cells(line: string): string[] {
+  let s = line.trim();
+  if (s.startsWith("|")) s = s.slice(1);
+  if (s.endsWith("|")) s = s.slice(0, -1);
+  return s.split("|").map((c) => c.trim());
+}
+
+function parse(text: string): Block[] {
+  const lines = text.replace(/\r\n?/g, "\n").split("\n");
+  const blocks: Block[] = [];
+  let para: string[] = [];
+  const flush = () => {
+    if (para.length) blocks.push({ kind: "p", lines: para });
+    para = [];
+  };
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    const t = line.trim();
+    if (!t) {
+      flush();
+      continue;
+    }
+    // Table: a header row followed by its |---| line.
+    if (t.includes("|") && i + 1 < lines.length && TABLE_SEP.test(lines[i + 1])) {
+      flush();
+      const head = cells(t);
+      const align = cells(lines[i + 1]).map((c) => (c.endsWith(":") ? (c.startsWith(":") ? "c" : "r") : "l") as "l" | "r" | "c");
+      const rows: string[][] = [];
+      i += 2;
+      while (i < lines.length && lines[i].trim().includes("|")) {
+        rows.push(cells(lines[i]));
+        i++;
+      }
+      i--;
+      blocks.push({ kind: "table", head, rows, align });
+      continue;
+    }
+    const heading = /^(#{1,6})\s+(.*)$/.exec(t);
+    if (heading) {
+      flush();
+      blocks.push({ kind: "h", level: Math.min(heading[1].length, 3), text: heading[2] });
+      continue;
+    }
+    if (/^(-{3,}|\*{3,}|_{3,})$/.test(t)) {
+      flush();
+      blocks.push({ kind: "hr" });
+      continue;
+    }
+    // The agent closes every answer with its sources: a footnote, not prose.
+    if (/^\*{0,2}(Fuentes?|Fuente)\*{0,2}\s*:/i.test(t)) {
+      flush();
+      blocks.push({ kind: "source", text: t.replace(/^\*{0,2}(Fuentes?)\*{0,2}\s*:\s*/i, "") });
+      continue;
+    }
+    const bullet = BULLET.exec(line);
+    const numbered = bullet ? null : NUMBERED.exec(line);
+    if (bullet || numbered) {
+      flush();
+      const kind = bullet ? "ul" : "ol";
+      const last = blocks[blocks.length - 1];
+      const item = (bullet ?? numbered)![1];
+      if (last && last.kind === kind) last.items.push(item);
+      else blocks.push({ kind, items: [item] });
+      continue;
+    }
+    // A line that continues a list item (indented) stays with it.
+    const last = blocks[blocks.length - 1];
+    if (!para.length && last && (last.kind === "ul" || last.kind === "ol") && /^\s{2,}/.test(line)) {
+      last.items[last.items.length - 1] += " " + t;
+      continue;
+    }
+    para.push(t);
+  }
+  flush();
+  return blocks;
+}
+
+/** Bold, italics and code inside a line, as nodes. */
+function inline(text: string): Node[] {
+  const out: Node[] = [];
+  const re = /(\*\*[^*]+\*\*|`[^`]+`|(?<![\w*])\*[^*\s][^*]*\*(?![\w*])|(?<![\w_])_[^_\s][^_]*_(?![\w_]))/g;
+  let at = 0;
+  for (const m of text.matchAll(re)) {
+    if (m.index! > at) out.push(document.createTextNode(text.slice(at, m.index)));
+    const tok = m[0];
+    if (tok.startsWith("**")) out.push(h("strong", { text: tok.slice(2, -2) }));
+    else if (tok.startsWith("`")) out.push(h("code", { text: tok.slice(1, -1) }));
+    else out.push(h("em", { text: tok.slice(1, -1) }));
+    at = m.index! + tok.length;
+  }
+  if (at < text.length) out.push(document.createTextNode(text.slice(at)));
+  return out;
+}
+
+function withInline<T extends HTMLElement>(el: T, text: string): T {
+  el.append(...inline(text));
+  return el;
+}
+
+/** The agent's Markdown as elements, ready to put in a `.md` container. */
+export function renderMarkdown(text: string): DocumentFragment {
+  const frag = document.createDocumentFragment();
+  for (const b of parse(text)) {
+    switch (b.kind) {
+      case "p": {
+        const p = h("p");
+        b.lines.forEach((l, i) => {
+          if (i) p.append(h("br"));
+          p.append(...inline(l));
+        });
+        frag.append(p);
+        break;
+      }
+      case "h":
+        frag.append(withInline(h(b.level === 1 ? "h3" : b.level === 2 ? "h4" : "h5"), b.text));
+        break;
+      case "ul":
+      case "ol": {
+        const list = h(b.kind);
+        for (const item of b.items) list.append(withInline(h("li"), item));
+        frag.append(list);
+        break;
+      }
+      case "hr":
+        frag.append(h("hr"));
+        break;
+      case "source":
+        frag.append(withInline(h("p", { class: "md-source" }, "Fuente · "), b.text));
+        break;
+      case "table": {
+        const numericCol = b.head.map((_, c) => {
+          const vals = b.rows.map((r) => r[c] ?? "").filter((v) => v && v !== "—" && v !== "-");
+          return vals.length > 0 && vals.every((v) => NUMERIC.test(v.replace(/\*\*/g, "")));
+        });
+        const cls = (c: number) => (b.align[c] === "r" || numericCol[c] ? "num" : b.align[c] === "c" ? "mid" : "");
+        const table = h("table");
+        const tr = h("tr");
+        b.head.forEach((cell, c) => tr.append(withInline(h("th", { class: cls(c) }), cell)));
+        table.append(h("thead", {}, tr));
+        const body = h("tbody");
+        for (const row of b.rows) {
+          const r = h("tr");
+          // A "Total" row reads as the result of the table.
+          if (/^\**\s*total/i.test(row[0] ?? "")) r.className = "total";
+          b.head.forEach((_, c) => r.append(withInline(h("td", { class: cls(c) }), row[c] ?? "")));
+          body.append(r);
+        }
+        table.append(body);
+        frag.append(h("div", { class: "md-table" }, table));
+        break;
+      }
+    }
+  }
+  return frag;
+}
