+  // Wednesday's free time: 17 to 21:30 and nothing else long enough.
+  const day = arMs("2026-10-07");
+  assert.deepEqual(freeSlots(dayBusy(evs, day)), [{ s: 17 * 60, e: 21 * 60 + 30 }, { s: 22 * 60, e: 23 * 60 }]);
+});
