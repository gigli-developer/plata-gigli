+static DRAGGING: AtomicBool = AtomicBool::new(false);
+
+/// How close to a screen edge, in logical px, a dropped island docks to it.
+const SNAP: f64 = 56.0;
+
+/// Moves the island's window with the mouse until the left button comes up, then
+/// docks it. Near the left or right edge of the work area → that side; near the
+/// top → back to the top centre; anywhere else → floating where it was dropped.
+///
+/// Rust owns the loop rather than the page: the window moves under the cursor, so
+/// window-relative mouse events would chase themselves. `offset_*` is where the
+/// cursor grabbed the window, in window-logical px.
+pub fn drag_loop(app: AppHandle, offset_x: f64, offset_y: f64) {
+    if DRAGGING.swap(true, Ordering::SeqCst) {
+        return;
+    }
+    let Some(win) = window(&app) else {
+        DRAGGING.store(false, Ordering::SeqCst);
+        return;
+    };
+    let scale = win.scale_factor().unwrap_or(1.0);
+    let (ox, oy) = ((offset_x * scale).round() as i32, (offset_y * scale).round() as i32);
+    let mut last = (i32::MIN, i32::MIN);
+    while left_button_down() {
+        if let Some((cx, cy)) = cursor_physical() {
+            let pos = (cx as i32 - ox, cy as i32 - oy);
+            if pos != last {
+                let _ = win.set_position(PhysicalPosition::new(pos.0, pos.1));
+                last = pos;
+            }
+        }
+        std::thread::sleep(Duration::from_millis(8));
+    }
+    if let Some(settings) = dock_after_drag(&app, &win) {
+        crate::log::line(format!("island docked: {} ({:.0}, {:.0})", settings.dock, settings.dock_x, settings.dock_y));
+        if let Err(err) = crate::settings::save(&settings) {
+            crate::log::line(format!("could not save the island position: {err}"));
+        }
+        apply_geometry(&app, &settings.screen, false);
+        // Both windows keep a copy of the settings: keep them in step.
+        let _ = app.emit("settings-changed", settings);
+    }
+    DRAGGING.store(false, Ordering::SeqCst);
+}
