+    let top = want.1.clamp(wa.y as f64, (wa.y + wa.h) as f64);
+    let keep_y = keep.map(|k| k.1).unwrap_or(0.0);
+    let y = clamp_y(top - keep_y * scale);
+    let anchor_y = (top - y as f64) / scale;
