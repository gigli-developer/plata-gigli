+        assert_eq!(r(r#"{"skill":"gasto","confianza":92}"#), json!({"skill":"gasto","confianza":92}));
+        assert_eq!(r("```json\n{\"skill\": \"saldo\", \"confianza\": 71}\n```"), json!({"skill":"saldo","confianza":71}));
+        assert_eq!(r(r#"Creo que es {"skill":"Resumenes","confianza":"85%"} nomás"#), json!({"skill":"resumenes","confianza":85}));
+        assert_eq!(r(r#"{"skill":"dia","confianza":0.8}"#), json!({"skill":"dia","confianza":80}));
